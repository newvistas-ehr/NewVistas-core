^TIU(8925,44,0)="TELEPHONE NOTE^12;DPT(^3^^^^3250202"
^TIU(8925,44,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,44,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,44,"TEXT",3,0)=""
^TIU(8925,44,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,44,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,44,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,44,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,44,"TEXT",8,0)=""
^TIU(8925,44,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,44,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,44,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,44,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,44,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,44,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,44,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,44,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,44,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,44,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,44,"TEXT",19,0)=""
^TIU(8925,44,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,44,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,44,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,44,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,44,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,45,0)="CONSULT NOTE^13;DPT(^5^^^^3240811"
^TIU(8925,45,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,45,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,45,"TEXT",3,0)=""
^TIU(8925,45,"TEXT",4,0)="SUBJECTIVE: 6 weeks status post right Achilles tendon repair."
^TIU(8925,45,"TEXT",5,0)="Transitioned from posterior splint to CAM boot 2 weeks ago."
^TIU(8925,45,"TEXT",6,0)="Weight-bearing as tolerated in boot. Pain minimal."
^TIU(8925,45,"TEXT",7,0)=""
^TIU(8925,45,"TEXT",8,0)="OBJECTIVE:"
^TIU(8925,45,"TEXT",9,0)="Right ankle: Incision well healed. Palpable repair intact."
^TIU(8925,45,"TEXT",10,0)="Ankle ROM (in boot): DF to neutral, PF 30 degrees."
^TIU(8925,45,"TEXT",11,0)="Thompson test: Positive (expected at this stage, tendon not yet strong)."
^TIU(8925,45,"TEXT",12,0)="Calf atrophy noted compared to left."
^TIU(8925,45,"TEXT",13,0)=""
^TIU(8925,45,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,45,"TEXT",15,0)="1. R Achilles repair: Healing on schedule."
^TIU(8925,45,"TEXT",16,0)="2. Begin gentle active ROM outside of boot."
^TIU(8925,45,"TEXT",17,0)="3. PT referral for Achilles repair protocol."
^TIU(8925,45,"TEXT",18,0)="4. Continue CAM boot for walking. Remove for exercises only."
^TIU(8925,45,"TEXT",19,0)="5. No running or jumping for 4-6 months."
^TIU(8925,45,"TEXT",20,0)="6. Follow up in 6 weeks."
^TIU(8925,46,0)="PROGRESS NOTE^13;DPT(^5^^^^3240610"
^TIU(8925,46,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,46,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,46,"TEXT",3,0)=""
^TIU(8925,46,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,46,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,46,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,46,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,46,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,46,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,46,"TEXT",10,0)=""
^TIU(8925,46,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,46,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,46,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,46,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,46,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,46,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,46,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,46,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,46,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
^TIU(8925,46,"TEXT",20,0)=""
^TIU(8925,46,"TEXT",21,0)="ASSESSMENT AND PLAN:"
^TIU(8925,46,"TEXT",22,0)="Symptoms improving on current medication regimen."
^TIU(8925,46,"TEXT",23,0)="Continue current psychotropic medications."
^TIU(8925,46,"TEXT",24,0)="Continue weekly psychotherapy."
^TIU(8925,46,"TEXT",25,0)="Safety plan reviewed and updated. Patient verbalizes plan."
^TIU(8925,46,"TEXT",26,0)="Follow up in 4 weeks."
^TIU(8925,47,0)="PROGRESS NOTE^13;DPT(^5^^^^3250924"
^TIU(8925,47,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,47,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,47,"TEXT",3,0)=""
^TIU(8925,47,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,47,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,47,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,47,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,47,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,47,"TEXT",9,0)=""
^TIU(8925,47,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,47,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,47,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,47,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,47,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,47,"TEXT",15,0)=""
^TIU(8925,47,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,47,"TEXT",17,0)=""
^TIU(8925,47,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,47,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,47,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,47,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,47,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,47,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
^TIU(8925,48,0)="DISCHARGE SUMMARY^14;DPT(^1^^^^3240615"
^TIU(8925,48,"TEXT",1,0)="REHABILITATION MEDICINE NOTE"
^TIU(8925,48,"TEXT",2,0)="INPATIENT REHABILITATION MEDICINE NOTE"
^TIU(8925,48,"TEXT",3,0)=""
^TIU(8925,48,"TEXT",4,0)="SUBJECTIVE: Day 5 of inpatient rehabilitation following acute right MCA CVA."
^TIU(8925,48,"TEXT",5,0)="Patient alert but fatigued. Left-sided weakness improving slowly."
^TIU(8925,48,"TEXT",6,0)="Able to follow 2-step commands consistently. Speech slightly dysarthric."
^TIU(8925,48,"TEXT",7,0)="Motivation fair. Reports frustration with left arm weakness."
^TIU(8925,48,"TEXT",8,0)="Family supportive. Spouse present during therapy sessions."
^TIU(8925,48,"TEXT",9,0)=""
^TIU(8925,48,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,48,"TEXT",11,0)="Neuro: Alert, oriented x3 (date confused). Left neglect resolving."
^TIU(8925,48,"TEXT",12,0)="Motor: Right UE/LE 5/5. Left UE 2/5 prox, 1/5 distal. Left LE 3/5."
^TIU(8925,48,"TEXT",13,0)="Sensory: Decreased light touch left UE and LE."
^TIU(8925,48,"TEXT",14,0)="Speech: Mild dysarthria. Comprehension intact."
^TIU(8925,48,"TEXT",15,0)="Swallowing: Cleared by SLP for mechanical soft diet."
^TIU(8925,48,"TEXT",16,0)="FIM scores: Self-care 3 (mod assist), Mobility 3, Cognition 5."
^TIU(8925,48,"TEXT",17,0)=""
^TIU(8925,48,"TEXT",18,0)="THERAPY PROGRESS:"
^TIU(8925,48,"TEXT",19,0)="PT: Standing with mod assist. Beginning parallel bar gait training."
^TIU(8925,48,"TEXT",20,0)="OT: ADL training with adaptive equipment. Left UE AROM exercises."
^TIU(8925,48,"TEXT",21,0)="SLP: Articulation exercises. Cognitive-linguistic therapy."
^TIU(8925,48,"TEXT",22,0)=""
^TIU(8925,48,"TEXT",23,0)="ASSESSMENT AND PLAN:"
^TIU(8925,48,"TEXT",24,0)="1. R MCA stroke with L hemiparesis: Making functional gains."
^TIU(8925,48,"TEXT",25,0)="2. Continue intensive inpatient rehab (PT/OT/SLP 3 hrs/day)."
^TIU(8925,48,"TEXT",26,0)="3. DVT prophylaxis: Continue enoxaparin."
^TIU(8925,48,"TEXT",27,0)="4. Start aspirin 81mg + atorvastatin 80mg for secondary prevention."
^TIU(8925,48,"TEXT",28,0)="5. BP management: Target <130/80."
^TIU(8925,48,"TEXT",29,0)="6. Depression screening in 1 week (common post-stroke)."
^TIU(8925,48,"TEXT",30,0)="7. Family meeting scheduled to discuss discharge planning."
^TIU(8925,48,"TEXT",31,0)="8. Projected length of stay: 2-3 more weeks."
^TIU(8925,49,0)="PROGRESS NOTE^14;DPT(^1^^^^3240323"
^TIU(8925,49,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,49,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,49,"TEXT",3,0)=""
^TIU(8925,49,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,49,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,49,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,49,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,49,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,49,"TEXT",9,0)=""
^TIU(8925,49,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,49,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,49,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,49,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,49,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,49,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,49,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,49,"TEXT",17,0)=""
^TIU(8925,49,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,49,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,49,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,49,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,49,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,49,"TEXT",23,0)="5. Follow up in 3 months."
