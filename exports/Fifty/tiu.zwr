^TIU(8925,42,0)="CONSULT NOTE^12;DPT(^3^^^^3251214"
^TIU(8925,42,"TEXT",1,0)="SPINE CLINIC NOTE"
^TIU(8925,42,"TEXT",2,0)="SPINE CLINIC EVALUATION"
^TIU(8925,42,"TEXT",3,0)=""
^TIU(8925,42,"TEXT",4,0)="SUBJECTIVE: Patient presents with worsening low back pain radiating to left leg."
^TIU(8925,42,"TEXT",5,0)="Pain rated 7/10, described as sharp and burning down posterior left thigh to calf."
^TIU(8925,42,"TEXT",6,0)="Onset: Acute worsening 3 weeks ago while lifting."
^TIU(8925,42,"TEXT",7,0)="Aggravating factors: Sitting >20 min, bending, lifting."
^TIU(8925,42,"TEXT",8,0)="Relieving factors: Standing, walking short distances, lying flat."
^TIU(8925,42,"TEXT",9,0)="Denies bowel or bladder dysfunction. No saddle anesthesia."
^TIU(8925,42,"TEXT",10,0)="Has tried ibuprofen, acetaminophen, and ice without adequate relief."
^TIU(8925,42,"TEXT",11,0)=""
^TIU(8925,42,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,42,"TEXT",13,0)="Lumbar: Paravertebral muscle spasm bilateral. Decreased lordosis."
^TIU(8925,42,"TEXT",14,0)="ROM: Flexion limited to 30 degrees (pain), Extension 10 degrees."
^TIU(8925,42,"TEXT",15,0)="Lateral flexion limited bilateral. Rotation limited by pain."
^TIU(8925,42,"TEXT",16,0)="SLR: Positive on left at 35 degrees reproducing radicular symptoms."
^TIU(8925,42,"TEXT",17,0)="Neuro: L5 weakness (EHL 4/5 left). Sensation decreased L5 dermatome left."
^TIU(8925,42,"TEXT",18,0)="Ankle reflex present bilateral. Knee reflex 2+ bilateral."
^TIU(8925,42,"TEXT",19,0)="Babinski negative bilaterally."
^TIU(8925,42,"TEXT",20,0)=""
^TIU(8925,42,"TEXT",21,0)="MRI: L4-5 left paracentral disc extrusion compressing left L5 nerve root."
^TIU(8925,42,"TEXT",22,0)=""
^TIU(8925,42,"TEXT",23,0)="ASSESSMENT AND PLAN:"
^TIU(8925,42,"TEXT",24,0)="1. L4-5 disc herniation with left L5 radiculopathy."
^TIU(8925,42,"TEXT",25,0)="2. Start oral steroid taper: Medrol dose pack."
^TIU(8925,42,"TEXT",26,0)="3. Gabapentin 300mg TID for neuropathic pain."
^TIU(8925,42,"TEXT",27,0)="4. Physical therapy referral: McKenzie-based approach, core stabilization."
^TIU(8925,42,"TEXT",28,0)="5. Epidural steroid injection if no improvement in 4-6 weeks."
^TIU(8925,42,"TEXT",29,0)="6. Surgical consultation only if fail conservative management x 6-12 weeks."
^TIU(8925,42,"TEXT",30,0)="7. Activity modification: avoid heavy lifting. Ergonomic education."
^TIU(8925,42,"TEXT",31,0)="8. Follow up in 4 weeks."
