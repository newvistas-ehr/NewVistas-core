^TIU(8925,22,0)="PROGRESS NOTE^6;DPT(^3^^^^3240606"
^TIU(8925,22,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,22,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,22,"TEXT",3,0)=""
^TIU(8925,22,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,22,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,22,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,22,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,22,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,22,"TEXT",9,0)=""
^TIU(8925,22,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,22,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,22,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,22,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,22,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,22,"TEXT",15,0)=""
^TIU(8925,22,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,22,"TEXT",17,0)=""
^TIU(8925,22,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,22,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,22,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,22,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,22,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,22,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,23,0)="PROGRESS NOTE^7;DPT(^3^^^^3251228"
^TIU(8925,23,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,23,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,23,"TEXT",3,0)=""
^TIU(8925,23,"TEXT",4,0)="SUBJECTIVE: 2 weeks status post right ACL reconstruction with BTB autograft."
^TIU(8925,23,"TEXT",5,0)="Tolerating brace well. Minimal pain with medication."
^TIU(8925,23,"TEXT",6,0)="Ice and elevation as directed. No fever or wound concerns."
^TIU(8925,23,"TEXT",7,0)=""
^TIU(8925,23,"TEXT",8,0)="OBJECTIVE:"
^TIU(8925,23,"TEXT",9,0)="Right knee: Incisions clean. Mild effusion. No warmth."
^TIU(8925,23,"TEXT",10,0)="ROM: 0-90 degrees in brace (limited per protocol)."
^TIU(8925,23,"TEXT",11,0)="Quad firing present. Straight-leg raise possible with brace."
^TIU(8925,23,"TEXT",12,0)="Lachman: Stable endpoint."
^TIU(8925,23,"TEXT",13,0)=""
^TIU(8925,23,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,23,"TEXT",15,0)="1. R ACL reconstruction: Progressing per protocol."
^TIU(8925,23,"TEXT",16,0)="2. Unlock brace for ROM exercises. Goal: full extension, 120 degrees flexion by 6 weeks."
^TIU(8925,23,"TEXT",17,0)="3. Begin outpatient PT — ACL reconstruction protocol."
^TIU(8925,23,"TEXT",18,0)="4. Weight-bearing as tolerated in locked brace."
^TIU(8925,23,"TEXT",19,0)="5. Follow up in 4 weeks."
^TIU(8925,24,0)="PROGRESS NOTE^7;DPT(^3^^^^3250627"
^TIU(8925,24,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,24,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION — ACL RECONSTRUCTION PROTOCOL"
^TIU(8925,24,"TEXT",3,0)=""
^TIU(8925,24,"TEXT",4,0)="DIAGNOSIS: S/P right ACL reconstruction with BTB autograft, 2 weeks post-op."
^TIU(8925,24,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 24 visits."
^TIU(8925,24,"TEXT",6,0)="PROTOCOL: Progressive ACL rehabilitation, 6-9 month return to activity."
^TIU(8925,24,"TEXT",7,0)=""
^TIU(8925,24,"TEXT",8,0)="SUBJECTIVE: Young veteran sustained ACL tear during recreational sports."
^TIU(8925,24,"TEXT",9,0)="S/P arthroscopic ACL reconstruction with BTB autograft 2 weeks ago."
^TIU(8925,24,"TEXT",10,0)="Pain 3/10 at rest, 5/10 with exercise. Sleeping in brace as instructed."
^TIU(8925,24,"TEXT",11,0)="Goal: Return to full activity including running and sports."
^TIU(8925,24,"TEXT",12,0)=""
^TIU(8925,24,"TEXT",13,0)="OBJECTIVE:"
^TIU(8925,24,"TEXT",14,0)="Right knee ROM: Extension 0 degrees (full), Flexion 85 degrees."
^TIU(8925,24,"TEXT",15,0)="Effusion: 2+ (moderate). Patellar mobility: restricted superiorly."
^TIU(8925,24,"TEXT",16,0)="VMO activation present but weak. SLR possible."
^TIU(8925,24,"TEXT",17,0)="MMT: R quads 3/5, R hamstrings 4-/5."
^TIU(8925,24,"TEXT",18,0)="Gait: WBAT in locked hinged brace. Antalgic on right."
^TIU(8925,24,"TEXT",19,0)="Donor site: Patellar tendon harvest site tender to palpation."
^TIU(8925,24,"TEXT",20,0)=""
^TIU(8925,24,"TEXT",21,0)="ASSESSMENT: Patient in Phase 1 of ACL rehab protocol."
^TIU(8925,24,"TEXT",22,0)="Primary deficits: knee flexion ROM, quad strength, effusion control."
^TIU(8925,24,"TEXT",23,0)=""
^TIU(8925,24,"TEXT",24,0)="PLAN — PHASE 1 (Weeks 0-6):"
^TIU(8925,24,"TEXT",25,0)="1. Restore full extension, progress flexion to 120 degrees."
^TIU(8925,24,"TEXT",26,0)="2. Quad activation: e-stim, quad sets, SLR in 4 planes."
^TIU(8925,24,"TEXT",27,0)="3. Patellar mobilization. Scar mobilization at 4 weeks."
^TIU(8925,24,"TEXT",28,0)="4. Effusion management: ice, compression, elevation."
^TIU(8925,24,"TEXT",29,0)="5. Begin closed-chain exercises: mini-squats, leg press (limited range)."
^TIU(8925,24,"TEXT",30,0)="6. Gait training: normalize pattern, wean from brace."
^TIU(8925,24,"TEXT",31,0)="7. Frequency: 3x/week for 6 weeks, then reassess."
^TIU(8925,25,0)="PROGRESS NOTE^7;DPT(^3^^^^3240228"
^TIU(8925,25,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,25,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,25,"TEXT",3,0)=""
^TIU(8925,25,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,25,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,25,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,25,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,25,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,25,"TEXT",9,0)=""
^TIU(8925,25,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,25,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,25,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,25,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,25,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,25,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,25,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,25,"TEXT",17,0)=""
^TIU(8925,25,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,25,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,25,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,25,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,25,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,25,"TEXT",23,0)="5. Follow up in 3 months."
^TIU(8925,26,0)="TELEPHONE NOTE^7;DPT(^3^^^^3240427"
^TIU(8925,26,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,26,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,26,"TEXT",3,0)=""
^TIU(8925,26,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,26,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,26,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,26,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,26,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,26,"TEXT",9,0)=""
^TIU(8925,26,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,26,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,26,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,26,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,26,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,26,"TEXT",15,0)=""
^TIU(8925,26,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,26,"TEXT",17,0)=""
^TIU(8925,26,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,26,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,26,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,26,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,26,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,26,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
^TIU(8925,27,0)="PROGRESS NOTE^8;DPT(^3^^^^3240209"
^TIU(8925,27,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,27,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,27,"TEXT",3,0)=""
^TIU(8925,27,"TEXT",4,0)="SUBJECTIVE: 2 weeks status post ORIF right distal radius fracture."
^TIU(8925,27,"TEXT",5,0)="Splint removed today. Pain 3/10. Fingers moving well."
^TIU(8925,27,"TEXT",6,0)="Numbness in thumb and index finger has resolved since surgery."
^TIU(8925,27,"TEXT",7,0)=""
^TIU(8925,27,"TEXT",8,0)="OBJECTIVE:"
^TIU(8925,27,"TEXT",9,0)="Right wrist: Incision clean, healing well. Mild swelling."
^TIU(8925,27,"TEXT",10,0)="Finger ROM: Full flexion and extension all digits. Grip weak."
^TIU(8925,27,"TEXT",11,0)="Wrist ROM: DF 15 degrees, PF 20 degrees, Rad Dev 5 degrees."
^TIU(8925,27,"TEXT",12,0)=""
^TIU(8925,27,"TEXT",13,0)="X-rays: Hardware intact. Articular surface maintained. No displacement."
^TIU(8925,27,"TEXT",14,0)=""
^TIU(8925,27,"TEXT",15,0)="ASSESSMENT AND PLAN:"
^TIU(8925,27,"TEXT",16,0)="1. R distal radius fracture s/p ORIF: Healing appropriately."
^TIU(8925,27,"TEXT",17,0)="2. Begin gentle active ROM exercises for wrist."
^TIU(8925,27,"TEXT",18,0)="3. Hand therapy/PT referral for ROM, grip strength, scar management."
^TIU(8925,27,"TEXT",19,0)="4. Removable wrist splint for comfort, remove for exercises."
^TIU(8925,27,"TEXT",20,0)="5. Follow up in 4 weeks with repeat x-rays."
^TIU(8925,28,0)="PROGRESS NOTE^8;DPT(^3^^^^3250621"
^TIU(8925,28,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,28,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,28,"TEXT",3,0)=""
^TIU(8925,28,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,28,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,28,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,28,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,28,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,28,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,28,"TEXT",10,0)=""
^TIU(8925,28,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,28,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,28,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,28,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,28,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,28,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,28,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,28,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,28,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
^TIU(8925,28,"TEXT",20,0)=""
^TIU(8925,28,"TEXT",21,0)="ASSESSMENT AND PLAN:"
^TIU(8925,28,"TEXT",22,0)="Symptoms improving on current medication regimen."
^TIU(8925,28,"TEXT",23,0)="Continue current psychotropic medications."
^TIU(8925,28,"TEXT",24,0)="Continue weekly psychotherapy."
^TIU(8925,28,"TEXT",25,0)="Safety plan reviewed and updated. Patient verbalizes plan."
^TIU(8925,28,"TEXT",26,0)="Follow up in 4 weeks."
