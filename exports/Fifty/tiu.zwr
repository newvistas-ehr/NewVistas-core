^TIU(8925,118,0)="DISCHARGE SUMMARY^34;DPT(^3^^^^3240109"
^TIU(8925,118,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,118,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,118,"TEXT",3,0)=""
^TIU(8925,118,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,118,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,118,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,118,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,118,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,118,"TEXT",9,0)=""
^TIU(8925,118,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,118,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,118,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,118,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,118,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,118,"TEXT",15,0)=""
^TIU(8925,118,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,118,"TEXT",17,0)=""
^TIU(8925,118,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,118,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,118,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,118,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,118,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,118,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,119,0)="PROGRESS NOTE^34;DPT(^3^^^^3250113"
^TIU(8925,119,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,119,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,119,"TEXT",3,0)=""
^TIU(8925,119,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,119,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,119,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,119,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,119,"TEXT",8,0)=""
^TIU(8925,119,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,119,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,119,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,119,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,119,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,119,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,119,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,119,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,119,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,119,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,119,"TEXT",19,0)=""
^TIU(8925,119,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,119,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,119,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,119,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,119,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,120,0)="DISCHARGE SUMMARY^35;DPT(^5^^^^3241208"
^TIU(8925,120,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,120,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,120,"TEXT",3,0)=""
^TIU(8925,120,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,120,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,120,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,120,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,120,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,120,"TEXT",9,0)=""
^TIU(8925,120,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,120,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,120,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,120,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,120,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,120,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,120,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,120,"TEXT",17,0)=""
^TIU(8925,120,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,120,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,120,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,120,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,120,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,120,"TEXT",23,0)="5. Follow up in 3 months."
