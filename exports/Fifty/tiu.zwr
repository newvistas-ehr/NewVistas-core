^TIU(8925,53,0)="PROGRESS NOTE^15;DPT(^3^^^^3251016"
^TIU(8925,53,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,53,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,53,"TEXT",3,0)=""
^TIU(8925,53,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,53,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,53,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,53,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,53,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,53,"TEXT",9,0)=""
^TIU(8925,53,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,53,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,53,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,53,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,53,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,53,"TEXT",15,0)=""
^TIU(8925,53,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,53,"TEXT",17,0)=""
^TIU(8925,53,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,53,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,53,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,53,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,53,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,53,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,54,0)="CONSULT NOTE^16;DPT(^5^^^^3251214"
^TIU(8925,54,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,54,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,54,"TEXT",3,0)=""
^TIU(8925,54,"TEXT",4,0)="SUBJECTIVE: 6 weeks status post arthroscopic left rotator cuff repair."
^TIU(8925,54,"TEXT",5,0)="Wearing sling as instructed. Pain 3/10, well-controlled."
^TIU(8925,54,"TEXT",6,0)="Home passive ROM exercises have been going well."
^TIU(8925,54,"TEXT",7,0)="Spouse assists with pendulum exercises and passive elevation."
^TIU(8925,54,"TEXT",8,0)=""
^TIU(8925,54,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,54,"TEXT",10,0)="Left shoulder: Well-healed portal sites. No infection."
^TIU(8925,54,"TEXT",11,0)="Passive ROM: Forward elevation 130 degrees. ER at side 30 degrees."
^TIU(8925,54,"TEXT",12,0)="No active ROM testing at this time per protocol."
^TIU(8925,54,"TEXT",13,0)="Deltoid and periscapular muscles firing with isometrics."
^TIU(8925,54,"TEXT",14,0)=""
^TIU(8925,54,"TEXT",15,0)="ASSESSMENT AND PLAN:"
^TIU(8925,54,"TEXT",16,0)="1. L rotator cuff repair: Healing well per protocol."
^TIU(8925,54,"TEXT",17,0)="2. Discontinue sling. Begin active-assisted ROM."
^TIU(8925,54,"TEXT",18,0)="3. Physical therapy to begin — rotator cuff repair protocol."
^TIU(8925,54,"TEXT",19,0)="4. No lifting >1 lb with left arm until 12 weeks post-op."
^TIU(8925,54,"TEXT",20,0)="5. Follow up in 6 weeks."
^TIU(8925,55,0)="PROGRESS NOTE^16;DPT(^5^^^^3240905"
^TIU(8925,55,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,55,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION — ROTATOR CUFF REPAIR PROTOCOL"
^TIU(8925,55,"TEXT",3,0)=""
^TIU(8925,55,"TEXT",4,0)="DIAGNOSIS: S/P arthroscopic left rotator cuff repair, 6 weeks post-op."
^TIU(8925,55,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 20 visits."
^TIU(8925,55,"TEXT",6,0)="PROTOCOL: Phase 2 — Active-assisted to active ROM."
^TIU(8925,55,"TEXT",7,0)=""
^TIU(8925,55,"TEXT",8,0)="SUBJECTIVE: Patient reports improving pain. Sling discontinued today."
^TIU(8925,55,"TEXT",9,0)="Dominant hand: Right. Left shoulder is non-dominant."
^TIU(8925,55,"TEXT",10,0)="Goal: Return to overhead activities and yard work."
^TIU(8925,55,"TEXT",11,0)=""
^TIU(8925,55,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,55,"TEXT",13,0)="L shoulder PROM: Flexion 135 deg, Abduction 90 deg, ER at 0 deg abd 35 deg."
^TIU(8925,55,"TEXT",14,0)="IR at 90 abd: 30 degrees. Horizontal adduction: 90 degrees."
^TIU(8925,55,"TEXT",15,0)="Active ROM: Flexion 80 degrees (with hiking). Abduction 60 degrees."
^TIU(8925,55,"TEXT",16,0)="Scapular control: Poor. Scapular winging with attempted elevation."
^TIU(8925,55,"TEXT",17,0)="Grip strength: Left 15 kg (Right 35 kg)."
^TIU(8925,55,"TEXT",18,0)=""
^TIU(8925,55,"TEXT",19,0)="ASSESSMENT: Significant ROM and strength deficits expected at this stage."
^TIU(8925,55,"TEXT",20,0)="Patient progressing appropriately per surgical protocol timeline."
^TIU(8925,55,"TEXT",21,0)=""
^TIU(8925,55,"TEXT",22,0)="PLAN — PHASE 2 (Weeks 6-12):"
^TIU(8925,55,"TEXT",23,0)="1. Active-assisted ROM: pulleys, wand exercises, wall slides."
^TIU(8925,55,"TEXT",24,0)="2. Scapular stabilization exercises: rows, serratus punches."
^TIU(8925,55,"TEXT",25,0)="3. Gentle isometrics: ER/IR at side."
^TIU(8925,55,"TEXT",26,0)="4. Scar mobilization and soft tissue mobilization."
^TIU(8925,55,"TEXT",27,0)="5. NO resisted ER/IR or overhead strengthening until 12 weeks."
^TIU(8925,55,"TEXT",28,0)="6. Frequency: 2x/week for 6 weeks, then reassess for Phase 3."
^TIU(8925,56,0)="PROGRESS NOTE^16;DPT(^5^^^^3251215"
^TIU(8925,56,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,56,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,56,"TEXT",3,0)=""
^TIU(8925,56,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,56,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,56,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,56,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,56,"TEXT",8,0)=""
^TIU(8925,56,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,56,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,56,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,56,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,56,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,56,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,56,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,56,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,56,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,56,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,56,"TEXT",19,0)=""
^TIU(8925,56,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,56,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,56,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,56,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,56,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,57,0)="PROGRESS NOTE^16;DPT(^5^^^^3240816"
^TIU(8925,57,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,57,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,57,"TEXT",3,0)=""
^TIU(8925,57,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,57,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,57,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,57,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,57,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,57,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,57,"TEXT",10,0)=""
^TIU(8925,57,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,57,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,57,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,57,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,57,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,57,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,57,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,57,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,57,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
