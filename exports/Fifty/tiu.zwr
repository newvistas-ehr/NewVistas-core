^TIU(8925,129,"TEXT",2,0)="SUBJECTIVE: Patient presents for routine follow-up of chronic conditions."
^TIU(8925,129,"TEXT",3,0)="Reports compliance with medications. Denies new complaints."
^TIU(8925,129,"TEXT",4,0)="Sleep adequate. Appetite normal. Activity level stable."
