^TIU(8925,106,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,106,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,106,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,106,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,106,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,106,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,106,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,106,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,106,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,106,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,106,"TEXT",19,0)=""
