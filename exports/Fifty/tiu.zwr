^TIU(8925,139,"TEXT",8,0)="HEENT: PERRL, EOMI, oropharynx clear."
^TIU(8925,139,"TEXT",9,0)="Cardiovascular: RRR, no murmurs, rubs, or gallops."
^TIU(8925,139,"TEXT",10,0)="Lungs: Clear to auscultation bilaterally."
^TIU(8925,139,"TEXT",11,0)="Abdomen: Soft, non-tender, non-distended."
