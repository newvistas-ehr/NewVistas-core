^TIU(8925,64,0)="PROGRESS NOTE^18;DPT(^1^^^^3240716"
^TIU(8925,64,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,64,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,64,"TEXT",3,0)=""
^TIU(8925,64,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,64,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,64,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,64,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,64,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,64,"TEXT",9,0)=""
^TIU(8925,64,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,64,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,64,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,64,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,64,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,64,"TEXT",15,0)=""
^TIU(8925,64,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,64,"TEXT",17,0)=""
^TIU(8925,64,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,64,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,64,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,64,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,64,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,64,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
