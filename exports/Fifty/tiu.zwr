^TIU(8925,148,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,148,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,149,0)="PROGRESS NOTE^43;DPT(^4^^^^3240515"
^TIU(8925,149,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,149,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,149,"TEXT",3,0)=""
^TIU(8925,149,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,149,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,149,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,149,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,149,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,149,"TEXT",9,0)=""
^TIU(8925,149,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,149,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,149,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,149,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,149,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,149,"TEXT",15,0)=""
^TIU(8925,149,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,149,"TEXT",17,0)=""
^TIU(8925,149,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,149,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,149,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,149,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,149,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,149,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
^TIU(8925,150,0)="PROGRESS NOTE^43;DPT(^4^^^^3240107"
^TIU(8925,150,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,150,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,150,"TEXT",3,0)=""
^TIU(8925,150,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,150,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,150,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,150,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,150,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,150,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,150,"TEXT",10,0)=""
^TIU(8925,150,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,150,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,150,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,150,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,150,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,150,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,150,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,150,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,150,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
^TIU(8925,150,"TEXT",20,0)=""
^TIU(8925,150,"TEXT",21,0)="ASSESSMENT AND PLAN:"
^TIU(8925,150,"TEXT",22,0)="Symptoms improving on current medication regimen."
^TIU(8925,150,"TEXT",23,0)="Continue current psychotropic medications."
^TIU(8925,150,"TEXT",24,0)="Continue weekly psychotherapy."
^TIU(8925,150,"TEXT",25,0)="Safety plan reviewed and updated. Patient verbalizes plan."
^TIU(8925,150,"TEXT",26,0)="Follow up in 4 weeks."
^TIU(8925,151,0)="PROGRESS NOTE^44;DPT(^3^^^^3251206"
^TIU(8925,151,"TEXT",1,0)="CARDIOLOGY FOLLOW-UP"
^TIU(8925,151,"TEXT",2,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,151,"TEXT",3,0)=""
^TIU(8925,151,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,151,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,151,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,151,"TEXT",7,0)="Medication compliance good. No side effects reported."
^TIU(8925,151,"TEXT",8,0)=""
^TIU(8925,151,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,151,"TEXT",10,0)="General: No acute distress."
^TIU(8925,151,"TEXT",11,0)="JVP: Not elevated."
^TIU(8925,151,"TEXT",12,0)="Cardiovascular: Irregularly irregular rhythm. S1/S2 normal. No S3 or S4. Grade 2/6 systolic murmur at apex."
^TIU(8925,151,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,151,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,151,"TEXT",15,0)=""
^TIU(8925,151,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,151,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,151,"TEXT",18,0)=""
^TIU(8925,151,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,151,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,151,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,151,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,151,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,151,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
^TIU(8925,152,0)="PROGRESS NOTE^44;DPT(^3^^^^3240401"
^TIU(8925,152,"TEXT",1,0)="ENDOCRINOLOGY FOLLOW-UP"
^TIU(8925,152,"TEXT",2,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,152,"TEXT",3,0)=""
^TIU(8925,152,"TEXT",4,0)="SUBJECTIVE: Patient presents for diabetes management follow-up."
^TIU(8925,152,"TEXT",5,0)="Home glucose readings reviewed: fasting 110-160, post-prandial 140-220."
^TIU(8925,152,"TEXT",6,0)="Denies hypoglycemic episodes. No polyuria or polydipsia."
^TIU(8925,152,"TEXT",7,0)="Following diabetic diet. Walking 20 minutes 3x/week."
^TIU(8925,152,"TEXT",8,0)="Last eye exam 6 months ago — no retinopathy. Foot exam today."
^TIU(8925,152,"TEXT",9,0)=""
^TIU(8925,152,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,152,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,152,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,152,"TEXT",13,0)=""
^TIU(8925,152,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,152,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,152,"TEXT",16,0)=""
^TIU(8925,152,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,152,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,152,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,152,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,152,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,152,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,153,0)="PROGRESS NOTE^44;DPT(^3^^^^3240127"
^TIU(8925,153,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,153,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,153,"TEXT",3,0)=""
^TIU(8925,153,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,153,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,153,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,153,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,153,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,153,"TEXT",9,0)=""
^TIU(8925,153,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,153,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,153,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,153,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,153,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,153,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,153,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,153,"TEXT",17,0)=""
^TIU(8925,153,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,153,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,153,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,153,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,153,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,153,"TEXT",23,0)="5. Follow up in 3 months."
