^TIU(8925,51,0)="PROGRESS NOTE^15;DPT(^3^^^^3250212"
^TIU(8925,51,"TEXT",1,0)="MENTAL HEALTH COMPREHENSIVE NOTE"
^TIU(8925,51,"TEXT",2,0)="MENTAL HEALTH COMPREHENSIVE EVALUATION"
^TIU(8925,51,"TEXT",3,0)=""
^TIU(8925,51,"TEXT",4,0)="SUBJECTIVE: Patient presents for mental health follow-up."
^TIU(8925,51,"TEXT",5,0)="Reports persistent nightmares about combat experiences 4-5 nights/week."
^TIU(8925,51,"TEXT",6,0)="Hypervigilance: Cannot sit with back to door. Startles easily."
^TIU(8925,51,"TEXT",7,0)="Mood: Depressed. Rating 3/10 (10=best). Anhedonia prominent."
^TIU(8925,51,"TEXT",8,0)="Sleep: 3-4 hours/night despite trazodone. Frequent awakenings."
^TIU(8925,51,"TEXT",9,0)="Appetite: Poor. Lost 8 lbs in last 2 months."
^TIU(8925,51,"TEXT",10,0)="Substance use: Reports drinking 4-6 beers daily to 'numb out.'"
^TIU(8925,51,"TEXT",11,0)="Admits this has increased from 2-3 beers at last visit."
^TIU(8925,51,"TEXT",12,0)="Denies suicidal ideation but reports passive death wish ('wouldn't mind not waking up')."
^TIU(8925,51,"TEXT",13,0)="No plan or intent. Firearms in home — stored at friend's house per safety plan."
^TIU(8925,51,"TEXT",14,0)=""
^TIU(8925,51,"TEXT",15,0)="OBJECTIVE:"
^TIU(8925,51,"TEXT",16,0)="Appearance: Unkempt. Lost weight since last visit."
^TIU(8925,51,"TEXT",17,0)="Psychomotor: Slightly retarded. Long response latency."
^TIU(8925,51,"TEXT",18,0)="Speech: Low volume. Slow rate."
^TIU(8925,51,"TEXT",19,0)="Mood: 'Terrible.' Affect: Constricted, tearful at times."
^TIU(8925,51,"TEXT",20,0)="Thought process: Linear but slowed."
^TIU(8925,51,"TEXT",21,0)="Thought content: Passive death wish. No active SI. No HI."
^TIU(8925,51,"TEXT",22,0)="Cognition: Oriented x4. Concentration impaired."
^TIU(8925,51,"TEXT",23,0)=""
^TIU(8925,51,"TEXT",24,0)="PHQ-9: 22 (severe depression). GAD-7: 18 (severe anxiety)."
^TIU(8925,51,"TEXT",25,0)="PCL-5: 62 (severe PTSD). AUDIT-C: 8 (harmful use)."
^TIU(8925,51,"TEXT",26,0)="Columbia Suicide Severity: Category 2 (non-specific active SI)."
^TIU(8925,51,"TEXT",27,0)=""
^TIU(8925,51,"TEXT",28,0)="ASSESSMENT AND PLAN:"
^TIU(8925,51,"TEXT",29,0)="1. PTSD: Severe. Increase prazosin to 5mg QHS for nightmares."
^TIU(8925,51,"TEXT",30,0)="2. MDD: Severe. Cross-taper sertraline to venlafaxine XR 75mg."
^TIU(8925,51,"TEXT",31,0)="3. Alcohol use disorder: Worsening. Refer to SATP (substance abuse treatment)."
^TIU(8925,51,"TEXT",32,0)="4. Safety: Firearms removed. Safety plan updated. Crisis line reviewed."
^TIU(8925,51,"TEXT",33,0)="5. Increase therapy to 2x/week. CPT (Cognitive Processing Therapy) sessions."
^TIU(8925,51,"TEXT",34,0)="6. Nutritional support: Ensure supplements. Social work consult for benefits."
^TIU(8925,51,"TEXT",35,0)="7. Close follow-up in 1 week given severity and passive SI."
^TIU(8925,51,"TEXT",36,0)="8. If worsening, consider inpatient psychiatric admission."
