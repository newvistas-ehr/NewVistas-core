^TIU(8925,129,"TEXT",7,0)="General: Well-appearing, no acute distress."
^TIU(8925,129,"TEXT",8,0)="HEENT: PERRL, EOMI, oropharynx clear."
^TIU(8925,129,"TEXT",9,0)="Cardiovascular: RRR, no murmurs, rubs, or gallops."
^TIU(8925,129,"TEXT",10,0)="Lungs: Clear to auscultation bilaterally."
^TIU(8925,129,"TEXT",11,0)="Abdomen: Soft, non-tender, non-distended."
^TIU(8925,129,"TEXT",12,0)="Extremities: No edema. Pedal pulses palpable bilaterally."
^TIU(8925,129,"TEXT",13,0)=""
^TIU(8925,129,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,129,"TEXT",15,0)="Chronic conditions stable on current regimen."
