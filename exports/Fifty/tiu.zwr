^TIU(8925,145,"TEXT",3,0)=""
^TIU(8925,145,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,145,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,145,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,145,"TEXT",7,0)="Medication compliance good. No side effects reported."
