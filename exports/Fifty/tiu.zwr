^TIU(8925,94,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,94,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,94,"TEXT",3,0)=""
^TIU(8925,94,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,94,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,94,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,94,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,94,"TEXT",8,0)=""
^TIU(8925,94,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,94,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,94,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,94,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,94,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,94,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,94,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,94,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,94,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,94,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,94,"TEXT",19,0)=""
^TIU(8925,94,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,94,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,94,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,94,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,94,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
