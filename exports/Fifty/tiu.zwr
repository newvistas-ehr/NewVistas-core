^TIU(8925,34,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,35,0)="PROGRESS NOTE^10;DPT(^2^^^^3251224"
^TIU(8925,35,"TEXT",1,0)="SURGERY POST-OP NOTE"
^TIU(8925,35,"TEXT",2,0)="SURGICAL FOLLOW-UP — BELOW-KNEE AMPUTATION"
^TIU(8925,35,"TEXT",3,0)=""
^TIU(8925,35,"TEXT",4,0)="SUBJECTIVE: Patient presents 3 weeks status post left transtibial amputation."
^TIU(8925,35,"TEXT",5,0)="Residual limb pain 5/10, improving. Reports phantom limb sensations."
^TIU(8925,35,"TEXT",6,0)="Phantom pain 4/10 in left foot (burning, tingling). Worse at night."
^TIU(8925,35,"TEXT",7,0)="Adjusting to wheelchair mobility. Emotional status: some grief reaction."
^TIU(8925,35,"TEXT",8,0)="Attending psychology sessions as recommended."
^TIU(8925,35,"TEXT",9,0)=""
^TIU(8925,35,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,35,"TEXT",11,0)="Residual limb: Incision healing well. Sutures intact. No infection."
^TIU(8925,35,"TEXT",12,0)="Moderate edema. Shaping with elastic bandage wrapping."
^TIU(8925,35,"TEXT",13,0)="No skin breakdown. Stump length adequate for prosthetic fitting."
^TIU(8925,35,"TEXT",14,0)="Upper extremity strength 5/5 bilateral. Core strength 4/5."
^TIU(8925,35,"TEXT",15,0)="Independent with wheelchair transfers."
^TIU(8925,35,"TEXT",16,0)=""
^TIU(8925,35,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,35,"TEXT",18,0)="1. Left BKA: Healing progressing. Continue wound care and edema management."
^TIU(8925,35,"TEXT",19,0)="2. Phantom limb pain: Start gabapentin 300mg TID. Mirror therapy initiated."
^TIU(8925,35,"TEXT",20,0)="3. Prosthetics consultation placed for prosthetic limb fitting timeline."
^TIU(8925,35,"TEXT",21,0)="4. Continue PT for pre-prosthetic training, transfers, and upper body conditioning."
^TIU(8925,35,"TEXT",22,0)="5. Psychology for adjustment disorder management."
^TIU(8925,35,"TEXT",23,0)="6. Follow up in 2 weeks for suture removal and prosthetic planning."
