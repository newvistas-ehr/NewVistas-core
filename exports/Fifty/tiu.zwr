^TIU(8925,124,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,124,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,124,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,124,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,124,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,124,"TEXT",15,0)=""
^TIU(8925,124,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,124,"TEXT",17,0)=""
^TIU(8925,124,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,124,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,124,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,124,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,124,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,124,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
