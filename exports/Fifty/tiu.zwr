^TIU(8925,171,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,171,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,171,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,171,"TEXT",13,0)=""
^TIU(8925,171,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,171,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,171,"TEXT",16,0)=""
^TIU(8925,171,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,171,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,171,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,171,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,171,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,171,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,172,0)="PROGRESS NOTE^49;DPT(^2^^^^3240603"
^TIU(8925,172,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,172,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,172,"TEXT",3,0)=""
^TIU(8925,172,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,172,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,172,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,172,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,172,"TEXT",8,0)=""
^TIU(8925,172,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,172,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,172,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,172,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,172,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,172,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,172,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,172,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,172,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,172,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,172,"TEXT",19,0)=""
^TIU(8925,172,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,172,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,172,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,172,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,172,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,173,0)="PROGRESS NOTE^49;DPT(^2^^^^3250404"
^TIU(8925,173,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,173,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,173,"TEXT",3,0)=""
^TIU(8925,173,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,173,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,173,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,173,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,173,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,173,"TEXT",9,0)=""
^TIU(8925,173,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,173,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,173,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,173,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,173,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,173,"TEXT",15,0)=""
^TIU(8925,173,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,173,"TEXT",17,0)=""
^TIU(8925,173,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,173,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,173,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,173,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,173,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,173,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
