^TIU(8925,37,0)="PROGRESS NOTE^10;DPT(^2^^^^3250821"
^TIU(8925,37,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,37,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,37,"TEXT",3,0)=""
^TIU(8925,37,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,37,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,37,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,37,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,37,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,37,"TEXT",9,0)=""
^TIU(8925,37,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,37,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,37,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,37,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,37,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,37,"TEXT",15,0)=""
^TIU(8925,37,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,37,"TEXT",17,0)=""
^TIU(8925,37,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,37,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,37,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,37,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,37,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,37,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,38,0)="PROGRESS NOTE^11;DPT(^5^^^^3250410"
^TIU(8925,38,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,38,"TEXT",2,0)="ORTHOPEDIC PRE-OPERATIVE EVALUATION — TOTAL KNEE ARTHROPLASTY"
^TIU(8925,38,"TEXT",3,0)=""
^TIU(8925,38,"TEXT",4,0)="SUBJECTIVE: Patient presents for pre-op evaluation for left TKA."
^TIU(8925,38,"TEXT",5,0)="Bilateral knee pain for 8 years, progressively worsening."
^TIU(8925,38,"TEXT",6,0)="Left knee more symptomatic: pain 7/10 with walking, 4/10 at rest."
^TIU(8925,38,"TEXT",7,0)="Failed conservative management: PT, NSAIDs, cortisone injections (x3),"
^TIU(8925,38,"TEXT",8,0)="hyaluronic acid injections, bracing, and activity modification."
^TIU(8925,38,"TEXT",9,0)="Walking limited to 1 block. Difficulty with stairs. Using cane."
^TIU(8925,38,"TEXT",10,0)="Right knee planned for future surgery."
^TIU(8925,38,"TEXT",11,0)=""
^TIU(8925,38,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,38,"TEXT",13,0)="Left knee: Varus deformity 8 degrees. Crepitus with ROM."
^TIU(8925,38,"TEXT",14,0)="ROM: 5-105 degrees (10-degree flexion contracture)."
^TIU(8925,38,"TEXT",15,0)="Medial joint line tenderness. Small effusion."
^TIU(8925,38,"TEXT",16,0)="Ligaments: Stable to varus/valgus stress. ACL/PCL intact."
^TIU(8925,38,"TEXT",17,0)="Right knee: Similar findings, less symptomatic."
^TIU(8925,38,"TEXT",18,0)=""
^TIU(8925,38,"TEXT",19,0)="X-rays: Severe medial compartment OA bilaterally, bone-on-bone."
^TIU(8925,38,"TEXT",20,0)="Large osteophytes. Subchondral sclerosis and cysts."
^TIU(8925,38,"TEXT",21,0)=""
^TIU(8925,38,"TEXT",22,0)="ASSESSMENT AND PLAN:"
^TIU(8925,38,"TEXT",23,0)="1. Severe bilateral knee OA: Surgical candidate for left TKA."
^TIU(8925,38,"TEXT",24,0)="2. Pre-operative clearance obtained — cardiac and anesthesia."
^TIU(8925,38,"TEXT",25,0)="3. Surgery scheduled. Pre-op PT (prehab) for quad strengthening."
^TIU(8925,38,"TEXT",26,0)="4. Discussed risks, benefits, alternatives. Consent obtained."
^TIU(8925,38,"TEXT",27,0)="5. Post-op plan: Inpatient rehab vs home PT based on progress."
^TIU(8925,38,"TEXT",28,0)="6. Right TKA planned 4-6 months after left recovery."
