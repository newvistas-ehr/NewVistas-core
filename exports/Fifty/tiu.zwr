^TIU(8925,141,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,141,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,141,"TEXT",3,0)=""
^TIU(8925,141,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,141,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,141,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,141,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,141,"TEXT",8,0)=""
^TIU(8925,141,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,141,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,141,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,141,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,141,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,141,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,141,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,141,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,141,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,141,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,141,"TEXT",19,0)=""
^TIU(8925,141,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,141,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,141,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,141,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,141,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,142,0)="PROGRESS NOTE^41;DPT(^3^^^^3250422"
^TIU(8925,142,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,142,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,142,"TEXT",3,0)=""
^TIU(8925,142,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,142,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,142,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,142,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,142,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,142,"TEXT",9,0)=""
^TIU(8925,142,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,142,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,142,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,142,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,142,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,142,"TEXT",15,0)=""
^TIU(8925,142,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,142,"TEXT",17,0)=""
^TIU(8925,142,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,142,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,142,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,142,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,142,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,142,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,143,0)="DISCHARGE SUMMARY^41;DPT(^3^^^^3251019"
^TIU(8925,143,"TEXT",1,0)="ENDOCRINOLOGY FOLLOW-UP"
^TIU(8925,143,"TEXT",2,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,143,"TEXT",3,0)=""
^TIU(8925,143,"TEXT",4,0)="SUBJECTIVE: Patient presents for diabetes management follow-up."
^TIU(8925,143,"TEXT",5,0)="Home glucose readings reviewed: fasting 110-160, post-prandial 140-220."
^TIU(8925,143,"TEXT",6,0)="Denies hypoglycemic episodes. No polyuria or polydipsia."
^TIU(8925,143,"TEXT",7,0)="Following diabetic diet. Walking 20 minutes 3x/week."
^TIU(8925,143,"TEXT",8,0)="Last eye exam 6 months ago — no retinopathy. Foot exam today."
^TIU(8925,143,"TEXT",9,0)=""
^TIU(8925,143,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,143,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,143,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,143,"TEXT",13,0)=""
^TIU(8925,143,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,143,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,143,"TEXT",16,0)=""
^TIU(8925,143,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,143,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,143,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,143,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,143,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,143,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
