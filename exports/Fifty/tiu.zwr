^TIU(8925,160,0)="TELEPHONE NOTE^46;DPT(^2^^^^3240121"
^TIU(8925,160,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,160,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,160,"TEXT",3,0)=""
^TIU(8925,160,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,160,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,160,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,160,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,160,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,160,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,160,"TEXT",10,0)=""
^TIU(8925,160,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,160,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,160,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,160,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,160,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,160,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,160,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,160,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,160,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
^TIU(8925,160,"TEXT",20,0)=""
^TIU(8925,160,"TEXT",21,0)="ASSESSMENT AND PLAN:"
