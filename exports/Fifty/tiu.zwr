^TIU(8925,1,0)="PROGRESS NOTE^1;DPT(^5^^^^3251011"
^TIU(8925,1,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,1,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,1,"TEXT",3,0)=""
^TIU(8925,1,"TEXT",4,0)="SUBJECTIVE: Patient presents 6 weeks status post ORIF left tibial shaft fracture."
^TIU(8925,1,"TEXT",5,0)="Pain well controlled with oral medications. Using walker for ambulation."
^TIU(8925,1,"TEXT",6,0)="Has been non-weight-bearing per instructions. No fever or wound drainage."
^TIU(8925,1,"TEXT",7,0)="Numbness/tingling in left foot has improved since surgery."
^TIU(8925,1,"TEXT",8,0)=""
^TIU(8925,1,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,1,"TEXT",10,0)="Left lower extremity: Incision well-healed. No erythema or drainage."
^TIU(8925,1,"TEXT",11,0)="Mild residual swelling. Compartments soft."
^TIU(8925,1,"TEXT",12,0)="Ankle: ROM 10 degrees dorsiflexion, 30 degrees plantarflexion."
^TIU(8925,1,"TEXT",13,0)="Knee: ROM 0-120 degrees. Quad strength 4-/5."
^TIU(8925,1,"TEXT",14,0)="Sensation intact to light touch L4-S1 dermatomes."
^TIU(8925,1,"TEXT",15,0)="Pedal pulses 2+ bilaterally."
^TIU(8925,1,"TEXT",16,0)=""
^TIU(8925,1,"TEXT",17,0)="X-rays: Progressive callus formation across fracture site."
^TIU(8925,1,"TEXT",18,0)="Hardware intact. Alignment maintained."
^TIU(8925,1,"TEXT",19,0)=""
^TIU(8925,1,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,1,"TEXT",21,0)="1. Left tibial shaft fracture: Healing well. Callus formation noted."
^TIU(8925,1,"TEXT",22,0)="2. Advance to toe-touch weight-bearing in CAM boot."
^TIU(8925,1,"TEXT",23,0)="3. Begin physical therapy for ROM, strengthening, and gait training."
^TIU(8925,1,"TEXT",24,0)="4. PT referral placed for 2-3x/week x 8 weeks."
^TIU(8925,1,"TEXT",25,0)="5. Wean pain medications. Discontinue opioids by next visit."
^TIU(8925,1,"TEXT",26,0)="6. Follow up in 4 weeks with repeat x-rays."
^TIU(8925,2,0)="PROGRESS NOTE^1;DPT(^5^^^^3251114"
^TIU(8925,2,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,2,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION"
^TIU(8925,2,"TEXT",3,0)=""
^TIU(8925,2,"TEXT",4,0)="DIAGNOSIS: S/P ORIF left tibial shaft fracture, 6 weeks post-op."
^TIU(8925,2,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 16 visits."
^TIU(8925,2,"TEXT",6,0)=""
^TIU(8925,2,"TEXT",7,0)="SUBJECTIVE: Patient reports left leg pain at 4/10 with ambulation."
^TIU(8925,2,"TEXT",8,0)="Currently using front-wheeled walker. Non-weight-bearing until today."
^TIU(8925,2,"TEXT",9,0)="Goals: Return to independent ambulation without assistive device."
^TIU(8925,2,"TEXT",10,0)="Prior level of function: Independent community ambulator."
^TIU(8925,2,"TEXT",11,0)=""
^TIU(8925,2,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,2,"TEXT",13,0)="Left ankle ROM: DF 5 deg (N=20), PF 25 deg (N=50), Inv 15 deg (N=35), Ev 8 deg (N=15)."
^TIU(8925,2,"TEXT",14,0)="Left knee ROM: Flex 110 deg (N=140), Ext 0 deg (N=0)."
^TIU(8925,2,"TEXT",15,0)="Left hip ROM: WNL all planes."
^TIU(8925,2,"TEXT",16,0)="MMT: L quads 3+/5, L hamstrings 4-/5, L gastroc 3/5, L anterior tibialis 3+/5."
^TIU(8925,2,"TEXT",17,0)="Gait: TTWB with FWW. Trendelenburg noted on left. Step-to pattern."
^TIU(8925,2,"TEXT",18,0)="Balance: Modified Romberg positive. Single-leg stance unable on left."
^TIU(8925,2,"TEXT",19,0)="Circumferential measurements: L calf 2.5cm less than R calf."
^TIU(8925,2,"TEXT",20,0)=""
^TIU(8925,2,"TEXT",21,0)="ASSESSMENT:"
^TIU(8925,2,"TEXT",22,0)="Patient presents with significant deficits in ROM, strength, and"
^TIU(8925,2,"TEXT",23,0)="function of the left lower extremity following tibial fracture and ORIF."
^TIU(8925,2,"TEXT",24,0)="Rehabilitation potential is good given age, motivation, and prior function level."
^TIU(8925,2,"TEXT",25,0)=""
^TIU(8925,2,"TEXT",26,0)="PLAN:"
^TIU(8925,2,"TEXT",27,0)="1. Progressive weight-bearing advancement per orthopedic protocol."
^TIU(8925,2,"TEXT",28,0)="2. Ankle and knee ROM exercises — AROM/AAROM progressing to stretching."
^TIU(8925,2,"TEXT",29,0)="3. LE strengthening: quad sets, SLR, hip abduction, calf raises (when WB allows)."
^TIU(8925,2,"TEXT",30,0)="4. Gait training: progress FWW to cane to independent."
^TIU(8925,2,"TEXT",31,0)="5. Balance and proprioception training."
^TIU(8925,2,"TEXT",32,0)="6. Scar mobilization."
^TIU(8925,2,"TEXT",33,0)="7. Frequency: 2-3x/week for 8 weeks."
^TIU(8925,2,"TEXT",34,0)="8. Goals: Full ankle ROM, 4+/5 LE strength, independent ambulation by 12 weeks post-op."
^TIU(8925,3,0)="PROGRESS NOTE^1;DPT(^5^^^^3250216"
^TIU(8925,3,"TEXT",1,0)="PT PROGRESS NOTE"
^TIU(8925,3,"TEXT",2,0)="PHYSICAL THERAPY PROGRESS NOTE"
^TIU(8925,3,"TEXT",3,0)=""
^TIU(8925,3,"TEXT",4,0)="DIAGNOSIS: S/P ORIF left tibial shaft fracture."
^TIU(8925,3,"TEXT",5,0)="VISIT: 8 of 16 authorized. 10 weeks post-op."
^TIU(8925,3,"TEXT",6,0)=""
^TIU(8925,3,"TEXT",7,0)="SUBJECTIVE: Patient reports improving confidence with walking."
^TIU(8925,3,"TEXT",8,0)="Pain decreased to 2/10 with ambulation. Sleeping better."
^TIU(8925,3,"TEXT",9,0)="Practicing home exercises daily as prescribed."
^TIU(8925,3,"TEXT",10,0)=""
^TIU(8925,3,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,3,"TEXT",12,0)="Left ankle ROM: DF 12 deg (was 5), PF 38 deg (was 25)."
^TIU(8925,3,"TEXT",13,0)="Left knee ROM: Flex 130 deg (was 110). Full extension."
^TIU(8925,3,"TEXT",14,0)="MMT: L quads 4/5 (was 3+), L gastroc 3+/5 (was 3)."
^TIU(8925,3,"TEXT",15,0)="Gait: PWB 50% with single-point cane. Improved step-through pattern."
^TIU(8925,3,"TEXT",16,0)="Balance: Single-leg stance L 8 seconds (was unable)."
^TIU(8925,3,"TEXT",17,0)="Timed Up and Go: 18 seconds (was 32 seconds)."
^TIU(8925,3,"TEXT",18,0)=""
^TIU(8925,3,"TEXT",19,0)="TREATMENT PROVIDED:"
^TIU(8925,3,"TEXT",20,0)="Manual therapy: ankle joint mobilization grades III-IV."
^TIU(8925,3,"TEXT",21,0)="Therapeutic exercise: mini-squats, step-ups, calf raises bilateral."
^TIU(8925,3,"TEXT",22,0)="Gait training with cane on varied surfaces."
^TIU(8925,3,"TEXT",23,0)="Balance training: tandem stance, single-leg activities."
^TIU(8925,3,"TEXT",24,0)=""
^TIU(8925,3,"TEXT",25,0)="ASSESSMENT: Good progress. ROM and strength improving steadily."
^TIU(8925,3,"TEXT",26,0)="Patient motivated and compliant with HEP."
^TIU(8925,3,"TEXT",27,0)=""
^TIU(8925,3,"TEXT",28,0)="PLAN: Continue 2x/week. Progress to full weight-bearing."
^TIU(8925,3,"TEXT",29,0)="Begin proprioceptive training and sport-specific drills if appropriate."
^TIU(8925,3,"TEXT",30,0)="Estimated 6-8 more visits to achieve discharge goals."
^TIU(8925,4,0)="PROGRESS NOTE^2;DPT(^4^^^^3250823"
^TIU(8925,4,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,4,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,4,"TEXT",3,0)=""
^TIU(8925,4,"TEXT",4,0)="SUBJECTIVE: Patient presents 2 weeks status post left hip hemiarthroplasty"
^TIU(8925,4,"TEXT",5,0)="for displaced femoral neck fracture."
^TIU(8925,4,"TEXT",6,0)="Pain controlled with Tylenol and low-dose opioid."
^TIU(8925,4,"TEXT",7,0)="Ambulating with rolling walker. Following posterior hip precautions."
^TIU(8925,4,"TEXT",8,0)="Home health PT has been visiting 3x/week."
^TIU(8925,4,"TEXT",9,0)=""
^TIU(8925,4,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,4,"TEXT",11,0)="Left hip: Incision clean, dry, intact. Staples in place (to remove today)."
^TIU(8925,4,"TEXT",12,0)="No erythema or drainage. No calf tenderness."
^TIU(8925,4,"TEXT",13,0)="ROM (passive): Flexion 80 degrees, abduction 25 degrees."
^TIU(8925,4,"TEXT",14,0)="Able to perform SLR against gravity."
^TIU(8925,4,"TEXT",15,0)=""
^TIU(8925,4,"TEXT",16,0)="X-ray: Prosthesis in good position. No periprosthetic fracture."
^TIU(8925,4,"TEXT",17,0)=""
^TIU(8925,4,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,4,"TEXT",19,0)="1. S/P left hip hemiarthroplasty: Progressing well."
^TIU(8925,4,"TEXT",20,0)="2. Remove staples today. Steri-strips applied."
^TIU(8925,4,"TEXT",21,0)="3. Continue weight-bearing as tolerated with walker."
^TIU(8925,4,"TEXT",22,0)="4. Continue posterior hip precautions x6 weeks."
^TIU(8925,4,"TEXT",23,0)="5. Transition to outpatient PT for continued strengthening and gait training."
^TIU(8925,4,"TEXT",24,0)="6. Wean opioid. Increase Tylenol for pain management."
^TIU(8925,4,"TEXT",25,0)="7. Follow up in 4 weeks."
^TIU(8925,5,0)="PROGRESS NOTE^2;DPT(^4^^^^3240524"
^TIU(8925,5,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,5,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION"
^TIU(8925,5,"TEXT",3,0)=""
^TIU(8925,5,"TEXT",4,0)="DIAGNOSIS: S/P left hip hemiarthroplasty for femoral neck fracture."
^TIU(8925,5,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 12 visits."
^TIU(8925,5,"TEXT",6,0)="PRECAUTIONS: Posterior hip precautions x6 weeks."
^TIU(8925,5,"TEXT",7,0)=""
^TIU(8925,5,"TEXT",8,0)="SUBJECTIVE: Patient is an elderly veteran who sustained a fall resulting in"
^TIU(8925,5,"TEXT",9,0)="left femoral neck fracture. S/P hemiarthroplasty 3 weeks ago."
^TIU(8925,5,"TEXT",10,0)="Currently using rolling walker. Pain 5/10 with ambulation."
^TIU(8925,5,"TEXT",11,0)="Lives alone. Prior level: independent with cane for community ambulation."
^TIU(8925,5,"TEXT",12,0)="Fall risk assessment: High (Morse Fall Scale 65)."
^TIU(8925,5,"TEXT",13,0)=""
^TIU(8925,5,"TEXT",14,0)="OBJECTIVE:"
^TIU(8925,5,"TEXT",15,0)="Left hip ROM (within precautions): Flex 75 deg, Abd 20 deg, ER 15 deg."
^TIU(8925,5,"TEXT",16,0)="Left knee ROM: 0-125 degrees. Left ankle: WNL."
^TIU(8925,5,"TEXT",17,0)="MMT: L hip flex 3/5, L hip abd 3-/5, L quads 3+/5, L glut max 3/5."
^TIU(8925,5,"TEXT",18,0)="Gait: WBAT with rolling walker. Short stride length. Antalgic on left."
^TIU(8925,5,"TEXT",19,0)="Transfers: Mod assist for sit-to-stand. Independent bed mobility."
^TIU(8925,5,"TEXT",20,0)="Balance: Berg Balance Scale 32/56 (fall risk)."
^TIU(8925,5,"TEXT",21,0)=""
^TIU(8925,5,"TEXT",22,0)="ASSESSMENT: Significant impairments in LE strength, balance, and"
^TIU(8925,5,"TEXT",23,0)="functional mobility. Fall risk remains elevated. Patient is motivated."
^TIU(8925,5,"TEXT",24,0)=""
^TIU(8925,5,"TEXT",25,0)="PLAN:"
^TIU(8925,5,"TEXT",26,0)="1. LE strengthening within hip precautions."
^TIU(8925,5,"TEXT",27,0)="2. Balance and fall prevention training."
^TIU(8925,5,"TEXT",28,0)="3. Gait training: progress walker to cane."
^TIU(8925,5,"TEXT",29,0)="4. Transfer training for home safety."
^TIU(8925,5,"TEXT",30,0)="5. Home exercise program for daily performance."
^TIU(8925,5,"TEXT",31,0)="6. Frequency: 2x/week for 6 weeks."
^TIU(8925,6,0)="PROGRESS NOTE^2;DPT(^4^^^^3240812"
^TIU(8925,6,"TEXT",1,0)="CARDIOLOGY FOLLOW-UP"
^TIU(8925,6,"TEXT",2,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,6,"TEXT",3,0)=""
^TIU(8925,6,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,6,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,6,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,6,"TEXT",7,0)="Medication compliance good. No side effects reported."
^TIU(8925,6,"TEXT",8,0)=""
^TIU(8925,6,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,6,"TEXT",10,0)="General: No acute distress."
^TIU(8925,6,"TEXT",11,0)="JVP: Not elevated."
^TIU(8925,6,"TEXT",12,0)="Cardiovascular: Irregularly irregular rhythm. S1/S2 normal. No S3 or S4. Grade 2/6 systolic murmur at apex."
^TIU(8925,6,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,6,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,6,"TEXT",15,0)=""
^TIU(8925,6,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,6,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,6,"TEXT",18,0)=""
^TIU(8925,6,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,6,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,6,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,6,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,6,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,6,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
^TIU(8925,7,0)="TELEPHONE NOTE^2;DPT(^4^^^^3251028"
^TIU(8925,7,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,7,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,7,"TEXT",3,0)=""
^TIU(8925,7,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,7,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,7,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,7,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,7,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,7,"TEXT",9,0)=""
^TIU(8925,7,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,7,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,7,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,7,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,7,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,7,"TEXT",15,0)=""
^TIU(8925,7,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,7,"TEXT",17,0)=""
^TIU(8925,7,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,7,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,7,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,7,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,7,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,7,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,8,0)="PROGRESS NOTE^3;DPT(^3^^^^3251223"
^TIU(8925,8,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,8,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,8,"TEXT",3,0)=""
^TIU(8925,8,"TEXT",4,0)="SUBJECTIVE: 4 weeks status post ORIF left bimalleolar ankle fracture."
^TIU(8925,8,"TEXT",5,0)="Pain improving. Using crutches, non-weight-bearing on left."
^TIU(8925,8,"TEXT",6,0)="Swelling has decreased. No wound concerns."
^TIU(8925,8,"TEXT",7,0)=""
^TIU(8925,8,"TEXT",8,0)="OBJECTIVE:"
^TIU(8925,8,"TEXT",9,0)="Left ankle: Incision healed. Hardware palpable. No tenderness over hardware."
^TIU(8925,8,"TEXT",10,0)="Swelling 1+ compared to right. No ecchymosis."
^TIU(8925,8,"TEXT",11,0)="ROM: DF -5 degrees, PF 20 degrees. Inv/Ev guarded."
^TIU(8925,8,"TEXT",12,0)=""
^TIU(8925,8,"TEXT",13,0)="X-rays: Fracture lines healing. Hardware intact. Mortise congruent."
^TIU(8925,8,"TEXT",14,0)=""
^TIU(8925,8,"TEXT",15,0)="ASSESSMENT AND PLAN:"
^TIU(8925,8,"TEXT",16,0)="1. Left ankle bimalleolar fracture: Healing on schedule."
^TIU(8925,8,"TEXT",17,0)="2. Transition to CAM boot. Begin partial weight-bearing 25% BW."
^TIU(8925,8,"TEXT",18,0)="3. Start physical therapy for ROM and progressive weight-bearing."
^TIU(8925,8,"TEXT",19,0)="4. Follow up in 4 weeks with weight-bearing x-rays."
