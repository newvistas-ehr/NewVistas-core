^TIU(8925,79,0)="PROGRESS NOTE^22;DPT(^2^^^^3240525"
^TIU(8925,79,"TEXT",1,0)="ENDOCRINOLOGY FOLLOW-UP"
^TIU(8925,79,"TEXT",2,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,79,"TEXT",3,0)=""
^TIU(8925,79,"TEXT",4,0)="SUBJECTIVE: Patient presents for diabetes management follow-up."
^TIU(8925,79,"TEXT",5,0)="Home glucose readings reviewed: fasting 110-160, post-prandial 140-220."
^TIU(8925,79,"TEXT",6,0)="Denies hypoglycemic episodes. No polyuria or polydipsia."
^TIU(8925,79,"TEXT",7,0)="Following diabetic diet. Walking 20 minutes 3x/week."
^TIU(8925,79,"TEXT",8,0)="Last eye exam 6 months ago — no retinopathy. Foot exam today."
^TIU(8925,79,"TEXT",9,0)=""
^TIU(8925,79,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,79,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,79,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,79,"TEXT",13,0)=""
^TIU(8925,79,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,79,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,79,"TEXT",16,0)=""
^TIU(8925,79,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,79,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,79,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,79,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,79,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,79,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,80,0)="PROGRESS NOTE^22;DPT(^2^^^^3251106"
^TIU(8925,80,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,80,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,80,"TEXT",3,0)=""
^TIU(8925,80,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,80,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,80,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,80,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,80,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,80,"TEXT",9,0)=""
^TIU(8925,80,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,80,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,80,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,80,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,80,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,80,"TEXT",15,0)=""
^TIU(8925,80,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,80,"TEXT",17,0)=""
^TIU(8925,80,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,80,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,80,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,80,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,80,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,80,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
