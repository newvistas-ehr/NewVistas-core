^TIU(8925,75,0)="CONSULT NOTE^21;DPT(^2^^^^3240828"
^TIU(8925,75,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,75,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,75,"TEXT",3,0)=""
^TIU(8925,75,"TEXT",4,0)="SUBJECTIVE: 2 weeks status post right ACL reconstruction with BTB autograft."
^TIU(8925,75,"TEXT",5,0)="Tolerating brace well. Minimal pain with medication."
^TIU(8925,75,"TEXT",6,0)="Ice and elevation as directed. No fever or wound concerns."
^TIU(8925,75,"TEXT",7,0)=""
^TIU(8925,75,"TEXT",8,0)="OBJECTIVE:"
^TIU(8925,75,"TEXT",9,0)="Right knee: Incisions clean. Mild effusion. No warmth."
^TIU(8925,75,"TEXT",10,0)="ROM: 0-90 degrees in brace (limited per protocol)."
^TIU(8925,75,"TEXT",11,0)="Quad firing present. Straight-leg raise possible with brace."
^TIU(8925,75,"TEXT",12,0)="Lachman: Stable endpoint."
^TIU(8925,75,"TEXT",13,0)=""
^TIU(8925,75,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,75,"TEXT",15,0)="1. R ACL reconstruction: Progressing per protocol."
^TIU(8925,75,"TEXT",16,0)="2. Unlock brace for ROM exercises. Goal: full extension, 120 degrees flexion by 6 weeks."
^TIU(8925,75,"TEXT",17,0)="3. Begin outpatient PT — ACL reconstruction protocol."
^TIU(8925,75,"TEXT",18,0)="4. Weight-bearing as tolerated in locked brace."
^TIU(8925,75,"TEXT",19,0)="5. Follow up in 4 weeks."
^TIU(8925,76,0)="PROGRESS NOTE^21;DPT(^2^^^^3250706"
^TIU(8925,76,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,76,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION — ACL RECONSTRUCTION PROTOCOL"
^TIU(8925,76,"TEXT",3,0)=""
^TIU(8925,76,"TEXT",4,0)="DIAGNOSIS: S/P right ACL reconstruction with BTB autograft, 2 weeks post-op."
^TIU(8925,76,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 24 visits."
^TIU(8925,76,"TEXT",6,0)="PROTOCOL: Progressive ACL rehabilitation, 6-9 month return to activity."
^TIU(8925,76,"TEXT",7,0)=""
^TIU(8925,76,"TEXT",8,0)="SUBJECTIVE: Young veteran sustained ACL tear during recreational sports."
^TIU(8925,76,"TEXT",9,0)="S/P arthroscopic ACL reconstruction with BTB autograft 2 weeks ago."
^TIU(8925,76,"TEXT",10,0)="Pain 3/10 at rest, 5/10 with exercise. Sleeping in brace as instructed."
^TIU(8925,76,"TEXT",11,0)="Goal: Return to full activity including running and sports."
^TIU(8925,76,"TEXT",12,0)=""
^TIU(8925,76,"TEXT",13,0)="OBJECTIVE:"
^TIU(8925,76,"TEXT",14,0)="Right knee ROM: Extension 0 degrees (full), Flexion 85 degrees."
^TIU(8925,76,"TEXT",15,0)="Effusion: 2+ (moderate). Patellar mobility: restricted superiorly."
^TIU(8925,76,"TEXT",16,0)="VMO activation present but weak. SLR possible."
^TIU(8925,76,"TEXT",17,0)="MMT: R quads 3/5, R hamstrings 4-/5."
^TIU(8925,76,"TEXT",18,0)="Gait: WBAT in locked hinged brace. Antalgic on right."
^TIU(8925,76,"TEXT",19,0)="Donor site: Patellar tendon harvest site tender to palpation."
^TIU(8925,76,"TEXT",20,0)=""
^TIU(8925,76,"TEXT",21,0)="ASSESSMENT: Patient in Phase 1 of ACL rehab protocol."
^TIU(8925,76,"TEXT",22,0)="Primary deficits: knee flexion ROM, quad strength, effusion control."
^TIU(8925,76,"TEXT",23,0)=""
^TIU(8925,76,"TEXT",24,0)="PLAN — PHASE 1 (Weeks 0-6):"
^TIU(8925,76,"TEXT",25,0)="1. Restore full extension, progress flexion to 120 degrees."
^TIU(8925,76,"TEXT",26,0)="2. Quad activation: e-stim, quad sets, SLR in 4 planes."
^TIU(8925,76,"TEXT",27,0)="3. Patellar mobilization. Scar mobilization at 4 weeks."
^TIU(8925,76,"TEXT",28,0)="4. Effusion management: ice, compression, elevation."
^TIU(8925,76,"TEXT",29,0)="5. Begin closed-chain exercises: mini-squats, leg press (limited range)."
^TIU(8925,76,"TEXT",30,0)="6. Gait training: normalize pattern, wean from brace."
^TIU(8925,76,"TEXT",31,0)="7. Frequency: 3x/week for 6 weeks, then reassess."
^TIU(8925,77,0)="PROGRESS NOTE^21;DPT(^2^^^^3250128"
^TIU(8925,77,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,77,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,77,"TEXT",3,0)=""
^TIU(8925,77,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,77,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,77,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,77,"TEXT",7,0)="Dizziness improved with vestibular therapy."
