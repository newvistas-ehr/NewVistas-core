^TIU(8925,30,0)="PROGRESS NOTE^9;DPT(^3^^^^3250926"
^TIU(8925,30,"TEXT",1,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,30,"TEXT",2,0)="PULMONOLOGY COMPREHENSIVE EVALUATION"
^TIU(8925,30,"TEXT",3,0)=""
^TIU(8925,30,"TEXT",4,0)="SUBJECTIVE: Patient presents for comprehensive pulmonary follow-up."
^TIU(8925,30,"TEXT",5,0)="COPD: Stable with 1 exacerbation in last 6 months. Currently at baseline."
^TIU(8925,30,"TEXT",6,0)="Uses 2L O2 at night per sleep study. CPAP compliance 5.2 hrs/night."
^TIU(8925,30,"TEXT",7,0)="Dyspnea: mMRC grade 2 (SOB on hurrying or walking up slight hill)."
^TIU(8925,30,"TEXT",8,0)="CHF: Lower extremity edema managed with diuretics."
^TIU(8925,30,"TEXT",9,0)="Depression: Affecting motivation for pulmonary rehab attendance."
^TIU(8925,30,"TEXT",10,0)=""
^TIU(8925,30,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,30,"TEXT",12,0)="SpO2: 92% on room air at rest, 88% with 6-minute walk."
^TIU(8925,30,"TEXT",13,0)="6-minute walk distance: 280 meters (below predicted)."
^TIU(8925,30,"TEXT",14,0)="Lungs: Scattered expiratory wheezes. Prolonged expiratory phase."
^TIU(8925,30,"TEXT",15,0)=""
^TIU(8925,30,"TEXT",16,0)="PFTs: FEV1 48% predicted (was 55% 1 year ago). FEV1/FVC 0.58."
^TIU(8925,30,"TEXT",17,0)="DLCO 52% predicted."
^TIU(8925,30,"TEXT",18,0)=""
^TIU(8925,30,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,30,"TEXT",20,0)="1. COPD: GOLD Stage III (progression). Add roflumilast to reduce exacerbations."
^TIU(8925,30,"TEXT",21,0)="2. Pulmonary rehab: Re-referral with coordination with MH team for motivation."
^TIU(8925,30,"TEXT",22,0)="3. OSA: CPAP compliance acceptable. Continue current settings."
^TIU(8925,30,"TEXT",23,0)="4. Supplemental O2: Qualify for exertional O2. Prescribe 2L NC with activity."
^TIU(8925,30,"TEXT",24,0)="5. CHF: Coordinate with cardiology for diuretic management."
^TIU(8925,30,"TEXT",25,0)="6. Flu and pneumonia vaccines current."
^TIU(8925,30,"TEXT",26,0)="7. Annual LDCT for lung cancer screening due in 2 months."
^TIU(8925,30,"TEXT",27,0)="8. Follow up in 3 months with repeat PFTs."
^TIU(8925,31,0)="TELEPHONE NOTE^9;DPT(^3^^^^3240805"
^TIU(8925,31,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,31,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,31,"TEXT",3,0)=""
^TIU(8925,31,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,31,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,31,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,31,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,31,"TEXT",8,0)=""
^TIU(8925,31,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,31,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,31,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,31,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,31,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,31,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,31,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,31,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,31,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,31,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,31,"TEXT",19,0)=""
^TIU(8925,31,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,31,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,31,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,31,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,31,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
