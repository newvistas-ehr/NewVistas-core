^TIU(8925,104,"TEXT",2,0)="SUBJECTIVE: Patient presents for routine follow-up of chronic conditions."
^TIU(8925,104,"TEXT",3,0)="Reports compliance with medications. Denies new complaints."
^TIU(8925,104,"TEXT",4,0)="Sleep adequate. Appetite normal. Activity level stable."
^TIU(8925,104,"TEXT",5,0)=""
^TIU(8925,104,"TEXT",6,0)="OBJECTIVE:"
^TIU(8925,104,"TEXT",7,0)="General: Well-appearing, no acute distress."
^TIU(8925,104,"TEXT",8,0)="HEENT: PERRL, EOMI, oropharynx clear."
^TIU(8925,104,"TEXT",9,0)="Cardiovascular: RRR, no murmurs, rubs, or gallops."
^TIU(8925,104,"TEXT",10,0)="Lungs: Clear to auscultation bilaterally."
^TIU(8925,104,"TEXT",11,0)="Abdomen: Soft, non-tender, non-distended."
^TIU(8925,104,"TEXT",12,0)="Extremities: No edema. Pedal pulses palpable bilaterally."
^TIU(8925,104,"TEXT",13,0)=""
^TIU(8925,104,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,104,"TEXT",15,0)="Chronic conditions stable on current regimen."
^TIU(8925,104,"TEXT",16,0)="Medications reconciled. No changes indicated."
^TIU(8925,104,"TEXT",17,0)="Age-appropriate screening up to date."
^TIU(8925,104,"TEXT",18,0)="Continue current management. Follow up in 3 months."
