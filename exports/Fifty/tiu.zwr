^TIU(8925,115,0)="CONSULT NOTE^34;DPT(^3^^^^3250728"
^TIU(8925,115,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,115,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,115,"TEXT",3,0)=""
^TIU(8925,115,"TEXT",4,0)="SUBJECTIVE: Patient presents 2 weeks status post left hip hemiarthroplasty"
^TIU(8925,115,"TEXT",5,0)="for displaced femoral neck fracture."
^TIU(8925,115,"TEXT",6,0)="Pain controlled with Tylenol and low-dose opioid."
^TIU(8925,115,"TEXT",7,0)="Ambulating with rolling walker. Following posterior hip precautions."
^TIU(8925,115,"TEXT",8,0)="Home health PT has been visiting 3x/week."
^TIU(8925,115,"TEXT",9,0)=""
^TIU(8925,115,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,115,"TEXT",11,0)="Left hip: Incision clean, dry, intact. Staples in place (to remove today)."
^TIU(8925,115,"TEXT",12,0)="No erythema or drainage. No calf tenderness."
^TIU(8925,115,"TEXT",13,0)="ROM (passive): Flexion 80 degrees, abduction 25 degrees."
^TIU(8925,115,"TEXT",14,0)="Able to perform SLR against gravity."
^TIU(8925,115,"TEXT",15,0)=""
^TIU(8925,115,"TEXT",16,0)="X-ray: Prosthesis in good position. No periprosthetic fracture."
^TIU(8925,115,"TEXT",17,0)=""
^TIU(8925,115,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,115,"TEXT",19,0)="1. S/P left hip hemiarthroplasty: Progressing well."
^TIU(8925,115,"TEXT",20,0)="2. Remove staples today. Steri-strips applied."
^TIU(8925,115,"TEXT",21,0)="3. Continue weight-bearing as tolerated with walker."
^TIU(8925,115,"TEXT",22,0)="4. Continue posterior hip precautions x6 weeks."
^TIU(8925,115,"TEXT",23,0)="5. Transition to outpatient PT for continued strengthening and gait training."
^TIU(8925,115,"TEXT",24,0)="6. Wean opioid. Increase Tylenol for pain management."
^TIU(8925,115,"TEXT",25,0)="7. Follow up in 4 weeks."
^TIU(8925,116,0)="PROGRESS NOTE^34;DPT(^3^^^^3250222"
^TIU(8925,116,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,116,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION"
^TIU(8925,116,"TEXT",3,0)=""
^TIU(8925,116,"TEXT",4,0)="DIAGNOSIS: S/P left hip hemiarthroplasty for femoral neck fracture."
^TIU(8925,116,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 12 visits."
^TIU(8925,116,"TEXT",6,0)="PRECAUTIONS: Posterior hip precautions x6 weeks."
^TIU(8925,116,"TEXT",7,0)=""
^TIU(8925,116,"TEXT",8,0)="SUBJECTIVE: Patient is an elderly veteran who sustained a fall resulting in"
^TIU(8925,116,"TEXT",9,0)="left femoral neck fracture. S/P hemiarthroplasty 3 weeks ago."
^TIU(8925,116,"TEXT",10,0)="Currently using rolling walker. Pain 5/10 with ambulation."
^TIU(8925,116,"TEXT",11,0)="Lives alone. Prior level: independent with cane for community ambulation."
^TIU(8925,116,"TEXT",12,0)="Fall risk assessment: High (Morse Fall Scale 65)."
^TIU(8925,116,"TEXT",13,0)=""
^TIU(8925,116,"TEXT",14,0)="OBJECTIVE:"
^TIU(8925,116,"TEXT",15,0)="Left hip ROM (within precautions): Flex 75 deg, Abd 20 deg, ER 15 deg."
^TIU(8925,116,"TEXT",16,0)="Left knee ROM: 0-125 degrees. Left ankle: WNL."
^TIU(8925,116,"TEXT",17,0)="MMT: L hip flex 3/5, L hip abd 3-/5, L quads 3+/5, L glut max 3/5."
^TIU(8925,116,"TEXT",18,0)="Gait: WBAT with rolling walker. Short stride length. Antalgic on left."
^TIU(8925,116,"TEXT",19,0)="Transfers: Mod assist for sit-to-stand. Independent bed mobility."
^TIU(8925,116,"TEXT",20,0)="Balance: Berg Balance Scale 32/56 (fall risk)."
^TIU(8925,116,"TEXT",21,0)=""
^TIU(8925,116,"TEXT",22,0)="ASSESSMENT: Significant impairments in LE strength, balance, and"
^TIU(8925,116,"TEXT",23,0)="functional mobility. Fall risk remains elevated. Patient is motivated."
^TIU(8925,116,"TEXT",24,0)=""
^TIU(8925,116,"TEXT",25,0)="PLAN:"
^TIU(8925,116,"TEXT",26,0)="1. LE strengthening within hip precautions."
^TIU(8925,116,"TEXT",27,0)="2. Balance and fall prevention training."
^TIU(8925,116,"TEXT",28,0)="3. Gait training: progress walker to cane."
^TIU(8925,116,"TEXT",29,0)="4. Transfer training for home safety."
^TIU(8925,116,"TEXT",30,0)="5. Home exercise program for daily performance."
^TIU(8925,116,"TEXT",31,0)="6. Frequency: 2x/week for 6 weeks."
