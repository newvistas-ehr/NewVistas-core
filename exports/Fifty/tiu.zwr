^TIU(8925,136,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,136,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,136,"TEXT",15,0)=""
^TIU(8925,136,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,136,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,136,"TEXT",18,0)=""
^TIU(8925,136,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,136,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,136,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,136,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,136,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,136,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
^TIU(8925,137,0)="PROGRESS NOTE^39;DPT(^4^^^^3240102"
^TIU(8925,137,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,137,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,137,"TEXT",3,0)=""
^TIU(8925,137,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,137,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,137,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,137,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,137,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,137,"TEXT",9,0)=""
^TIU(8925,137,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,137,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,137,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,137,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,137,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,137,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,137,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,137,"TEXT",17,0)=""
^TIU(8925,137,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,137,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,137,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,137,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,137,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,137,"TEXT",23,0)="5. Follow up in 3 months."
^TIU(8925,138,0)="TELEPHONE NOTE^39;DPT(^4^^^^3250519"
^TIU(8925,138,"TEXT",1,0)="MENTAL HEALTH FOLLOW-UP"
^TIU(8925,138,"TEXT",2,0)="MENTAL HEALTH PROGRESS NOTE"
^TIU(8925,138,"TEXT",3,0)=""
^TIU(8925,138,"TEXT",4,0)="SUBJECTIVE: Patient reports stable mood since last visit."
^TIU(8925,138,"TEXT",5,0)="Sleep improved on current regimen. Getting 6-7 hours per night."
^TIU(8925,138,"TEXT",6,0)="Appetite fair. Denies suicidal or homicidal ideation."
^TIU(8925,138,"TEXT",7,0)="Engaging in weekly therapy sessions. Reports finding them helpful."
^TIU(8925,138,"TEXT",8,0)="Some ongoing hypervigilance and startle response noted."
^TIU(8925,138,"TEXT",9,0)="Nightmares occurring 1-2x per week, down from 4-5x at last visit."
^TIU(8925,138,"TEXT",10,0)=""
^TIU(8925,138,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,138,"TEXT",12,0)="Appearance: Well-groomed, appropriate dress."
^TIU(8925,138,"TEXT",13,0)="Behavior: Cooperative, good eye contact."
^TIU(8925,138,"TEXT",14,0)="Speech: Normal rate, rhythm, and volume."
^TIU(8925,138,"TEXT",15,0)="Mood: 'Better' Affect: Euthymic, congruent."
^TIU(8925,138,"TEXT",16,0)="Thought process: Linear, goal-directed."
^TIU(8925,138,"TEXT",17,0)="Thought content: No SI/HI. No delusions or hallucinations."
^TIU(8925,138,"TEXT",18,0)="Cognition: Alert, oriented x4."
^TIU(8925,138,"TEXT",19,0)="PHQ-9: Reviewed. GAD-7: Reviewed."
^TIU(8925,138,"TEXT",20,0)=""
^TIU(8925,138,"TEXT",21,0)="ASSESSMENT AND PLAN:"
^TIU(8925,138,"TEXT",22,0)="Symptoms improving on current medication regimen."
^TIU(8925,138,"TEXT",23,0)="Continue current psychotropic medications."
^TIU(8925,138,"TEXT",24,0)="Continue weekly psychotherapy."
^TIU(8925,138,"TEXT",25,0)="Safety plan reviewed and updated. Patient verbalizes plan."
^TIU(8925,138,"TEXT",26,0)="Follow up in 4 weeks."
