^TIU(8925,86,"TEXT",1,0)="CARDIOLOGY FOLLOW-UP"
^TIU(8925,86,"TEXT",2,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,86,"TEXT",3,0)=""
^TIU(8925,86,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,86,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,86,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,86,"TEXT",7,0)="Medication compliance good. No side effects reported."
^TIU(8925,86,"TEXT",8,0)=""
^TIU(8925,86,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,86,"TEXT",10,0)="General: No acute distress."
^TIU(8925,86,"TEXT",11,0)="JVP: Not elevated."
^TIU(8925,86,"TEXT",12,0)="Cardiovascular: Irregularly irregular rhythm. S1/S2 normal. No S3 or S4. Grade 2/6 systolic murmur at apex."
^TIU(8925,86,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,86,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,86,"TEXT",15,0)=""
^TIU(8925,86,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,86,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,86,"TEXT",18,0)=""
^TIU(8925,86,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,86,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,86,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,86,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,86,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,86,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
