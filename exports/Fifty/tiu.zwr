^TIU(8925,100,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,100,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,100,"TEXT",23,0)="5. Follow up in 3 months."
^TIU(8925,101,0)="PROGRESS NOTE^30;DPT(^4^^^^3250718"
^TIU(8925,101,"TEXT",1,0)="ORTHOPEDIC CLINIC NOTE"
^TIU(8925,101,"TEXT",2,0)="ORTHOPEDIC POST-OPERATIVE FOLLOW-UP"
^TIU(8925,101,"TEXT",3,0)=""
^TIU(8925,101,"TEXT",4,0)="SUBJECTIVE: 6 weeks status post arthroscopic left rotator cuff repair."
^TIU(8925,101,"TEXT",5,0)="Wearing sling as instructed. Pain 3/10, well-controlled."
^TIU(8925,101,"TEXT",6,0)="Home passive ROM exercises have been going well."
^TIU(8925,101,"TEXT",7,0)="Spouse assists with pendulum exercises and passive elevation."
^TIU(8925,101,"TEXT",8,0)=""
^TIU(8925,101,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,101,"TEXT",10,0)="Left shoulder: Well-healed portal sites. No infection."
^TIU(8925,101,"TEXT",11,0)="Passive ROM: Forward elevation 130 degrees. ER at side 30 degrees."
^TIU(8925,101,"TEXT",12,0)="No active ROM testing at this time per protocol."
^TIU(8925,101,"TEXT",13,0)="Deltoid and periscapular muscles firing with isometrics."
^TIU(8925,101,"TEXT",14,0)=""
^TIU(8925,101,"TEXT",15,0)="ASSESSMENT AND PLAN:"
^TIU(8925,101,"TEXT",16,0)="1. L rotator cuff repair: Healing well per protocol."
^TIU(8925,101,"TEXT",17,0)="2. Discontinue sling. Begin active-assisted ROM."
^TIU(8925,101,"TEXT",18,0)="3. Physical therapy to begin — rotator cuff repair protocol."
^TIU(8925,101,"TEXT",19,0)="4. No lifting >1 lb with left arm until 12 weeks post-op."
^TIU(8925,101,"TEXT",20,0)="5. Follow up in 6 weeks."
^TIU(8925,102,0)="PROGRESS NOTE^30;DPT(^4^^^^3240901"
^TIU(8925,102,"TEXT",1,0)="PT INITIAL EVALUATION"
^TIU(8925,102,"TEXT",2,0)="PHYSICAL THERAPY INITIAL EVALUATION — ROTATOR CUFF REPAIR PROTOCOL"
^TIU(8925,102,"TEXT",3,0)=""
^TIU(8925,102,"TEXT",4,0)="DIAGNOSIS: S/P arthroscopic left rotator cuff repair, 6 weeks post-op."
^TIU(8925,102,"TEXT",5,0)="REFERRAL: Orthopedic surgery. Authorization: 20 visits."
^TIU(8925,102,"TEXT",6,0)="PROTOCOL: Phase 2 — Active-assisted to active ROM."
^TIU(8925,102,"TEXT",7,0)=""
^TIU(8925,102,"TEXT",8,0)="SUBJECTIVE: Patient reports improving pain. Sling discontinued today."
^TIU(8925,102,"TEXT",9,0)="Dominant hand: Right. Left shoulder is non-dominant."
^TIU(8925,102,"TEXT",10,0)="Goal: Return to overhead activities and yard work."
^TIU(8925,102,"TEXT",11,0)=""
^TIU(8925,102,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,102,"TEXT",13,0)="L shoulder PROM: Flexion 135 deg, Abduction 90 deg, ER at 0 deg abd 35 deg."
^TIU(8925,102,"TEXT",14,0)="IR at 90 abd: 30 degrees. Horizontal adduction: 90 degrees."
^TIU(8925,102,"TEXT",15,0)="Active ROM: Flexion 80 degrees (with hiking). Abduction 60 degrees."
^TIU(8925,102,"TEXT",16,0)="Scapular control: Poor. Scapular winging with attempted elevation."
^TIU(8925,102,"TEXT",17,0)="Grip strength: Left 15 kg (Right 35 kg)."
^TIU(8925,102,"TEXT",18,0)=""
^TIU(8925,102,"TEXT",19,0)="ASSESSMENT: Significant ROM and strength deficits expected at this stage."
^TIU(8925,102,"TEXT",20,0)="Patient progressing appropriately per surgical protocol timeline."
^TIU(8925,102,"TEXT",21,0)=""
^TIU(8925,102,"TEXT",22,0)="PLAN — PHASE 2 (Weeks 6-12):"
^TIU(8925,102,"TEXT",23,0)="1. Active-assisted ROM: pulleys, wand exercises, wall slides."
^TIU(8925,102,"TEXT",24,0)="2. Scapular stabilization exercises: rows, serratus punches."
^TIU(8925,102,"TEXT",25,0)="3. Gentle isometrics: ER/IR at side."
^TIU(8925,102,"TEXT",26,0)="4. Scar mobilization and soft tissue mobilization."
^TIU(8925,102,"TEXT",27,0)="5. NO resisted ER/IR or overhead strengthening until 12 weeks."
^TIU(8925,102,"TEXT",28,0)="6. Frequency: 2x/week for 6 weeks, then reassess for Phase 3."
^TIU(8925,103,0)="PROGRESS NOTE^30;DPT(^4^^^^3251104"
^TIU(8925,103,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,103,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,103,"TEXT",3,0)=""
^TIU(8925,103,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,103,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,103,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,103,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,103,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,103,"TEXT",9,0)=""
^TIU(8925,103,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,103,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,103,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,103,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,103,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,103,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,103,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,103,"TEXT",17,0)=""
^TIU(8925,103,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,103,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,103,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,103,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,103,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,103,"TEXT",23,0)="5. Follow up in 3 months."
^TIU(8925,104,0)="TELEPHONE NOTE^30;DPT(^4^^^^3250706"
