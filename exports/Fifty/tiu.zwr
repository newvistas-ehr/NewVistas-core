^TIU(8925,18,"TEXT",1,0)="PRIMARY CARE ANNUAL"
^TIU(8925,18,"TEXT",2,0)="ANNUAL COMPREHENSIVE EXAMINATION"
^TIU(8925,18,"TEXT",3,0)=""
^TIU(8925,18,"TEXT",4,0)="SUBJECTIVE: Patient presents for annual comprehensive exam."
^TIU(8925,18,"TEXT",5,0)="No new complaints. Functional status maintained."
^TIU(8925,18,"TEXT",6,0)="Reviews of systems negative except as documented in problem list."
^TIU(8925,18,"TEXT",7,0)="Current medications reviewed and reconciled with patient."
^TIU(8925,18,"TEXT",8,0)=""
^TIU(8925,18,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,18,"TEXT",10,0)="General: Well-nourished, well-developed, no acute distress."
^TIU(8925,18,"TEXT",11,0)="HEENT: Normal. TMs clear bilaterally. Dentition fair."
^TIU(8925,18,"TEXT",12,0)="Neck: Supple. No lymphadenopathy. Thyroid normal."
^TIU(8925,18,"TEXT",13,0)="Cardiovascular: RRR. No murmurs."
^TIU(8925,18,"TEXT",14,0)="Lungs: Clear bilaterally. Good air movement."
^TIU(8925,18,"TEXT",15,0)="Abdomen: Soft, non-tender. No organomegaly."
^TIU(8925,18,"TEXT",16,0)="Skin: No suspicious lesions. Skin cancer screening performed."
^TIU(8925,18,"TEXT",17,0)="Neuro: Alert, oriented x4. Cranial nerves intact. Strength 5/5."
^TIU(8925,18,"TEXT",18,0)="Musculoskeletal: Full ROM all major joints. No joint swelling."
^TIU(8925,18,"TEXT",19,0)=""
^TIU(8925,18,"TEXT",20,0)="ASSESSMENT AND PLAN:"
^TIU(8925,18,"TEXT",21,0)="1. Health maintenance current. All screening tests reviewed."
^TIU(8925,18,"TEXT",22,0)="2. Immunizations updated per schedule."
^TIU(8925,18,"TEXT",23,0)="3. Continue current medications without change."
^TIU(8925,18,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,19,0)="PROGRESS NOTE^6;DPT(^3^^^^3250827"
^TIU(8925,19,"TEXT",1,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,19,"TEXT",2,0)="CARDIOLOGY COMPREHENSIVE HEART FAILURE MANAGEMENT"
^TIU(8925,19,"TEXT",3,0)=""
^TIU(8925,19,"TEXT",4,0)="SUBJECTIVE: Patient presents for CHF management."
^TIU(8925,19,"TEXT",5,0)="Reports increasing DOE over the last 2 weeks — now symptomatic climbing 1 flight."
^TIU(8925,19,"TEXT",6,0)="Orthopnea: Using 3 pillows to sleep. Wakes once nightly with SOB."
^TIU(8925,19,"TEXT",7,0)="Weight has increased 4 lbs in the last week despite diuretic use."
^TIU(8925,19,"TEXT",8,0)="Denies chest pain or palpitations. Reports occasional skipped beats."
^TIU(8925,19,"TEXT",9,0)="Diet: Admits to dietary indiscretion (Chinese food last weekend)."
^TIU(8925,19,"TEXT",10,0)=""
^TIU(8925,19,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,19,"TEXT",12,0)="JVP: Elevated to 10 cm H2O."
^TIU(8925,19,"TEXT",13,0)="Cardiovascular: Irregularly irregular, rate 88. S3 gallop present."
^TIU(8925,19,"TEXT",14,0)="Grade 2/6 systolic murmur at apex radiating to axilla."
^TIU(8925,19,"TEXT",15,0)="Lungs: Bibasilar crackles to mid-lung fields bilaterally."
^TIU(8925,19,"TEXT",16,0)="Abdomen: Hepatojugular reflux positive."
^TIU(8925,19,"TEXT",17,0)="Extremities: 2+ pitting edema bilateral lower extremities to mid-calf."
^TIU(8925,19,"TEXT",18,0)="Weight: 198 lbs (was 194 lbs 2 weeks ago)."
^TIU(8925,19,"TEXT",19,0)=""
^TIU(8925,19,"TEXT",20,0)="Labs: BNP 580 pg/mL (prior 185). Na 134. K 4.8. Cr 1.6. INR 2.1."
^TIU(8925,19,"TEXT",21,0)="Echo (1 month ago): LVEF 35% (was 40% 6 months ago)."
^TIU(8925,19,"TEXT",22,0)=""
^TIU(8925,19,"TEXT",23,0)="ASSESSMENT AND PLAN:"
^TIU(8925,19,"TEXT",24,0)="1. CHF exacerbation: NYHA Class III (worsening from II)."
^TIU(8925,19,"TEXT",25,0)="   - Increase furosemide to 80mg BID from 40mg BID."
^TIU(8925,19,"TEXT",26,0)="   - Add metolazone 2.5mg daily x3 days for diuretic resistance."
^TIU(8925,19,"TEXT",27,0)="   - Daily weights. Call if weight increases >2 lbs in 24 hours."
^TIU(8925,19,"TEXT",28,0)="2. Atrial fibrillation: Rate borderline. Increase metoprolol to 50mg BID."
^TIU(8925,19,"TEXT",29,0)="3. Declining EF: Consider addition of sacubitril/valsartan if tolerated."
^TIU(8925,19,"TEXT",30,0)="4. Sodium restriction: <2g/day. Fluid restriction <1.5L/day."
^TIU(8925,19,"TEXT",31,0)="5. Dietary counseling reinforced. Nutrition referral placed."
^TIU(8925,19,"TEXT",32,0)="6. Reassess in 1 week. If no improvement, consider IV diuresis admission."
^TIU(8925,19,"TEXT",33,0)="7. Repeat echo in 3 months. BNP in 1 week."
