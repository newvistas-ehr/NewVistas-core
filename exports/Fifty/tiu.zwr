^TIU(8925,112,"TEXT",1,0)="ENDOCRINOLOGY FOLLOW-UP"
^TIU(8925,112,"TEXT",2,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,112,"TEXT",3,0)=""
^TIU(8925,112,"TEXT",4,0)="SUBJECTIVE: Patient presents for diabetes management follow-up."
^TIU(8925,112,"TEXT",5,0)="Home glucose readings reviewed: fasting 110-160, post-prandial 140-220."
^TIU(8925,112,"TEXT",6,0)="Denies hypoglycemic episodes. No polyuria or polydipsia."
^TIU(8925,112,"TEXT",7,0)="Following diabetic diet. Walking 20 minutes 3x/week."
^TIU(8925,112,"TEXT",8,0)="Last eye exam 6 months ago — no retinopathy. Foot exam today."
^TIU(8925,112,"TEXT",9,0)=""
^TIU(8925,112,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,112,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,112,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,112,"TEXT",13,0)=""
^TIU(8925,112,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,112,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,112,"TEXT",16,0)=""
^TIU(8925,112,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,112,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,112,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,112,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,112,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,112,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,113,0)="DISCHARGE SUMMARY^33;DPT(^4^^^^3241101"
^TIU(8925,113,"TEXT",1,0)="ENDOCRINOLOGY FOLLOW-UP"
^TIU(8925,113,"TEXT",2,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,113,"TEXT",3,0)=""
^TIU(8925,113,"TEXT",4,0)="SUBJECTIVE: Patient presents for diabetes management follow-up."
^TIU(8925,113,"TEXT",5,0)="Home glucose readings reviewed: fasting 110-160, post-prandial 140-220."
^TIU(8925,113,"TEXT",6,0)="Denies hypoglycemic episodes. No polyuria or polydipsia."
^TIU(8925,113,"TEXT",7,0)="Following diabetic diet. Walking 20 minutes 3x/week."
^TIU(8925,113,"TEXT",8,0)="Last eye exam 6 months ago — no retinopathy. Foot exam today."
^TIU(8925,113,"TEXT",9,0)=""
^TIU(8925,113,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,113,"TEXT",11,0)="Foot exam: Monofilament intact bilaterally. Pedal pulses palpable."
^TIU(8925,113,"TEXT",12,0)="No foot ulcers or callus formation. Nails trimmed appropriately."
^TIU(8925,113,"TEXT",13,0)=""
^TIU(8925,113,"TEXT",14,0)="Labs: HbA1c 7.8% (prior 8.2%). Creatinine 1.1. eGFR 72."
^TIU(8925,113,"TEXT",15,0)="Fasting glucose 148. Lipid panel: LDL 95, HDL 42, TG 180."
^TIU(8925,113,"TEXT",16,0)=""
^TIU(8925,113,"TEXT",17,0)="ASSESSMENT AND PLAN:"
^TIU(8925,113,"TEXT",18,0)="1. T2DM: A1C improving but not at goal. Increase metformin to 1000mg BID."
^TIU(8925,113,"TEXT",19,0)="2. Consider adding GLP-1 agonist if A1C not <7.5% in 3 months."
^TIU(8925,113,"TEXT",20,0)="3. Diabetic nephropathy: Stable. Continue ACE inhibitor."
^TIU(8925,113,"TEXT",21,0)="4. Diabetic foot care education reinforced."
^TIU(8925,113,"TEXT",22,0)="5. Recheck A1C, BMP, microalbumin in 3 months."
^TIU(8925,114,0)="PROGRESS NOTE^33;DPT(^4^^^^3250114"
^TIU(8925,114,"TEXT",1,0)="PRIMARY CARE VISIT"
^TIU(8925,114,"TEXT",2,0)="SUBJECTIVE: Patient presents for routine follow-up of chronic conditions."
^TIU(8925,114,"TEXT",3,0)="Reports compliance with medications. Denies new complaints."
^TIU(8925,114,"TEXT",4,0)="Sleep adequate. Appetite normal. Activity level stable."
^TIU(8925,114,"TEXT",5,0)=""
^TIU(8925,114,"TEXT",6,0)="OBJECTIVE:"
^TIU(8925,114,"TEXT",7,0)="General: Well-appearing, no acute distress."
^TIU(8925,114,"TEXT",8,0)="HEENT: PERRL, EOMI, oropharynx clear."
^TIU(8925,114,"TEXT",9,0)="Cardiovascular: RRR, no murmurs, rubs, or gallops."
^TIU(8925,114,"TEXT",10,0)="Lungs: Clear to auscultation bilaterally."
^TIU(8925,114,"TEXT",11,0)="Abdomen: Soft, non-tender, non-distended."
^TIU(8925,114,"TEXT",12,0)="Extremities: No edema. Pedal pulses palpable bilaterally."
^TIU(8925,114,"TEXT",13,0)=""
^TIU(8925,114,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,114,"TEXT",15,0)="Chronic conditions stable on current regimen."
