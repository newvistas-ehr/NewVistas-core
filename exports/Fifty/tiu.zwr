^TIU(8925,10,0)="PROGRESS NOTE^4;DPT(^2^^^^3241007"
^TIU(8925,10,"TEXT",1,0)="ENDOCRINOLOGY CLINIC NOTE"
^TIU(8925,10,"TEXT",2,0)="ENDOCRINOLOGY COMPREHENSIVE DIABETES MANAGEMENT"
^TIU(8925,10,"TEXT",3,0)=""
^TIU(8925,10,"TEXT",4,0)="SUBJECTIVE: Patient presents for comprehensive diabetes review."
^TIU(8925,10,"TEXT",5,0)="Reports numbness and burning in both feet, worse at night."
^TIU(8925,10,"TEXT",6,0)="Home glucose log: fasting 130-200, post-prandial 180-280."
^TIU(8925,10,"TEXT",7,0)="Had 2 hypoglycemic episodes (glucose <70) last month while fasting."
^TIU(8925,10,"TEXT",8,0)="Following diabetic diet inconsistently. Sedentary lifestyle."
^TIU(8925,10,"TEXT",9,0)="Last eye exam 3 months ago showed mild non-proliferative diabetic retinopathy."
^TIU(8925,10,"TEXT",10,0)=""
^TIU(8925,10,"TEXT",11,0)="OBJECTIVE:"
^TIU(8925,10,"TEXT",12,0)="Foot exam: Monofilament absent at 3/10 sites bilaterally."
^TIU(8925,10,"TEXT",13,0)="Vibration sense decreased bilateral great toes."
^TIU(8925,10,"TEXT",14,0)="No ulcers. Skin dry with some cracking. Nails thickened."
^TIU(8925,10,"TEXT",15,0)="Ankle reflexes absent bilaterally."
^TIU(8925,10,"TEXT",16,0)=""
^TIU(8925,10,"TEXT",17,0)="Labs: HbA1c 9.1% (prior 8.5%). Creatinine 1.8. eGFR 42."
^TIU(8925,10,"TEXT",18,0)="Microalbumin/Creatinine ratio: 180 mg/g (elevated)."
^TIU(8925,10,"TEXT",19,0)="Fasting glucose 198. LDL 128. TG 245."
^TIU(8925,10,"TEXT",20,0)=""
^TIU(8925,10,"TEXT",21,0)="ASSESSMENT AND PLAN:"
^TIU(8925,10,"TEXT",22,0)="1. T2DM: Poorly controlled. A1C 9.1%. Add semaglutide 0.25mg SQ weekly."
^TIU(8925,10,"TEXT",23,0)="2. Diabetic neuropathy: Worsening. Increase gabapentin to 600mg TID."
^TIU(8925,10,"TEXT",24,0)="3. CKD Stage 3b (eGFR 42): Declining from 55 last year. Refer nephrology."
^TIU(8925,10,"TEXT",25,0)="4. Proteinuria: Maximize ACE inhibitor dose. Consider adding finerenone."
^TIU(8925,10,"TEXT",26,0)="5. Diabetic retinopathy: Ophthalmology follow-up in 6 months."
^TIU(8925,10,"TEXT",27,0)="6. Hyperlipidemia: LDL above goal. Increase atorvastatin to 40mg."
^TIU(8925,10,"TEXT",28,0)="7. Podiatry referral for comprehensive foot care."
^TIU(8925,10,"TEXT",29,0)="8. Nutrition consult for carb counting and meal planning."
^TIU(8925,10,"TEXT",30,0)="9. Recheck A1C, BMP, lipids, microalbumin in 3 months."
^TIU(8925,11,0)="PROGRESS NOTE^4;DPT(^2^^^^3241116"
^TIU(8925,11,"TEXT",1,0)="CARDIOLOGY FOLLOW-UP"
^TIU(8925,11,"TEXT",2,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,11,"TEXT",3,0)=""
^TIU(8925,11,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,11,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,11,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,11,"TEXT",7,0)="Medication compliance good. No side effects reported."
^TIU(8925,11,"TEXT",8,0)=""
^TIU(8925,11,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,11,"TEXT",10,0)="General: No acute distress."
^TIU(8925,11,"TEXT",11,0)="JVP: Not elevated."
^TIU(8925,11,"TEXT",12,0)="Cardiovascular: Irregularly irregular rhythm. S1/S2 normal. No S3 or S4. Grade 2/6 systolic murmur at apex."
^TIU(8925,11,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,11,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,11,"TEXT",15,0)=""
^TIU(8925,11,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,11,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,11,"TEXT",18,0)=""
^TIU(8925,11,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,11,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,11,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,11,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,11,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,11,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
^TIU(8925,12,0)="PROGRESS NOTE^4;DPT(^2^^^^3241016"
^TIU(8925,12,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,12,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,12,"TEXT",3,0)=""
^TIU(8925,12,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,12,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,12,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,12,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,12,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,12,"TEXT",9,0)=""
^TIU(8925,12,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,12,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,12,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,12,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,12,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,12,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,12,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,12,"TEXT",17,0)=""
^TIU(8925,12,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,12,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,12,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,12,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,12,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,12,"TEXT",23,0)="5. Follow up in 3 months."
^TIU(8925,13,0)="PROGRESS NOTE^4;DPT(^2^^^^3250508"
^TIU(8925,13,"TEXT",1,0)="PRIMARY CARE VISIT"
^TIU(8925,13,"TEXT",2,0)="SUBJECTIVE: Patient presents for routine follow-up of chronic conditions."
^TIU(8925,13,"TEXT",3,0)="Reports compliance with medications. Denies new complaints."
^TIU(8925,13,"TEXT",4,0)="Sleep adequate. Appetite normal. Activity level stable."
^TIU(8925,13,"TEXT",5,0)=""
^TIU(8925,13,"TEXT",6,0)="OBJECTIVE:"
^TIU(8925,13,"TEXT",7,0)="General: Well-appearing, no acute distress."
^TIU(8925,13,"TEXT",8,0)="HEENT: PERRL, EOMI, oropharynx clear."
^TIU(8925,13,"TEXT",9,0)="Cardiovascular: RRR, no murmurs, rubs, or gallops."
^TIU(8925,13,"TEXT",10,0)="Lungs: Clear to auscultation bilaterally."
^TIU(8925,13,"TEXT",11,0)="Abdomen: Soft, non-tender, non-distended."
^TIU(8925,13,"TEXT",12,0)="Extremities: No edema. Pedal pulses palpable bilaterally."
^TIU(8925,13,"TEXT",13,0)=""
^TIU(8925,13,"TEXT",14,0)="ASSESSMENT AND PLAN:"
^TIU(8925,13,"TEXT",15,0)="Chronic conditions stable on current regimen."
^TIU(8925,13,"TEXT",16,0)="Medications reconciled. No changes indicated."
^TIU(8925,13,"TEXT",17,0)="Age-appropriate screening up to date."
^TIU(8925,13,"TEXT",18,0)="Continue current management. Follow up in 3 months."
^TIU(8925,14,0)="PROGRESS NOTE^5;DPT(^2^^^^3250512"
^TIU(8925,14,"TEXT",1,0)="POLYTRAUMA CLINIC NOTE"
^TIU(8925,14,"TEXT",2,0)="POLYTRAUMA/TBI CLINIC NOTE"
^TIU(8925,14,"TEXT",3,0)=""
^TIU(8925,14,"TEXT",4,0)="SUBJECTIVE: Patient presents for polytrauma follow-up."
^TIU(8925,14,"TEXT",5,0)="Reports ongoing headaches, 5-6 days per week, intensity 5-7/10."
^TIU(8925,14,"TEXT",6,0)="Persistent tinnitus bilateral, constant. Hearing aids in use."
^TIU(8925,14,"TEXT",7,0)="Chronic low back pain, worse with prolonged sitting. Rating 6/10."
^TIU(8925,14,"TEXT",8,0)="Sleep disrupted by nightmares 3-4 nights per week."
^TIU(8925,14,"TEXT",9,0)="Hypervigilance in crowds. Avoids loud noises."
^TIU(8925,14,"TEXT",10,0)="Memory and concentration difficulties affecting daily activities."
^TIU(8925,14,"TEXT",11,0)=""
^TIU(8925,14,"TEXT",12,0)="OBJECTIVE:"
^TIU(8925,14,"TEXT",13,0)="Neurological: Oriented x4. Cranial nerves intact."
^TIU(8925,14,"TEXT",14,0)="MoCA: 24/30 (deficits in delayed recall and executive function)."
^TIU(8925,14,"TEXT",15,0)="Audiometry: Bilateral sensorineural hearing loss, moderate severity."
^TIU(8925,14,"TEXT",16,0)="Tinnitus Handicap Inventory: 52/100 (moderate handicap)."
^TIU(8925,14,"TEXT",17,0)="Lumbar spine: Paravertebral tenderness. ROM limited by 30%."
^TIU(8925,14,"TEXT",18,0)="Straight leg raise negative bilaterally."
^TIU(8925,14,"TEXT",19,0)=""
^TIU(8925,14,"TEXT",20,0)="PCL-5: 48 (above threshold for probable PTSD)."
^TIU(8925,14,"TEXT",21,0)="PHQ-9: 15 (moderately severe depression)."
^TIU(8925,14,"TEXT",22,0)=""
^TIU(8925,14,"TEXT",23,0)="ASSESSMENT AND PLAN:"
^TIU(8925,14,"TEXT",24,0)="1. TBI: Persistent post-concussive symptoms. Continue topiramate for headache."
^TIU(8925,14,"TEXT",25,0)="2. Hearing loss: Hearing aids functioning well. Follow-up audiology in 6 months."
^TIU(8925,14,"TEXT",26,0)="3. Tinnitus: Trial of sound masking therapy. Tinnitus retraining referral."
^TIU(8925,14,"TEXT",27,0)="4. PTSD: Continue sertraline 100mg and prazosin 2mg QHS. Therapy ongoing."
^TIU(8925,14,"TEXT",28,0)="5. Chronic pain: Continue multimodal approach. PT referral for spine program."
^TIU(8925,14,"TEXT",29,0)="6. Neuropsychology testing recommended for cognitive rehabilitation planning."
^TIU(8925,14,"TEXT",30,0)="7. Interdisciplinary team conference scheduled."
^TIU(8925,14,"TEXT",31,0)="8. Follow up in 2 months."
^TIU(8925,15,0)="TELEPHONE NOTE^5;DPT(^2^^^^3240902"
^TIU(8925,15,"TEXT",1,0)="PULMONOLOGY FOLLOW-UP"
^TIU(8925,15,"TEXT",2,0)="PULMONOLOGY CLINIC NOTE"
^TIU(8925,15,"TEXT",3,0)=""
^TIU(8925,15,"TEXT",4,0)="SUBJECTIVE: Patient presents for COPD management."
^TIU(8925,15,"TEXT",5,0)="Reports 1 exacerbation in the last 3 months requiring oral steroids."
^TIU(8925,15,"TEXT",6,0)="Cough productive of white sputum daily. Dyspnea on exertion stable."
^TIU(8925,15,"TEXT",7,0)="Using rescue inhaler 2-3x per week. CPAP compliance reviewed."
^TIU(8925,15,"TEXT",8,0)="Denies hemoptysis, fever, or weight loss."
^TIU(8925,15,"TEXT",9,0)=""
^TIU(8925,15,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,15,"TEXT",11,0)="General: Speaking in full sentences without pause."
^TIU(8925,15,"TEXT",12,0)="Lungs: Decreased breath sounds at bases. Mild expiratory wheeze bilaterally."
^TIU(8925,15,"TEXT",13,0)="No accessory muscle use. No cyanosis."
^TIU(8925,15,"TEXT",14,0)="SpO2: 93% on room air."
^TIU(8925,15,"TEXT",15,0)=""
^TIU(8925,15,"TEXT",16,0)="PFTs (recent): FEV1 55% predicted. FEV1/FVC 0.62. DLCO 60% predicted."
^TIU(8925,15,"TEXT",17,0)=""
^TIU(8925,15,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,15,"TEXT",19,0)="1. COPD: GOLD Stage II, Group B. Continue tiotropium and PRN albuterol."
^TIU(8925,15,"TEXT",20,0)="2. Add ICS/LABA combination if exacerbation frequency increases."
^TIU(8925,15,"TEXT",21,0)="3. Smoking cessation: Patient quit 2 years ago. Reinforced counseling."
^TIU(8925,15,"TEXT",22,0)="4. Annual flu vaccine given today. Pneumovax up to date."
^TIU(8925,15,"TEXT",23,0)="5. Pulmonary rehab referral discussed. Follow up in 3 months."
