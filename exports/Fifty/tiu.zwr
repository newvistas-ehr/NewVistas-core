^TIU(8925,106,"TEXT",24,0)="4. Follow up in 1 year for annual exam or sooner as needed."
^TIU(8925,107,0)="PROGRESS NOTE^32;DPT(^2^^^^3251208"
^TIU(8925,107,"TEXT",1,0)="RHEUMATOLOGY FOLLOW-UP"
^TIU(8925,107,"TEXT",2,0)="RHEUMATOLOGY CLINIC NOTE"
^TIU(8925,107,"TEXT",3,0)=""
^TIU(8925,107,"TEXT",4,0)="SUBJECTIVE: Patient presents for rheumatoid arthritis follow-up."
^TIU(8925,107,"TEXT",5,0)="Joint stiffness in the morning lasting 30 minutes, improved from 90 minutes."
^TIU(8925,107,"TEXT",6,0)="Bilateral hand swelling has decreased. Able to open jars again."
^TIU(8925,107,"TEXT",7,0)="Fatigue moderate. No new joint involvement."
^TIU(8925,107,"TEXT",8,0)="Tolerating methotrexate well. Takes folic acid as prescribed."
^TIU(8925,107,"TEXT",9,0)=""
^TIU(8925,107,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,107,"TEXT",11,0)="Joints: Mild synovitis bilateral MCPs 2-3. No PIP swelling today."
^TIU(8925,107,"TEXT",12,0)="Wrists: Full ROM. No effusion."
^TIU(8925,107,"TEXT",13,0)="Knees: No effusion. Full ROM."
^TIU(8925,107,"TEXT",14,0)="Grip strength: 20 kg bilateral (improved from 15 kg)."
^TIU(8925,107,"TEXT",15,0)=""
^TIU(8925,107,"TEXT",16,0)="Labs: ESR 28 (prior 45). CRP 1.2 (prior 3.8). CBC normal. LFTs normal."
^TIU(8925,107,"TEXT",17,0)=""
^TIU(8925,107,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,107,"TEXT",19,0)="1. RA: Disease activity improving on current DMARD regimen. DAS28 2.8."
^TIU(8925,107,"TEXT",20,0)="2. Continue methotrexate 15mg weekly + hydroxychloroquine 200mg BID."
^TIU(8925,107,"TEXT",21,0)="3. Continue folic acid 1mg daily."
^TIU(8925,107,"TEXT",22,0)="4. Repeat labs (CBC, CMP, ESR, CRP) in 3 months."
^TIU(8925,107,"TEXT",23,0)="5. Follow up in 3 months. Consider biologic if plateau."
^TIU(8925,108,0)="PROGRESS NOTE^32;DPT(^2^^^^3250109"
^TIU(8925,108,"TEXT",1,0)="CARDIOLOGY FOLLOW-UP"
^TIU(8925,108,"TEXT",2,0)="CARDIOLOGY CLINIC NOTE"
^TIU(8925,108,"TEXT",3,0)=""
^TIU(8925,108,"TEXT",4,0)="SUBJECTIVE: Patient presents for cardiac follow-up."
^TIU(8925,108,"TEXT",5,0)="Denies chest pain, shortness of breath at rest, or palpitations."
^TIU(8925,108,"TEXT",6,0)="Can walk 2 blocks without symptoms. Orthopnea stable."
^TIU(8925,108,"TEXT",7,0)="Medication compliance good. No side effects reported."
^TIU(8925,108,"TEXT",8,0)=""
^TIU(8925,108,"TEXT",9,0)="OBJECTIVE:"
^TIU(8925,108,"TEXT",10,0)="General: No acute distress."
^TIU(8925,108,"TEXT",11,0)="JVP: Not elevated."
^TIU(8925,108,"TEXT",12,0)="Cardiovascular: Irregularly irregular rhythm. S1/S2 normal. No S3 or S4. Grade 2/6 systolic murmur at apex."
^TIU(8925,108,"TEXT",13,0)="Lungs: Clear bilaterally. No crackles or wheezes."
^TIU(8925,108,"TEXT",14,0)="Extremities: Trace pedal edema bilaterally."
^TIU(8925,108,"TEXT",15,0)=""
^TIU(8925,108,"TEXT",16,0)="Labs: BNP 185 pg/mL. BMP stable. INR 2.4 (therapeutic)."
^TIU(8925,108,"TEXT",17,0)="Echo (recent): LVEF 40%. Mild MR. Moderate LA dilation."
^TIU(8925,108,"TEXT",18,0)=""
^TIU(8925,108,"TEXT",19,0)="ASSESSMENT AND PLAN:"
^TIU(8925,108,"TEXT",20,0)="1. CHF: Stable NYHA Class II. Continue current HF regimen."
^TIU(8925,108,"TEXT",21,0)="2. Atrial fibrillation: Rate controlled. INR therapeutic."
^TIU(8925,108,"TEXT",22,0)="3. CAD: Continue statin and antiplatelet therapy."
^TIU(8925,108,"TEXT",23,0)="4. Repeat echo in 6 months. BNP in 3 months."
^TIU(8925,108,"TEXT",24,0)="5. Follow up in 3 months. Return sooner for worsening dyspnea, weight gain, or chest pain."
