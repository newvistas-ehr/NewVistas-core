^TIU(8925,164,0)="PROGRESS NOTE^47;DPT(^1^^^^3251216"
^TIU(8925,164,"TEXT",1,0)="NEUROLOGY FOLLOW-UP"
^TIU(8925,164,"TEXT",2,0)="NEUROLOGY CLINIC NOTE"
^TIU(8925,164,"TEXT",3,0)=""
^TIU(8925,164,"TEXT",4,0)="SUBJECTIVE: Patient presents for TBI follow-up."
^TIU(8925,164,"TEXT",5,0)="Reports persistent headaches 3-4 days per week, mild-moderate intensity."
^TIU(8925,164,"TEXT",6,0)="Some difficulty with concentration and short-term memory."
^TIU(8925,164,"TEXT",7,0)="Dizziness improved with vestibular therapy."
^TIU(8925,164,"TEXT",8,0)="Sleep disrupted by nightmares. Currently in MH treatment for PTSD."
^TIU(8925,164,"TEXT",9,0)=""
^TIU(8925,164,"TEXT",10,0)="OBJECTIVE:"
^TIU(8925,164,"TEXT",11,0)="Neuro exam: Alert and oriented x4. Cranial nerves II-XII intact."
^TIU(8925,164,"TEXT",12,0)="Motor: 5/5 strength all extremities."
^TIU(8925,164,"TEXT",13,0)="Sensory: Intact to light touch, pinprick, vibration."
^TIU(8925,164,"TEXT",14,0)="Coordination: Finger-to-nose and heel-to-shin normal."
^TIU(8925,164,"TEXT",15,0)="Gait: Normal. Romberg negative."
^TIU(8925,164,"TEXT",16,0)="Montreal Cognitive Assessment (MoCA): 25/30."
^TIU(8925,164,"TEXT",17,0)=""
^TIU(8925,164,"TEXT",18,0)="ASSESSMENT AND PLAN:"
^TIU(8925,164,"TEXT",19,0)="1. Post-concussive syndrome: Persistent but slowly improving."
^TIU(8925,164,"TEXT",20,0)="2. Continue headache prophylaxis with topiramate."
^TIU(8925,164,"TEXT",21,0)="3. Continue vestibular rehabilitation."
^TIU(8925,164,"TEXT",22,0)="4. Neuropsych testing scheduled for detailed cognitive assessment."
^TIU(8925,164,"TEXT",23,0)="5. Follow up in 3 months."
