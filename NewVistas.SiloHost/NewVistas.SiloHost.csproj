<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Server" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.Streaming" Version="10.1.0" />
    <PackageReference Include="Microsoft.Orleans.EventSourcing" Version="10.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewVistas.Abstractions\NewVistas.Abstractions.csproj" />
    <ProjectReference Include="..\NewVistas.PT\NewVistas.PT.csproj" />
    <ProjectReference Include="..\NewVistas.ServiceDefaults\NewVistas.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icd10cm-order-2023.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\OrleansMainSchema.sql" />
    <EmbeddedResource Include="Sql\OrleansClusteringSchema.sql" />
    <EmbeddedResource Include="Sql\OrleansPersistenceSchema.sql" />
    <EmbeddedResource Include="Sql\FederationOutboxSchema.sql" />
  </ItemGroup>

</Project>
