<Project>

  <!-- Shared version for all NewVistas projects (imported automatically by MSBuild).
       Bump VersionSuffix for each pre-release (beta.1 -> beta.2 -> rc.1);
       clear VersionSuffix entirely for the stable 1.0.0 release. -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta.4</VersionSuffix>
  </PropertyGroup>

</Project>
