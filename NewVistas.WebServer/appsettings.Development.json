{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Debug",
      "Orleans.Runtime": "Information"
    }
  },
  "ConnectionStrings": {
    "OrleansDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=NewVistasOrleans;Trusted_Connection=True;MultipleActiveResultSets=true",
    "SqlExpress": "Server=(localdb)\\MSSQLLocalDB;Database=NewVistasDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "ImageStorage": {
    "Provider": "Filesystem",
    "Filesystem": {
      "RootPath": "./ImageStore",
      "SigningKey": "dev-only-change-in-prod-newvistas-imaging-signing-key",
      "SignedLinkLifetimeMinutes": 10,
      "PublicBaseUrl": "https://localhost:7127"
    }
  }
}

