<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.Orleans.Client" Version="10.2.1" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.2.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewVistas.Abstractions\NewVistas.Abstractions.csproj" />
    <ProjectReference Include="..\NewVistas.ImageStorage\NewVistas.ImageStorage.csproj" />
    <ProjectReference Include="..\NewVistas.PT\NewVistas.PT.csproj" />
    <ProjectReference Include="..\NewVistas.ServiceDefaults\NewVistas.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icd10cm-order-2023.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sql\OrleansMainSchema.sql" />
    <EmbeddedResource Include="Sql\OrleansClusteringSchema.sql" />
    <EmbeddedResource Include="Sql\OrleansPersistenceSchema.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SeedData\*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
