<Window x:Class="NewVistas.StartInBackground.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewVistas.StartInBackground"
        mc:Ignorable="d"
        Title="NewVistas Launcher" Height="640" Width="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="NewVistas Launcher" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- SiloHost Options -->
        <GroupBox Grid.Row="1" Header="SiloHost" Margin="0,0,0,10" Padding="8">
            <CheckBox x:Name="UseSqlExpressCheckBox" Content="Use SQL Express (unchecked = in-memory)" IsChecked="False"/>
        </GroupBox>

        <!-- Delay Settings -->
        <GroupBox Grid.Row="2" Header="Startup Delays (seconds)" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="After SiloHost:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SiloDelayTextBox" Grid.Column="1" Text="15" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="After WebServer:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox x:Name="WebDelayTextBox" Grid.Column="3" Text="10" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- UI Selection -->
        <GroupBox Grid.Row="3" Header="Frontend" Margin="0,0,0,10" Padding="8">
            <StackPanel>
                <RadioButton x:Name="BlazorRadio" Content="Blazor Web (NewVistas.BlazorWeb)" IsChecked="True" Margin="0,2"/>
                <RadioButton x:Name="CharUIRadio" Content="Character UI (NewVistas.CharUI)" Margin="0,2"/>
                <RadioButton x:Name="PatientPortalRadio" Content="Patient Portal (NewVistas.PatientPortal)" Margin="0,2"/>
                <RadioButton x:Name="WpfDelphiRadio" Content="WPF Delphi UI (NewVistas.WpfDelphiUI)" Margin="0,2"/>
                <RadioButton x:Name="WpfUIRadio" Content="WPF UI (NewVistas.Wpf_UI)" Margin="0,2"/>
                <RadioButton x:Name="NoUIRadio" Content="None (SiloHost + WebServer only)" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <!-- Status -->
        <GroupBox Grid.Row="4" Header="Status" Margin="0,0,0,10" Padding="8">
            <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" Foreground="Gray"/>
        </GroupBox>

        <!-- Log -->
        <TextBox Grid.Row="5" x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="StopButton" Content="Stop All" Width="90" Height="30" Margin="0,0,8,0"
                    Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="LaunchButton" Content="Launch" Width="90" Height="30"
                    Click="LaunchButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
