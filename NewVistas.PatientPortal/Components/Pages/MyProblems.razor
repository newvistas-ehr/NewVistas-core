@page "/my-problems"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>My Health Conditions</PageTitle>
<h1>My Health Conditions</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (loading) { <p>Loading...</p> }
else if (items.Count == 0) { <p class="empty-state">No health conditions on record.</p> }
else
{
    <table class="health-table">
        <thead><tr><th>Condition</th><th>ICD Code</th><th>Status</th><th>Onset Date</th></tr></thead>
        <tbody>
            @foreach (ProblemDto p in items)
            {
                <tr>
                    <td>@(p.ProblemName ?? "—")</td>
                    <td>@(p.IcdCode ?? "—")</td>
                    <td><span class="badge status-@(p.Status?.ToLowerInvariant() ?? "unknown")">@(p.Status ?? "—")</span></td>
                    <td>@(p.OnsetDate ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    bool loading = true;
    string? error;
    List<ProblemDto> items = new();

    protected override async Task OnInitializedAsync()
    {
        try { items = await Http.GetFromJsonAsync<List<ProblemDto>>("api/my/health/problems") ?? new(); }
        catch (Exception ex) { error = $"Error: {ex.Message}"; }
        finally { loading = false; }
    }

    private class ProblemDto
    {
        public string? ProblemName { get; set; }
        public string? IcdCode { get; set; }
        public string? Status { get; set; }
        public string? OnsetDate { get; set; }
    }
}

<style>
    .health-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .health-table th { background: #f1f8f4; text-align: left; padding: .5rem .6rem; border-bottom: 2px solid #d4e8db; }
    .health-table td { padding: .4rem .6rem; border-bottom: 1px solid #eee; }
    .health-table tr:hover td { background: #f5faf7; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: 3px; font-size: .78rem; font-weight: 600; }
    .status-active { background: #d4edda; color: #155724; }
    .status-inactive { background: #e9ecef; color: #495057; }
    .status-resolved { background: #cce5ff; color: #004085; }
    .status-unknown { background: #e9ecef; color: #495057; }
    .empty-state { color: #888; font-style: italic; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: .5rem .75rem; border-radius: 4px; margin-bottom: .5rem; }
</style>
