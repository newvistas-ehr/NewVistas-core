@page "/my-pharmacy"
@rendermode InteractiveServer
@using NewVistas.PatientPortal.Controllers
@inject HttpClient Http

<PageTitle>My Pharmacy</PageTitle>
<h1>My Pharmacy</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }

@if (loading) { <p>Loading...</p> }
else
{
    <p class="intro">
        Choose the pharmacy where you'd like your prescriptions sent. Your care team uses this as
        your default — you can still ask them to send a specific prescription somewhere else.
    </p>

    <div class="current">
        <span class="current-label">Your default pharmacy:</span>
        @if (preferred is null)
        {
            <span class="none">none selected yet</span>
        }
        else
        {
            <span class="pref">@preferred.Name@(string.IsNullOrEmpty(preferred.City) ? "" : $" — {preferred.City}, {preferred.State}")</span>
        }
    </div>

    @if (options.Count == 0)
    {
        <p class="empty-state">No pharmacies are available right now.</p>
    }
    else
    {
        <ul class="pharmacy-list">
            @foreach (PharmacyOptionDto p in options)
            {
                <li class="@(p.PharmacyId == preferred?.PharmacyId ? "selected" : "")">
                    <div class="pinfo">
                        <span class="pname">@p.Name</span>
                        <span class="pmeta">
                            @KindLabel(p.Kind)@(string.IsNullOrEmpty(p.City) ? "" : $" · {p.City}, {p.State}")@(string.IsNullOrEmpty(p.Phone) ? "" : $" · {p.Phone}")
                        </span>
                    </div>
                    @if (p.PharmacyId == preferred?.PharmacyId)
                    {
                        <span class="badge">Default</span>
                    }
                    else
                    {
                        <button class="btn-set" @onclick="() => SetPreferred(p)" disabled="@saving">Make default</button>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private List<PharmacyOptionDto> options = new();
    private PharmacyOptionDto? preferred;
    private bool loading = true, saving;
    private string? error, success;

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        loading = true; error = null;
        try
        {
            options = await Http.GetFromJsonAsync<List<PharmacyOptionDto>>("api/my/pharmacy/options") ?? new();
            preferred = await Http.GetFromJsonAsync<PharmacyOptionDto?>("api/my/pharmacy/preferred");
        }
        catch (Exception ex) { error = $"Could not load pharmacies: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task SetPreferred(PharmacyOptionDto p)
    {
        saving = true; error = null; success = null;
        try
        {
            HttpResponseMessage resp = await Http.PutAsync($"api/my/pharmacy/preferred/{p.PharmacyId}", null);
            resp.EnsureSuccessStatusCode();
            preferred = p;
            success = $"{p.Name} is now your default pharmacy.";
        }
        catch (Exception ex) { error = $"Could not update your pharmacy: {ex.Message}"; }
        finally { saving = false; }
    }

    private static string KindLabel(string kind) => kind switch
    {
        "MAIL" => "Mail order",
        "SPECIALTY" => "Specialty",
        "INPATIENT" => "Hospital",
        _ => "Retail"
    };
}

<style>
    .intro { color: #555; font-size: .9rem; margin-bottom: 1rem; max-width: 640px; }
    .current { margin-bottom: 1rem; font-size: .95rem; }
    .current-label { color: #555; margin-right: .4rem; }
    .current .pref { font-weight: 700; color: #1d6b3f; }
    .current .none { color: #888; font-style: italic; }
    .pharmacy-list { list-style: none; padding: 0; margin: 0; max-width: 640px; }
    .pharmacy-list li { display: flex; align-items: center; gap: 1rem; padding: .6rem .75rem; border: 1px solid #e2e8e4; border-radius: 6px; margin-bottom: .5rem; background: #fff; }
    .pharmacy-list li.selected { border-color: #1d6b3f; background: #f1f8f4; }
    .pinfo { flex: 1; display: flex; flex-direction: column; }
    .pname { font-weight: 600; }
    .pmeta { color: #6b7280; font-size: .8rem; }
    .badge { background: #d4edda; color: #1d6b3f; font-size: .72rem; font-weight: 700; padding: 2px 8px; border-radius: 10px; }
    .btn-set { background: #1d6b3f; color: #fff; border: none; border-radius: 4px; padding: .35rem .8rem; font-size: .8rem; cursor: pointer; }
    .btn-set:disabled { background: #999; cursor: not-allowed; }
    .empty-state { color: #888; font-style: italic; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: .5rem .75rem; border-radius: 4px; margin-bottom: .5rem; }
    .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: .5rem .75rem; border-radius: 4px; margin-bottom: .5rem; }
</style>
