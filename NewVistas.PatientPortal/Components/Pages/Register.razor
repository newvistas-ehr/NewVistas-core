@page "/register"
@layout NewVistas.PatientPortal.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using NewVistas.PatientPortal.Services
@inject PatientAuthStateProvider AuthProvider
@inject NavigationManager Navigation

<div class="register-container">
    <div class="register-card">
        <h2>Create Your Account</h2>
        <p class="register-subtitle">MyHealth Patient Portal</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="form-group">
            <label>Patient ID *</label>
            <input type="text" @bind="patientId" @bind:event="oninput" disabled="@isLoading"
                   placeholder="Your patient ID from your care team" />
        </div>

        <div class="form-group">
            <label>Email Address *</label>
            <input type="email" @bind="email" @bind:event="oninput" disabled="@isLoading"
                   placeholder="your.email@example.com" />
        </div>

        <div class="form-group">
            <label>Display Name</label>
            <input type="text" @bind="displayName" @bind:event="oninput" disabled="@isLoading"
                   placeholder="How you'd like to be addressed" />
        </div>

        <div class="form-group">
            <label>Password * (at least 8 characters)</label>
            <input type="password" @bind="password" @bind:event="oninput" disabled="@isLoading" />
        </div>

        <div class="form-group">
            <label>Confirm Password *</label>
            <input type="password" @bind="confirmPassword" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" disabled="@isLoading" />
        </div>

        <button class="btn-register" @onclick="RegisterAsync" disabled="@isLoading">
            @if (isLoading) { <span>Creating account...</span> } else { <span>Create Account</span> }
        </button>

        <p class="login-link">
            Already have an account? <a href="/login">Sign in</a>
        </p>
    </div>
</div>

@code {
    private string patientId = string.Empty;
    private string email = string.Empty;
    private string? displayName;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string? error;
    private bool isLoading;

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RegisterAsync();
    }

    private async Task RegisterAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Patient ID, Email, and Password are required.";
            return;
        }
        if (password != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }
        if (password.Length < 8)
        {
            error = "Password must be at least 8 characters.";
            return;
        }

        isLoading = true;
        try
        {
            PatientLoginResult result = await AuthProvider.RegisterAsync(
                patientId.Trim(), email.Trim(), password, displayName?.Trim());
            if (result.Success)
                Navigation.NavigateTo("/", forceLoad: false);
            else
                error = result.Error ?? "Registration failed.";
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally { isLoading = false; }
    }
}

<style>
    .register-container { display: flex; justify-content: center; align-items: center; min-height: 80vh; }
    .register-card { background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 2rem; width: 400px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
    .register-card h2 { margin: 0 0 0.25rem; color: #1a6b3c; }
    .register-subtitle { color: #666; margin: 0 0 1.5rem; font-size: 0.9rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.25rem; font-weight: 600; font-size: 0.85rem; }
    .form-group input { width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; box-sizing: border-box; }
    .btn-register { width: 100%; padding: 0.6rem; background: #1a6b3c; color: #fff; border: none; border-radius: 4px; font-size: 1rem; cursor: pointer; }
    .btn-register:hover { background: #228b4a; }
    .btn-register:disabled { opacity: 0.6; cursor: not-allowed; }
    .alert-danger { background: #f8d7da; color: #842029; padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem; }
    .login-link { text-align: center; margin-top: 1rem; font-size: 0.85rem; color: #666; }
    .login-link a { color: #1a6b3c; font-weight: 600; }
</style>
