@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>MyHealth Dashboard</PageTitle>

<h1>Welcome to MyHealth Portal</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }

@if (loading)
{
    <p>Loading your health summary...</p>
}
else if (profile != null)
{
    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>My Profile</h3>
            <div class="card-body">
                <div><strong>Name:</strong> @(profile.PatientName ?? profile.DisplayName ?? "—")</div>
                @if (!string.IsNullOrEmpty(profile.DateOfBirth)) { <div><strong>Date of Birth:</strong> @profile.DateOfBirth</div> }
                <div><strong>Email:</strong> @(profile.Email ?? "—")</div>
                @if (profile.LastLoginDate.HasValue) { <div><strong>Last Login:</strong> @profile.LastLoginDate.Value.ToString("MM/dd/yyyy HH:mm")</div> }
            </div>
        </div>

        <div class="dashboard-card">
            <h3>Quick Links</h3>
            <div class="card-body quick-links">
                <a href="/my-submissions" class="quick-link">Submit Health Information</a>
                <a href="/my-messages" class="quick-link">Send a Message</a>
                <a href="/my-medications" class="quick-link">View Medications</a>
                <a href="/my-vitals" class="quick-link">View Vitals</a>
            </div>
        </div>

        <div class="dashboard-card">
            <h3>Recent Submissions (@submissions.Count)</h3>
            <div class="card-body">
                @if (submissions.Count == 0)
                {
                    <p class="empty-state">No submissions yet.</p>
                }
                else
                {
                    @foreach (SubmissionDto s in submissions.Take(5))
                    {
                        <div class="list-item">
                            <span class="badge badge-status status-@s.Status">@s.Status</span>
                            <span>@s.SubmittedDate.ToString("MM/dd/yyyy") — @s.SectionCount sections</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="dashboard-card">
            <h3>Unread Messages (@unreadThreads.Count)</h3>
            <div class="card-body">
                @if (unreadThreads.Count == 0)
                {
                    <p class="empty-state">No unread messages.</p>
                }
                else
                {
                    @foreach (ThreadDto t in unreadThreads.Take(5))
                    {
                        <div class="list-item">
                            <span class="badge badge-category">@t.Category</span>
                            <a href="/my-messages">@t.Subject</a>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    bool loading = true;
    string? error;
    ProfileDto? profile;
    List<SubmissionDto> submissions = new();
    List<ThreadDto> unreadThreads = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Http.GetFromJsonAsync<ProfileDto>("api/patient-auth/me");
            submissions = await Http.GetFromJsonAsync<List<SubmissionDto>>("api/my/submissions") ?? new();
            unreadThreads = await Http.GetFromJsonAsync<List<ThreadDto>>("api/my/messages/threads/unread") ?? new();
        }
        catch (Exception ex)
        {
            error = $"Error loading dashboard: {ex.Message}";
        }
        finally { loading = false; }
    }

    private class ProfileDto
    {
        public string PatientId { get; set; } = "";
        public string? DisplayName { get; set; }
        public string? Email { get; set; }
        public string? PatientName { get; set; }
        public string? DateOfBirth { get; set; }
        public DateTime? LastLoginDate { get; set; }
    }

    private class SubmissionDto
    {
        public string SubmissionId { get; set; } = "";
        public DateTime SubmittedDate { get; set; }
        public string Status { get; set; } = "";
        public int SectionCount { get; set; }
    }

    private class ThreadDto
    {
        public string ThreadId { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Category { get; set; } = "";
        public DateTime LastMessageDate { get; set; }
    }
}

<style>
    .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .dashboard-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; padding: 1rem; }
    .dashboard-card h3 { margin: 0 0 .75rem; font-size: 1rem; color: #1a6b3c; border-bottom: 1px solid #eee; padding-bottom: .5rem; }
    .card-body { font-size: .9rem; }
    .quick-links { display: flex; flex-direction: column; gap: .5rem; }
    .quick-link { display: block; padding: .5rem .75rem; background: #f1f8f4; border: 1px solid #d4e8db; border-radius: 4px; color: #1a6b3c; text-decoration: none; font-weight: 600; }
    .quick-link:hover { background: #e0f0e6; }
    .list-item { display: flex; align-items: center; gap: .5rem; padding: .3rem 0; border-bottom: 1px solid #f0f0f0; }
    .list-item:last-child { border-bottom: none; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: 3px; font-size: .75rem; font-weight: 600; }
    .badge-category { background: #e9ecef; color: #495057; }
    .badge-status.status-submitted { background: #fff3cd; color: #856404; }
    .badge-status.status-under-review { background: #cce5ff; color: #004085; }
    .badge-status.status-accepted { background: #d4edda; color: #155724; }
    .badge-status.status-partial { background: #ffeaa7; color: #6c5c00; }
    .badge-status.status-rejected { background: #f8d7da; color: #721c24; }
    .empty-state { color: #888; font-style: italic; }
    .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; padding: .5rem .75rem; border-radius: 4px; margin-bottom: .5rem; }
</style>
