<Window x:Class="NewVistas.Wpf_UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NewVistas.Wpf_UI.ViewModels"
        mc:Ignorable="d"
        Title="NewVistas Clinical Information System"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#003f72">
            <DockPanel Margin="16,0">
                <!-- Right side: user info + Sign Out -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AuthService.DisplayName}" Foreground="#aac4df"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Command="{Binding LogoutCommand}" Content="Sign Out"
                            Background="Transparent" Foreground="White" BorderBrush="#5580a0"
                            BorderThickness="1" Padding="10,4" FontSize="11" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a4f72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Left side: branding + patient ID -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NewVistas" FontSize="16" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" — Clinical Information System" FontSize="13" Foreground="#aac4df"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <!-- Patient ID input in header (shared across all views) -->
                    <Separator Width="1" Background="#5580a0" Margin="20,8"/>
                    <TextBlock Text="Patient:" Foreground="#aac4df" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox Text="{Binding PatientContext.PatientId, UpdateSourceTrigger=PropertyChanged}"
                             Width="180" Margin="4,0"
                             VerticalAlignment="Center"
                             Padding="4,3"
                             FontSize="12"
                             Background="#1a4f72"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#5580a0"/>
                    <Button Content="&#x1F50D;" Command="{Binding SearchPatientCommand}"
                            CommandParameter="{Binding PatientContext.PatientId}"
                            Background="Transparent" Foreground="White" BorderThickness="0"
                            FontSize="14" Cursor="Hand" VerticalAlignment="Center" Margin="4,0"
                            ToolTip="Search patients by name">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="4,2" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1a4f72"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="#f4f6f9" BorderBrush="#d4d9e0" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding NavSections}" Margin="0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavSection}">
                                <StackPanel>
                                    <!-- Section header (empty string = no header shown) -->
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="#8899aa"
                                               Margin="12,8,0,2"
                                               Visibility="{Binding Title, Converter={StaticResource NullToVisibility}}"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                                <Button Command="{Binding DataContext.NavigateCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource NavButtonStyle}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Main content area — resolved by DataTemplates in theme -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="20"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
