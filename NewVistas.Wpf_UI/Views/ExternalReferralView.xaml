<UserControl x:Class="NewVistas.Wpf_UI.Views.ExternalReferralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="External Referrals"/>

            <!-- Feature disabled banner -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="3"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsFeatureEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="External Referral tracking is not currently enabled for this site."
                           Foreground="#856404" FontSize="13"/>
            </Border>

            <!-- Error / Success -->
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="{StaticResource VaSuccessBrush}" FontSize="13" Margin="0,0,0,8"
                       Text="{Binding SuccessMessage}"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="New Referral" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleNewFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- New Referral Form -->
            <Border Background="{StaticResource VaLightBlueBrush}" BorderBrush="{StaticResource VaBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding ShowNewForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Create New Referral"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" SelectedItem="{Binding ReferralType}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="SPECIALTY" IsSelected="True"/>
                            <ComboBoxItem Content="DIAGNOSTIC"/>
                            <ComboBoxItem Content="SURGICAL"/>
                            <ComboBoxItem Content="BEHAVIORAL_HEALTH"/>
                            <ComboBoxItem Content="REHABILITATION"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Facility Name:*" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FacilityName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Provider Name:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Purpose:*" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Diagnosis:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Urgency:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectedItem="{Binding Urgency}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="ROUTINE" IsSelected="True"/>
                            <ComboBoxItem Content="URGENT"/>
                            <ComboBoxItem Content="STAT"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Auth Number:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding AuthNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Special Instructions:" VerticalAlignment="Top" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding SpecialInstructions, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" Width="300" Height="60" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"/>
                    </Grid>

                    <Button Content="Create Referral" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateReferralCommand}" Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Referrals DataGrid -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Referrals"/>
            <DataGrid ItemsSource="{Binding Referrals}" AutoGenerateColumns="False"
                      IsReadOnly="True" MaxHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding ReferralType}" Width="120"/>
                    <DataGridTextColumn Header="Facility" Binding="{Binding ExternalFacilityName}" Width="180"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Urgency" Binding="{Binding Urgency}" Width="90"/>
                    <DataGridTextColumn Header="Referral Date" Binding="{Binding ReferralDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Appointment" Binding="{Binding AppointmentDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ReferredByProviderName}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Follow-Up" Binding="{Binding RequiresFollowUp}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
