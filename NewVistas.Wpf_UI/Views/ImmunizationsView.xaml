<UserControl x:Class="NewVistas.Wpf_UI.Views.ImmunizationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Immunizations"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Immunizations" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Record Immunization" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRecordFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRecordForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Record Immunization"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Vaccine Name"/>
                    <TextBox Text="{Binding VaccineName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="CVX Code (optional)"/>
                    <TextBox Text="{Binding CvxCode, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Lot Number"/>
                    <TextBox Text="{Binding LotNumber, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Site"/>
                    <ComboBox ItemsSource="{Binding SiteOptions}" SelectedItem="{Binding Site}" Width="200" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RecordImmunizationCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRecordFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Immunizations}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vaccine" Binding="{Binding VaccineName}" Width="*"/>
                    <DataGridTextColumn Header="CVX" Binding="{Binding CvxCode}" Width="70"/>
                    <DataGridTextColumn Header="Date Given" Binding="{Binding AdministeredDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Site" Binding="{Binding AdministrationSite}" Width="100"/>
                    <DataGridTextColumn Header="Lot" Binding="{Binding LotNumber}" Width="120"/>
                    <DataGridTextColumn Header="Administered By" Binding="{Binding AdministeredByName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
