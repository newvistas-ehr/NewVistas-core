<UserControl x:Class="NewVistas.Wpf_UI.Views.InfectionControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Infection Control"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="HAI Cases"/>
            <DataGrid ItemsSource="{Binding Cases}" AutoGenerateColumns="False" MaxHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="HAI Type" Binding="{Binding HaiType}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Onset Date" Binding="{Binding OnsetDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                    <DataGridTextColumn Header="Pathogen" Binding="{Binding Pathogen}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Outbreaks" Margin="0,12,0,0"/>
            <DataGrid ItemsSource="{Binding Outbreaks}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Outbreak Name" Binding="{Binding OutbreakName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Cases" Binding="{Binding CaseCount}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
