<UserControl x:Class="NewVistas.Wpf_UI.Views.LexiconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Lexicon Utility"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <!-- Search Section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Search"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SearchSystem}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Search" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <Button Content="Seed Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" MaxHeight="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120"/>
                    <DataGridTextColumn Header="System" Binding="{Binding System}" Width="80"/>
                    <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="*"/>
                    <DataGridTextColumn Header="FSN" Binding="{Binding Fsn}" Width="200"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTextColumn Header="Semantic Type" Binding="{Binding SemanticType}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Lookup Section -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Code Lookup" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <ComboBox ItemsSource="{Binding Systems}" SelectedItem="{Binding LookupSystem}" Width="120" Margin="0,0,8,0"/>
                <TextBox Text="{Binding LookupCode, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0"/>
                <Button Content="Lookup" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LookupCommand}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding LookupResult, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Code: " Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding LookupResult.Code}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="System: " Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding LookupResult.System}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Designation: " Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding LookupResult.Designation}" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
