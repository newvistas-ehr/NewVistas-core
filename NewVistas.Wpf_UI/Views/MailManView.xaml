<UserControl x:Class="NewVistas.Wpf_UI.Views.MailManView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="MailMan — VA Messaging System"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="User ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Load Messages" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadMessagesCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding UnreadCount, StringFormat=Unread: {0}}" VerticalAlignment="Center"
                           FontWeight="SemiBold" Margin="8,0,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Folder tabs -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Inbox" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SwitchFolderCommand}" CommandParameter="inbox" Margin="0,0,4,0"/>
                <Button Content="Sent" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SwitchFolderCommand}" CommandParameter="sent" Margin="0,0,4,0"/>
                <Button Content="Deleted" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SwitchFolderCommand}" CommandParameter="deleted"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                    <DataGridTextColumn Header="From" Binding="{Binding From}" Width="140"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedMessage, Converter={StaticResource NullToVisibility}}">
                <Button Content="Toggle Read" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleReadCommand}" Margin="0,0,8,0"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteMessageCommand}"/>
            </StackPanel>

            <!-- Compose -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Compose Message" Margin="0,16,0,0"/>
            <Border Style="{StaticResource FormPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="To"/>
                            <TextBox Text="{Binding ComposeTo, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="CC"/>
                            <TextBox Text="{Binding ComposeCc, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Priority"/>
                            <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding ComposePriority}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Subject"/>
                    <TextBox Text="{Binding ComposeSubject, UpdateSourceTrigger=PropertyChanged}" Width="500" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Body"/>
                    <TextBox Text="{Binding ComposeBody, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="100" TextWrapping="Wrap"/>
                    <CheckBox Content="Confidential" IsChecked="{Binding ComposeConfidential}" Margin="0,8,0,0"/>
                    <Button Content="Send" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SendMessageCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Mail Groups -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Mail Groups" Margin="0,16,0,0"/>
            <Button Content="Load Groups" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadGroupsCommand}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
            <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" MaxHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Members" Binding="{Binding Members}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource FormPanel}" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding NewGroupDescription, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding GroupTypes}" SelectedItem="{Binding NewGroupType}" Width="100" Margin="0,0,8,0"/>
                    <Button Content="Create Group" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CreateGroupCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
