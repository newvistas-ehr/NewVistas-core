<UserControl x:Class="NewVistas.Wpf_UI.Views.DrugFormularyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="24,24,8,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Drug Formulary (NDF)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <CheckBox Content="Formulary Only" IsChecked="{Binding FormularyOnly}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CheckBox Content="Active Only" IsChecked="{Binding ActiveOnly}"
                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Search" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="100" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedEntry}" Height="500">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="VA Product Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Generic" Binding="{Binding VaGenericName}" Width="160"/>
                    <DataGridTextColumn Header="Form" Binding="{Binding DosageFormName}" Width="100"/>
                    <DataGridTextColumn Header="Strength" Binding="{Binding Strength}" Width="80"/>
                    <DataGridTextColumn Header="Class" Binding="{Binding PrimaryDrugClassCode}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Formulary" Binding="{Binding FormularyIndicator}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Selected product detail -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,24,24,24">
            <StackPanel Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding SelectedProduct.Name}" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="VA Generic Name"/>
                <TextBlock Text="{Binding SelectedProduct.VaGenericName}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Dosage Form"/>
                <TextBlock Text="{Binding SelectedProduct.DosageFormName}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Strength"/>
                <TextBlock Text="{Binding SelectedProduct.Strength}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Class"/>
                <TextBlock Text="{Binding SelectedProduct.PrimaryDrugClassName}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Formulary"/>
                <TextBlock Text="{Binding SelectedProduct.FormularyIndicator}"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="CS Schedule"/>
                <TextBlock Text="{Binding SelectedProduct.ControlledSubstanceSchedule}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
