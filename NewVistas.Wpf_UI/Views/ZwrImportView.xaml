<UserControl x:Class="NewVistas.Wpf_UI.Views.ZwrImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="ZWR Import Tool"/>
            <TextBlock Text="Import VistA MUMPS global exports (.zwr files) into NewVistas grains."
                       FontSize="13" Margin="0,0,0,16"/>

            <!-- Error display -->
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <!-- Folder selection -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Source Directory"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                <TextBox Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="500" IsReadOnly="True" Margin="0,0,8,0"/>
                <Button Content="Browse..." Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseFolderCommand}" Margin="0,0,8,0"/>
                <Button Content="Import" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ImportCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Import log -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Import Log"/>
            <TextBox x:Name="LogBox"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="400"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="#1e1e2e"
                     Foreground="#c6d0f5"
                     Padding="8"
                     Margin="0,4,0,0"
                     TextChanged="LogBox_TextChanged"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
