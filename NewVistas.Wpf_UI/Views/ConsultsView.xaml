<UserControl x:Class="NewVistas.Wpf_UI.Views.ConsultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Consults"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Consults" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Request Consult" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRequestFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Request form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRequestForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Request Consult"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Service"/>
                    <TextBox Text="{Binding ToService, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reason"/>
                    <TextBox Text="{Binding ReasonForRequest, UpdateSourceTrigger=PropertyChanged}"
                             Width="400" HorizontalAlignment="Left" AcceptsReturn="True" Height="80"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Urgency"/>
                    <ComboBox ItemsSource="{Binding UrgencyOptions}" SelectedItem="{Binding Urgency}"
                              Width="160" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Submit" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RequestConsultCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRequestFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Consults}" SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Service" Binding="{Binding ToService}" Width="160"/>
                    <DataGridTextColumn Header="Provisional Dx" Binding="{Binding ProvisionalDiagnosis}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Urgency" Binding="{Binding Urgency}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding RequestDateTime, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedConsult, Converter={StaticResource NullToVisibility}}">
                <Button Content="Accept" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AcceptConsultCommand}" Margin="0,0,8,0"/>
                <Button Content="Complete" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteConsultCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
