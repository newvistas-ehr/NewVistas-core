<UserControl x:Class="NewVistas.Wpf_UI.Views.BeneficiaryTravelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Beneficiary Travel"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Claims" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ File Claim" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleFileFormCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- File Claim Form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowFileForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="File Travel Claim"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Travel Date"/>
                    <DatePicker SelectedDate="{Binding TravelDate}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mileage"/>
                    <TextBox Text="{Binding Mileage, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
                    <CheckBox Content="Round Trip" IsChecked="{Binding RoundTrip}" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Transport Mode"/>
                    <ComboBox ItemsSource="{Binding TransportModes}" SelectedItem="{Binding TransportMode}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Origin Address"/>
                    <TextBox Text="{Binding OriginAddress, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Destination Address"/>
                    <TextBox Text="{Binding DestinationAddress, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <CheckBox Content="Deductible Exempt" IsChecked="{Binding DeductibleExempt}" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Submit Claim" Style="{StaticResource PrimaryButton}"
                                Command="{Binding FileClaimCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleFileFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Claims}" SelectedItem="{Binding SelectedClaim}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Travel Date" Binding="{Binding TravelDate}" Width="110"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ClaimType}" Width="100"/>
                    <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                    <DataGridTextColumn Header="Miles" Binding="{Binding Miles}" Width="80"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedClaim, Converter={StaticResource NullToVisibility}}">
                <Button Content="Approve" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApproveClaimCommand}" Margin="0,0,8,0"/>
                <Button Content="Deny" Style="{StaticResource DangerButton}"
                        Command="{Binding DenyClaimCommand}" Margin="0,0,8,0"/>
                <Button Content="Pay" Style="{StaticResource SecondaryButton}"
                        Command="{Binding PayClaimCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
