<UserControl x:Class="NewVistas.Wpf_UI.Views.RemindersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Clinical Reminders"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Reminders" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Create Reminder" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleCreateFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Create Reminder"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reminder Name"/>
                    <TextBox Text="{Binding NewReminderName, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Due Date"/>
                    <DatePicker SelectedDate="{Binding NewDueDate}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Priority"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding NewPriority}" Width="160" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Create" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateReminderCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleCreateFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Reminders}" SelectedItem="{Binding SelectedReminder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Reminder" Binding="{Binding ReminderName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Completed" Binding="{Binding CompletedDate, StringFormat=d}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Complete Reminder" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CompleteReminderCommand}"
                    Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding SelectedReminder, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
