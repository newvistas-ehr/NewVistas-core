<UserControl x:Class="NewVistas.Wpf_UI.Views.AmbulatoryCopayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Ambulatory Copay Check-Off Sheet"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Text="{Binding SheetIdInput, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0"/>
                <Button Content="Load Sheet" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Sheet.ChecklistItems}" AutoGenerateColumns="False" IsReadOnly="True" Height="300"
                      Visibility="{Binding Sheet, Converter={StaticResource NullToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding ItemCode}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding ItemDescription}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Checked" Binding="{Binding IsChecked}" Width="80"/>
                    <DataGridTextColumn Header="Checked By" Binding="{Binding CheckedByUserName}" Width="140"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CheckedDateTime, StringFormat=g}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding Sheet, Converter={StaticResource NullToVisibility}}">
                <Button Content="Check Item" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckItemCommand}" Margin="0,0,8,0"/>
                <Button Content="Complete Sheet" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteSheetCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
