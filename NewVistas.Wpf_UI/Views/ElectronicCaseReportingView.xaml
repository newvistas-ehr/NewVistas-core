<UserControl x:Class="NewVistas.Wpf_UI.Views.ElectronicCaseReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Electronic Case Reporting (eCR)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Cases" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Triggers" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadTriggersCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Cases}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Case ID" Binding="{Binding CaseId}" Width="160"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Condition" Binding="{Binding ConditionName}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Triggers" FontWeight="Bold" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding Triggers}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Trigger ID" Binding="{Binding TriggerId}" Width="160"/>
                    <DataGridTextColumn Header="Condition" Binding="{Binding ConditionName}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
