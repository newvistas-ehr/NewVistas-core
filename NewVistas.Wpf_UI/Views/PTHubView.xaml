<UserControl x:Class="NewVistas.Wpf_UI.Views.PTHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900">
            <TextBlock Style="{StaticResource PageTitle}" Text="Physical Therapy"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Load Body Groups" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- PT Feature Navigation -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="🧙 Measurement Wizard" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartWizardCommand}" Margin="0,0,8,0" Padding="12,8"/>
                <Button Content="🎯 Goals" Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateToGoalsCommand}" Margin="0,0,8,0" Padding="12,8"/>
                <Button Content="🏠 Home Exercises" Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateToHomeExercisesCommand}" Margin="0,0,8,0" Padding="12,8"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Select a Body Group"/>
            <TextBlock Text="Click a body group to record ROM and strength measurements or view session history."
                       FontSize="12" Foreground="Gray" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding BodyGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectBodyGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Width="170" Height="80" Margin="4"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="White" BorderBrush="#D4D9E0" BorderThickness="1"
                                            CornerRadius="6" Padding="8">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <TextBlock Text="Has Data" FontSize="10" Foreground="#166534"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                                       Visibility="{Binding HasData, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasData}" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#003F72"/>
                                            <Setter TargetName="Bd" Property="Background" Value="#F4F6F9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
