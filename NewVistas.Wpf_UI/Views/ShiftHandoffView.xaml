<UserControl x:Class="NewVistas.Wpf_UI.Views.ShiftHandoffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Nursing Shift Handoff"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Handoffs" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Handoffs}" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding ShiftDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Shift" Binding="{Binding Shift}" Width="80"/>
                    <DataGridTextColumn Header="Outgoing" Binding="{Binding OutgoingNurseName}" Width="*"/>
                    <DataGridTextColumn Header="Incoming" Binding="{Binding IncomingNurseName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Create Handoff" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CreateHandoffCommand}" Margin="0,0,8,0"/>
                <Button Content="Complete" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteHandoffCommand}" Margin="0,0,8,0"/>
                <Button Content="Acknowledge" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AcknowledgeHandoffCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
