<UserControl x:Class="NewVistas.Wpf_UI.Views.AutoEligibilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Auto Eligibility Determination"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Existing" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Run Determination" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RunDeterminationCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding Determination, Converter={StaticResource NullToVisibility}}" MaxWidth="500">
                <TextBlock Text="{Binding Determination.DeterminationResult, StringFormat='Result: {0}'}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Determination.DeterminationDate, StringFormat='Date: {0:g}'}"/>
                <TextBlock Text="{Binding Determination.IncomeCategory, StringFormat='Income Category: {0}'}"/>
                <TextBlock Text="{Binding Determination.CopayExempt, StringFormat='Copay Exempt: {0}'}"/>
                <TextBlock Text="{Binding Determination.MeansTestRequired, StringFormat='Means Test Required: {0}'}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
