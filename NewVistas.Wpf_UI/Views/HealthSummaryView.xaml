<UserControl x:Class="NewVistas.Wpf_UI.Views.HealthSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Health Summary"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Saved Summaries"/>
                    <DataGrid ItemsSource="{Binding Summaries}" SelectedItem="{Binding SelectedSummary}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="*"/>
                            <DataGridTextColumn Header="Generated" Binding="{Binding GeneratedDate, StringFormat=d}" Width="120"/>
                            <DataGridTextColumn Header="Provider" Binding="{Binding GeneratedByName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0"
                            Visibility="{Binding SummaryDetail, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Summary Content"/>
                    <TextBox Text="{Binding SummaryDetail.Content}" IsReadOnly="True"
                             TextWrapping="Wrap" MaxHeight="400" VerticalScrollBarVisibility="Auto"
                             Background="#f8f8f8" Padding="8"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
