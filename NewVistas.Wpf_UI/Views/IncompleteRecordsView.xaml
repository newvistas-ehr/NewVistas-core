<UserControl x:Class="NewVistas.Wpf_UI.Views.IncompleteRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Incomplete Records"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Provider ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Status:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Deficiencies}" SelectedItem="{Binding SelectedDeficiency}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="180"/>
                    <DataGridTextColumn Header="Deficiency Type" Binding="{Binding DeficiencyType}" Width="*"/>
                    <DataGridTextColumn Header="Days Outstanding" Binding="{Binding DaysOutstanding}" Width="120"/>
                    <DataGridTextColumn Header="Discharge Date" Binding="{Binding DischargeDate}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedDeficiency, Converter={StaticResource NullToVisibility}}">
                <Button Content="Complete" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CompleteCommand}" Margin="0,0,8,0"/>
                <Button Content="Waive" Style="{StaticResource SecondaryButton}"
                        Command="{Binding WaiveCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
