<UserControl x:Class="NewVistas.Wpf_UI.Views.RadTechView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Radiology Technologist Workflow"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Worklist" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Protocols" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadProtocolsCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Worklist.Items}" AutoGenerateColumns="False" IsReadOnly="True" Height="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Procedure" Binding="{Binding ProcedureName}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ImagingType}" Width="80"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientId}" Width="140"/>
                    <DataGridTextColumn Header="Urgency" Binding="{Binding Urgency}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding ExamStatus}" Width="100"/>
                    <DataGridTextColumn Header="Body Part" Binding="{Binding BodyPart}" Width="100"/>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedExam, Converter={StaticResource NullToVisibility}}">
                <Button Content="Mark Prepped" Style="{StaticResource PrimaryButton}"
                        Command="{Binding MarkPreppedCommand}" Margin="0,0,8,0"/>
                <Button Content="Start Exam" Style="{StaticResource SecondaryButton}"
                        Command="{Binding StartExamCommand}" Margin="0,0,8,0"/>
                <Button Content="Complete Exam" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CompleteExamCommand}"/>
            </StackPanel>

            <TextBlock Text="Protocols" FontWeight="Bold" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding Protocols}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Protocol" Binding="{Binding ProtocolName}" Width="*"/>
                    <DataGridTextColumn Header="Imaging Type" Binding="{Binding ImagingType}" Width="120"/>
                    <DataGridTextColumn Header="Body Part" Binding="{Binding BodyPart}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
