<UserControl x:Class="NewVistas.Wpf_UI.Views.DirectMessagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Direct Project Secure Messaging"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Addresses" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Messages" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadMessagesCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Addresses}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Direct Address" Binding="{Binding DirectAddress}" Width="*"/>
                    <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="160"/>
                    <DataGridTextColumn Header="Owner Type" Binding="{Binding OwnerType}" Width="100"/>
                    <DataGridTextColumn Header="Organization" Binding="{Binding OrganizationName}" Width="160"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Messages" FontWeight="Bold" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="From" Binding="{Binding FromAddress}" Width="*"/>
                    <DataGridTextColumn Header="To" Binding="{Binding ToAddress}" Width="*"/>
                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTextColumn Header="Sent" Binding="{Binding SentDate, StringFormat=g}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
