<UserControl x:Class="NewVistas.Wpf_UI.Views.DataSegmentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Data Segmentation for Privacy (DS4P)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Analyze C-CDA" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AnalyzeCcdaCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Existing" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Message ID"/>
            <TextBox Text="{Binding MessageId, UpdateSourceTrigger=PropertyChanged}" Width="400" Margin="0,0,0,8"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="C-CDA Content"/>
            <TextBox Text="{Binding CcdaContent, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="120" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <StackPanel Visibility="{Binding AnalysisResult, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="Analysis Results" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock Text="{Binding AnalysisResult.DocumentConfidentialityCode, StringFormat='Confidentiality: {0}'}"/>
                <TextBlock Text="{Binding AnalysisResult.HasDs4pTags, StringFormat='Has DS4P Tags: {0}'}"/>
                <TextBlock Text="{Binding AnalysisResult.AnalyzedDate, StringFormat='Analyzed: {0:g}'}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
