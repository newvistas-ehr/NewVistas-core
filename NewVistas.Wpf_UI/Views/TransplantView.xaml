<UserControl x:Class="NewVistas.Wpf_UI.Views.TransplantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Transplant"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Active Waitlist"/>
            <DataGrid ItemsSource="{Binding Waitlist}" AutoGenerateColumns="False" MaxHeight="240">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Organ" Binding="{Binding OrganType}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>
                    <DataGridTextColumn Header="Listed" Binding="{Binding ListedDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Blood Type" Binding="{Binding BloodType}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Available Donors" Margin="0,12,0,0"/>
            <DataGrid ItemsSource="{Binding Donors}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Donor ID" Binding="{Binding DonorId}" Width="120"/>
                    <DataGridTextColumn Header="Organ" Binding="{Binding OrganType}" Width="100"/>
                    <DataGridTextColumn Header="Donor Type" Binding="{Binding DonorType}" Width="120"/>
                    <DataGridTextColumn Header="Blood Type" Binding="{Binding BloodType}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
