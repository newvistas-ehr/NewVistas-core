<UserControl x:Class="NewVistas.Wpf_UI.Views.SpinalCordInjuryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Spinal Cord Injury"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding Patient, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource SectionHeader}" Text="SCI Registry"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Patient.Status}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Level: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Patient.NeurologicalLevel}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Category: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Patient.InjuryCategory}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Annual Encounters"/>
            <DataGrid ItemsSource="{Binding Encounters}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Year" Binding="{Binding FiscalYear}" Width="80"/>
                    <DataGridTextColumn Header="Encounter Date" Binding="{Binding EncounterDate, StringFormat=d}" Width="130"/>
                    <DataGridTextColumn Header="Facility" Binding="{Binding FacilityName}" Width="*"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
