<UserControl x:Class="NewVistas.Wpf_UI.Views.ImmunizationForecastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Immunization Forecast"/>

            <!-- Error display -->
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <!-- Success message -->
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontSize="13" Margin="0,0,0,8"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}"/>

            <!-- Feature disabled banner -->
            <Border Background="#FFF9C4" BorderBrush="#F9A825" BorderThickness="1" CornerRadius="4"
                    Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding IsFeatureEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Immunization Forecast feature is not currently enabled. Load the page to check feature status."
                           Foreground="#E65100" TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Generate Forecast" Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateForecastCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Summary bar -->
            <Border Style="{StaticResource FormPanel}" Margin="0,0,0,12"
                    Visibility="{Binding ForecastDate, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Forecast Summary"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock FontSize="14" Margin="0,0,24,0">
                            <Run Text="Forecast Date: "/>
                            <Run Text="{Binding ForecastDate, StringFormat=d, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="14" Margin="0,0,24,0">
                            <Run Text="DUE: "/>
                            <Run Text="{Binding TotalDue, Mode=OneWay}" FontWeight="Bold" Foreground="#1565C0"/>
                        </TextBlock>
                        <TextBlock FontSize="14" Margin="0,0,24,0">
                            <Run Text="OVERDUE: "/>
                            <Run Text="{Binding TotalOverdue, Mode=OneWay}" FontWeight="Bold" Foreground="#C62828"/>
                        </TextBlock>
                        <TextBlock FontSize="14" Margin="0,0,0,0">
                            <Run Text="COMPLETE: "/>
                            <Run Text="{Binding TotalComplete, Mode=OneWay}" FontWeight="Bold" Foreground="#2E7D32"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recommendations DataGrid -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Recommendations"/>
            <DataGrid ItemsSource="{Binding Recommendations}" AutoGenerateColumns="False" Margin="0,4,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vaccine Group" Binding="{Binding VaccineGroup}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Doses (Recv/Req)" Width="120">
                        <DataGridTextColumn.Binding>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="DosesReceived"/>
                                <Binding Path="DosesRequired"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Last Dose" Binding="{Binding LastDoseDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Recommended Date" Binding="{Binding RecommendedDate, StringFormat=d}" Width="130"/>
                    <DataGridTextColumn Header="Earliest Date" Binding="{Binding EarliestDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Reason" Binding="{Binding StatusReason}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
