<UserControl x:Class="NewVistas.Wpf_UI.Views.OncologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Oncology"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Tumor Registry"/>
            <DataGrid ItemsSource="{Binding Tumors}" SelectedItem="{Binding SelectedTumor}" AutoGenerateColumns="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Primary Site" Binding="{Binding PrimarySite}" Width="*"/>
                    <DataGridTextColumn Header="Histology" Binding="{Binding Histology}" Width="*"/>
                    <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Diagnosis Date" Binding="{Binding DiagnosisDate, StringFormat=d}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Treatments" Margin="0,12,0,0"/>
            <DataGrid ItemsSource="{Binding Treatments}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding TreatmentType}" Width="140"/>
                    <DataGridTextColumn Header="Regimen" Binding="{Binding Regimen}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=d}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
