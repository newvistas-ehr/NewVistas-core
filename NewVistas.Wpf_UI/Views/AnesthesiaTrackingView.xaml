<UserControl x:Class="NewVistas.Wpf_UI.Views.AnesthesiaTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Anesthesia Tracking"/>

            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="3"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsFeatureEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Anesthesia Tracking is not currently enabled for this site." Foreground="#856404" FontSize="13"/>
            </Border>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Anesthesia Records"/>
            <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Procedure" Binding="{Binding ProcedureName}" Width="200"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding AnesthesiaType}" Width="100"/>
                    <DataGridTextColumn Header="ASA" Binding="{Binding AsaClassification}" Width="70"/>
                    <DataGridTextColumn Header="Anesthesiologist" Binding="{Binding AnesthesiologistName}" Width="160"/>
                    <DataGridTextColumn Header="Agents" Binding="{Binding AgentCount}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
