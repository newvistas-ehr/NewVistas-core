<UserControl x:Class="NewVistas.Wpf_UI.Views.MedicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Medications"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Medications" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Medications}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug Name" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Dosage" Binding="{Binding Dosage}" Width="100"/>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="80"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Prescriber" Binding="{Binding PrescriberName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
