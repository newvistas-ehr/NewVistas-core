<UserControl x:Class="NewVistas.Wpf_UI.Views.DrugAccountabilityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Drug Accountability"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Location ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Load Inventory" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadInventoryCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Drug balance list -->
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Drug Inventory"/>
                    <DataGrid ItemsSource="{Binding Drugs}" SelectedItem="{Binding SelectedDrug}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Drug Name" Binding="{Binding DrugName}" Width="*"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding CurrentBalance}" Width="90"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="70"/>
                            <DataGridCheckBoxColumn Header="Controlled" Binding="{Binding IsControlled}" Width="90"/>
                            <DataGridTextColumn Header="Reorder Pt" Binding="{Binding ReorderPoint}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Transaction panel -->
                <StackPanel Grid.Column="1" Margin="16,0,0,0"
                            Visibility="{Binding SelectedDrug, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding SelectedDrug.DrugName}"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource VaBlueBrush}"
                               Text="{Binding SelectedDrug.CurrentBalance, StringFormat='Balance: {0}'}"/>

                    <Button Content="+ Record Transaction" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleTransactionFormCommand}" Margin="0,8,0,8"
                            HorizontalAlignment="Left"/>

                    <Border Style="{StaticResource FormPanel}"
                            Visibility="{Binding ShowTransactionForm, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Transaction Type"/>
                            <ComboBox ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding TransactionType}" Width="180"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Quantity"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Record" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding RecordTransactionCommand}" Margin="0,0,8,0"/>
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ToggleTransactionFormCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Transaction History"/>
                    <ItemsControl ItemsSource="{Binding TransactionHistory}" MaxHeight="300">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource VaBorderBrush}" BorderThickness="0,0,0,1" Padding="4">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding TransactionType}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" FontSize="12" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding BalanceAfter, StringFormat='Bal: {0}'}" FontSize="12" Foreground="#666"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TransactionDate, StringFormat=g}" FontSize="11" Foreground="#888"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
