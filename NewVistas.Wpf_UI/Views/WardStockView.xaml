<UserControl x:Class="NewVistas.Wpf_UI.Views.WardStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Ward Stock Management"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Ward ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding WardId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Inventory"/>
            <DataGrid ItemsSource="{Binding StockItems}" AutoGenerateColumns="False" MaxHeight="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding Drug}" Width="*"/>
                    <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand}" Width="80"/>
                    <DataGridTextColumn Header="Par" Binding="{Binding Par}" Width="60"/>
                    <DataGridTextColumn Header="Reorder Pt" Binding="{Binding ReorderPoint}" Width="80"/>
                    <DataGridTextColumn Header="UOM" Binding="{Binding Uom}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridCheckBoxColumn Header="CS" Binding="{Binding IsControlledSubstance}" Width="40"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Low Stock Alerts" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding LowStockItems}" AutoGenerateColumns="False" MaxHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding Drug}" Width="*"/>
                    <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand}" Width="80"/>
                    <DataGridTextColumn Header="Reorder Pt" Binding="{Binding ReorderPoint}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Replenishment Log" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding ReplenishmentLog}" AutoGenerateColumns="False" MaxHeight="150">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding Drug}" Width="*"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
