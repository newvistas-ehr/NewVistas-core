<UserControl x:Class="NewVistas.Wpf_UI.Views.BcmaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="BCMA — Barcode Medication Administration"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load MAR" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Due Medications"/>
            <DataGrid ItemsSource="{Binding MarEntries}" SelectedItem="{Binding SelectedMarEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Dose" Binding="{Binding Dosage}" Width="100"/>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="80"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="90"/>
                    <DataGridTextColumn Header="Last Status" Binding="{Binding LastAdminStatus}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Administer form -->
            <StackPanel Visibility="{Binding SelectedMarEntry, Converter={StaticResource NullToVisibility}}" Margin="0,12,0,0">
                <Border Style="{StaticResource FormPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Administer Medication"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Status"/>
                        <ComboBox ItemsSource="{Binding ActionStatuses}" SelectedItem="{Binding ActionStatus}"
                                  Width="200" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                        <TextBox Text="{Binding AdminNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Width="400" HorizontalAlignment="Left"/>
                        <Button Content="Record Administration" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AdministerMedicationCommand}" Margin="0,12,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Administration History" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding Administrations}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Dose" Binding="{Binding Dosage}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding ActionStatus}" Width="100"/>
                    <DataGridTextColumn Header="Given At" Binding="{Binding AdministrationDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Nurse" Binding="{Binding AdministeredByName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
