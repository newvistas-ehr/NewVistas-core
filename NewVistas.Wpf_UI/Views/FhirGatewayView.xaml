<UserControl x:Class="NewVistas.Wpf_UI.Views.FhirGatewayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="FHIR R4 Gateway"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Resource:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding ResourceTypes}" SelectedItem="{Binding ResourceType}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Query" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Capability Statement" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadCapabilityCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="FHIR Response"/>
            <TextBox Text="{Binding ResultJson, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="300"
                     FontFamily="Courier New" FontSize="11"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Capability Statement" Margin="0,16,0,0"/>
            <TextBox Text="{Binding CapabilityStatement, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="200"
                     FontFamily="Courier New" FontSize="11"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
