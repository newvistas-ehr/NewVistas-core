<UserControl x:Class="NewVistas.Wpf_UI.Views.IfcapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock Text="IFCAP Procurement" Style="{StaticResource PageTitle}"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <TabControl SelectedIndex="{Binding SelectedTab}">

                <!-- ── Tab: Control Points ── -->
                <TabItem Header="Control Points">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Control Points" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <TextBlock Text="FY:" VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <TextBox Width="60" Text="{Binding FiscalYear, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Load" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding LoadControlPointsCommand}"/>
                            <Button Content="Refresh All" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ControlPoints}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Control Point" Binding="{Binding ControlPointId}" Width="130"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Fund" Binding="{Binding FundCode}" Width="80"/>
                                <DataGridTextColumn Header="Cost Center" Binding="{Binding CostCenterCode}" Width="100"/>
                                <DataGridTextColumn Header="FY" Binding="{Binding FiscalYear}" Width="60"/>
                                <DataGridTextColumn Header="Budget" Binding="{Binding BudgetAmount, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Committed" Binding="{Binding CommittedAmount, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Obligated" Binding="{Binding ObligatedAmount, StringFormat=C}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ── Tab: Purchase Orders ── -->
                <TabItem Header="Purchase Orders">
                    <StackPanel Margin="8">
                        <TextBlock Text="Purchase Orders" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding PurchaseOrders}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PO #" Binding="{Binding PurchaseOrderId}" Width="130"/>
                                <DataGridTextColumn Header="Vendor" Binding="{Binding VendorName}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="100"/>
                                <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat=d}" Width="100"/>
                                <DataGridTextColumn Header="Delivery" Binding="{Binding DeliveryDate, StringFormat=d}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ── Tab: Vendors ── -->
                <TabItem Header="Vendors">
                    <StackPanel Margin="8">
                        <TextBlock Text="IFCAP Vendors" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding Vendors}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vendor ID" Binding="{Binding VendorId}" Width="100"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Vendor #" Binding="{Binding VendorNumber}" Width="100"/>
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                                <DataGridTextColumn Header="SB" Binding="{Binding IsSmallBusiness}" Width="50"/>
                                <DataGridTextColumn Header="SDVOSB" Binding="{Binding IsVeteranOwned}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
