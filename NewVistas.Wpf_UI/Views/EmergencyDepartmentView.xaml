<UserControl x:Class="NewVistas.Wpf_UI.Views.EmergencyDepartmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Emergency Department"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Refresh Board" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Register Patient" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRegisterFormCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Statistics -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding Stats, Converter={StaticResource NullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Total:" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Stats.TotalPatients}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Waiting:" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Stats.Waiting}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="In Treatment:" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Stats.InTreatment}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Avg Wait:" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Stats.AvgWaitMinutes, StringFormat={}{0:F0} min}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Register Form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRegisterForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Register ED Patient"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patient ID"/>
                    <TextBox Text="{Binding RegPatientId, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patient Name"/>
                    <TextBox Text="{Binding RegPatientName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Chief Complaint"/>
                    <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Arrival Mode"/>
                    <ComboBox ItemsSource="{Binding ArrivalModes}" SelectedItem="{Binding ArrivalMode}" Width="200" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Register" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RegisterPatientCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRegisterFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tracking Board -->
            <DataGrid ItemsSource="{Binding Board}" SelectedItem="{Binding SelectedVisit}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ESI" Binding="{Binding EsiLevel}" Width="50"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="160"/>
                    <DataGridTextColumn Header="Chief Complaint" Binding="{Binding ChiefComplaint}" Width="*"/>
                    <DataGridTextColumn Header="Bed" Binding="{Binding Bed}" Width="80"/>
                    <DataGridTextColumn Header="Physician" Binding="{Binding Physician}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Wait (min)" Binding="{Binding WaitMinutes}" Width="80"/>
                    <DataGridTextColumn Header="Arrival" Binding="{Binding Arrival}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedVisit, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Bed:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding AssignBedId, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,0"/>
                <Button Content="Assign Bed" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AssignBedCommand}" Margin="0,0,8,0"/>
                <Button Content="Discharge" Style="{StaticResource DangerButton}"
                        Command="{Binding DischargeCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
