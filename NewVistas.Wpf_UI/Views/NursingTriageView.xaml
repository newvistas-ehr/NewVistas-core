<UserControl x:Class="NewVistas.Wpf_UI.Views.NursingTriageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Nursing Triage Assessment"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Triages" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Triages}" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding TriageDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Nurse" Binding="{Binding NurseName}" Width="140"/>
                    <DataGridTextColumn Header="Chief Complaint" Binding="{Binding ChiefComplaint}" Width="*"/>
                    <DataGridTextColumn Header="ESI" Binding="{Binding TriageLevel}" Width="80"/>
                    <DataGridTextColumn Header="Pain" Binding="{Binding PainScore}" Width="60"/>
                    <DataGridTextColumn Header="Disposition" Binding="{Binding Disposition}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Sign Triage" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SignTriageCommand}" Margin="0,0,8,0"/>
                <Button Content="Create Triage" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CreateTriageCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
