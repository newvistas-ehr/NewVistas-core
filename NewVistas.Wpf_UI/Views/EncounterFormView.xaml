<UserControl x:Class="NewVistas.Wpf_UI.Views.EncounterFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Encounter Form Templates"/>

            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="3"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsFeatureEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Encounter Form Templates are not currently enabled for this site."
                           Foreground="#856404" FontSize="13"/>
            </Border>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="{StaticResource VaSuccessBrush}" FontSize="13" Margin="0,0,0,8"
                       Text="{Binding SuccessMessage}"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}" Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="New Form Instance" Style="{StaticResource SecondaryButton}" Command="{Binding CreateInstanceCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Published Templates"/>
            <DataGrid ItemsSource="{Binding Templates}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding FormType}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
                    <DataGridTextColumn Header="Fields" Binding="{Binding FieldCount}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Patient Form Instances" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding Instances}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Template" Binding="{Binding TemplateName}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding CreatedByProviderName}" Width="140"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Submitted" Binding="{Binding SubmittedDate, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
