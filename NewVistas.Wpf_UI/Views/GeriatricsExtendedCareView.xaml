<UserControl x:Class="NewVistas.Wpf_UI.Views.GeriatricsExtendedCareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Geriatrics &amp; Extended Care"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Patient ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Load Assessments" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Assessments}" SelectedItem="{Binding SelectedAssessment}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Assessment Type" Binding="{Binding AssessmentType}" Width="160"/>
                    <DataGridTextColumn Header="RUG Category" Binding="{Binding RUGCategory}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Assessment Date" Binding="{Binding AssessmentDate, StringFormat=d}" Width="130"/>
                    <DataGridTextColumn Header="Assessor" Binding="{Binding AssessorName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
