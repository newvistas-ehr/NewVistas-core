<UserControl x:Class="NewVistas.Wpf_UI.Views.PceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="PCE — Patient Care Encounters"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Encounters" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Create Encounter" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleCreateFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Create Encounter"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Visit Type"/>
                    <ComboBox ItemsSource="{Binding VisitTypeOptions}" SelectedItem="{Binding VisitType}"
                              Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Clinic Name"/>
                    <TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Provider Name"/>
                    <TextBox Text="{Binding PrimaryProviderName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Stop Code"/>
                    <TextBox Text="{Binding StopCode, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Create" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateEncounterCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleCreateFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Encounters}" SelectedItem="{Binding SelectedVisit}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Category" Binding="{Binding ServiceCategory}" Width="130"/>
                    <DataGridTextColumn Header="Clinic" Binding="{Binding LocationName}" Width="160"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding PrimaryProviderName}" Width="160"/>
                    <DataGridTextColumn Header="Dx" Binding="{Binding DiagnosisCount}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Visit Date" Binding="{Binding VisitDateTime, StringFormat=d}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Check Out" Style="{StaticResource PrimaryButton}"
                    Command="{Binding CheckOutEncounterCommand}" Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Visibility="{Binding SelectedEncounter, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
