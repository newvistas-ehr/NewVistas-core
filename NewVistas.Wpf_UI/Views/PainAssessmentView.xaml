<UserControl x:Class="NewVistas.Wpf_UI.Views.PainAssessmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Pain Assessment"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Assessments" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Assessments}" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding AssessmentDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Nurse" Binding="{Binding NurseName}" Width="140"/>
                    <DataGridTextColumn Header="Tool" Binding="{Binding Tool}" Width="100"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding PainScore}" Width="60"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding PainLocation}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Reassess" Binding="{Binding IsReassessment}" Width="70"/>
                    <DataGridTextColumn Header="Post-Rx" Binding="{Binding PostInterventionScore}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Record Pain" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RecordPainCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
