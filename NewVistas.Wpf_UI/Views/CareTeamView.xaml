<UserControl x:Class="NewVistas.Wpf_UI.Views.CareTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Care Team (PCMM)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Care Team" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Members}" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="140"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding AssignmentSource}" Width="100"/>
                    <DataGridTextColumn Header="Assigned" Binding="{Binding AssignmentDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeenDate, StringFormat=d}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add Member" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddMemberCommand}" Margin="0,0,8,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
