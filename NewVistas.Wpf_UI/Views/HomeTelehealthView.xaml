<UserControl x:Class="NewVistas.Wpf_UI.Views.HomeTelehealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home Telehealth"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Visibility="{Binding Patient, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Enrollment"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status: " Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Patient.EnrollmentStatus}" FontWeight="SemiBold"/>
                    <TextBlock Margin="16,0,4,0" Style="{StaticResource FieldLabel}" Text="Program: "/>
                    <TextBlock Text="{Binding Patient.Program}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Recent Readings"/>
            <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date/Time" Binding="{Binding ReadingDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ReadingType}" Width="120"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="100"/>
                    <DataGridTextColumn Header="Alert" Binding="{Binding AlertGenerated}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Alerts" Margin="0,12,0,0"/>
            <DataGrid ItemsSource="{Binding Alerts}" AutoGenerateColumns="False" MaxHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding AlertDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding AlertType}" Width="140"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
