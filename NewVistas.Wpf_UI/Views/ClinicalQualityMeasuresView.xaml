<UserControl x:Class="NewVistas.Wpf_UI.Views.ClinicalQualityMeasuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Clinical Quality Measures (eCQM)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load All Measures" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Active Only" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadActiveMeasuresCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Measures}" AutoGenerateColumns="False" IsReadOnly="True" Height="300">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Measure ID" Binding="{Binding MeasureId}" Width="140"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Domain" Binding="{Binding ClinicalDomain}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding MeasureType}" Width="100"/>
                    <DataGridTextColumn Header="NQF #" Binding="{Binding NqfNumber}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                <TextBox Text="{Binding ViewReportId, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0"/>
                <Button Content="Load Report" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadReportCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
