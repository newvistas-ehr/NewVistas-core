<UserControl x:Class="NewVistas.Wpf_UI.Views.PharmacyPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Pharmacy Point of Sale"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <CheckBox Content="Paid Only" IsChecked="{Binding ShowPaidOnly}"
                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Claims}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DateOfService, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="180"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="60"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Insurer" Binding="{Binding InsurerName}" Width="130"/>
                    <DataGridTextColumn Header="Paid" Binding="{Binding InsurancePaidAmount, StringFormat=C}" Width="90"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientResponsibility, StringFormat=C}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
