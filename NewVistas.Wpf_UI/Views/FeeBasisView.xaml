<UserControl x:Class="NewVistas.Wpf_UI.Views.FeeBasisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock Text="Fee Basis" Style="{StaticResource PageTitle}"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <!-- Patient search -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="200" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"/>
                <Button Content="Load Patient" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>

            <TabControl SelectedIndex="{Binding SelectedTab}">

                <!-- ── Tab: Authorizations ── -->
                <TabItem Header="Authorizations">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: authorizations DataGrid -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Fee Authorizations" Style="{StaticResource SectionHeader}"/>
                            <DataGrid ItemsSource="{Binding Authorizations}" MaxHeight="350" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Auth #" Binding="{Binding AuthorizationId}" Width="140"/>
                                    <DataGridTextColumn Header="Service" Binding="{Binding ServiceType}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Vendor" Binding="{Binding VendorName}" Width="130"/>
                                    <DataGridTextColumn Header="Authorized" Binding="{Binding AuthorizedAmount, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="From" Binding="{Binding EffectiveDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="To" Binding="{Binding ExpirationDate, StringFormat=d}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Right: fee patient summary -->
                        <StackPanel Grid.Column="1"
                                    Visibility="{Binding Loaded, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Patient Summary" Style="{StaticResource SectionHeader}"/>
                            <Border Style="{StaticResource FormPanel}">
                                <StackPanel>
                                    <TextBlock Text="Fee Category" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FeePatient.FeeCategory}"/>
                                    <TextBlock Text="Eligibility Status" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FeePatient.EligibilityStatus}"/>
                                    <TextBlock Text="Enrollment Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FeePatient.EnrollmentDate, StringFormat=d}"/>
                                    <TextBlock Text="Total Authorized" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FeePatient.TotalAuthorizedAmount, StringFormat=C}"/>
                                    <TextBlock Text="Total Paid" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding FeePatient.TotalPaidAmount, StringFormat=C}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ── Tab: Invoices ── -->
                <TabItem Header="Invoices">
                    <StackPanel Margin="8">
                        <TextBlock Text="Fee Invoices" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding Invoices}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceId}" Width="140"/>
                                <DataGridTextColumn Header="Vendor" Binding="{Binding VendorName}" Width="140"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding InvoiceAmount, StringFormat=C}" Width="90"/>
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDate, StringFormat=d}" Width="100"/>
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceType}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ── Tab: Vendors ── -->
                <TabItem Header="Vendors">
                    <StackPanel Margin="8">
                        <TextBlock Text="Fee Vendors" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding Vendors}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Vendor ID" Binding="{Binding VendorId}" Width="120"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding VendorType}" Width="100"/>
                                <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="130"/>
                                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
