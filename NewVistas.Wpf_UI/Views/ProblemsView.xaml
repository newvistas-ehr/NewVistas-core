<UserControl x:Class="NewVistas.Wpf_UI.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Problem List"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Problems" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Add Problem" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleAddFormCommand}" Margin="0,0,8,0"/>
                <CheckBox Content="Show Inactive" IsChecked="{Binding ShowInactive}"
                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Add form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Add Problem"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="ICD-10 Code"/>
                    <TextBox Text="{Binding NewIcdCode, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Problem Description"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddProblemCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleAddFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Problems}" SelectedItem="{Binding SelectedProblem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ICD-10" Binding="{Binding IcdCode}" Width="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Onset" Binding="{Binding OnsetDate, StringFormat=d}" Width="120"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding EnteredByName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
