<UserControl x:Class="NewVistas.Wpf_UI.Views.SubstanceAbuseTreatmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Substance Abuse Treatment"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Treatment Episodes" Margin="0,8,0,4"/>
            <DataGrid ItemsSource="{Binding Episodes}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Intake Date" Binding="{Binding IntakeDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Modality" Binding="{Binding Modality}" Width="140"/>
                    <DataGridTextColumn Header="Substance" Binding="{Binding PrimarySubstance}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Program" Binding="{Binding ProgramName}" Width="140"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Treatment Visits" Margin="0,16,0,4"/>
            <DataGrid ItemsSource="{Binding Visits}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding VisitDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding VisitType}" Width="120"/>
                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationMinutes}" Width="80"/>
                    <DataGridTextColumn Header="UDS Result" Binding="{Binding UdsResult}" Width="100"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
