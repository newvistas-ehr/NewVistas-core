<UserControl x:Class="NewVistas.Wpf_UI.Views.HomeHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Home Health (HBPC)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Active Patients" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="HBPC Patient Registry"/>
                    <DataGrid ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="*"/>
                            <DataGridTextColumn Header="Care Level" Binding="{Binding LevelOfCare}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding EnrollmentStatus}" Width="110"/>
                            <DataGridTextColumn Header="Next Visit" Binding="{Binding NextVisitDate, StringFormat=d}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0"
                            Visibility="{Binding SelectedPatient, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Visit History"/>
                    <DataGrid ItemsSource="{Binding Visits}" AutoGenerateColumns="False" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding VisitDate, StringFormat=d}" Width="100"/>
                            <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
