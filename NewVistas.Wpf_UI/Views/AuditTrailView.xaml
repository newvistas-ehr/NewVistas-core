<UserControl x:Class="NewVistas.Wpf_UI.Views.AuditTrailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Audit Trail"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Recent Events" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="160"/>
                    <DataGridTextColumn Header="Entity Type" Binding="{Binding EntityType}" Width="140"/>
                    <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="160"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="160"/>
                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="90"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Detail pane -->
            <StackPanel Visibility="{Binding SelectedEvent, Converter={StaticResource NullToVisibility}}" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource SectionHeader}" Text="Event Details"/>
                <Border Style="{StaticResource FormPanel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Event Hash"/>
                            <TextBlock Text="{Binding SelectedEvent.EventHash}" FontSize="12"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Old Value"/>
                            <TextBlock Text="{Binding SelectedEvent.OldValue}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="New Value"/>
                            <TextBlock Text="{Binding SelectedEvent.NewValue}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Details"/>
                            <TextBlock Text="{Binding SelectedEvent.Details}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
