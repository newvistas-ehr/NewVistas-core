<UserControl x:Class="NewVistas.Wpf_UI.Views.OutpatientPharmacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Outpatient Pharmacy"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Prescriptions" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Prescriptions}" SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rx #" Binding="{Binding PrescriptionId}" Width="100"/>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Dosage" Binding="{Binding Dosage}" Width="180"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="80"/>
                    <DataGridTextColumn Header="Refills" Binding="{Binding RefillsRemaining}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Issued" Binding="{Binding IssueDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Prescriber" Binding="{Binding ProviderName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedPrescription, Converter={StaticResource NullToVisibility}}">
                <Button Content="Fill Rx" Style="{StaticResource PrimaryButton}"
                        Command="{Binding FillRxCommand}" Margin="0,0,8,0"/>
                <Button Content="Refill" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefillRxCommand}" Margin="0,0,8,0"/>
                <Button Content="Hold" Style="{StaticResource SecondaryButton}"
                        Command="{Binding HoldRxCommand}" Margin="0,0,8,0"/>
                <Button Content="Discontinue" Style="{StaticResource DangerButton}"
                        Command="{Binding ShowDiscontinueCommand}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}" Margin="0,8,0,0"
                    Visibility="{Binding ShowDiscontinueForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Discontinue Prescription"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reason"/>
                    <TextBox Text="{Binding DiscontinueReason, UpdateSourceTrigger=PropertyChanged}"
                             Width="400" HorizontalAlignment="Left"/>
                    <Button Content="Confirm Discontinue" Style="{StaticResource DangerButton}"
                            Command="{Binding ConfirmDiscontinueCommand}" Margin="0,12,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ActionMessage}" Margin="0,8,0,0"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
