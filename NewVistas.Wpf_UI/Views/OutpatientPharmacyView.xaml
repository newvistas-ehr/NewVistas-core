<UserControl x:Class="NewVistas.Wpf_UI.Views.OutpatientPharmacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Outpatient Pharmacy"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Prescriptions" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Prescriptions}" SelectedItem="{Binding SelectedPrescription}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rx #" Binding="{Binding PrescriptionNumber}" Width="100"/>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Sig" Binding="{Binding Sig}" Width="180"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTextColumn Header="Refills" Binding="{Binding RefillsRemaining}" Width="70"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Last Fill" Binding="{Binding LastFillDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Prescriber" Binding="{Binding PrescriberName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedPrescription, Converter={StaticResource NullToVisibility}}">
                <Button Content="Fill Rx" Style="{StaticResource PrimaryButton}"
                        Command="{Binding FillRxCommand}" Margin="0,0,8,0"/>
                <Button Content="Refill" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefillCommand}" Margin="0,0,8,0"/>
                <Button Content="Hold" Style="{StaticResource SecondaryButton}"
                        Command="{Binding HoldCommand}" Margin="0,0,8,0"/>
                <Button Content="Discontinue" Style="{StaticResource DangerButton}"
                        Command="{Binding DiscontinueCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
