<UserControl x:Class="NewVistas.Wpf_UI.Views.DrugFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Drug File (File #50)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <TabControl SelectedIndex="{Binding SelectedTab}">
                <!-- Drugs tab -->
                <TabItem Header="Drug Catalog">
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,8,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SearchDrugsCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="Search" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SearchDrugsCommand}" Margin="0,0,8,0"/>
                            <ProgressBar IsIndeterminate="True" Width="100" Height="20"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedDrug}" Height="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Local Name" Binding="{Binding LocalName}" Width="*"/>
                                    <DataGridTextColumn Header="VA Generic" Binding="{Binding VaGenericName}" Width="160"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding PharmacyType}" Width="100"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="Formulary" Binding="{Binding IsNationalFormulary}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0"
                                        Visibility="{Binding SelectedDrug, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding SelectedDrug.LocalName}" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="VA Product"/>
                                <TextBlock Text="{Binding SelectedDrug.VaProductName}" FontSize="13"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Class"/>
                                <TextBlock Text="{Binding SelectedDrug.PrimaryDrugClassName}" FontSize="13"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CS Schedule"/>
                                <TextBlock Text="{Binding SelectedDrug.ControlledSubstanceSchedule}" FontSize="13"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Message"/>
                                <TextBlock Text="{Binding SelectedDrug.Message}" TextWrapping="Wrap" FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- Orderable Items tab -->
                <TabItem Header="Orderable Items">
                    <StackPanel Margin="0,12,0,0">
                        <Button Content="Load Orderable Items" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadOrderableItemsCommand}" Margin="0,0,0,12"
                                HorizontalAlignment="Left"/>
                        <DataGrid ItemsSource="{Binding OrderableItems}" Height="400">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding PharmacyType}" Width="110"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                <DataGridTextColumn Header="VA Generic" Binding="{Binding VaGenericName}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
