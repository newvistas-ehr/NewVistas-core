<UserControl x:Class="NewVistas.Wpf_UI.Views.InpatientPharmacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Inpatient Pharmacy"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Orders" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ New Order" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleOrderFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowOrderForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="New Inpatient Order"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Name"/>
                    <TextBox Text="{Binding DrugName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Dose"/>
                    <TextBox Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Route"/>
                    <ComboBox ItemsSource="{Binding RouteOptions}" SelectedItem="{Binding Route}" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Schedule"/>
                    <TextBox Text="{Binding Schedule, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Place Order" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PlaceInpatientOrderCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleOrderFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding MarEntries}" SelectedItem="{Binding SelectedEntry}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Dose" Binding="{Binding Dosage}" Width="100"/>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="80"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Verify Order" Style="{StaticResource PrimaryButton}"
                    Command="{Binding VerifyOrderCommand}" Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
