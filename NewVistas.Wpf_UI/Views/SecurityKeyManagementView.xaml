<UserControl x:Class="NewVistas.Wpf_UI.Views.SecurityKeyManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Security Key Management"/>

            <!-- Lookup Bar -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="User ID:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,8,0"/>
                <Button Content="Load User" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadUserCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo Keys" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Error Message -->
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <!-- Success Message -->
            <Border Background="{StaticResource VaSuccessBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="8" Margin="0,0,0,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="White" FontSize="13"/>
            </Border>

            <!-- Content shown only when user is loaded -->
            <StackPanel Visibility="{Binding UserState, Converter={StaticResource NullToVisibility}}">

                <!-- Session Status Banner -->
                <Border CornerRadius="4" Padding="8" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FEF3C7"/>
                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UserState.HasActiveSession}" Value="True">
                                    <Setter Property="Background" Value="#DCFCE7"/>
                                    <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="NO SESSION"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserState.HasActiveSession}" Value="True">
                                            <Setter Property="Text" Value="SESSION ACTIVE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UserState.SessionStartTime, StringFormat='Since {0:MM/dd/yyyy HH:mm}'}"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding UserState.HasActiveSession, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding UserState.ClientDevice, StringFormat='Device: {0}'}"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding UserState.HasActiveSession, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding UserState.ClientIpAddress, StringFormat='IP: {0}'}"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding UserState.HasActiveSession, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding UserState.SessionTimeoutMinutes, StringFormat='Timeout: {0} min'}"
                                   FontSize="12" Foreground="#555" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding UserState.HasActiveSession, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="End Session" Style="{StaticResource DangerButton}"
                                Command="{Binding ForceEndSessionCommand}"
                                Visibility="{Binding UserState.HasActiveSession, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Border>

                <!-- Tab Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Security Keys" Margin="0,0,4,0"
                            Command="{Binding SwitchTabCommand}" CommandParameter="keys">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeysTabActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VaBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Grant Key" Margin="0,0,4,0"
                            Command="{Binding SwitchTabCommand}" CommandParameter="grant">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGrantTabActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VaBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Key Audit Log" Margin="0,0,4,0"
                            Command="{Binding SwitchTabCommand}" CommandParameter="audit">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuditTabActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource VaBlueBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Tab 1: Security Keys -->
                <StackPanel Visibility="{Binding IsKeysTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Held Security Keys"/>
                    <TextBlock FontSize="13" Foreground="#555" Margin="0,0,0,8">
                        <Run Text="Holding "/>
                        <Run Text="{Binding UserState.SecurityKeys.Count, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text=" security key(s)"/>
                    </TextBlock>
                    <DataGrid ItemsSource="{Binding UserState.SecurityKeys}" AutoGenerateColumns="False"
                              IsReadOnly="True" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Security Key" Binding="{Binding}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Revoke" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.RevokeKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Padding="4,2" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Tab 2: Grant Key -->
                <StackPanel Visibility="{Binding IsGrantTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Available Security Keys"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Category Filter:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}"
                                  Width="200" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FilteredKeys}" AutoGenerateColumns="False"
                              IsReadOnly="True" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding KeyName}" Width="180"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Grant" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding DataContext.GrantKeyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding KeyName}" Padding="4,2" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Tab 3: Key Audit Log -->
                <StackPanel Visibility="{Binding IsAuditTabActive, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Key Audit Log"/>
                    <DataGrid ItemsSource="{Binding AuditLog}" AutoGenerateColumns="False"
                              IsReadOnly="True" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding ActionDateTime, StringFormat=MM/dd/yyyy HH:mm:ss}" Width="160"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="90"/>
                            <DataGridTextColumn Header="Key" Binding="{Binding KeyName}" Width="180"/>
                            <DataGridTextColumn Header="By" Binding="{Binding PerformedByName}" Width="160"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
