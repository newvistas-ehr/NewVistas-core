<UserControl x:Class="NewVistas.Wpf_UI.Views.AgentCashierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock Text="Agent Cashier" Style="{StaticResource PageTitle}"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <TabControl SelectedIndex="{Binding SelectedTab}">

                <!-- ── Tab: Cashier Window ── -->
                <TabItem Header="Cashier Window">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: patient receipt history -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Patient Receipt History" Style="{StaticResource SectionHeader}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox Width="200" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding LoadPatientReceiptsCommand}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding PatientReceipts}" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="110"/>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Method" Binding="{Binding PaymentMethod}" Width="100"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ReceiptDate, StringFormat=d}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Right: issue receipt form -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Issue Receipt" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Command="{Binding ToggleReceiptFormCommand}"/>
                            </StackPanel>
                            <Border Style="{StaticResource FormPanel}"
                                    Visibility="{Binding ShowReceiptForm, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Receipt Number *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptNumber}"/>
                                    <TextBlock Text="Patient ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptPatientId}"/>
                                    <TextBlock Text="Patient Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptPatientName}"/>
                                    <TextBlock Text="AR Account ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptArAccountId}"/>
                                    <TextBlock Text="Amount" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptAmount}"/>
                                    <TextBlock Text="Payment Method" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                                              SelectedItem="{Binding ReceiptPaymentMethod}"/>
                                    <TextBlock Text="Session ID *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptSessionId}"/>
                                    <TextBlock Text="Cashier ID" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptCashierId}"/>
                                    <TextBlock Text="Cashier Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ReceiptCashierName}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Issue" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding IssueReceiptCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ToggleReceiptFormCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- ── Tab: Sessions ── -->
                <TabItem Header="Sessions">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: all sessions list -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Open Sessions" Style="{StaticResource SectionHeader}"/>
                            <DataGrid ItemsSource="{Binding OpenSessions}" MaxHeight="200" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="130"/>
                                    <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="80"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding SessionDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCollected, StringFormat=C}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="All Sessions" Style="{StaticResource SectionHeader}"/>
                            <DataGrid ItemsSource="{Binding AllSessions}" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding SessionDate, StringFormat=d}" Width="90"/>
                                    <DataGridTextColumn Header="Cashier" Binding="{Binding CashierName}" Width="120"/>
                                    <DataGridTextColumn Header="Station" Binding="{Binding StationId}" Width="80"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding TotalCollected, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <!-- Right: open new session -->
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Open New Session" Style="{StaticResource SectionHeader}" Margin="0"/>
                                <Button Content="+ New" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                        Command="{Binding ToggleSessionFormCommand}"/>
                            </StackPanel>
                            <Border Style="{StaticResource FormPanel}"
                                    Visibility="{Binding ShowSessionForm, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Station ID *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding StationId}"/>
                                    <TextBlock Text="Station Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding StationName}"/>
                                    <TextBlock Text="Cashier ID *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CashierId}"/>
                                    <TextBlock Text="Cashier Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CashierName}"/>
                                    <TextBlock Text="Opening Balance" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding OpeningBalance}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Open Session" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding OpenSessionCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                                Command="{Binding ToggleSessionFormCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
