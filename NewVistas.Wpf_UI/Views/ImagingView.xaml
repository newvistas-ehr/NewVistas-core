<UserControl x:Class="NewVistas.Wpf_UI.Views.ImagingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Imaging (VistA Imaging)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Images" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Capture Image" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleCaptureFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowCaptureForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Capture Image"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Image Type"/>
                    <ComboBox ItemsSource="{Binding ImageTypeOptions}" SelectedItem="{Binding ImageType}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Description"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Body Part"/>
                    <TextBox Text="{Binding BodyPart, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Capture" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CaptureImageCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleCaptureFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Images}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding ImageType}" Width="120"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Body Part" Binding="{Binding BodyPart}" Width="120"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CaptureDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Captured By" Binding="{Binding CapturedByName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
