<UserControl x:Class="NewVistas.Wpf_UI.Views.NursingCarePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Nursing Care Plan"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Care Plan" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding CarePlan.Problems}" AutoGenerateColumns="False" IsReadOnly="True" Height="300"
                      Visibility="{Binding CarePlan, Converter={StaticResource NullToVisibility}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Diagnosis" Binding="{Binding NursingDiagnosis}" Width="*"/>
                    <DataGridTextColumn Header="Related To" Binding="{Binding RelatedTo}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
                    <DataGridTextColumn Header="Goals" Binding="{Binding Goals.Count}" Width="60"/>
                    <DataGridTextColumn Header="Interventions" Binding="{Binding Interventions.Count}" Width="90"/>
                    <DataGridTextColumn Header="Created" Binding="{Binding CreatedDateTime, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Add Diagnosis" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddDiagnosisCommand}" Margin="0,0,8,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
