<UserControl x:Class="NewVistas.Wpf_UI.Views.ConsultServiceDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Consult Service Directory"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load All Services" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                <Button Content="Search" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SearchServicesCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True" Height="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Service ID" Binding="{Binding ServiceId}" Width="140"/>
                    <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="Specialty" Binding="{Binding Specialty}" Width="160"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding DefaultProviderName}" Width="160"/>
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="140"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridCheckBoxColumn Header="Interfacility" Binding="{Binding AcceptsInterfacility}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
