<UserControl x:Class="NewVistas.Wpf_UI.Views.ControlledSubstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Controlled Substances"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Location:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Inspections"/>
            <DataGrid ItemsSource="{Binding Inspections}" AutoGenerateColumns="False" MaxHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding InspectionDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding InspectionType}" Width="130"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="120"/>
                    <DataGridTextColumn Header="Inspector" Binding="{Binding InspectorName}" Width="*"/>
                    <DataGridTextColumn Header="Discrepancies" Binding="{Binding TotalDiscrepancies}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource SectionHeader}" Text="Dispense Records" Margin="0,12,0,0"/>
            <DataGrid ItemsSource="{Binding DispenseRecords}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding DispenseDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding ControlledSchedule}" Width="90"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Patient ID" Binding="{Binding PatientId}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
