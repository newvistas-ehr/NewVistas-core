<UserControl x:Class="NewVistas.Wpf_UI.Views.ARAgingDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="AR Aging Dashboard"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Generate Report" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshReportCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Text="Aging Buckets" FontWeight="Bold" Margin="0,0,0,4"/>
            <DataGrid ItemsSource="{Binding Buckets}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="120"/>
                    <DataGridTextColumn Header="Count" Binding="{Binding AccountCount}" Width="80"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="120"/>
                    <DataGridTextColumn Header="% of AR" Binding="{Binding PercentOfTotal, StringFormat=P1}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Account Details" FontWeight="Bold" Margin="0,12,0,4"/>
            <DataGrid ItemsSource="{Binding AccountDetails}" AutoGenerateColumns="False" IsReadOnly="True" Height="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Account" Binding="{Binding AccountId}" Width="140"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Bucket" Binding="{Binding Bucket}" Width="100"/>
                    <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Payer" Binding="{Binding PayerName}" Width="140"/>
                    <DataGridTextColumn Header="Last Activity" Binding="{Binding LastActivityDate, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Visibility="{Binding Metrics, Converter={StaticResource NullToVisibility}}" Margin="0,12,0,0">
                <TextBlock Text="Revenue Cycle Metrics" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Metrics.TotalAR, StringFormat='Total AR: {0:C}'}"/>
                <TextBlock Text="{Binding Metrics.DaysInAR, StringFormat='Days in AR: {0:F1}'}"/>
                <TextBlock Text="{Binding Metrics.CollectionRate, StringFormat='Collection Rate: {0:P1}'}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
