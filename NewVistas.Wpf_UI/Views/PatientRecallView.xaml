<UserControl x:Class="NewVistas.Wpf_UI.Views.PatientRecallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Patient Recall"/>

            <!-- Feature disabled banner -->
            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1" CornerRadius="3"
                    Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding IsFeatureEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="Patient Recall is not currently enabled for this site."
                           Foreground="#856404" FontSize="13"/>
            </Border>

            <!-- Error / Success -->
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="{StaticResource VaSuccessBrush}" FontSize="13" Margin="0,0,0,8"
                       Text="{Binding SuccessMessage}"
                       Visibility="{Binding SuccessMessage, Converter={StaticResource NullToVisibility}}"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="New Recall" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleNewFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- New Recall Form -->
            <Border Background="{StaticResource VaLightBlueBrush}" BorderBrush="{StaticResource VaBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding ShowNewForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Create New Recall"/>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Clinic ID:*" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ClinicId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Clinic Name:*" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClinicName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Recall Type:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding RecallType}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left">
                            <ComboBoxItem Content="FOLLOW-UP" IsSelected="True"/>
                            <ComboBoxItem Content="ANNUAL_EXAM"/>
                            <ComboBoxItem Content="LAB_RECHECK"/>
                            <ComboBoxItem Content="CHRONIC_CARE"/>
                            <ComboBoxItem Content="IMMUNIZATION"/>
                            <ComboBoxItem Content="SCREENING"/>
                            <ComboBoxItem Content="PROCEDURE"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Recall Date:*" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding RecallDate}" Margin="0,0,0,6" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Provider:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Diagnosis:" VerticalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="300" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Instructions:" VerticalAlignment="Top" Margin="0,0,0,6"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,6" Width="300" Height="60" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"/>
                    </Grid>

                    <Button Content="Create Recall" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateRecallCommand}" Margin="0,8,0,0"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Entries DataGrid -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Recall Entries"/>
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False"
                      IsReadOnly="True" MaxHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Clinic" Binding="{Binding ClinicName}" Width="160"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding RecallType}" Width="120"/>
                    <DataGridTextColumn Header="Recall Date" Binding="{Binding RecallDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="140"/>
                    <DataGridTextColumn Header="Letters" Binding="{Binding LetterCount}" Width="70"/>
                    <DataGridTextColumn Header="Contacts" Binding="{Binding ContactAttemptCount}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
