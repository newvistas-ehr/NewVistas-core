<UserControl x:Class="NewVistas.Wpf_UI.Views.GpraReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="GPRA Population Health Reporting"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Reports" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Reports}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="FY" Binding="{Binding FiscalYear}" Width="60"/>
                    <DataGridTextColumn Header="Period" Binding="{Binding ReportingPeriod}" Width="120"/>
                    <DataGridTextColumn Header="Facility" Binding="{Binding FacilityName}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Population" Binding="{Binding ActiveUserPopulation}" Width="90"/>
                    <DataGridTextColumn Header="Indicators" Binding="{Binding IndicatorCount}" Width="80"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedDate, StringFormat=d}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
