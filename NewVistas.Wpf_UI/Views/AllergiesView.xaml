<UserControl x:Class="NewVistas.Wpf_UI.Views.AllergiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Allergies / Adverse Reactions"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Allergies" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Record Allergy" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRecordFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Record form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRecordForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Record Allergy"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Allergen"/>
                    <TextBox Text="{Binding Allergen, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reaction Type"/>
                    <ComboBox ItemsSource="{Binding ReactionTypeOptions}" SelectedItem="{Binding ReactionType}"
                              Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Severity"/>
                    <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding Severity}"
                              Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Reactions (comma-separated)"/>
                    <TextBox Text="{Binding Reactions, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RecordAllergyCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRecordFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Allergies}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Allergen" Binding="{Binding Allergen}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding ReactionType}" Width="120"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="100"/>
                    <DataGridTextColumn Header="Reactions" Binding="{Binding ReactionsDisplay}" Width="200"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ObservedDate, StringFormat=d}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
