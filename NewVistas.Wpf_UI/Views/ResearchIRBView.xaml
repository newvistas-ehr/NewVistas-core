<UserControl x:Class="NewVistas.Wpf_UI.Views.ResearchIRBView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Research / IRB"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Studies" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Studies}" SelectedItem="{Binding SelectedStudy}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IRB #" Binding="{Binding IrbProtocolNumber}" Width="120"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="PI" Binding="{Binding PrincipalInvestigator}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                    <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="100"/>
                    <DataGridTextColumn Header="Enrollment" Binding="{Binding CurrentEnrollment}" Width="90"/>
                    <DataGridTextColumn Header="Expiration" Binding="{Binding CurrentExpirationDate, StringFormat=d}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
