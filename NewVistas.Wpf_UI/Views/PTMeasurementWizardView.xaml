<UserControl x:Class="NewVistas.Wpf_UI.Views.PTMeasurementWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1000">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="&lt; Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="PT Measurement Wizard"/>
            </StackPanel>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding SaveError}"
                       Visibility="{Binding SaveError, Converter={StaticResource NullToVisibility}}"/>

            <!-- ═══ SELECTION PAGE (Step 0) ═══ -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding IsOnSelectionPage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Session Details"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Therapist"/>
                            <TextBox Text="{Binding TherapistName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Location"/>
                            <TextBox Text="{Binding LocationName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Select Body Regions"/>
                    <TextBlock Text="Check the body regions to measure. For extremities, choose which side(s)."
                               FontSize="12" Foreground="Gray" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding RegionSelections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#D4D9E0" BorderThickness="1" CornerRadius="4"
                                        Padding="12" Margin="0,0,0,6" Background="White">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                       FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BodyGroupList}" FontSize="11" Foreground="Gray"
                                                   Margin="28,2,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="28,6,0,0"
                                                    Visibility="{Binding ShowLaterality, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Side:" FontSize="12" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <RadioButton Content="Right" GroupName="{Binding DisplayName}"
                                                         IsChecked="{Binding IsRight}" Margin="0,0,12,0"/>
                                            <RadioButton Content="Left" GroupName="{Binding DisplayName}"
                                                         IsChecked="{Binding IsLeft}" Margin="0,0,12,0"/>
                                            <RadioButton Content="Both" GroupName="{Binding DisplayName}"
                                                         IsChecked="{Binding IsBoth}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Session Notes (applies to all pages)"/>
                        <TextBox Text="{Binding GlobalNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                    </StackPanel>

                    <Button Content="Start Measurements >" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ProceedToMeasurementsCommand}"
                            Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ═══ MEASUREMENT PAGES (Steps 1..N) ═══ -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding IsOnMeasurementPage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="{Binding CurrentMeasurementPage.PageTitle}"/>
                        <TextBlock Text="{Binding StepLabel}" FontSize="12" Foreground="Gray"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding CurrentMeasurementPage.MovementRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="500">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Movement" Binding="{Binding DisplayName}" Width="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Normal" Binding="{Binding NormalRange}" Width="70" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Active ROM" Binding="{Binding ActiveRom, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Passive ROM" Binding="{Binding PassiveRom, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Pain" Binding="{Binding Pain, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="Strength" Binding="{Binding StrengthGrade, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                            <DataGridTextColumn Header="Comments" Binding="{Binding StrengthComments, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Page Notes (optional)"/>
                        <TextBox Text="{Binding CurrentMeasurementPage.SessionNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="40"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="&lt; Back" Style="{StaticResource SecondaryButton}"
                                Command="{Binding GoBackCommand}" Margin="0,0,8,0"/>
                        <Button Content="Next &gt;" Style="{StaticResource SecondaryButton}"
                                Command="{Binding GoNextCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Content="Done (Save All)" Style="{StaticResource PrimaryButton}"
                                Command="{Binding DoneCommand}" Margin="0,0,8,0"/>
                        <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                                     Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
