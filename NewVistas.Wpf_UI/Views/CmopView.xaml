<UserControl x:Class="NewVistas.Wpf_UI.Views.CmopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="CMOP — Consolidated Mail Outpatient Pharmacy"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Site:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Text="{Binding SiteId, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,8,0"/>
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Add to Queue" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleAddFormCommand}" Margin="0,0,8,0"/>
                <Button Content="Transmit to CMOP" Style="{StaticResource PrimaryButton}"
                        Command="{Binding TransmitCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Add to Queue Form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Add Prescription to Suspense Queue"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rx ID"/>
                    <TextBox Text="{Binding RxId, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patient ID"/>
                    <TextBox Text="{Binding AddPatientId, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Patient Name"/>
                    <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Drug Name"/>
                    <TextBox Text="{Binding DrugName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Rx Number"/>
                    <TextBox Text="{Binding RxNumber, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Qty"/>
                            <TextBox Text="{Binding Qty}" Width="80"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Days Supply"/>
                            <TextBox Text="{Binding DaysSupply}" Width="80"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Fill Type"/>
                            <ComboBox ItemsSource="{Binding FillTypes}" SelectedItem="{Binding FillType}" Width="120"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Priority"/>
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Add" Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddToQueueCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleAddFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Suspense Queue"/>
            <DataGrid ItemsSource="{Binding SuspenseQueue}" SelectedItem="{Binding SelectedSuspenseItem}" AutoGenerateColumns="False" MaxHeight="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Rx Number" Binding="{Binding RxNumber}" Width="100"/>
                    <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="160"/>
                    <DataGridTextColumn Header="Drug" Binding="{Binding DrugName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="60"/>
                    <DataGridTextColumn Header="Fill Type" Binding="{Binding FillType}" Width="100"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Remove from Queue" Style="{StaticResource DangerButton}"
                    Command="{Binding RemoveFromQueueCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding SelectedSuspenseItem, Converter={StaticResource NullToVisibility}}"/>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Transmissions" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding Transmissions}" SelectedItem="{Binding SelectedTransmission}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Transmission ID" Binding="{Binding TransmissionId}" Width="200"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding TransmitDate}" Width="150"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding TotalItems}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
