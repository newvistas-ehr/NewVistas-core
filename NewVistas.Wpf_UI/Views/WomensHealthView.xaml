<UserControl x:Class="NewVistas.Wpf_UI.Views.WomensHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Women's Health"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <CheckBox Content="Follow-Up Required" IsChecked="{Binding ShowFollowUpRequired}"
                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="8,0,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Notifications}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Notification Type" Binding="{Binding NotificationType}" Width="180"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding NotificationDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Follow-Up" Binding="{Binding FollowUpRequired}" Width="90"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
