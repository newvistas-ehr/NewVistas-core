<UserControl x:Class="NewVistas.Wpf_UI.Views.LabEdiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Lab EDI — Electronic Data Interchange"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Demo" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadDemoCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Reference Labs"/>
            <DataGrid ItemsSource="{Binding ReferenceLabs}" SelectedItem="{Binding SelectedLab}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Lab Name" Binding="{Binding LabName}" Width="180"/>
                    <DataGridTextColumn Header="CLIA" Binding="{Binding Clia}" Width="120"/>
                    <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionType}" Width="100"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                    <DataGridTextColumn Header="Orders Sent" Binding="{Binding OrdersSent}" Width="100"/>
                    <DataGridTextColumn Header="Results Rcvd" Binding="{Binding ResultsReceived}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Patient Orders" Margin="0,16,0,0"/>
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order ID" Binding="{Binding OrderId}" Width="160"/>
                    <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/>
                    <DataGridTextColumn Header="Lab" Binding="{Binding LabName}" Width="140"/>
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate}" Width="130"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="View Order Detail" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadOrderDetailCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}}"/>

            <TextBox Text="{Binding OrderDetail, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                     FontFamily="Courier New" FontSize="11" Margin="0,8,0,0"
                     VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding OrderDetail, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
