<UserControl x:Class="NewVistas.Wpf_UI.Views.DecisionSupportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Clinical Decision Support (CDS)"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Interventions" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="Load Events" Style="{StaticResource SecondaryButton}"
                        Command="{Binding LoadEventsCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Interventions}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Intervention ID" Binding="{Binding InterventionId}" Width="160"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding InterventionType}" Width="120"/>
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Evaluate Patient" FontWeight="Bold" Margin="0,12,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Text="{Binding EvalPatientId, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                <Button Content="Evaluate" Style="{StaticResource PrimaryButton}"
                        Command="{Binding EvaluatePatientCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True" Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Intervention" Binding="{Binding InterventionTitle}" Width="*"/>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="Response" Binding="{Binding UserResponse}" Width="300"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
