<UserControl x:Class="NewVistas.Wpf_UI.Views.DieteticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dietetics"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Diet Orders" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Create Diet Order" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleCreateFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Create Diet Order"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Diet Type"/>
                    <TextBox Text="{Binding DietType, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Texture"/>
                    <ComboBox ItemsSource="{Binding TextureOptions}" SelectedItem="{Binding Texture}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Fluid Consistency"/>
                    <ComboBox ItemsSource="{Binding FluidOptions}" SelectedItem="{Binding FluidConsistency}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Calorie Level"/>
                    <TextBox Text="{Binding CalorieLevel, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Create" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateDietOrderCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleCreateFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding DietOrders}" SelectedItem="{Binding SelectedOrder}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Diet Type" Binding="{Binding DietType}" Width="*"/>
                    <DataGridTextColumn Header="Current Diet" Binding="{Binding CurrentDiet}" Width="150"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Start" Binding="{Binding StartDateTime, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Order ID" Binding="{Binding DietOrderId}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Discontinue Selected" Style="{StaticResource DangerButton}"
                    Command="{Binding DiscontinueDietOrderCommand}"
                    Margin="0,8,0,0" HorizontalAlignment="Left"
                    Visibility="{Binding SelectedOrder, Converter={StaticResource NullToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
