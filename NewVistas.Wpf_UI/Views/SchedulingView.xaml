<UserControl x:Class="NewVistas.Wpf_UI.Views.SchedulingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Scheduling"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Appointments" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Schedule Appointment" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleScheduleFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowScheduleForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Schedule Appointment"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Clinic"/>
                    <ComboBox ItemsSource="{Binding Clinics}" DisplayMemberPath="ClinicName"
                              SelectedItem="{Binding SelectedClinic}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Appointment Date/Time"/>
                    <DatePicker SelectedDate="{Binding AppointmentDate}" Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Appointment Type"/>
                    <ComboBox ItemsSource="{Binding AppointmentTypeOptions}" SelectedItem="{Binding AppointmentType}"
                              Width="200" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Purpose of Visit"/>
                    <TextBox Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Schedule" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScheduleAppointmentCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleScheduleFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Clinic" Binding="{Binding ClinicName}" Width="160"/>
                    <DataGridTextColumn Header="Date/Time" Binding="{Binding AppointmentDateTime, StringFormat=g}" Width="140"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding AppointmentType}" Width="120"/>
                    <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding SelectedAppointment, Converter={StaticResource NullToVisibility}}">
                <Button Content="Check In" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CheckInCommand}" Margin="0,0,8,0"/>
                <Button Content="Cancel Appt" Style="{StaticResource DangerButton}"
                        Command="{Binding CancelAppointmentCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
