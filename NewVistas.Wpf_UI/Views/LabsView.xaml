<UserControl x:Class="NewVistas.Wpf_UI.Views.LabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Laboratory"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Results" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Order Lab" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleOrderFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Order form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowOrderForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Order Lab Test"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Test Name"/>
                    <TextBox Text="{Binding NewTestName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Priority"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding NewPriority}"
                              Width="160" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Order" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OrderLabCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleOrderFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding LabResults}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test" Binding="{Binding TestName}" Width="*"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding ResultValue}" Width="120"/>
                    <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="80"/>
                    <DataGridTextColumn Header="Ref Range" Binding="{Binding ReferenceRange}" Width="120"/>
                    <DataGridTextColumn Header="Flag" Binding="{Binding AbnormalFlag}" Width="60"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding SpecimenDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
