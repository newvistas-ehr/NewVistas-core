<UserControl x:Class="NewVistas.Wpf_UI.Views.MeansTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Means Test / Financial Assessment"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Tests" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Record Test" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRecordFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRecordForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Record Means Test"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Test Type"/>
                            <ComboBox ItemsSource="{Binding TestTypes}" SelectedItem="{Binding TestType}" Width="200"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Eligibility Status"/>
                            <ComboBox ItemsSource="{Binding EligibilityOptions}" SelectedItem="{Binding EligibilityStatus}" Width="200"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Annual Income ($)"/>
                            <TextBox Text="{Binding AnnualIncome, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Net Worth ($)"/>
                            <TextBox Text="{Binding NetWorth, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="# Dependents"/>
                            <TextBox Text="{Binding NumberOfDependents, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        </StackPanel>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Priority Group"/>
                            <ComboBox ItemsSource="{Binding PriorityGroups}" SelectedItem="{Binding PriorityGroup}" Width="100"/>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Record" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RecordMeansTestCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRecordFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding MeansTests}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding TestType}" Width="130"/>
                    <DataGridTextColumn Header="Eligibility" Binding="{Binding EligibilityStatus}" Width="180"/>
                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityGroup}" Width="80"/>
                    <DataGridTextColumn Header="Income" Binding="{Binding AnnualIncome, StringFormat=C}" Width="110"/>
                    <DataGridTextColumn Header="Dependents" Binding="{Binding NumberOfDependents}" Width="90"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding TestDate, StringFormat=d}" Width="100"/>
                    <DataGridTextColumn Header="Completed By" Binding="{Binding CompletedByName}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
