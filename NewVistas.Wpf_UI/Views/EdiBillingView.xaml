<UserControl x:Class="NewVistas.Wpf_UI.Views.EdiBillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Margin="16">

            <TextBlock Text="EDI / Electronic Billing" Style="{StaticResource PageTitle}"/>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <TabControl SelectedIndex="{Binding SelectedTab}">

                <!-- ── Tab: Claims ── -->
                <TabItem Header="Claims">
                    <StackPanel Margin="8">
                        <TextBlock Text="Electronic Claims" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Width="200" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0"/>
                            <Button Content="Load Claims" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding LoadClaimsCommand}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Claims}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimId}" Width="160"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding ClaimType}" Width="120"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                                <DataGridTextColumn Header="Payer" Binding="{Binding PayerName}" Width="140"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding TotalChargeAmount, StringFormat=C}" Width="90"/>
                                <DataGridTextColumn Header="Service Date" Binding="{Binding ServiceFromDate, StringFormat=d}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ── Tab: Transmissions ── -->
                <TabItem Header="Transmissions">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Transmissions" Style="{StaticResource SectionHeader}" Margin="0"/>
                            <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding RefreshTransmissionsCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Open Transmissions" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding OpenTransmissions}" MaxHeight="180" Margin="0,0,0,12"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Batch ID" Binding="{Binding TransmissionId}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Claim Count" Binding="{Binding ClaimCount}" Width="90"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedDate, StringFormat=d}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="All Transmissions" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                        <DataGrid ItemsSource="{Binding Transmissions}" MaxHeight="280" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Batch ID" Binding="{Binding TransmissionId}" Width="160"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                                <DataGridTextColumn Header="Claims" Binding="{Binding ClaimCount}" Width="70"/>
                                <DataGridTextColumn Header="Accepted" Binding="{Binding AcceptedCount}" Width="70"/>
                                <DataGridTextColumn Header="Rejected" Binding="{Binding RejectedCount}" Width="70"/>
                                <DataGridTextColumn Header="Sent" Binding="{Binding SentDate, StringFormat=d}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- ── Tab: ERAs ── -->
                <TabItem Header="ERAs">
                    <StackPanel Margin="8">
                        <TextBlock Text="Electronic Remittance Advice" Style="{StaticResource SectionHeader}"/>
                        <DataGrid ItemsSource="{Binding Eras}" MaxHeight="400" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ERA ID" Binding="{Binding EraId}" Width="160"/>
                                <DataGridTextColumn Header="Payer" Binding="{Binding PayerName}" Width="150"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Claims" Binding="{Binding ClaimCount}" Width="70"/>
                                <DataGridTextColumn Header="Total Paid" Binding="{Binding TotalPaidAmount, StringFormat=C}" Width="100"/>
                                <DataGridTextColumn Header="Received" Binding="{Binding ReceivedDate, StringFormat=d}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
