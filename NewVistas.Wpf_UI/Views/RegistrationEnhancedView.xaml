<UserControl x:Class="NewVistas.Wpf_UI.Views.RegistrationEnhancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Enhanced Registration"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
            <TextBlock Foreground="Green" Text="{Binding ActionMessage}"
                       Visibility="{Binding ActionMessage, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Registration Data" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <TextBlock Text="Advance Directives" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Visibility="{Binding AdvanceDirectives, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding AdvanceDirectives.CodeStatus, StringFormat='Code Status: {0}'}"/>
                <TextBlock Text="{Binding AdvanceDirectives.Documents.Count, StringFormat='Documents: {0}'}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                <Button Content="Update Code Status" Style="{StaticResource PrimaryButton}"
                        Command="{Binding UpdateCodeStatusCommand}" Margin="0,0,8,0"/>
                <Button Content="Add Living Will" Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddLivingWillCommand}" Margin="0,0,8,0"/>
                <Button Content="Verify Identity" Style="{StaticResource SecondaryButton}"
                        Command="{Binding VerifyIdentityCommand}"/>
            </StackPanel>

            <TextBlock Text="Identity Verification" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Visibility="{Binding IdentityVerification, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding IdentityVerification.VerificationResult, StringFormat='Result: {0}'}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
