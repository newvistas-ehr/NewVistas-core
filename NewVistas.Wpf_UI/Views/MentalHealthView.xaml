<UserControl x:Class="NewVistas.Wpf_UI.Views.MentalHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Mental Health"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Screens" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Record Screen" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleRecordFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowRecordForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Record Mental Health Screen"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Instrument"/>
                    <ComboBox ItemsSource="{Binding InstrumentOptions}" SelectedItem="{Binding InstrumentName}"
                              Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Raw Score"/>
                    <TextBox Text="{Binding TotalScore, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Result / Interpretation"/>
                    <TextBox Text="{Binding ScoreInterpretation, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RecordScreenCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleRecordFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Screens}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Instrument" Binding="{Binding InstrumentName}" Width="180"/>
                    <DataGridTextColumn Header="Score" Binding="{Binding TotalScore}" Width="80"/>
                    <DataGridTextColumn Header="Result" Binding="{Binding ScoreInterpretation}" Width="*"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding AdministrationDateTime, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
