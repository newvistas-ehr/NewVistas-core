<UserControl x:Class="NewVistas.Wpf_UI.Views.SurgeryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Surgery"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Load Surgeries" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <Button Content="+ Schedule Surgery" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleScheduleFormCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowScheduleForm, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Schedule Surgery"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Principal Procedure"/>
                    <TextBox Text="{Binding PrincipalProcedure, UpdateSourceTrigger=PropertyChanged}" Width="400" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Surgeon Name"/>
                    <TextBox Text="{Binding SurgeonName, UpdateSourceTrigger=PropertyChanged}" Width="300" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Anesthesia Type"/>
                    <ComboBox ItemsSource="{Binding AnesthesiaOptions}" SelectedItem="{Binding AnesthesiaType}" Width="200" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Schedule" Style="{StaticResource PrimaryButton}"
                                Command="{Binding ScheduleSurgeryCommand}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleScheduleFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Surgeries}" SelectedItem="{Binding SelectedSurgery}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Procedure" Binding="{Binding PrincipalProcedureName}" Width="*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="Surgeon" Binding="{Binding PrincipalSurgeonName}" Width="160"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, StringFormat=d}" Width="110"/>
                    <DataGridTextColumn Header="Anesthesia" Binding="{Binding AnesthesiaType}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
