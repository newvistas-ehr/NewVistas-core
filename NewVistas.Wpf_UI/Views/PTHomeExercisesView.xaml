<UserControl x:Class="NewVistas.Wpf_UI.Views.PTHomeExercisesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1000">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="&lt; Back to PT Hub" Style="{StaticResource SecondaryButton}"
                        Command="{Binding GoBackCommand}" Margin="0,0,12,0"/>
                <TextBlock Style="{StaticResource PageTitle}" Text="Home Exercise Program"/>
            </StackPanel>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Load Program" Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0"/>
                <ProgressBar IsIndeterminate="True" Width="120" Height="20"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>

            <!-- Tab buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Active Program" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ShowProgramTabCommand}" Margin="0,0,8,0"/>
                <Button Content="Prescribe Exercise" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ShowPrescribeTabCommand}" Margin="0,0,8,0"/>
                <Button Content="Completion Log" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ShowLogTabCommand}" Margin="0,0,8,0"/>
            </StackPanel>

            <!-- Active Program -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowProgram, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Active Prescriptions"/>
                    <DataGrid ItemsSource="{Binding ActivePrescriptions}" AutoGenerateColumns="False"
                              IsReadOnly="True" MaxHeight="500"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Exercise" Binding="{Binding ExerciseName}" Width="150"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Body Group" Binding="{Binding BodyGroup}" Width="100"/>
                            <DataGridTextColumn Header="Frequency" Binding="{Binding Frequency}" Width="100"/>
                            <DataGridTextColumn Header="Sets" Binding="{Binding Sets}" Width="50"/>
                            <DataGridTextColumn Header="Reps" Binding="{Binding Reps}" Width="50"/>
                            <DataGridTextColumn Header="Prescribed By" Binding="{Binding PrescribedBy}" Width="120"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PrescribedDate, StringFormat=MM/dd/yyyy}" Width="90"/>
                            <DataGridTemplateColumn Header="" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Done" Style="{StaticResource PrimaryButton}"
                                                    Padding="4,2" FontSize="11" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.LogDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Stop" Padding="4,2" FontSize="11"
                                                    Background="#b91c1c" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.DiscontinueCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Prescribe Form -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowPrescribe, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Prescribe Home Exercise"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Exercise Name"/>
                            <TextBox Text="{Binding RxName, UpdateSourceTrigger=PropertyChanged}" Width="250"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Category"/>
                            <ComboBox SelectedItem="{Binding RxCategory}" Width="140">
                                <ComboBox.Items>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Strengthening"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Stretching"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Balance"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Endurance"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Functional"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Modality"/>
                                    <x:Static Member="NewVistas.PT.Models.ExerciseCategory.Other"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Body Group"/>
                            <ComboBox SelectedItem="{Binding RxBodyGroup}" Width="140">
                                <ComboBox.Items>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Cervical"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Shoulder"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Elbow"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Wrist"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Hand"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Hip"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Knee"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Ankle"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.Foot"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.ThoracicSpine"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.LumbarSpine"/>
                                    <x:Static Member="NewVistas.PT.Models.BodyGroup.TMJ"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Instructions"/>
                        <TextBox Text="{Binding RxInstructions, UpdateSourceTrigger=PropertyChanged}" Width="600" HorizontalAlignment="Left"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Frequency"/>
                            <TextBox Text="{Binding RxFrequency, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Sets"/>
                            <TextBox Text="{Binding RxSets, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Reps"/>
                            <TextBox Text="{Binding RxReps, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Duration (sec)"/>
                            <TextBox Text="{Binding RxDuration, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Side"/>
                            <ComboBox SelectedItem="{Binding RxSide}" Width="120">
                                <ComboBox.Items>
                                    <x:Static Member="NewVistas.PT.GrainStates.Laterality.Bilateral"/>
                                    <x:Static Member="NewVistas.PT.GrainStates.Laterality.Left"/>
                                    <x:Static Member="NewVistas.PT.GrainStates.Laterality.Right"/>
                                </ComboBox.Items>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Prescribed By"/>
                            <TextBox Text="{Binding RxPrescribedBy, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
                        <TextBox Text="{Binding RxNotes, UpdateSourceTrigger=PropertyChanged}" Width="600" HorizontalAlignment="Left"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="40"/>
                    </StackPanel>
                    <Button Content="Prescribe" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PrescribeCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Completion Log -->
            <Border Style="{StaticResource FormPanel}"
                    Visibility="{Binding ShowLog, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Completion Log"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="From"/>
                            <DatePicker SelectedDate="{Binding LogFrom}" Width="160"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="To"/>
                            <DatePicker SelectedDate="{Binding LogTo}" Width="160"/>
                        </StackPanel>
                        <Button Content="Search" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadCompletionLogsCommand}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding CompletionLogs}" AutoGenerateColumns="False"
                              IsReadOnly="True" MaxHeight="400"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding CompletedDate, StringFormat=MM/dd/yyyy HH:mm}" Width="140"/>
                            <DataGridTextColumn Header="Completed By" Binding="{Binding CompletedBy}" Width="100"/>
                            <DataGridTextColumn Header="Sets" Binding="{Binding SetsCompleted}" Width="50"/>
                            <DataGridTextColumn Header="Reps" Binding="{Binding RepsCompleted}" Width="50"/>
                            <DataGridTextColumn Header="Pain" Binding="{Binding PainLevel}" Width="50"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
