<Window x:Class="NewVistas.Wpf_UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NewVistas — Sign In"
        Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f4f6f9">

    <Grid>
        <Border Background="White" BorderBrush="#d4d9e0" BorderThickness="1"
                CornerRadius="8" Padding="32" Margin="24"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="NewVistas Sign-In" FontSize="22" FontWeight="Bold"
                           Foreground="#003f72" Margin="0,0,0,2"/>
                <TextBlock Text="Clinical Information System" FontSize="13"
                           Foreground="#666" Margin="0,0,0,20"/>

                <!-- Error -->
                <Border Background="#f8d7da" CornerRadius="4" Padding="8,6" Margin="0,0,0,12"
                        Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Error}" Foreground="#842029" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <!-- Credentials (Step 1) -->
                <StackPanel Visibility="{Binding IsMfaStep, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Access Code (Username)" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                             Padding="6,4" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Verify Code (Password)" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox"
                                 IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                                 Padding="6,4" FontSize="14" Margin="0,0,0,16"
                                 KeyDown="PasswordBox_KeyDown"/>
                </StackPanel>

                <!-- MFA (Step 2) -->
                <StackPanel Visibility="{Binding IsMfaStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Multi-Factor Authentication" FontSize="14" FontWeight="SemiBold"
                               Foreground="#003f72" Margin="0,0,0,8"/>
                    <TextBlock Text="Enter the verification code from your authenticator app."
                               FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Verification Code" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MfaCode, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                             Padding="6,4" FontSize="14" Margin="0,0,0,16"
                             MaxLength="6"/>
                </StackPanel>

                <!-- Sign In button -->
                <Button Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                        Background="#003f72" Foreground="White"
                        Padding="0,10" FontSize="14" Cursor="Hand"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#004488"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Sign In"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Text" Value="Signing in..."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMfaStep}" Value="True">
                                        <Setter Property="Text" Value="Verify"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
