<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:NewVistas.WpfDelphiUI.Converters">

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  CPRS Classic Windows Color Palette                               -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ControlBrush"    Color="#D4D0C8"/>  <!-- clBtnFace -->
    <SolidColorBrush x:Key="ControlDarkBrush" Color="#808080"/> <!-- clBtnShadow -->
    <SolidColorBrush x:Key="ControlLightBrush" Color="#FFFFFF"/><!-- clBtnHighlight -->
    <SolidColorBrush x:Key="WindowBrush"     Color="#FFFFFF"/>  <!-- clWindow -->
    <SolidColorBrush x:Key="NavyBrush"       Color="#000080"/>  <!-- header labels -->
    <SolidColorBrush x:Key="MaroonBrush"     Color="#800000"/>  <!-- patient flags -->
    <SolidColorBrush x:Key="RedBrush"        Color="#CC0000"/>  <!-- abnormal labs -->
    <SolidColorBrush x:Key="DarkBlueBrush"   Color="#000080"/>  <!-- nav tabs -->
    <SolidColorBrush x:Key="BlackBrush"      Color="#000000"/>
    <SolidColorBrush x:Key="GrayTextBrush"   Color="#444444"/>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Converters                                                        -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <conv:BoolToVisibilityConverter         x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVis"/>
    <conv:NullToVisibilityConverter         x:Key="NullToVis"/>
    <conv:ReportingPeriodLabelConverter     x:Key="ReportingPeriodLabelConverter"/>
    <conv:GpraStatusLabelConverter          x:Key="GpraStatusLabelConverter"/>
    <conv:GpraCategoryLabelConverter        x:Key="GpraCategoryLabelConverter"/>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Base font — mimics CPRS "MS Sans Serif 8pt"                      -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BlackBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="2,1"/>
        <Setter Property="BorderBrush"     Value="#808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"      Value="White"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="FontFamily"       Value="Courier New"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="BorderBrush"      Value="#808080"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Background"       Value="White"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="SelectionMode"    Value="Single"/>
    </Style>

    <Style TargetType="ListView">
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="BorderBrush"     Value="#808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"      Value="White"/>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background"  Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground"  Value="Black"/>
        <Setter Property="FontWeight"  Value="Normal"/>
        <Setter Property="Padding"     Value="4,2"/>
        <Setter Property="BorderBrush" Value="#888"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns"  Value="False"/>
        <Setter Property="CanUserAddRows"       Value="False"/>
        <Setter Property="CanUserDeleteRows"    Value="False"/>
        <Setter Property="IsReadOnly"           Value="True"/>
        <Setter Property="SelectionMode"        Value="Single"/>
        <Setter Property="GridLinesVisibility"  Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#C8C8C8"/>
        <Setter Property="BorderBrush"          Value="#808080"/>
        <Setter Property="Background"           Value="White"/>
        <Setter Property="RowBackground"        Value="White"/>
        <Setter Property="FontSize"             Value="11"/>
        <Setter Property="FontFamily"           Value="Segoe UI"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"  Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground"  Value="Black"/>
        <Setter Property="Padding"     Value="4,2"/>
        <Setter Property="FontWeight"  Value="Normal"/>
        <Setter Property="BorderBrush" Value="#888"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="SeparatorBrush" Value="#888"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Classic Windows Button                                            -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style TargetType="Button">
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Background"      Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground"      Value="Black"/>
        <Setter Property="BorderBrush"     Value="#888"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,3"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="MinWidth"        Value="75"/>
        <Setter Property="Height"          Value="23"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C8D8E8"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#A0B8CC"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#888"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  CPRS Panel header (TOROffsetLabel style)                          -->
    <!--  — gray bar across the top of each cover-sheet panel              -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CprsPanelHeader" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource ControlBrush}"/>
        <Setter Property="BorderBrush"     Value="#999"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding"         Value="3,1"/>
        <Setter Property="Height"          Value="20"/>
    </Style>

    <Style x:Key="CprsPanelHeaderText" TargetType="TextBlock">
        <Setter Property="FontWeight"       Value="SemiBold"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="Foreground"       Value="{StaticResource NavyBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  CPRS cover-sheet panel container (TORListBox in Delphi)          -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="CprsPanel" TargetType="Border">
        <Setter Property="BorderBrush"     Value="#808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background"      Value="White"/>
        <Setter Property="Margin"          Value="1"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Patient Record Flag text (maroon bold, like CPRS lstFlag)        -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="FlagText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MaroonBrush}"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="Margin"     Value="2,0"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Abnormal lab result text (red)                                    -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="AbnormalText" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource RedBrush}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Section header (like CPRS panel titles in forms like fNotes)     -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
        <Setter Property="Margin"     Value="0,4,0,2"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Patient toolbar panels (border with 3D raised look)              -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ToolbarPanel" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource ControlBrush}"/>
        <Setter Property="BorderBrush"     Value="#999"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin"          Value="2,3"/>
        <Setter Property="Padding"         Value="4,2"/>
    </Style>

    <Style x:Key="PatientNameText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
    </Style>

    <Style x:Key="ToolbarLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Foreground" Value="Black"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  RadioButton (patient list type selector in frmPtSel)             -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize"  Value="11"/>
        <Setter Property="Margin"    Value="2,1"/>
        <Setter Property="Padding"   Value="2,0"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin"   Value="2,1"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Error / status message                                            -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground"    Value="#CC0000"/>
        <Setter Property="FontSize"      Value="11"/>
        <Setter Property="TextWrapping"  Value="Wrap"/>
        <Setter Property="Margin"        Value="0,2"/>
    </Style>

    <!-- ═════════════════════════════════════════════════════════════════ -->
    <!--  Monospace list item (Courier New, like CPRS TORListBox)          -->
    <!-- ═════════════════════════════════════════════════════════════════ -->
    <Style x:Key="MonoListItem" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Margin"     Value="1,0"/>
    </Style>

</ResourceDictionary>
