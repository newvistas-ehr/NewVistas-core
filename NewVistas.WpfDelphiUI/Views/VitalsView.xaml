<UserControl x:Class="NewVistas.WpfDelphiUI.Views.VitalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NewVistas.WpfDelphiUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:VitalsViewModel}"
             Background="White">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CprsPanelHeader}">
            <DockPanel>
                <TextBlock Text="Vital Signs" Style="{StaticResource CprsPanelHeaderText}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="History" Margin="4,0" Padding="8,2"
                            Command="{Binding ToggleHistoryCommand}"/>
                    <Button Content="Enter Vitals" Margin="4,0" Padding="8,2"
                            Command="{Binding ToggleRecordFormCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>

        <!-- Record Vitals Form -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="8" Visibility="{Binding ShowRecordForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <UniformGrid Columns="4" Margin="0,0,0,4">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Temperature"/>
                        <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Pulse"/>
                        <TextBox Text="{Binding Pulse, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Respiration"/>
                        <TextBox Text="{Binding Respiration, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Blood Pressure"/>
                        <TextBox Text="{Binding BloodPressure, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <UniformGrid Columns="4" Margin="0,0,0,4">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Height"/>
                        <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Weight"/>
                        <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Pain (0-10)"/>
                        <TextBox Text="{Binding Pain, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Pulse Ox %"/>
                        <TextBox Text="{Binding PulseOximetry, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Record" Padding="16,2" Margin="0,0,4,0"
                            Command="{Binding RecordVitalsCommand}"/>
                    <Button Content="Cancel" Padding="16,2"
                            Command="{Binding ToggleRecordFormCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- History panel -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,1,0,0"
                Padding="8" Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding HistoryFrom}" Width="140" Margin="0,0,12,0"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding HistoryTo}" Width="140" Margin="0,0,12,0"/>
                    <Button Content="Load History" Padding="12,2"
                            Command="{Binding LoadHistoryCommand}"/>
                </StackPanel>
                <ListView ItemsSource="{Binding HistoryVitals}" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Vital"     Width="140"
                                            DisplayMemberBinding="{Binding VitalType}"/>
                            <GridViewColumn Header="Value"     Width="100"
                                            DisplayMemberBinding="{Binding Value}"/>
                            <GridViewColumn Header="Units"     Width="80"
                                            DisplayMemberBinding="{Binding Units}"/>
                            <GridViewColumn Header="Flag"      Width="80"
                                            DisplayMemberBinding="{Binding IsAbnormal}"/>
                            <GridViewColumn Header="Date/Time" Width="160"
                                            DisplayMemberBinding="{Binding TakenDate}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <ListView ItemsSource="{Binding Vitals}" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Vital"       Width="160"
                                    DisplayMemberBinding="{Binding VitalType}"/>
                    <GridViewColumn Header="Value"       Width="100"
                                    DisplayMemberBinding="{Binding Value}"/>
                    <GridViewColumn Header="Units"       Width="80"
                                    DisplayMemberBinding="{Binding Units}"/>
                    <GridViewColumn Header="Taken"       Width="160"
                                    DisplayMemberBinding="{Binding TakenDate}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
