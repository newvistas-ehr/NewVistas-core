<UserControl x:Class="NewVistas.WpfDelphiUI.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NewVistas.WpfDelphiUI.ViewModels"
             xmlns:svc="clr-namespace:NewVistas.WpfDelphiUI.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:NotesViewModel}"
             Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Notes list (left panel) -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CprsPanelHeader}">
                <DockPanel>
                    <TextBlock Text="Notes" Style="{StaticResource CprsPanelHeaderText}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="New Note" Margin="4,0" Padding="8,2"
                                Command="{Binding ToggleCreateFormCommand}"/>
                        <Button Content="History" Margin="4,0" Padding="8,2"
                                Command="{Binding ToggleHistoryCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}"
                       Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
            <ListBox ItemsSource="{Binding Notes}"
                     SelectedItem="{Binding SelectedNote}"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type svc:NoteDto}">
                        <StackPanel Margin="2,2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock FontSize="10" Foreground="#555">
                                <Run Text="{Binding Author, Mode=OneWay}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding SignedDate, Mode=OneWay}"/>
                                <Run Text="  ["/>
                                <Run Text="{Binding Status, Mode=OneWay}"/>
                                <Run Text="]"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                      Background="{StaticResource ControlBrush}"/>

        <!-- Right panel: detail or create form -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Style="{StaticResource CprsPanelHeader}">
                <DockPanel>
                    <TextBlock Style="{StaticResource CprsPanelHeaderText}">
                        <Run Text="{Binding SelectedNote.Title, Mode=OneWay, FallbackValue='(no note selected)'}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding SelectedNote.Author, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding SelectedNote, Converter={StaticResource NullToVis}}">
                        <Button Content="Sign Note" Margin="4,0" Padding="8,2"
                                Command="{Binding SignNoteCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Create Note Form -->
            <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                    Padding="8" Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="Title:" Width="50" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                        <TextBlock Text="Type:" Width="40" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding NewDocumentType}" Width="160"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Author:" Width="50" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding NewAuthor, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                    </StackPanel>
                    <TextBlock Text="Note Text:" Margin="0,4,0,2"/>
                    <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="100" TextWrapping="Wrap"
                             FontFamily="Courier New" FontSize="11"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Save Note" Padding="16,2" Margin="0,0,4,0"
                                Command="{Binding CreateNoteCommand}"/>
                        <Button Content="Cancel" Padding="16,2"
                                Command="{Binding ToggleCreateFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Note History -->
            <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,1,0,0"
                    Padding="8" Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding HistoryFrom}" Width="140" Margin="0,0,12,0"/>
                        <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <DatePicker SelectedDate="{Binding HistoryTo}" Width="140" Margin="0,0,12,0"/>
                        <Button Content="Load History" Padding="12,2"
                                Command="{Binding LoadHistoryCommand}"/>
                    </StackPanel>
                    <ListView ItemsSource="{Binding HistoryNotes}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" Width="140"
                                                DisplayMemberBinding="{Binding SignedDate}"/>
                                <GridViewColumn Header="Type" Width="120"
                                                DisplayMemberBinding="{Binding DocumentType}"/>
                                <GridViewColumn Header="Title" Width="200"
                                                DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Author" Width="140"
                                                DisplayMemberBinding="{Binding Author}"/>
                                <GridViewColumn Header="Status" Width="90"
                                                DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <TextBlock Padding="8" TextWrapping="Wrap"
                       Text="{Binding SelectedNote.DocumentType, FallbackValue=''}"
                       Visibility="{Binding SelectedNote, Converter={StaticResource NullToVis}}"/>
        </DockPanel>
    </Grid>
</UserControl>
