<UserControl x:Class="NewVistas.WpfDelphiUI.Views.SurgeryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NewVistas.WpfDelphiUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SurgeryViewModel}"
             Background="White">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CprsPanelHeader}">
            <DockPanel>
                <TextBlock Text="Surgery" Style="{StaticResource CprsPanelHeaderText}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Schedule Surgery" Margin="4,0" Padding="8,2"
                            Command="{Binding ToggleScheduleFormCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>

        <!-- Schedule Surgery Form -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="8" Visibility="{Binding ShowScheduleForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Procedure:" Width="75" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewProcedure, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Surgeon:" Width="75" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewSurgeon, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,8,0"/>
                    <TextBlock Text="Anesthesia:" Width="75" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AnesthesiaTypes}" SelectedItem="{Binding NewAnesthesiaType}" Width="120"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Schedule" Padding="16,2" Margin="0,0,4,0"
                            Command="{Binding ScheduleSurgeryCommand}"/>
                    <Button Content="Cancel" Padding="16,2"
                            Command="{Binding ToggleScheduleFormCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView ItemsSource="{Binding Surgeries}" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Procedure"     Width="280"
                                    DisplayMemberBinding="{Binding Procedure}"/>
                    <GridViewColumn Header="Surgery Date"  Width="120"
                                    DisplayMemberBinding="{Binding SurgeryDate}"/>
                    <GridViewColumn Header="Surgeon"       Width="180"
                                    DisplayMemberBinding="{Binding Surgeon}"/>
                    <GridViewColumn Header="Status"        Width="100"
                                    DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
