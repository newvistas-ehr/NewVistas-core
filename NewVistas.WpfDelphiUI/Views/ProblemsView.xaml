<UserControl x:Class="NewVistas.WpfDelphiUI.Views.ProblemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NewVistas.WpfDelphiUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProblemsViewModel}"
             Background="White">

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CprsPanelHeader}">
            <DockPanel>
                <TextBlock Text="Problem List" Style="{StaticResource CprsPanelHeaderText}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Add Problem" Margin="4,0" Padding="8,2"
                            Command="{Binding ToggleAddFormCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorText}"
                   Style="{StaticResource ErrorText}"
                   Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>

        <!-- Add Problem Form -->
        <Border DockPanel.Dock="Top" Background="#F0F0F0" BorderBrush="#C0C0C0" BorderThickness="0,0,0,1"
                Padding="8" Visibility="{Binding ShowAddForm, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="ICD Code:" Width="80" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewIcdCode, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,8,0"/>
                    <TextBlock Text="Description:" Width="80" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" Width="250" Margin="0,0,8,0"/>
                    <TextBlock Text="Onset:" Width="45" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewOnsetDate, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="OK" Padding="16,2" Margin="0,0,4,0"
                            Command="{Binding AddProblemCommand}"/>
                    <Button Content="Cancel" Padding="16,2"
                            Command="{Binding ToggleAddFormCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListView ItemsSource="{Binding Problems}" BorderThickness="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ICD Code"    Width="90"
                                    DisplayMemberBinding="{Binding IcdCode}"/>
                    <GridViewColumn Header="Description" Width="320"
                                    DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Status"      Width="80"
                                    DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="Onset Date"  Width="100"
                                    DisplayMemberBinding="{Binding OnsetDate}"/>
                    <GridViewColumn Header="Provider"    Width="160"
                                    DisplayMemberBinding="{Binding Provider}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
