<Window x:Class="NewVistas.WpfDelphiUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NewVistas.WpfDelphiUI.ViewModels"
        xmlns:views="clr-namespace:NewVistas.WpfDelphiUI.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1024" Height="768"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ControlBrush}">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  DataTemplate map (tab content area dispatches to the right View)   -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:CoverSheetViewModel}">
            <views:CoverSheetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProblemsViewModel}">
            <views:ProblemsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicationsViewModel}">
            <views:MedicationsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesViewModel}">
            <views:NotesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultsViewModel}">
            <views:ConsultsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LabsViewModel}">
            <views:LabsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VitalsViewModel}">
            <views:VitalsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SurgeryViewModel}">
            <views:SurgeryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ── Menu bar (fFrame main menu) ──────────────────────────────── -->
        <Menu DockPanel.Dock="Top"
              Background="{StaticResource ControlBrush}"
              Foreground="Black"
              FontFamily="Segoe UI" FontSize="12">

            <MenuItem Header="_File">
                <MenuItem Header="_Select New Patient..."
                          Command="{Binding SelectPatientCommand}"
                          InputGestureText="Ctrl+P"/>
                <Separator/>
                <MenuItem Header="_Print Chart..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="E_xit"
                          Command="{Binding ExitApplicationCommand}"
                          InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy"    Command="ApplicationCommands.Copy"/>
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll"/>
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Refresh"
                          Command="{Binding RefreshPatientCommand}"
                          InputGestureText="F5"/>
                <Separator/>
                <MenuItem Header="Font Size">
                    <MenuItem Header="Small (10pt)"  Command="{Binding SetFontSizeCommand}" CommandParameter="10"/>
                    <MenuItem Header="Normal (12pt)" Command="{Binding SetFontSizeCommand}" CommandParameter="12"/>
                    <MenuItem Header="Large (14pt)"  Command="{Binding SetFontSizeCommand}" CommandParameter="14"/>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_ZWR Import..."
                          Command="{Binding NavigateToTabCommand}" CommandParameter="9"/>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About NewVistas..."
                          Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ── Status bar (stsArea) ─────────────────────────────────────── -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{StaticResource ControlBrush}"
                   BorderBrush="#999" BorderThickness="0,1,0,0"
                   FontFamily="Segoe UI" FontSize="11">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CurrentUser}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ── Main content ──────────────────────────────────────────────── -->
        <Grid>

            <!-- ── Patient toolbar (pnlToolbar, h=61 in fFrame.dfm) ──────── -->
            <DockPanel DockPanel.Dock="Top"
                       LastChildFill="False"
                       Background="{StaticResource ControlBrush}"
                       Height="64">

                <!-- Patient name panel (pnlPatient) -->
                <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Left"
                        MinWidth="240">
                    <StackPanel>
                        <TextBlock Text="{Binding PatientDisplayName}"
                                   Style="{StaticResource PatientNameText}"
                                   Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding SelectPatientCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{Binding PatientInfoLine}"
                                   Style="{StaticResource ToolbarLabel}"
                                   Foreground="#444"/>
                    </StackPanel>
                </Border>

                <!-- Visit location/provider (pnlVisit) -->
                <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Left"
                        MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="Visit:" Style="{StaticResource ToolbarLabel}" Foreground="{StaticResource NavyBrush}"/>
                        <TextBlock Text="{Binding VisitLocation}"  Style="{StaticResource ToolbarLabel}"/>
                        <TextBlock Text="{Binding VisitProvider}"  Style="{StaticResource ToolbarLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Primary care (pnlPrimaryCare) -->
                <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Left"
                        MinWidth="160">
                    <StackPanel>
                        <TextBlock Text="Primary Provider:" Style="{StaticResource ToolbarLabel}" Foreground="{StaticResource NavyBrush}"/>
                        <TextBlock Text="{Binding PrimaryProvider}"  Style="{StaticResource ToolbarLabel}"/>
                        <TextBlock Text="{Binding AttendingProvider}" Style="{StaticResource ToolbarLabel}"/>
                    </StackPanel>
                </Border>

                <!-- Reminders indicator (pnlReminders) -->
                <Border Style="{StaticResource ToolbarPanel}" DockPanel.Dock="Left"
                        Width="80">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Reminders" Style="{StaticResource ToolbarLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RemindersCount}"
                                   HorizontalAlignment="Center"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{Binding RemindersColor}"/>
                    </StackPanel>
                </Border>

                <!-- Select Patient button -->
                <Button Content="Select Patient"
                        Command="{Binding SelectPatientCommand}"
                        DockPanel.Dock="Right"
                        Margin="4,8" VerticalAlignment="Center"/>

                <!-- Refresh button -->
                <Button Content="Refresh"
                        Command="{Binding RefreshPatientCommand}"
                        DockPanel.Dock="Right"
                        Margin="0,8,4,8" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Thin separator line (bvlPageTop in fFrame.dfm) -->
            <Border Height="2" Background="#999"
                    DockPanel.Dock="Top" VerticalAlignment="Top"
                    Margin="0,64,0,0"/>

            <!-- ── "No patient selected" overlay (pnlNoPatientSelected) ──── -->
            <Border Background="{StaticResource ControlBrush}"
                    Visibility="{Binding HasPatient, Converter={StaticResource InverseBoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No patient selected."
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Use File → Select New Patient or the button above."
                               FontSize="12" Foreground="#555"
                               HorizontalAlignment="Center" Margin="0,6"/>
                    <Button Content="Select Patient..."
                            Command="{Binding SelectPatientCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,10" Padding="20,5"/>
                </StackPanel>
            </Border>

            <!-- ── CPRS Chart TabControl (tabPage in fFrame.dfm) ─────────── -->
            <!--  Tabs: Cover Sheet | Problems | Meds | Orders | Notes |       -->
            <!--        Consults | Labs | Vitals | Surgery | Reports           -->
            <TabControl SelectedIndex="{Binding SelectedChartTab}"
                        Margin="0,66,0,0"
                        Background="White"
                        BorderBrush="#808080" BorderThickness="0,1,0,0"
                        Visibility="{Binding HasPatient, Converter={StaticResource BoolToVis}}"
                        IsEnabled="{Binding ShowClinicalTabs}">

                <TabItem Header="Cover Sheet">
                    <ContentControl Content="{Binding CoverSheetVm}"/>
                </TabItem>

                <TabItem Header="Problems">
                    <ContentControl Content="{Binding ProblemsVm}"/>
                </TabItem>

                <TabItem Header="Meds">
                    <ContentControl Content="{Binding MedicationsVm}"/>
                </TabItem>

                <TabItem Header="Orders">
                    <ContentControl Content="{Binding OrdersVm}"/>
                </TabItem>

                <TabItem Header="Notes">
                    <ContentControl Content="{Binding NotesVm}"/>
                </TabItem>

                <TabItem Header="Consults">
                    <ContentControl Content="{Binding ConsultsVm}"/>
                </TabItem>

                <TabItem Header="Labs">
                    <ContentControl Content="{Binding LabsVm}"/>
                </TabItem>

                <TabItem Header="Vitals">
                    <ContentControl Content="{Binding VitalsVm}"/>
                </TabItem>

                <TabItem Header="Surgery">
                    <ContentControl Content="{Binding SurgeryVm}"/>
                </TabItem>

                <TabItem Header="Reports">
                    <ContentControl Content="{Binding ReportsVm}"/>
                </TabItem>

            </TabControl>

        </Grid>
    </DockPanel>
</Window>
