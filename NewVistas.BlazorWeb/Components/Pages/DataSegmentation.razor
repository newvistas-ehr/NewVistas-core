@page "/ds4p"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Data Segmentation for Privacy</PageTitle>
<h1>Data Segmentation for Privacy (DS4P)</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }

<div class="tab-bar">
    <button class="tab @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">Patient Segments</button>
    <button class="tab @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Apply Labels</button>
</div>

@* ── Patient Segments / Analysis Tab ── *@
@if (activeTab == 0)
{
    <div class="form-section">
        <h3>Analyze Received C-CDA for DS4P Tags</h3>
        <div class="form-row">
            <label>Patient ID</label>
            <input type="text" class="form-input" @bind="analyzePatientId" placeholder="Patient ID" />
        </div>
        <div class="form-row">
            <label>Message ID</label>
            <input type="text" class="form-input" @bind="analyzeMessageId" placeholder="Message or document ID" />
        </div>
        <div class="form-row">
            <label>C-CDA Content</label>
            <textarea class="form-textarea" @bind="analyzeCcdaContent" placeholder="Paste C-CDA XML here..."></textarea>
        </div>
        <div class="form-actions">
            <button @onclick="AnalyzeCcda" disabled="@(string.IsNullOrWhiteSpace(analyzePatientId) || string.IsNullOrWhiteSpace(analyzeCcdaContent) || analyzing)" class="btn btn-primary">
                @if (analyzing) { <span>Analyzing...</span> } else { <span>Analyze Document</span> }
            </button>
        </div>
    </div>

    @if (analysisResult != null)
    {
        <div class="detail-card">
            <h3>DS4P Analysis Result</h3>
            <div class="detail-grid">
                <div><strong>Has DS4P Tags:</strong> @(analysisResult.HasDs4pTags ? "Yes" : "No")</div>
                <div><strong>Document Confidentiality:</strong> <span class="badge @ConfBadgeClass(analysisResult.DocumentConfidentialityCode)">@analysisResult.DocumentConfidentialityCode</span></div>
                <div><strong>Has DS4P Template ID:</strong> @(analysisResult.HasDs4pTemplateId ? "Yes" : "No")</div>
                <div><strong>Analyzed:</strong> @analysisResult.AnalyzedDate.ToString("MM/dd/yyyy HH:mm")</div>
            </div>

            @if (analysisResult.ObligationPolicies.Count > 0)
            {
                <div class="tag-section">
                    <strong>Obligation Policies:</strong>
                    @foreach (var p in analysisResult.ObligationPolicies) { <span class="tag">@p</span> }
                </div>
            }

            @if (analysisResult.RefrainPolicies.Count > 0)
            {
                <div class="tag-section">
                    <strong>Refrain Policies:</strong>
                    @foreach (var p in analysisResult.RefrainPolicies) { <span class="tag tag-refrain">@p</span> }
                </div>
            }

            @if (analysisResult.SectionTags.Count > 0)
            {
                <h4>Section-Level Tags</h4>
                <table class="data-table">
                    <thead><tr><th>Section</th><th>Code</th><th>Confidentiality</th><th>Sensitivity Codes</th><th>Obligations</th><th>Refrains</th></tr></thead>
                    <tbody>
                        @foreach (var s in analysisResult.SectionTags)
                        {
                            <tr>
                                <td>@s.SectionTitle</td>
                                <td class="code">@s.SectionCode</td>
                                <td><span class="badge @ConfBadgeClass(s.ConfidentialityCode)">@s.ConfidentialityCode</span></td>
                                <td>@string.Join(", ", s.SensitivityCodes)</td>
                                <td>@string.Join(", ", s.ObligationPolicies)</td>
                                <td>@string.Join(", ", s.RefrainPolicies)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <div class="form-section" style="margin-top: 2rem;">
        <h3>Retrieve Previous Analysis</h3>
        <div class="form-row">
            <label>Patient ID</label>
            <input type="text" class="form-input" @bind="retrievePatientId" placeholder="Patient ID" />
        </div>
        <div class="form-row">
            <label>Message ID</label>
            <input type="text" class="form-input" @bind="retrieveMessageId" placeholder="Message ID" />
            <button @onclick="RetrieveAnalysis" disabled="@(string.IsNullOrWhiteSpace(retrievePatientId) || string.IsNullOrWhiteSpace(retrieveMessageId) || retrieving)" class="btn btn-primary">
                @if (retrieving) { <span>Loading...</span> } else { <span>Retrieve</span> }
            </button>
        </div>
    </div>
}

@* ── Apply Labels / Generate Tab ── *@
@if (activeTab == 1)
{
    <div class="form-section">
        <h3>Generate DS4P-Tagged C-CDA</h3>
        <p class="help-text">Generate a C-CDA document with HL7 DS4P security tags applied to sections containing sensitive data.</p>
        <div class="form-row">
            <label>Patient ID</label>
            <input type="text" class="form-input" @bind="genPatientId" placeholder="Patient ID" />
        </div>
        <div class="form-row">
            <label>Document Type</label>
            <select class="form-input" @bind="genDocType">
                <option value="CCD">CCD (Continuity of Care)</option>
                <option value="REFERRAL">Referral Note</option>
                <option value="DISCHARGE">Discharge Summary</option>
            </select>
        </div>
        <div class="sensitivity-picker">
            <label><strong>Sensitivity Categories to Tag:</strong></label>
            <div class="checkbox-grid">
                @foreach (var cat in sensitivityOptions)
                {
                    var catCode = cat.Code;
                    <label class="checkbox-label">
                        <input type="checkbox"
                               checked="@selectedSensitivities.Contains(catCode)"
                               @onchange="e => ToggleSensitivity(catCode, (bool)(e.Value ?? false))" />
                        @cat.Label
                    </label>
                }
            </div>
        </div>
        <div class="form-actions">
            <button @onclick="GenerateDs4pCcda" disabled="@(string.IsNullOrWhiteSpace(genPatientId) || selectedSensitivities.Count == 0 || generatingCcda)" class="btn btn-primary">
                @if (generatingCcda) { <span>Generating...</span> } else { <span>Generate DS4P C-CDA</span> }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(generatedCcda))
    {
        <div class="detail-card">
            <h3>Generated DS4P C-CDA</h3>
            <p class="help-text">Document-level confidentialityCode set to "R" (Restricted). Tagged sensitivity categories: @string.Join(", ", selectedSensitivities)</p>
            <pre class="ccda-preview">@generatedCcda.Substring(0, Math.Min(generatedCcda.Length, 2000))@(generatedCcda.Length > 2000 ? "\n... (truncated)" : "")</pre>
        </div>
    }
}

@code {
    private int activeTab;
    private string? error, success;

    // Analyze
    private string analyzePatientId = string.Empty, analyzeMessageId = string.Empty, analyzeCcdaContent = string.Empty;
    private bool analyzing;
    private Ds4pAnalysisResult? analysisResult;

    // Retrieve
    private string retrievePatientId = string.Empty, retrieveMessageId = string.Empty;
    private bool retrieving;

    // Generate
    private string genPatientId = string.Empty, genDocType = "CCD";
    private HashSet<string> selectedSensitivities = new() { "ETH", "PSY" };
    private bool generatingCcda;
    private string? generatedCcda;

    private static readonly (string Code, string Label)[] sensitivityOptions = new[]
    {
        ("ETH", "Substance Abuse (42 CFR Part 2)"),
        ("PSY", "Mental Health"),
        ("HIV", "HIV/AIDS"),
        ("SDV", "Sexual Assault / Domestic Violence"),
        ("SEX", "Sexuality / Reproductive Health"),
        ("GDIS", "Genetic Information (GINA)"),
        ("SCD", "Sickle Cell Disease")
    };

    private static string ConfBadgeClass(string code) => code switch
    {
        "N" => "badge-success",      // Normal
        "R" => "badge-warning",      // Restricted
        "V" => "badge-danger",       // Very Restricted
        _   => "badge-neutral",
    };

    private void ToggleSensitivity(string code, bool isChecked)
    {
        if (isChecked) selectedSensitivities.Add(code);
        else selectedSensitivities.Remove(code);
    }

    private async Task AnalyzeCcda()
    {
        if (string.IsNullOrWhiteSpace(analyzePatientId) || string.IsNullOrWhiteSpace(analyzeCcdaContent)) return;
        analyzing = true; error = null; success = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(analyzePatientId.Trim());
            string msgId = string.IsNullOrWhiteSpace(analyzeMessageId) ? $"DS4P-{Guid.NewGuid():N}" : analyzeMessageId.Trim();
            analysisResult = await workflow.AnalyzeDs4pCcdaAsync(msgId, analyzeCcdaContent);
            success = "Analysis complete.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { analyzing = false; }
    }

    private async Task RetrieveAnalysis()
    {
        if (string.IsNullOrWhiteSpace(retrievePatientId) || string.IsNullOrWhiteSpace(retrieveMessageId)) return;
        retrieving = true; error = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(retrievePatientId.Trim());
            analysisResult = await workflow.GetDs4pAnalysisAsync(retrieveMessageId.Trim());
        }
        catch (Exception ex) { error = ex.Message; }
        finally { retrieving = false; }
    }

    private async Task GenerateDs4pCcda()
    {
        if (string.IsNullOrWhiteSpace(genPatientId) || selectedSensitivities.Count == 0) return;
        generatingCcda = true; error = null; success = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(genPatientId.Trim());
            generatedCcda = await workflow.GenerateDs4pCcdaAsync(genDocType, selectedSensitivities.ToList());
            success = "DS4P-tagged C-CDA generated.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { generatingCcda = false; }
    }
}

<style>
    /* Canonical interaction classes (btn, btn-primary, alert, alert-error,
       alert-success, tab-bar, tab, data-table, badge, badge-*, empty-state,
       form-input) are defined once in app.css per UI-CONVENTIONS.md.
       Only page-specific styles live here. */
    h1 { color: #003f72; }
    .help-text { color: #555; font-size: 0.85rem; margin-bottom: 1rem; }
    .form-section { max-width: 700px; } .form-section h3 { color: #003f72; }
    .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row label:first-child { width: 160px; font-size: 0.85rem; font-weight: 500; color: #555; flex-shrink: 0; }
    .form-textarea { width: 100%; min-height: 120px; padding: 0.5rem; border: 1px solid #d4d9e0; border-radius: 4px; font-size: 0.85rem; background: #fff; color: #333; resize: vertical; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1rem; margin-bottom: 1.5rem; }
    .sensitivity-picker { margin-bottom: 1rem; } .sensitivity-picker > label { display: block; margin-bottom: 0.5rem; color: #555; font-size: 0.85rem; }
    .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
    .checkbox-label { font-size: 0.85rem; color: #333; display: flex; align-items: center; gap: 0.5rem; }
    .code { font-family: monospace; color: #003f72; }
    .detail-card { background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 6px; padding: 1.5rem; margin-bottom: 1rem; }
    .detail-card h3 { color: #003f72; margin-top: 0; } .detail-card h4 { color: #003f72; margin-bottom: 0.5rem; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 2rem; font-size: 0.85rem; color: #333; margin-bottom: 1rem; }
    .detail-grid strong { color: #003f72; }
    .tag-section { margin-bottom: 0.75rem; font-size: 0.85rem; color: #333; }
    .tag { display: inline-block; padding: 0.15rem 0.5rem; margin: 0.2rem; background: #dbeafe; color: #1e40af; border-radius: 3px; font-size: 0.8rem; }
    .tag-refrain { background: #fde8e8; color: #b91c1c; }
    .ccda-preview { background: #f4f6f9; border: 1px solid #d4d9e0; border-radius: 4px; padding: 1rem; font-size: 0.75rem; color: #333; font-family: monospace; overflow-x: auto; max-height: 400px; overflow-y: auto; white-space: pre-wrap; word-break: break-all; }
</style>
