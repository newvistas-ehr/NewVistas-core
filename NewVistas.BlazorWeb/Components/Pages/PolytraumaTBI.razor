@page "/polytrauma"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Polytrauma / TBI</PageTitle>

<h2>Polytrauma / TBI</h2>

<div class="tab-bar">
    <button class="@TabClass(1)" @onclick="() => activeTab = 1">Registry</button>
    <button class="@TabClass(2)" @onclick="() => activeTab = 2">TBI Screenings</button>
    <button class="@TabClass(3)" @onclick="() => activeTab = 3">Record</button>
</div>

@if (error != null)
{
    <div class="error-banner">@error</div>
}

@* ── Tab 1: Registry ───────────────────────────────────────────────────────── *@
@if (activeTab == 1)
{
    <div class="toolbar">
        <label>
            <input type="checkbox" @bind="showActiveOnly" @bind:after="LoadRegistry" /> Active only
        </label>
        <button @onclick="LoadRegistry" disabled="@loadingRegistry">Refresh</button>
    </div>

    @if (loadingRegistry)
    {
        <p>Loading registry...</p>
    }
    else if (registryEntries.Count == 0)
    {
        <p class="empty">No polytrauma patients found.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Status</th>
                    <th>Mechanism</th>
                    <th>Injuries</th>
                    <th>ISS</th>
                    <th>TBI Severity</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in registryEntries)
                {
                    <tr class="@(selectedPatientId == p.PatientId ? "selected-row" : "")"
                        @onclick="() => SelectRegistryPatient(p.PatientId)">
                        <td>@p.PatientName<br /><small>@p.PatientId</small></td>
                        <td><span class="badge badge-@p.Status.ToString().ToLower()">@p.Status</span></td>
                        <td>@p.PrimaryCareTeam</td>
                        <td>@p.InjuryCount</td>
                        <td>@p.IssTotalScore</td>
                        <td>@(p.TBISeverity.HasValue ? p.TBISeverity.ToString() : "—")</td>
                        <td>@p.RegistrationDate.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (selectedRecord != null)
        {
            <div class="detail-panel">
                <h4>@selectedRecord.PatientName — Injuries</h4>
                @if (selectedRecord.Injuries.Count == 0)
                {
                    <p class="empty">No injuries documented.</p>
                }
                else
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Region</th>
                                <th>Description</th>
                                <th>AIS</th>
                                <th>Severity</th>
                                <th>Resolved</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inj in selectedRecord.Injuries)
                            {
                                <tr>
                                    <td>@inj.BodyRegion</td>
                                    <td>@inj.InjuryDescription</td>
                                    <td>@inj.AisScore</td>
                                    <td>@inj.SeverityScore</td>
                                    <td>@(inj.ResolvedDate.HasValue ? inj.ResolvedDate.Value.ToString("yyyy-MM-dd") : "Ongoing")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
}

@* ── Tab 2: TBI Screenings ────────────────────────────────────────────────── *@
@if (activeTab == 2)
{
    <div class="search-bar">
        <input @bind="screeningPatientId" placeholder="Patient ID" />
        <button @onclick="LoadScreenings" disabled="@loadingScreenings">Load Screenings</button>
    </div>

    @if (loadingScreenings)
    {
        <p>Loading screenings...</p>
    }
    else if (screenings.Count == 0 && !string.IsNullOrEmpty(screeningPatientId))
    {
        <p class="empty">No screenings found for this patient.</p>
    }
    else if (screenings.Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Result</th>
                    <th>Screener</th>
                    <th>Encounter</th>
                    <th>Full Eval</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in screenings)
                {
                    <tr class="@(selectedScreeningId == s.ScreeningId ? "selected-row" : "")"
                        @onclick="() => SelectScreening(s.ScreeningId)">
                        <td>@s.ScreeningDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge badge-@ResultClass(s.Result)">@s.Result</span></td>
                        <td>@s.ScreenedByName</td>
                        <td>—</td>
                        <td>@(s.TriggeredFullEvaluation ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (selectedScreening != null)
        {
            <div class="detail-panel">
                <h4>Screening @selectedScreening.ScreeningDate.ToString("yyyy-MM-dd") — Q&A</h4>
                <table class="data-table">
                    <thead>
                        <tr><th>#</th><th>Question</th><th>Answer</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var ans in selectedScreening.Answers)
                        {
                            <tr>
                                <td>@ans.QuestionNumber</td>
                                <td>@ans.QuestionText</td>
                                <td>@(ans.Answer ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (selectedScreening.ConfirmedTBISeverity.HasValue)
                {
                    <p><strong>Confirmed TBI Severity:</strong> @selectedScreening.ConfirmedTBISeverity</p>
                }
            </div>
        }
    }
}

@* ── Tab 3: Record ────────────────────────────────────────────────────────── *@
@if (activeTab == 3)
{
    <div class="sub-tabs">
        <button class="@SubTabClass(1)" @onclick="() => activeSubTab = 1">New TBI Screening</button>
        <button class="@SubTabClass(2)" @onclick="() => activeSubTab = 2">Register Polytrauma Patient</button>
    </div>

    @* Sub-tab A: New TBI Screening *@
    @if (activeSubTab == 1)
    {
        <div class="form-section">
            <h4>New TBI Screening</h4>
            <div class="form-row">
                <label>Patient ID</label>
                <input @bind="newScreen.PatientId" placeholder="Patient ID" />
            </div>
            <div class="form-row">
                <label>Patient Name</label>
                <input @bind="newScreen.PatientName" />
            </div>
            <div class="form-row">
                <label>Screening Date</label>
                <input type="datetime-local" @bind="newScreen.ScreeningDate" />
            </div>
            <div class="form-row">
                <label>Location</label>
                <input @bind="newScreen.ScreeningLocation" />
            </div>
            <div class="form-row">
                <label>Screener ID</label>
                <input @bind="newScreen.ScreenedById" />
            </div>
            <div class="form-row">
                <label>Screener Name</label>
                <input @bind="newScreen.ScreenedByName" />
            </div>
            <div class="form-row">
                <label>Encounter Type</label>
                <select @bind="newScreen.EncounterType">
                    <option value="">-- Select --</option>
                    <option>Primary Care</option>
                    <option>Post-Deployment</option>
                    <option>Specialty</option>
                    <option>Telehealth</option>
                </select>
            </div>

            <h5>DVBIC TBI Screening Questions</h5>
            @foreach (var q in dvbicQuestions)
            {
                <div class="form-row question-row">
                    <label>@q.Number. @q.Text</label>
                    <label class="radio-label">
                        <input type="radio" name="q@(q.Number)" value="yes"
                               @onchange="() => SetAnswer(q.Number, true)" /> Yes
                    </label>
                    <label class="radio-label">
                        <input type="radio" name="q@(q.Number)" value="no"
                               @onchange="() => SetAnswer(q.Number, false)" /> No
                    </label>
                </div>
            }

            <div class="form-row">
                <label>Notes</label>
                <textarea @bind="newScreen.Notes" rows="2"></textarea>
            </div>
            <div class="form-row">
                <label>Result</label>
                <select @bind="newScreen.Result">
                    <option value="@TBIScreeningResult.Negative">Negative</option>
                    <option value="@TBIScreeningResult.PositiveRequiresEvaluation">Positive — Requires Evaluation</option>
                    <option value="@TBIScreeningResult.Inconclusive">Inconclusive</option>
                </select>
            </div>

            <button @onclick="SubmitScreening" disabled="@submitting">Submit Screening</button>
            @if (submitMessage != null)
            {
                <p class="submit-msg">@submitMessage</p>
            }
        </div>
    }

    @* Sub-tab B: Register Polytrauma Patient *@
    @if (activeSubTab == 2)
    {
        <div class="form-section">
            <h4>Register Polytrauma Patient</h4>
            <div class="form-row">
                <label>Patient ID</label>
                <input @bind="newReg.PatientId" />
            </div>
            <div class="form-row">
                <label>Patient Name</label>
                <input @bind="newReg.PatientName" />
            </div>
            <div class="form-row">
                <label>Date of Birth</label>
                <input type="date" @bind="newReg.DateOfBirth" />
            </div>
            <div class="form-row">
                <label>Trauma Mechanism</label>
                <select @bind="newReg.TraumaMechanism">
                    @foreach (var m in Enum.GetValues<TraumaMechanism>())
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label>Trauma Date</label>
                <input type="date" @bind="newReg.TraumaDate" />
            </div>
            <div class="form-row">
                <label>Trauma Location</label>
                <input @bind="newReg.TraumaLocation" />
            </div>
            <div class="form-row">
                <label>Network Site</label>
                <select @bind="newReg.PolytraumaNetworkSite">
                    <option value="">-- Select --</option>
                    <option>PRC</option>
                    <option>PTRP</option>
                    <option>PSC</option>
                    <option>LPPOC</option>
                </select>
            </div>
            <div class="form-row">
                <label>Referral Source</label>
                <input @bind="newReg.ReferralSource" />
            </div>
            <div class="form-row">
                <label>Primary Team ID</label>
                <input @bind="newReg.PrimaryTeamId" />
            </div>
            <div class="form-row">
                <label>Primary Team Name</label>
                <input @bind="newReg.PrimaryTeamName" />
            </div>
            <div class="form-row">
                <label>Case Manager ID</label>
                <input @bind="newReg.CaseManagerId" />
            </div>
            <div class="form-row">
                <label>Case Manager Name</label>
                <input @bind="newReg.CaseManagerName" />
            </div>
            <div class="form-row">
                <label>Notes</label>
                <textarea @bind="newReg.Notes" rows="2"></textarea>
            </div>

            <h5>Add Initial Injury</h5>
            <div class="form-row">
                <label>Body Region</label>
                <select @bind="newInjury.BodyRegion">
                    @foreach (var r in Enum.GetValues<BodyRegion>())
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="form-row">
                <label>Injury Description</label>
                <input @bind="newInjury.InjuryDescription" />
            </div>
            <div class="form-row">
                <label>AIS Score (1–6)</label>
                <input type="number" min="1" max="6" @bind="newInjury.AisScore" />
            </div>
            <div class="form-row">
                <label>Severity Category</label>
                <select @bind="newInjury.SeverityScore">
                    @foreach (var s in Enum.GetValues<InjurySeverityScore>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <button @onclick="SubmitRegistration" disabled="@submitting">Register Patient</button>
            @if (submitMessage != null)
            {
                <p class="submit-msg">@submitMessage</p>
            }
        </div>
    }
}

<style>
    .tab-bar { display: flex; gap: 4px; margin-bottom: 16px; }
    .tab-btn { padding: 6px 16px; border: 1px solid #555; background: #2a2a2a; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0; }
    .tab-btn.active { background: #1a3a5c; color: #fff; border-bottom-color: #1a3a5c; }
    .sub-tabs { display: flex; gap: 4px; margin: 12px 0; }
    .sub-tab-btn { padding: 5px 12px; border: 1px solid #444; background: #222; color: #ccc; cursor: pointer; border-radius: 4px; }
    .sub-tab-btn.active { background: #2a4a6a; color: #fff; }
    .toolbar { display: flex; gap: 12px; align-items: center; margin-bottom: 12px; }
    .search-bar { display: flex; gap: 8px; margin-bottom: 12px; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .data-table th { background: #1e2a38; color: #8ab4d8; padding: 6px 8px; text-align: left; }
    .data-table td { padding: 5px 8px; border-bottom: 1px solid #2a2a2a; }
    .data-table tr:hover { background: #1a2535; cursor: pointer; }
    .selected-row { background: #1a3a5c !important; }
    .empty { color: #888; font-style: italic; }
    .error-banner { background: #5c1a1a; color: #ffaaaa; padding: 8px; margin-bottom: 12px; border-radius: 4px; }
    .detail-panel { background: #1a2535; border: 1px solid #2a4a6a; border-radius: 6px; padding: 16px; margin-top: 16px; }
    .form-section { max-width: 700px; }
    .form-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }
    .form-row label:first-child { width: 160px; min-width: 160px; color: #8ab4d8; font-size: 13px; }
    .form-row input, .form-row select, .form-row textarea { flex: 1; background: #1a2535; border: 1px solid #2a4a6a; color: #e0e0e0; padding: 4px 8px; border-radius: 4px; font-size: 13px; }
    .question-row { flex-direction: column; align-items: flex-start; }
    .question-row label:first-child { width: auto; }
    .radio-label { margin-left: 16px; }
    .badge { padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: bold; }
    .badge-active { background: #1a4a1a; color: #88dd88; }
    .badge-inactive { background: #3a3a1a; color: #dddd88; }
    .badge-transferred { background: #1a1a4a; color: #8888dd; }
    .badge-deceased { background: #3a1a1a; color: #dd8888; }
    .badge-negative { background: #1a4a1a; color: #88dd88; }
    .badge-positiverequiresevaluation { background: #4a1a1a; color: #dd8888; }
    .badge-inconclusive { background: #3a3a1a; color: #dddd88; }
    .submit-msg { color: #88dd88; margin-top: 8px; }
    button { padding: 6px 16px; background: #1a3a5c; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #2a5a8c; }
    button:disabled { opacity: 0.5; cursor: not-allowed; }
    h5 { color: #8ab4d8; margin: 16px 0 8px; }
</style>

@code {
    private int activeTab = 1;
    private int activeSubTab = 1;
    private string? error;
    private string? submitMessage;
    private bool submitting;

    // ── Registry ──────────────────────────────────────────────────────────────
    private bool loadingRegistry;
    private bool showActiveOnly = true;
    private List<RegistryEntryDto> registryEntries = new();
    private string? selectedPatientId;
    private PolytraumaRecordDto? selectedRecord;

    // ── Screenings ────────────────────────────────────────────────────────────
    private bool loadingScreenings;
    private string screeningPatientId = string.Empty;
    private List<ScreeningSummaryDto> screenings = new();
    private string? selectedScreeningId;
    private ScreeningDetailDto? selectedScreening;

    // ── New Screening form ────────────────────────────────────────────────────
    private NewScreeningForm newScreen = new();
    private Dictionary<int, bool> answerMap = new();

    // ── New Registration form ─────────────────────────────────────────────────
    private NewRegForm newReg = new();
    private NewInjuryForm newInjury = new();

    // DVBIC 4-question TBI screen
    private static readonly List<DvbicQuestion> dvbicQuestions = new()
    {
        new(1, "Did you have any injury to your head or neck (e.g., any blow, bump, or jolt to your head)?"),
        new(2, "Did you have any of these problems right after the injury? (Losing consciousness, feeling dazed or confused, not remembering the injury)"),
        new(3, "Did you have any of these problems that started soon after the injury and lasted more than a day? (Memory problems, balance problems, sensitivity to light or noise, irritability, sleep problems, headaches)"),
        new(4, "Do you CURRENTLY have any of these problems? (Memory problems, balance problems, sensitivity to light or noise, irritability, sleep problems, headaches)")
    };

    protected override async Task OnInitializedAsync() => await LoadRegistry();

    private string TabClass(int tab) => $"tab-btn{(activeTab == tab ? " active" : "")}";
    private string SubTabClass(int tab) => $"sub-tab-btn{(activeSubTab == tab ? " active" : "")}";
    private string ResultClass(TBIScreeningResult r) => r switch
    {
        TBIScreeningResult.Negative => "negative",
        TBIScreeningResult.PositiveRequiresEvaluation => "positiverequiresevaluation",
        _ => "inconclusive"
    };

    private async Task LoadRegistry()
    {
        loadingRegistry = true;
        error = null;
        try
        {
            var regIdx = Grains.GetGrain<IPolytraumaRegistryIndexGrain>("PT-REGISTRY-IDX");
            var rawEntries = showActiveOnly ? await regIdx.GetActivePatientAsync() : await regIdx.GetAllPatientsAsync();
            registryEntries = rawEntries.Select(e => new RegistryEntryDto
            {
                PatientId = e.PatientId, PatientName = e.PatientName,
                Status = e.Status, PrimaryCareTeam = e.PrimaryCareTeam,
                InjuryCount = e.InjuryCount, IssTotalScore = e.IssTotalScore,
                TBISeverity = e.TBISeverity, RegistrationDate = e.RegistrationDate
            }).ToList();
            selectedPatientId = null;
            selectedRecord = null;
        }
        catch (Exception ex)
        {
            error = $"Error loading registry: {ex.Message}";
        }
        finally
        {
            loadingRegistry = false;
        }
    }

    private async Task SelectRegistryPatient(string patientId)
    {
        selectedPatientId = patientId;
        selectedRecord = null;
        try
        {
            var ptGrain = Grains.GetGrain<IPolytraumaRecordGrain>($"PT-RECORD:{patientId}");
            var ptState = await ptGrain.GetRecordAsync();
            selectedRecord = new PolytraumaRecordDto
            {
                PatientId = ptState.PatientId, PatientName = ptState.PatientName,
                Injuries = ptState.Injuries.Select(i => new InjuryDto
                {
                    InjuryId = i.InjuryId, BodyRegion = i.BodyRegion,
                    InjuryDescription = i.InjuryDescription, AisScore = i.AisScore,
                    SeverityScore = i.SeverityScore, ResolvedDate = i.ResolvedDate, Notes = i.Notes
                }).ToList()
            };
        }
        catch
        {
            error = "Could not load patient record.";
        }
    }

    private async Task LoadScreenings()
    {
        if (string.IsNullOrWhiteSpace(screeningPatientId)) return;
        loadingScreenings = true;
        error = null;
        try
        {
            var scrIdx = Grains.GetGrain<ITBIScreeningIndexGrain>($"TBI-SCREEN-IDX:{screeningPatientId.Trim()}");
            screenings = (await scrIdx.GetAllScreeningsAsync()).Select(s => new ScreeningSummaryDto
            {
                ScreeningId = s.ScreeningId, ScreeningDate = s.ScreeningDate,
                Result = s.Result, ScreenedByName = s.ScreenedByName
            }).ToList();
            selectedScreeningId = null;
            selectedScreening = null;
        }
        catch (Exception ex)
        {
            error = $"Error loading screenings: {ex.Message}";
        }
        finally
        {
            loadingScreenings = false;
        }
    }

    private async Task SelectScreening(string screeningId)
    {
        selectedScreeningId = screeningId;
        selectedScreening = null;
        try
        {
            var scrGrain = Grains.GetGrain<ITBIScreeningGrain>(screeningId);
            var scrState = await scrGrain.GetScreeningAsync();
            selectedScreening = new ScreeningDetailDto
            {
                ScreeningId = screeningId,
                ScreeningDate = scrState.ScreeningDate, Result = scrState.Result,
                ConfirmedTBISeverity = scrState.ConfirmedTBISeverity,
                Answers = scrState.Answers.Select(a => new AnswerDto
                {
                    QuestionNumber = a.QuestionNumber, QuestionText = a.QuestionText, Answer = a.Answer
                }).ToList()
            };
        }
        catch
        {
            error = "Could not load screening detail.";
        }
    }

    private void SetAnswer(int questionNum, bool answer) => answerMap[questionNum] = answer;

    private async Task SubmitScreening()
    {
        if (string.IsNullOrWhiteSpace(newScreen.PatientId)) { submitMessage = "Patient ID is required."; return; }
        submitting = true;
        submitMessage = null;
        try
        {
            var answers = dvbicQuestions.Select(q => new TBIAnswerDto(
                q.Number, q.Text, answerMap.TryGetValue(q.Number, out bool a) && a)).ToList();

            var payload = new
            {
                patientName = newScreen.PatientName,
                screeningDate = newScreen.ScreeningDate,
                screeningLocation = newScreen.ScreeningLocation,
                screenedById = newScreen.ScreenedById,
                screenedByName = newScreen.ScreenedByName,
                encounterType = newScreen.EncounterType,
                answers,
                notes = newScreen.Notes
            };

            string scrId = $"TBI-SCREEN:{Guid.NewGuid()}";
            var newScrGrain = Grains.GetGrain<ITBIScreeningGrain>(scrId);
            var tbiAnswers = dvbicQuestions.Select(q => new TBIScreeningAnswer
            {
                QuestionNumber = q.Number, QuestionText = q.Text,
                Answer = answerMap.TryGetValue(q.Number, out bool a) && a
            }).ToList();
            await newScrGrain.CreateScreeningAsync(
                newScreen.PatientId.Trim(), newScreen.PatientName, newScreen.ScreeningDate,
                newScreen.ScreeningLocation, newScreen.ScreenedById, newScreen.ScreenedByName,
                newScreen.EncounterType, tbiAnswers, newScreen.Notes);
            await newScrGrain.FinalizeScreeningAsync(newScreen.Result,
                newScreen.Result == TBIScreeningResult.PositiveRequiresEvaluation);
            var newScrState = await newScrGrain.GetScreeningAsync();
            var scrIndex = Grains.GetGrain<ITBIScreeningIndexGrain>($"TBI-SCREEN-IDX:{newScreen.PatientId.Trim()}");
            await scrIndex.UpsertScreeningAsync(new TBIScreeningSummaryEntry
            {
                ScreeningId = scrId, PatientId = newScrState.PatientId,
                ScreeningDate = newScrState.ScreeningDate, Result = newScrState.Result,
                ScreenedByName = newScrState.ScreenedByName
            });
            submitMessage = "Screening recorded successfully.";
            newScreen = new();
            answerMap.Clear();
        }
        catch (Exception ex)
        {
            submitMessage = $"Error: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }

    private async Task SubmitRegistration()
    {
        if (string.IsNullOrWhiteSpace(newReg.PatientId)) { submitMessage = "Patient ID is required."; return; }
        submitting = true;
        submitMessage = null;
        try
        {
            var payload = new
            {
                patientName = newReg.PatientName,
                dateOfBirth = newReg.DateOfBirth,
                traumaMechanism = newReg.TraumaMechanism,
                traumaDate = newReg.TraumaDate,
                traumaLocation = newReg.TraumaLocation,
                polytraumaNetworkSite = newReg.PolytraumaNetworkSite,
                referralSource = newReg.ReferralSource,
                primaryTeamId = newReg.PrimaryTeamId,
                primaryTeamName = newReg.PrimaryTeamName,
                caseManagerId = newReg.CaseManagerId,
                caseManagerName = newReg.CaseManagerName,
                notes = newReg.Notes
            };

            string decodedPtId = newReg.PatientId.Trim();
            var ptRegGrain = Grains.GetGrain<IPolytraumaRecordGrain>($"PT-RECORD:{decodedPtId}");
            await ptRegGrain.RegisterPatientAsync(
                decodedPtId, newReg.PatientName, newReg.DateOfBirth,
                Enum.Parse<TraumaMechanism>(newReg.TraumaMechanism.ToString()),
                newReg.TraumaDate, newReg.TraumaLocation, newReg.PolytraumaNetworkSite,
                newReg.ReferralSource, newReg.PrimaryTeamId, newReg.PrimaryTeamName,
                newReg.CaseManagerId, newReg.CaseManagerName, newReg.Notes);

            if (!string.IsNullOrWhiteSpace(newInjury.InjuryDescription))
            {
                await ptRegGrain.AddInjuryAsync(new PolytraumaInjury
                {
                    BodyRegion = newInjury.BodyRegion,
                    InjuryDescription = newInjury.InjuryDescription,
                    AisScore = newInjury.AisScore,
                    SeverityScore = newInjury.SeverityScore
                });
            }

            var ptRegState = await ptRegGrain.GetRecordAsync();
            var ptRegIdx = Grains.GetGrain<IPolytraumaRegistryIndexGrain>("PT-REGISTRY-IDX");
            await ptRegIdx.UpsertPatientAsync(new PolytraumaRegistrySummaryEntry
            {
                PatientId = ptRegState.PatientId, PatientName = ptRegState.PatientName,
                Status = ptRegState.Status, PrimaryCareTeam = ptRegState.PrimaryPolytraumaTeamName,
                InjuryCount = ptRegState.Injuries.Count, IssTotalScore = ptRegState.IssTotalScore,
                TBISeverity = ptRegState.TBISeverity, RegistrationDate = ptRegState.RegistrationDate
            });
            submitMessage = "Patient registered successfully.";
            newReg = new();
            newInjury = new();
            await LoadRegistry();
        }
        catch (Exception ex)
        {
            submitMessage = $"Error: {ex.Message}";
        }
        finally
        {
            submitting = false;
        }
    }

