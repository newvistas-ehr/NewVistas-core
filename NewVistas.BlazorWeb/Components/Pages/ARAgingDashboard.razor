@page "/ar-aging"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>AR Aging &amp; Financial Reporting</PageTitle>

<h1>AR Aging &amp; Financial Reporting</h1>
<p class="page-subtitle">PRCA AR Aging Analysis &amp; Revenue Cycle Metrics (RCRP*.m)</p>

<div class="lookup-bar">
    <input class="lookup-input" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="GenerateReport" disabled="@loading">Generate Report</button>
    <button class="btn btn-primary" @onclick="LoadDemo" disabled="@loading">Load Demo</button>
</div>

<AlertBanner Error="@error" />

<TabStrip Tabs="_tabs" @bind-Active="tab" />

@* ─── Revenue Metrics ──────────────────────────────────────────────────── *@
@if (tab == "metrics" && metrics != null)
{
    <div class="metric-grid">
        <div class="metric-card"><div class="metric-value">@metrics.TotalARBalance.ToString("C")</div><div class="metric-label">Total AR Balance</div></div>
        <div class="metric-card"><div class="metric-value">@metrics.CollectionRate.ToString("P1")</div><div class="metric-label">Collection Rate</div></div>
        <div class="metric-card"><div class="metric-value">@metrics.AverageDaysOutstanding</div><div class="metric-label">Avg Days Outstanding</div></div>
        <div class="metric-card"><div class="metric-value">@metrics.TotalActiveAccounts</div><div class="metric-label">Active Accounts</div></div>
    </div>
    <div class="metric-grid">
        <div class="metric-card"><div class="metric-value">@metrics.TotalPaymentsReceived.ToString("C")</div><div class="metric-label">Total Payments</div></div>
        <div class="metric-card"><div class="metric-value">@metrics.TotalNewCharges.ToString("C")</div><div class="metric-label">Total Charges</div></div>
        <div class="metric-card"><div class="metric-value"><span class="badge badge-warning">@metrics.DelinquentAccountCount</span> @metrics.DelinquentBalance.ToString("C")</div><div class="metric-label">Delinquent</div></div>
        <div class="metric-card"><div class="metric-value"><span class="badge badge-danger">@metrics.InCollectionCount</span> @metrics.InCollectionBalance.ToString("C")</div><div class="metric-label">In Collection</div></div>
    </div>
    <p class="page-subtitle">Report generated: @metrics.ReportDate.ToString("yyyy-MM-dd HH:mm:ss UTC")</p>
}

@* ─── Aging Buckets ────────────────────────────────────────────────────── *@
@if (tab == "aging" && buckets != null && buckets.Count > 0)
{
    <table class="data-table">
        <thead>
            <tr><th>Aging Bucket</th><th>Accounts</th><th>Balance</th><th>% of Total</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in buckets)
            {
                <tr class="@BucketRowClass(b.Bucket)">
                    <td><span class="badge @BucketBadge(b.Bucket)">@b.Label</span></td>
                    <td>@b.AccountCount</td>
                    <td>@b.TotalBalance.ToString("C")</td>
                    <td>@b.PercentOfTotal.ToString("P1")</td>
                    <td><button class="btn btn-primary" @onclick="() => DrillIntoBucket(b.Bucket)">Details</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td><strong>Total</strong></td>
                <td><strong>@buckets.Sum(b => b.AccountCount)</strong></td>
                <td><strong>@buckets.Sum(b => b.TotalBalance).ToString("C")</strong></td>
                <td></td><td></td>
            </tr>
        </tfoot>
    </table>
}

@* ─── Account Details ──────────────────────────────────────────────────── *@
@if (tab == "accounts" && report != null && report.AccountDetails.Count > 0)
{
    @if (selectedBucket.HasValue) { <p>Showing accounts in <strong>@selectedBucket</strong> bucket. <button class="btn btn-primary" @onclick="() => { selectedBucket = null; }">Show All</button></p> }

    <table class="data-table">
        <thead><tr><th>Account ID</th><th>Category</th><th>Status</th><th>Original</th><th>Balance</th><th>Days</th><th>Bucket</th></tr></thead>
        <tbody>
            @foreach (var a in filteredAccounts)
            {
                <tr class="@BucketRowClass(a.Bucket)">
                    <td>@a.ARAccountId[..Math.Min(12, a.ARAccountId.Length)]...</td>
                    <td>@a.Category</td>
                    <td><span class="badge @AccountStatusBadge(a.Status)">@a.Status</span></td>
                    <td>@a.OriginalAmount.ToString("C")</td>
                    <td>@a.CurrentBalance.ToString("C")</td>
                    <td>@a.DaysOutstanding</td>
                    <td><span class="badge @BucketBadge(a.Bucket)">@BucketLabel(a.Bucket)</span></td>
                </tr>
            }
        </tbody>
    </table>
}
else if (tab == "accounts" && !loading)
{
    <div class="empty-state">No report generated. Click "Generate Report" to create an AR aging snapshot.</div>
}

@code {
    private string patientId = string.Empty;
    private string tab = "metrics";
    private bool loading;
    private string? error;
    private ARAgingReportState? report;
    private List<AgingBucketSummary>? buckets;
    private RevenueCycleMetrics? metrics;
    private AgingBucket? selectedBucket;
    private readonly (string, string)[] _tabs = new[] { ("metrics", "Revenue Metrics"), ("aging", "Aging Buckets"), ("accounts", "Account Details") };

    private IEnumerable<AgingAccountDetail> filteredAccounts =>
        report?.AccountDetails.Where(a => !selectedBucket.HasValue || a.Bucket == selectedBucket.Value) ?? Enumerable.Empty<AgingAccountDetail>();

    private async Task GenerateReport()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            report = await wf.GenerateARAgingReportAsync(null, null);
            buckets = report.BucketSummaries;
            metrics = report.Metrics;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void DrillIntoBucket(AgingBucket bucket) { selectedBucket = bucket; tab = "accounts"; }

    private async Task LoadDemo()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await wf.CreateARAccountAsync(null, "CopayOutpatient", 50m, DateTime.UtcNow.AddDays(15));
            await wf.CreateARAccountAsync(null, "CopayPharmacy", 24m, DateTime.UtcNow.AddDays(-15));
            await wf.CreateARAccountAsync(null, "CopayInpatient", 200m, DateTime.UtcNow.AddDays(-45));
            await wf.CreateARAccountAsync(null, "CopayOutpatient", 35m, DateTime.UtcNow.AddDays(-80));
            await wf.CreateARAccountAsync(null, "MedicareDeductible", 150m, DateTime.UtcNow.AddDays(-120));
            report = await wf.GenerateARAgingReportAsync("DEMO", "Demo User");
            buckets = report.BucketSummaries;
            metrics = report.Metrics;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private string BucketLabel(AgingBucket b) => b switch
    {
        AgingBucket.Current => "0-30", AgingBucket.ThirtyOneToSixty => "31-60",
        AgingBucket.SixtyOneToNinety => "61-90", AgingBucket.NinetyOneToOneTwenty => "91-120",
        AgingBucket.OverOneTwenty => "121+", _ => "—",
    };

    // Aging buckets carry the at-a-glance overdue cue (patient-safety badge rule for AR):
    // 90+ days = warning, 120+ days = danger.
    private string BucketBadge(AgingBucket b) => b switch
    {
        AgingBucket.NinetyOneToOneTwenty => "badge-warning",
        AgingBucket.OverOneTwenty => "badge-danger",
        _ => "badge-neutral",
    };

    private string BucketRowClass(AgingBucket b) => b switch
    {
        AgingBucket.OverOneTwenty => "row-danger",
        AgingBucket.NinetyOneToOneTwenty => "row-warning",
        _ => "",
    };

    private string AccountStatusBadge(ARAccountStatus s) => s switch
    {
        ARAccountStatus.Active => "badge-info", ARAccountStatus.Paid => "badge-success",
        ARAccountStatus.InCollection => "badge-danger", ARAccountStatus.TreasuryOffset => "badge-danger",
        ARAccountStatus.OnPaymentPlan => "badge-info", ARAccountStatus.Waived => "badge-neutral",
        _ => "badge-neutral",
    };
}

<style>
    /* Canonical clinical classes live in app.css. Page-specific only: */
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
    .metric-card { border: 1px solid #e5e7eb; border-radius: 6px; padding: 1rem; text-align: center; }
    .metric-value { font-size: 1.25rem; font-weight: 600; }
    .metric-label { color: #666; font-size: 0.8rem; margin-top: 0.25rem; }
</style>
