@page "/collection-letters"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Collection Letters</PageTitle>

<h1>Collection Letter Generation</h1>
<p class="page-subtitle">PRCA Dunning Letters &amp; AR Correspondence (RCCLLT*.m, RCCL*.m)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadLetters" />
<AlertBanner Error="@error" Success="@genResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <div class="form-actions">
        <button class="btn btn-primary" @onclick="LoadDemo" disabled="@loading">Load Demo</button>
    </div>

    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "list")
    {
        @if (letters == null) { <div class="empty-state">Enter a Patient ID and click Load.</div> }
        else if (letters.Count == 0) { <div class="empty-state">No collection letters found.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Seq</th><th>Type</th><th>Status</th><th>Amount Due</th><th>Generated</th><th></th></tr></thead>
                <tbody>
                    @foreach (var l in letters)
                    {
                        <tr>
                            <td>@l.DunningSequence</td>
                            <td>@l.LetterType</td>
                            <td><span class="badge @StatusBadge(l.Status)">@l.Status</span></td>
                            <td>@l.TotalAmountDue.ToString("C")</td>
                            <td>@l.GeneratedDate.ToString("MM/dd/yyyy HH:mm")</td>
                            <td><button class="btn btn-primary" @onclick="() => ViewDetail(l.LetterId)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tab == "detail" && selected != null)
    {
        <div class="form-section">
            <h3>@selected.LetterType — Sequence #@selected.DunningSequence <span class="badge @StatusBadge(selected.Status)">@selected.Status</span></h3>
            <p class="text-muted">@selected.GeneratedDate.ToString("yyyy-MM-dd HH:mm")</p>

            <p>
                <strong>To:</strong> @selected.PatientName &nbsp;&nbsp;
                <strong>Address:</strong> @(selected.MailingAddress ?? "—") &nbsp;&nbsp;
                <strong>Amount Due:</strong> @selected.TotalAmountDue.ToString("C")
            </p>
            <p>
                <strong>Payment Due:</strong> @(selected.PaymentDueDate?.ToString("yyyy-MM-dd") ?? "—") &nbsp;&nbsp;
                <strong>Response Days:</strong> @selected.ResponseDays &nbsp;&nbsp;
                <strong>Printed:</strong> @(selected.PrintedDate?.ToString("MM/dd HH:mm") ?? "—") &nbsp;&nbsp;
                <strong>Mailed:</strong> @(selected.MailedDate?.ToString("MM/dd HH:mm") ?? "—")
            </p>

            @if (selected.LineItems.Count > 0)
            {
                <h3>Line Items</h3>
                <table class="data-table">
                    <thead><tr><th>Description</th><th>Original</th><th>Balance</th><th>Days Past Due</th></tr></thead>
                    <tbody>
                        @foreach (var li in selected.LineItems)
                        {
                            <tr><td>@li.Description</td><td>@li.OriginalAmount.ToString("C")</td><td>@li.CurrentBalance.ToString("C")</td><td>@li.DaysPastDue</td></tr>
                        }
                    </tbody>
                </table>
            }

            <h3>Letter Body</h3>
            <pre class="letter-body">@selected.LetterBody</pre>

            <div class="form-actions">
                @if (selected.Status == CollectionLetterStatus.Generated)
                {
                    <button class="btn btn-primary" @onclick="() => MarkPrinted(selected.LetterId)">Mark Printed</button>
                    <button class="btn btn-primary" @onclick="() => Cancel(selected.LetterId)">Cancel</button>
                }
                @if (selected.Status == CollectionLetterStatus.Printed)
                {
                    <button class="btn btn-primary" @onclick="() => MarkMailed(selected.LetterId)">Mark Mailed</button>
                }
                @if (selected.Status == CollectionLetterStatus.Mailed)
                {
                    <button class="btn btn-primary" @onclick="() => MarkReturned(selected.LetterId)">Mark Returned</button>
                }
            </div>
        </div>
    }

    @if (tab == "generate")
    {
        <div class="form-section">
            <FormField Label="Letter Type">
                <select class="form-input" @bind="newLetterType">
                    <option value="@CollectionLetterType.FirstNotice">First Notice</option>
                    <option value="@CollectionLetterType.SecondNotice">Second Notice</option>
                    <option value="@CollectionLetterType.ThirdNotice">Third/Final Notice</option>
                    <option value="@CollectionLetterType.IntentToCollect">Intent to Collect</option>
                    <option value="@CollectionLetterType.Statement">Statement</option>
                    <option value="@CollectionLetterType.PaymentPlanOffer">Payment Plan Offer</option>
                    <option value="@CollectionLetterType.TopPreReferral">TOP Pre-Referral</option>
                    <option value="@CollectionLetterType.AdministrativeReview">Administrative Review</option>
                </select>
            </FormField>
            <FormField Label="Notes (optional)"><input class="form-input" @bind="newNotes" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Generate" disabled="@generating">@(generating ? "Generating..." : "Generate Letter")</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "list";
    private bool loading;
    private string? error;
    private List<CollectionLetterIndexEntry>? letters;
    private CollectionLetterState? selected;
    private CollectionLetterType newLetterType = CollectionLetterType.FirstNotice;
    private string? newNotes;
    private bool generating;
    private string? genResult;
    private readonly (string, string)[] _tabs = new[] { ("list", "Letter History"), ("detail", "Letter Detail"), ("generate", "Generate Letter") };

    private async Task LoadLetters()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { letters = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetCollectionLettersAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task ViewDetail(string letterId)
    {
        error = null;
        try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetCollectionLetterAsync(letterId); tab = "detail"; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        generating = true; error = null; genResult = null;
        try
        {
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .GenerateCollectionLetterAsync(newLetterType, null, null, newNotes);
            genResult = $"Letter generated: {id}";
            await LoadLetters();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { generating = false; }
    }

    private async Task MarkPrinted(string id) { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).MarkCollectionLetterPrintedAsync(id); await ViewDetail(id); await LoadLetters(); }
    private async Task MarkMailed(string id) { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).MarkCollectionLetterMailedAsync(id); await ViewDetail(id); await LoadLetters(); }
    private async Task MarkReturned(string id) { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).MarkCollectionLetterReturnedAsync(id); await ViewDetail(id); await LoadLetters(); }
    private async Task Cancel(string id) { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).CancelCollectionLetterAsync(id, "Cancelled via UI"); await ViewDetail(id); await LoadLetters(); }

    private async Task LoadDemo()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await wf.CreateARAccountAsync(null, "CopayOutpatient", 50m, DateTime.UtcNow.AddDays(-70));
            await wf.CreateARAccountAsync(null, "CopayPharmacy", 24m, DateTime.UtcNow.AddDays(-15));
            await wf.GenerateCollectionLetterAsync(CollectionLetterType.FirstNotice, "DEMO", "Demo User", null);
            await wf.GenerateCollectionLetterAsync(CollectionLetterType.SecondNotice, "DEMO", "Demo User", null);
            letters = await wf.GetCollectionLettersAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private string StatusBadge(CollectionLetterStatus s) => s switch
    {
        CollectionLetterStatus.Returned => "badge-warning",
        CollectionLetterStatus.Cancelled => "badge-danger",
        _ => "badge-info",
    };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.6; }
    .letter-body { white-space: pre-wrap; background: #f8f9fa; padding: 1rem; border: 1px solid #ddd; }
</style>
