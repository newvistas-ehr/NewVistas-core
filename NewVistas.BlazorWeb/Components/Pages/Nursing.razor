    // ── DTOs (deserialise from API) ────────────────────────────────────────────
    private record AssessmentSummaryDto(
        string AssessmentId, DateTime AssessmentDateTime, string AssessmentType,
        string NurseName, string Status, string? LocationName,
        int? PainScore, int? MorseScore, int? BradenScore);

    private record NursingAssessmentDetailDto(
        string AssessmentId, string PatientId, DateTime AssessmentDateTime, string AssessmentType,
        string NurseId, string NurseName, string? LocationId, string? LocationName,
        NursingAssessmentStatus Status, string? SignedById, string? SignedByName,
        string? LevelOfConsciousness, List<string> Orientation, string? PupilResponse,
        string? BreathSounds, string? OxygenTherapy, decimal? SpO2,
        int? HeartRate, string? HeartRhythm, string? Edema,
        string? SkinIntegrity, int? BradenScore,
        int? PainScore, string? PainLocation,
        string? BowelSounds, string? AppetiteAssessment,
        decimal? UrineOutput, bool HasFoley, DateTime? FoleyInsertedDate,
        string? AnxietyLevel, string? Mood,
        int? MorseScoreTotal, string? FallRiskLevel, List<string> FallPrecautions,
        string? AdlMobility, string? NarrativeNotes);

    private record NursingCarePlanDto(
        string PatientId, List<NursingCarePlanProblemDto> Problems, DateTime LastModifiedDate);

    private record NursingCarePlanProblemDto(
        string ProblemId, string NursingDiagnosis, string? RelatedTo, string? EvidencedBy,
        string Status, int? Priority, DateTime CreatedDateTime,
        List<NursingGoalDto> Goals, List<NursingInterventionDto> Interventions,
        List<NursingOutcomeEvalDto> OutcomeEvaluations,
        DateTime? ResolvedDateTime, string? ResolutionNotes);

    private record NursingGoalDto(string GoalId, string GoalText, DateTime? TargetDate, string Status);

    private record NursingInterventionDto(
        string InterventionId, string InterventionText, string? Frequency, bool IsActive);

    private record NursingOutcomeEvalDto(
        string EvaluationId, DateTime EvaluationDateTime,
        string EvaluatedByName, string OutcomeRating, string? Notes);

    private record NursingAcuityDto(
        string PatientId, AcuityLevel CurrentAcuityLevel, int? CurrentAcuityScore,
        DateTime? CurrentAcuityDateTime, string? CurrentAcuityNurseId, string? CurrentAcuityNurseName,
        string? CurrentShift, List<AcuityRecordDto> AcuityHistory);

    private record AcuityRecordDto(
        DateTime RecordedDateTime, AcuityLevel Level, int? Score,
        string? NurseId, string? NurseName, string? Shift, string? Notes);

    private record AddDxResult(string ProblemId);

