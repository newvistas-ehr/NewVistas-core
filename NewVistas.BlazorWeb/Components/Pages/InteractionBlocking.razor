@page "/interaction-blocking"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext

<PageTitle>Drug Interaction Blocking</PageTitle>
<h1>Drug Interaction Blocking</h1>

<div class="lookup-bar">
    <label>Patient ID:</label>
    <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleKeyDown"
           placeholder="Enter patient ID" />
    <button class="btn btn-primary" @onclick="Load"
            disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)">
        @(loading ? "Loading..." : "Load")
    </button>
    <button class="btn btn-secondary" @onclick="ShowScreenForm"
            disabled="@(string.IsNullOrWhiteSpace(patientId))">
        + Screen Rx
    </button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (successMsg != null) { <div class="alert alert-success">@successMsg</div> }

@* ── Screen Rx Form ──────────────────────────────────────────────── *@
@if (showForm)
{
    <div class="entry-form">
        <h3>Screen Prescription for Drug Interactions</h3>
        <div class="form-grid">
            <div class="form-field">
                <label>Prescription ID *</label>
                <input type="text" @bind="f_prescriptionId" />
            </div>
            <div class="form-field">
                <label>Drug Name *</label>
                <input type="text" @bind="f_drugName" />
            </div>
            <div class="form-field">
                <label>New Drug Ingredient IEN</label>
                <input type="text" @bind="f_newIngredientIen" />
            </div>
            <div class="form-field">
                <label>New Drug Ingredient Name</label>
                <input type="text" @bind="f_newIngredientName" />
            </div>
            <div class="form-field">
                <label>Existing Med Ingredient IEN</label>
                <input type="text" @bind="f_existingIngredientIen" />
            </div>
            <div class="form-field">
                <label>Existing Med Ingredient Name</label>
                <input type="text" @bind="f_existingIngredientName" />
            </div>
            <div class="form-field">
                <label>Screened By</label>
                <input type="text" @bind="f_screenedBy" placeholder="Pharmacist ID" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SubmitScreen" disabled="@saving">
                @(saving ? "Screening..." : "Run Screen")
            </button>
            <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
        </div>
    </div>
}

@* ── Tabs ────────────────────────────────────────────────────────── *@
@if (allScreenings != null)
{
    <div class="tab-bar">
        <button class="tab @(activeTab == "all" ? "tab-active" : "")"
                @onclick='() => activeTab = "all"'>All (@allScreenings.Count)</button>
        <button class="tab @(activeTab == "blocked" ? "tab-active" : "")"
                @onclick='() => activeTab = "blocked"'>Blocked (@blockedScreenings.Count)</button>
        @if (selectedScreening != null)
        {
            <button class="tab @(activeTab == "detail" ? "tab-active" : "")"
                    @onclick='() => activeTab = "detail"'>Detail</button>
        }
    </div>

    @if (activeTab == "all" || activeTab == "blocked")
    {
        List<InteractionScreeningIndexEntry> displayList = activeTab == "blocked" ? blockedScreenings : allScreenings;
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Drug</th>
                    <th>Rx ID</th>
                    <th>Status</th>
                    <th>Blocking</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (InteractionScreeningIndexEntry s in displayList)
                {
                    <tr class="@(s.Status == InteractionScreeningStatus.BlockedPendingOverride ? "row-alert" : "")">
                        <td>@(s.ScreenedDate?.ToString("MM/dd/yyyy HH:mm") ?? "—")</td>
                        <td>@s.DrugName</td>
                        <td>@s.PrescriptionId</td>
                        <td><span class="status-badge status-@s.Status.ToString().ToLower()">@FormatStatus(s.Status)</span></td>
                        <td class="@(s.BlockingCount > 0 ? "text-danger" : "")">@s.BlockingCount</td>
                        <td>@s.TotalInteractionCount</td>
                        <td><button class="btn btn-sm" @onclick="() => ViewDetail(s.ScreeningId)">View</button></td>
                    </tr>
                }
            </tbody>
        </table>
        @if (displayList.Count == 0)
        {
            <p class="empty-state">@(activeTab == "blocked" ? "No prescriptions are currently blocked." : "No screenings recorded.")</p>
        }
    }

    @if (activeTab == "detail" && selectedScreening != null)
    {
        <div class="detail-panel">
            <h3>Interaction Screening: @selectedScreening.DrugName</h3>
            <div class="detail-grid">
                <div><strong>Screening ID:</strong> @selectedScreening.ScreeningId</div>
                <div><strong>Prescription:</strong> @selectedScreening.PrescriptionId</div>
                <div><strong>Drug:</strong> @selectedScreening.DrugName</div>
                <div><strong>Status:</strong> <span class="status-badge status-@selectedScreening.Status.ToString().ToLower()">@FormatStatus(selectedScreening.Status)</span></div>
                <div><strong>Interactions:</strong> @selectedScreening.TotalInteractionCount total, @selectedScreening.BlockingCount blocking, @selectedScreening.OverriddenCount overridden</div>
                <div><strong>Screened:</strong> @(selectedScreening.ScreenedDate?.ToString("MM/dd/yyyy HH:mm") ?? "—") by @(selectedScreening.ScreenedBy ?? "System")</div>
            </div>

            @if (selectedScreening.Findings.Count > 0)
            {
                <h4>Interaction Findings</h4>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>New Drug Ingredient</th>
                            <th>Existing Drug Ingredient</th>
                            <th>Severity</th>
                            <th>Description</th>
                            <th>Blocking</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < selectedScreening.Findings.Count; i++)
                        {
                            InteractionFinding f = selectedScreening.Findings[i];
                            int idx = i;
                            <tr class="@GetFindingRowClass(f)">
                                <td>@(i + 1)</td>
                                <td>@f.Drug1IngredientName</td>
                                <td>@f.Drug2IngredientName</td>
                                <td><span class="severity-badge severity-@f.Severity.ToString().ToLower()">@f.Severity</span></td>
                                <td>@f.Description</td>
                                <td>
                                    @if (f.IsBlocking && f.IsOverridden)
                                    {
                                        <span title="@f.OverrideReason">Overridden by @f.OverriddenBy</span>
                                    }
                                    else if (f.IsBlocking)
                                    {
                                        <span class="text-danger">BLOCKED</span>
                                    }
                                    else
                                    {
                                        <span>Warning</span>
                                    }
                                </td>
                                <td>
                                    @if (f.IsBlocking && !f.IsOverridden)
                                    {
                                        <button class="btn btn-sm btn-primary" @onclick="() => ShowOverrideForm(idx)">Override</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="empty-state">No drug interactions found — prescription is cleared.</p>
            }

            @if (showOverrideForm)
            {
                <div class="entry-form" style="margin-top: 1rem;">
                    <h4>Override Blocking Interaction #@(overrideIndex + 1)</h4>
                    <div class="form-grid">
                        <div class="form-field">
                            <label>Pharmacist ID *</label>
                            <input type="text" @bind="o_pharmacistId" />
                        </div>
                        <div class="form-field full-width">
                            <label>Clinical Reason *</label>
                            <textarea @bind="o_reason" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitOverride" disabled="@saving">
                            @(saving ? "Saving..." : "Submit Override")
                        </button>
                        <button class="btn btn-secondary" @onclick="() => showOverrideForm = false">Cancel</button>
                    </div>
                </div>
            }

            @if (selectedScreening.Notes != null)
            {
                <div class="notes-section">
                    <h4>Notes</h4>
                    <pre>@selectedScreening.Notes</pre>
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }

    private List<InteractionScreeningIndexEntry>? allScreenings;
    private List<InteractionScreeningIndexEntry> blockedScreenings = new();
    private InteractionScreeningState? selectedScreening;
    private bool loading, saving, showForm, showOverrideForm;
    private string? error, successMsg;
    private string activeTab = "all";

    // Screen form
    private string f_prescriptionId = string.Empty, f_drugName = string.Empty;
    private string f_newIngredientIen = string.Empty, f_newIngredientName = string.Empty;
    private string f_existingIngredientIen = string.Empty, f_existingIngredientName = string.Empty;
    private string f_screenedBy = string.Empty;

    // Override form
    private int overrideIndex;
    private string o_pharmacistId = string.Empty, o_reason = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(patientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
            patientId = PatientContext.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId)) await Load();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null; successMsg = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            allScreenings = await wf.GetInteractionScreeningsAsync();
            blockedScreenings = allScreenings.Where(s => s.Status == InteractionScreeningStatus.BlockedPendingOverride).ToList();
            PatientContext.SetPatient(patientId.Trim());
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private void ShowScreenForm()
    {
        showForm = true;
        f_prescriptionId = f_drugName = f_newIngredientIen = f_newIngredientName = string.Empty;
        f_existingIngredientIen = f_existingIngredientName = f_screenedBy = string.Empty;
    }

    private async Task SubmitScreen()
    {
        if (string.IsNullOrWhiteSpace(f_prescriptionId) || string.IsNullOrWhiteSpace(f_drugName))
        { error = "Prescription ID and Drug Name are required."; return; }

        saving = true; error = null;
        try
        {
            List<DrugIngredient> newIngredients = new();
            if (!string.IsNullOrWhiteSpace(f_newIngredientIen))
                newIngredients.Add(new DrugIngredient { IngredientIen = f_newIngredientIen.Trim(), Name = f_newIngredientName.Trim() });

            List<DrugIngredient> existingIngredients = new();
            if (!string.IsNullOrWhiteSpace(f_existingIngredientIen))
                existingIngredients.Add(new DrugIngredient { IngredientIen = f_existingIngredientIen.Trim(), Name = f_existingIngredientName.Trim() });

            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            string screeningId = await wf.ScreenPrescriptionForInteractionsAsync(
                f_prescriptionId.Trim(), f_drugName.Trim(),
                newIngredients, existingIngredients,
                string.IsNullOrWhiteSpace(f_screenedBy) ? null : f_screenedBy.Trim());

            showForm = false;
            successMsg = $"Screening completed: {screeningId}";
            await Load();
            await ViewDetail(screeningId);
        }
        catch (Exception ex) { error = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private async Task ViewDetail(string screeningId)
    {
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            selectedScreening = await wf.GetInteractionScreeningAsync(screeningId);
            activeTab = "detail";
            showOverrideForm = false;
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void ShowOverrideForm(int idx)
    {
        overrideIndex = idx;
        o_pharmacistId = o_reason = string.Empty;
        showOverrideForm = true;
    }

    private async Task SubmitOverride()
    {
        if (string.IsNullOrWhiteSpace(o_pharmacistId) || string.IsNullOrWhiteSpace(o_reason))
        { error = "Pharmacist ID and clinical reason are required."; return; }

        saving = true; error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await wf.OverrideInteractionBlockAsync(selectedScreening!.ScreeningId, overrideIndex, o_pharmacistId.Trim(), o_reason.Trim());
            showOverrideForm = false;
            successMsg = $"Override submitted for interaction #{overrideIndex + 1}.";
            await Load();
            await ViewDetail(selectedScreening.ScreeningId);
        }
        catch (Exception ex) { error = $"Error: {ex.Message}"; }
        finally { saving = false; }
    }

    private static string FormatStatus(InteractionScreeningStatus s) => s switch
    {
        InteractionScreeningStatus.NotScreened => "Not Screened",
        InteractionScreeningStatus.Cleared => "Cleared",
        InteractionScreeningStatus.BlockedPendingOverride => "Blocked",
        InteractionScreeningStatus.OverriddenByPharmacist => "Overridden",
        _ => s.ToString()
    };

    private static string GetFindingRowClass(InteractionFinding f) =>
        f.IsBlocking && !f.IsOverridden ? "row-alert"
        : f.IsBlocking && f.IsOverridden ? "row-override"
        : f.Severity >= InteractionSeverity.Moderate ? "row-warning" : "";
}

<style>
    /* Canonical classes (lookup-bar, alert, alert-*, btn, btn-primary, btn-secondary,
       btn-sm, tab, tab-bar, data-table, data-table tr.row-danger/.row-warning) live in
       app.css. Page-specific layout and the clinical status/severity badges live here. */
    .lookup-bar input { padding: .4rem .6rem; border: 1px solid #d4d9e0; border-radius: 4px; background: #f9fafb; color: #333; min-width: 220px; }
    .tab-active { background: #fff; color: #003f72; border-color: #003f72; font-weight: 600; }
    .row-alert { background: #fef2f2 !important; }
    .row-override { background: #fffbeb !important; }
    .text-danger { color: #b91c1c; font-weight: bold; }
    .status-badge { padding: .15rem .4rem; border-radius: 3px; font-size: .8rem; font-weight: 600; }
    .status-badge.status-notscreened { background: #e5e7eb; color: #374151; }
    .status-badge.status-cleared { background: #dcfce7; color: #166534; }
    .status-badge.status-blockedpendingoverride { background: #fde8e8; color: #b91c1c; }
    .status-badge.status-overriddenbypharmacist { background: #fef3c7; color: #92400e; }
    .severity-badge { padding: .15rem .4rem; border-radius: 3px; font-size: .8rem; font-weight: 600; }
    .severity-badge.severity-minor { background: #dcfce7; color: #166534; }
    .severity-badge.severity-moderate { background: #fef3c7; color: #92400e; }
    .severity-badge.severity-significant { background: #ffedd5; color: #9a3412; }
    .severity-badge.severity-contraindicated { background: #fde8e8; color: #b91c1c; }
    .entry-form { background: #f4f6f9; border: 1px solid #d4d9e0; border-radius: 6px; padding: 1rem; margin-bottom: 1rem; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: .75rem; }
    .form-field label { display: block; font-size: .8rem; color: #555; margin-bottom: .2rem; }
    .form-field input, .form-field select, .form-field textarea { width: 100%; padding: .35rem .5rem; background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 4px; color: #333; }
    .form-field.full-width { grid-column: 1 / -1; }
    .form-actions { display: flex; gap: .5rem; margin-top: .75rem; }
    .detail-panel { background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 6px; padding: 1rem; }
    .detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: .4rem; margin-bottom: 1rem; color: #333; }
    .notes-section pre { background: #f4f6f9; padding: .75rem; border-radius: 4px; white-space: pre-wrap; color: #333; }
    .empty-state { color: #555; font-style: italic; padding: 2rem; text-align: center; }
</style>
