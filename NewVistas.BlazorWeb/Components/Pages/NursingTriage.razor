@page "/nursing-triage"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Nursing Triage / Intake Assessment</PageTitle>

<h1>Nursing Intake / Triage Assessment</h1>
<p class="page-subtitle">ESI Triage with Chief Complaint, Vitals, and Nursing Assessment</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadTriages" />
<AlertBanner Error="@error" Success="@createResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "list")
    {
        @if (triages == null) { <div class="empty-state">Enter a Patient ID and click Load.</div> }
        else if (triages.Count == 0) { <div class="empty-state">No triage assessments recorded.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Date/Time</th><th>Nurse</th><th>Chief Complaint</th><th>ESI</th><th>Pain</th><th>Disposition</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in triages)
                    {
                        <tr>
                            <td>@t.TriageDateTime.ToString("MM/dd HH:mm")</td>
                            <td>@t.NurseName</td>
                            <td>@t.ChiefComplaint</td>
                            <td>ESI @((int)t.TriageLevel)</td>
                            <td>@(t.PainScore?.ToString() ?? "—")</td>
                            <td>@t.Disposition</td>
                            <td>@t.Status</td>
                            <td><button class="btn btn-primary" @onclick="() => ViewDetail(t.TriageId)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tab == "detail" && selected != null)
    {
        <div class="form-section">
            <h3>Triage: @selected.TriageId — ESI @((int)selected.TriageLevel) — @selected.Status</h3>

            <h3>Chief Complaint &amp; History</h3>
            <p><strong>Chief Complaint:</strong> @selected.ChiefComplaint</p>
            <p><strong>HPI:</strong> @(selected.HistoryOfPresentIllness ?? "—")</p>
            <p><strong>Arrival:</strong> @(selected.ModeOfArrival ?? "—") @(selected.ArrivedByAmbulance ? "(Ambulance)" : "")</p>
            <p><strong>Acute Distress:</strong> @(selected.IsAcuteDistress ? "Yes" : "No")</p>
            <p><strong>LOC:</strong> @(selected.LevelOfConsciousness ?? "—")</p>

            <h3>Triage Vital Signs</h3>
            <p><strong>Temp:</strong> @(selected.Temperature?.ToString("F1") ?? "—") F</p>
            <p><strong>HR:</strong> @(selected.HeartRate?.ToString() ?? "—") bpm</p>
            <p><strong>RR:</strong> @(selected.RespiratoryRate?.ToString() ?? "—")</p>
            <p><strong>BP:</strong> @(selected.SystolicBP?.ToString() ?? "—")/@(selected.DiastolicBP?.ToString() ?? "—")</p>
            <p><strong>SpO2:</strong> @(selected.SpO2?.ToString("F0") ?? "—")%</p>
            <p><strong>Pain:</strong> @(selected.PainScore?.ToString() ?? "—")/10 @(selected.PainLocation ?? "")</p>

            <div class="form-actions">
                @if (selected.Status == NursingAssessmentStatus.Draft)
                { <button class="btn btn-primary" @onclick="() => Sign(selected.TriageId)">Sign</button> }
                @if (selected.Disposition == TriageDisposition.Pending)
                {
                    <button class="btn btn-primary" @onclick="() => SetDisp(selected.TriageId, TriageDisposition.Admit)">Admit</button>
                    <button class="btn btn-primary" @onclick="() => SetDisp(selected.TriageId, TriageDisposition.Observation)">Observation</button>
                    <button class="btn btn-primary" @onclick="() => SetDisp(selected.TriageId, TriageDisposition.Discharge)">Discharge</button>
                }
            </div>
        </div>
    }

    @if (tab == "new")
    {
        <div class="form-section">
            <FormField Label="Chief Complaint" Required><input class="form-input" @bind="nCC" /></FormField>
            <FormField Label="Nurse ID"><input class="form-input" @bind="nNurseId" /></FormField>
            <FormField Label="Nurse Name"><input class="form-input" @bind="nNurseName" /></FormField>

            <h3>Triage Vital Signs</h3>
            <FormField Label="Temp (F)"><input type="number" step="0.1" class="form-input" @bind="nTemp" /></FormField>
            <FormField Label="HR"><input type="number" class="form-input" @bind="nHR" /></FormField>
            <FormField Label="RR"><input type="number" class="form-input" @bind="nRR" /></FormField>
            <FormField Label="Sys BP"><input type="number" class="form-input" @bind="nSBP" /></FormField>
            <FormField Label="Dia BP"><input type="number" class="form-input" @bind="nDBP" /></FormField>
            <FormField Label="SpO2"><input type="number" class="form-input" @bind="nSpO2" /></FormField>
            <FormField Label="Pain (0-10)"><input type="number" class="form-input" @bind="nPain" /></FormField>

            <h3>Assessment</h3>
            <FormField Label="ESI Level">
                <select class="form-input" @bind="nESI">
                    <option value="@TriageLevel.Esi1_Resuscitation">ESI 1 — Resuscitation</option>
                    <option value="@TriageLevel.Esi2_Emergent">ESI 2 — Emergent</option>
                    <option value="@TriageLevel.Esi3_Urgent">ESI 3 — Urgent</option>
                    <option value="@TriageLevel.Esi4_LessUrgent">ESI 4 — Less Urgent</option>
                    <option value="@TriageLevel.Esi5_NonUrgent">ESI 5 — Non-Urgent</option>
                </select>
            </FormField>
            <FormField Label="Mode of Arrival">
                <select class="form-input" @bind="nArrival"><option>AMBULATORY</option><option>WHEELCHAIR</option><option>STRETCHER</option><option>AMBULANCE</option></select>
            </FormField>
            <FormField Label="Notes"><input class="form-input" @bind="nNotes" /></FormField>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="CreateTriage" disabled="@creating">@(creating ? "Creating..." : "Create Triage")</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "list";
    private bool loading, creating;
    private string? error, createResult;
    private List<NursingTriageIndexEntry>? triages;
    private NursingTriageState? selected;
    private string nCC = string.Empty, nNurseId = string.Empty, nNurseName = string.Empty, nArrival = "AMBULATORY", nNotes = string.Empty;
    private decimal? nTemp; private int? nHR, nRR, nSBP, nDBP, nPain; private decimal? nSpO2;
    private TriageLevel nESI = TriageLevel.Esi3_Urgent;
    private readonly (string, string)[] _tabs = new[] { ("list", "Triage History"), ("detail", "Triage Detail"), ("new", "New Triage") };

    private async Task LoadTriages() { if (string.IsNullOrWhiteSpace(patientId)) return; loading = true; error = null; try { triages = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetTriageAssessmentsAsync(); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task ViewDetail(string id) { try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetTriageAssessmentAsync(id); tab = "detail"; } catch (Exception ex) { error = ex.Message; } }
    private async Task Sign(string id) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).SignTriageAssessmentAsync(id, nNurseId, nNurseName); await ViewDetail(id); await LoadTriages(); } catch (Exception ex) { error = ex.Message; } }
    private async Task SetDisp(string id, TriageDisposition d) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).SetTriageDispositionAsync(id, d); await ViewDetail(id); await LoadTriages(); } catch (Exception ex) { error = ex.Message; } }
    private async Task CreateTriage() { if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(nCC)) return; creating = true; error = null; createResult = null; try { string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).CreateTriageAssessmentAsync(DateTime.UtcNow, nNurseId, nNurseName, null, null, nCC, null, nTemp, nHR, nRR, nSBP, nDBP, nSpO2, nPain, nESI, null, null, nArrival, false, nArrival == "AMBULANCE", nNotes); createResult = $"Triage created: {id}"; await LoadTriages(); } catch (Exception ex) { error = ex.Message; } finally { creating = false; } }
}

<style>
    /* Canonical clinical classes live in app.css. Page-specific only: */
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.5; }
</style>
