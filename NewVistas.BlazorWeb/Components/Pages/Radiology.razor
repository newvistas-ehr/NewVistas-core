@page "/radiology"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext

<PageTitle>Radiology</PageTitle>
<h1>Radiology</h1>

<div class="lookup-bar">
    <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Patient ID" class="lookup-input" />
    <button @onclick="Load" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)" class="btn btn-primary">
        @if (loading) { <span>Loading...</span> } else { <span>Load</span> }
    </button>
    <button @onclick="ShowForm" disabled="@(string.IsNullOrWhiteSpace(patientId))" class="btn btn-secondary">+ Order Study</button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }

@if (items != null || detail != null)
{
    <div class="tab-bar">
        <button class="tab @(activeTab == "list" ? "active" : "")" @onclick='() => SetTab("list")'>Studies</button>
        @if (detail != null)
        {
            <button class="tab @(activeTab == "detail" ? "active" : "")" @onclick='() => SetTab("detail")'>Study Detail</button>
        }
    </div>
}

@if (showNew)
{
    <div class="entry-form">
        <h3>Order Radiology Study</h3>
        <div class="form-grid">
            <div class="form-row"><label>Procedure Name *</label><input type="text" @bind="f_procedure" placeholder="e.g. Chest X-Ray PA and Lateral" /></div>
            <div class="form-row"><label>CPT Code</label><input type="text" @bind="f_cpt" placeholder="e.g. 71046" /></div>
            <div class="form-row"><label>Imaging Type</label>
                <select @bind="f_type"><option value="">--</option><option>GENERAL RADIOLOGY</option><option>CT SCAN</option><option>MRI</option><option>ULTRASOUND</option><option>NUCLEAR MEDICINE</option><option>MAMMOGRAPHY</option></select>
            </div>
            <div class="form-row"><label>Requesting Provider</label><ProviderPicker @bind-ProviderName="f_provider" Label="" DefaultToSelf="true" /></div>
            <div class="form-row"><label>Urgency</label>
                <select @bind="f_urgency"><option>ROUTINE</option><option>URGENT</option><option>STAT</option></select>
            </div>
            <div class="form-row"><label>Location</label><input type="text" @bind="f_location" /></div>
            <div class="form-row full"><label>Clinical History</label><textarea @bind="f_history" rows="2" placeholder="Relevant clinical history..."></textarea></div>
            <div class="form-row full"><label>Reason for Study</label><textarea @bind="f_reason" rows="2" placeholder="Clinical question..."></textarea></div>
        </div>
        <div class="form-actions">
            <button @onclick="Submit" disabled="@saving" class="btn btn-primary">@(saving ? "Ordering..." : "Order Study")</button>
            <button @onclick="() => showNew = false" class="btn btn-secondary">Cancel</button>
        </div>
    </div>
}

@if (activeTab == "list" && items != null)
{
    @if (items.Count == 0) { <div class="empty-state">No radiology studies found.</div> }
    else
    {
        <table class="data-table">
            <thead><tr><th>Date</th><th>Procedure</th><th>Type</th><th>Requesting</th><th>Status</th><th>Report</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var s in items)
                {
                    <tr class="clickable" @onclick="() => ViewDetail(s.RadiologyId)">
                        <td class="date">@s.ExamDateTime?.ToString("MM/dd/yyyy")</td>
                        <td>@s.ProcedureName</td><td>@s.ImagingType</td>
                        <td>@s.RequestingProviderName</td>
                        <td><span class="badge @StatusCss(s.Status)">@s.Status</span></td>
                        <td>@(s.HasReport ? "Yes" : "--")</td>
                        <td class="actions" @onclick:stopPropagation>
                            @if (s.Status == "PENDING" || s.Status == "EXAMINED")
                            {
                                <button @onclick="() => CompleteStudy(s.RadiologyId)" class="btn btn-primary">Complete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (activeTab == "detail" && detail != null)
{
    <div class="detail-panel">
        <div class="detail-header">
            <h3>@detail.ProcedureName</h3>
            <span class="badge @StatusCss(detail.Status)">@detail.Status</span>
            @if (detail.IsCriticalResult) { <span class="badge badge-danger">CRITICAL</span> }
            <button @onclick="CloseDetail" class="btn btn-secondary">Close</button>
        </div>
        <div class="detail-grid">
            <div><strong>Radiology ID:</strong> @detail.RadiologyId</div>
            <div><strong>Imaging Type:</strong> @(detail.ImagingType ?? "--")</div>
            <div><strong>Status:</strong> @detail.Status</div>
            <div><strong>Urgency:</strong> @(detail.Urgency ?? "--")</div>
            <div><strong>Requesting Provider:</strong> @(detail.RequestingProviderName ?? "--")</div>
            <div><strong>Interpreting Physician:</strong> @(detail.InterpretingPhysicianName ?? "--")</div>
            <div><strong>Order Date:</strong> @detail.OrderDateTime?.ToString("MM/dd/yyyy HH:mm")</div>
            <div><strong>Exam Date:</strong> @detail.ExamDateTime?.ToString("MM/dd/yyyy HH:mm")</div>
            <div><strong>Body Part:</strong> @(detail.BodyPart ?? "--")</div>
            <div><strong>Laterality:</strong> @(detail.Laterality ?? "--")</div>
            <div><strong>Location:</strong> @(detail.LocationName ?? "--")</div>
            <div><strong>Technician:</strong> @(detail.TechnicianName ?? "--")</div>
            @if (!string.IsNullOrEmpty(detail.ClinicalHistory))
            {
                <div class="full"><strong>Clinical History:</strong> @detail.ClinicalHistory</div>
            }
            @if (!string.IsNullOrEmpty(detail.ReasonForStudy))
            {
                <div class="full"><strong>Reason:</strong> @detail.ReasonForStudy</div>
            }
            @if (!string.IsNullOrEmpty(detail.ReportText))
            {
                <div class="full"><strong>Report:</strong><pre class="pre-wrap">@detail.ReportText</pre></div>
            }
            @if (!string.IsNullOrEmpty(detail.Impression))
            {
                <div class="full"><strong>Impression:</strong> @detail.Impression</div>
            }
            @if (!string.IsNullOrEmpty(detail.AmendmentText))
            {
                <div class="full"><strong>Amendment:</strong> @detail.AmendmentText <span class="date">(@detail.AmendmentDateTime?.ToString("MM/dd/yyyy HH:mm"))</span></div>
            }
        </div>

        @* ── Contrast ── *@
        <div class="section">
            <h4>Contrast</h4>
            @if (!string.IsNullOrEmpty(detail.ContrastAgent))
            {
                <div class="detail-grid">
                    <div><strong>Agent:</strong> @detail.ContrastAgent</div>
                    <div><strong>Route:</strong> @(detail.ContrastRoute ?? "--")</div>
                    <div><strong>Volume:</strong> @(detail.ContrastVolumeMl?.ToString("F1") ?? "--") mL</div>
                    @if (detail.ContrastReactionOccurred == true)
                    {
                        <div class="full"><strong>Reaction:</strong> <span class="badge badge-danger">YES</span> @detail.ContrastReactionDetails</div>
                    }
                </div>
                @if (detail.ContrastReactionOccurred != true)
                {
                    <div class="entry-form compact">
                        <div class="form-grid">
                            <div class="form-row full"><label>Reaction Details</label><input type="text" @bind="cr_reaction" placeholder="Describe contrast reaction..." /></div>
                        </div>
                        <div class="form-actions">
                            <button @onclick="SubmitContrastReaction" disabled="@saving" class="btn btn-primary">Record Reaction</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="entry-form compact">
                    <div class="form-grid">
                        <div class="form-row"><label>Contrast Agent *</label><input type="text" @bind="ct_agent" placeholder="e.g. Omnipaque 300" /></div>
                        <div class="form-row"><label>Route</label>
                            <select @bind="ct_route"><option value="">--</option><option>IV</option><option>ORAL</option><option>RECTAL</option><option>INTRATHECAL</option></select>
                        </div>
                        <div class="form-row"><label>Volume (mL)</label><input type="number" @bind="ct_volume" step="0.1" min="0" /></div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="SubmitContrast" disabled="@saving" class="btn btn-primary">Record Contrast</button>
                    </div>
                </div>
            }
        </div>

        @* ── Radiation Dose ── *@
        <div class="section">
            <h4>Radiation Dose</h4>
            @if (detail.RadiationDoseMSv.HasValue || detail.CtdiVol.HasValue || detail.DoseLengthProduct.HasValue)
            {
                <div class="detail-grid">
                    <div><strong>Dose (mSv):</strong> @(detail.RadiationDoseMSv?.ToString("F2") ?? "--")</div>
                    <div><strong>CTDIvol (mGy):</strong> @(detail.CtdiVol?.ToString("F2") ?? "--")</div>
                    <div><strong>DLP (mGy*cm):</strong> @(detail.DoseLengthProduct?.ToString("F2") ?? "--")</div>
                </div>
            }
            else
            {
                <div class="entry-form compact">
                    <div class="form-grid">
                        <div class="form-row"><label>Dose (mSv)</label><input type="number" @bind="rd_msv" step="0.01" min="0" /></div>
                        <div class="form-row"><label>CTDIvol (mGy)</label><input type="number" @bind="rd_ctdi" step="0.01" min="0" /></div>
                        <div class="form-row"><label>DLP (mGy*cm)</label><input type="number" @bind="rd_dlp" step="0.01" min="0" /></div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="SubmitRadiationDose" disabled="@saving" class="btn btn-primary">Record Radiation Dose</button>
                    </div>
                </div>
            }
        </div>

        @* ── Critical Results ── *@
        <div class="section">
            <h4>Critical Results</h4>
            @if (detail.IsCriticalResult)
            {
                <div class="detail-grid">
                    <div><strong>Critical:</strong> <span class="badge badge-danger">YES</span></div>
                    <div><strong>Notified To:</strong> @(detail.CriticalResultNotifiedTo ?? "--")</div>
                    <div><strong>Notified At:</strong> @(detail.CriticalResultNotifiedDateTime?.ToString("MM/dd/yyyy HH:mm") ?? "--")</div>
                    <div><strong>Acknowledged By:</strong> @(detail.CriticalResultAcknowledgedBy ?? "--")</div>
                </div>
                @if (string.IsNullOrEmpty(detail.CriticalResultNotifiedTo))
                {
                    <div class="entry-form compact">
                        <div class="form-grid">
                            <div class="form-row"><label>Notified To *</label><ProviderPicker @bind-ProviderName="cn_to" Label="" DefaultToSelf="false" /></div>
                        </div>
                        <div class="form-actions">
                            <button @onclick="SubmitCriticalNotification" disabled="@saving" class="btn btn-primary">Record Notification</button>
                        </div>
                    </div>
                }
                else if (string.IsNullOrEmpty(detail.CriticalResultAcknowledgedBy))
                {
                    <div class="entry-form compact">
                        <div class="form-grid">
                            <div class="form-row"><label>Acknowledged By *</label><ProviderPicker @bind-ProviderName="cn_ack" Label="" DefaultToSelf="true" /></div>
                        </div>
                        <div class="form-actions">
                            <button @onclick="SubmitAcknowledgeCritical" disabled="@saving" class="btn btn-primary">Acknowledge</button>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="form-actions">
                    <button @onclick="FlagCritical" disabled="@saving" class="btn btn-primary">Flag as Critical Result</button>
                </div>
            }
        </div>

        @* ── AI Findings (grounded extraction + acknowledgment gate) ──
           Pull-only: nothing runs until a clinician asks. Every finding cites a verbatim
           report sentence; material findings (≥ Moderate) must be acknowledged or
           rejected-with-reason, and a rejection is recorded patient-visibly — the forcing
           function against skimming past the second finding in a busy report. *@
        @if (!string.IsNullOrEmpty(detail.ReportText))
        {
            <div class="section">
                <h4>AI Findings</h4>
                @if (findings is null)
                {
                    <div class="form-actions">
                        <button @onclick="ExtractFindings" disabled="@extracting" class="btn btn-secondary">
                            @(extracting ? "Reading report..." : "Extract findings from report")
                        </button>
                    </div>
                }
                else
                {
                    <div class="rf-provenance">
                        Extracted @findings.ExtractedDate.ToString("MM/dd/yyyy HH:mm") by @findings.ExtractedBy
                        · engine: @findings.ModelProvider
                        <button @onclick="ExtractFindings" disabled="@extracting" class="btn-link">
                            @(extracting ? "re-reading..." : "re-run")
                        </button>
                    </div>
                    @if (findings.Findings.Count == 0)
                    {
                        <div class="empty-state">No discrete findings were extracted from this report.</div>
                    }
                    @foreach (var f in findings.Findings)
                    {
                        <div class="rf-row @(f.RequiresAcknowledgment && f.Acknowledgment == FindingAcknowledgment.Pending ? "rf-material" : "")">
                            <div>
                                <span class="rf-chip @SeverityCss(f.Severity)">@f.Severity.ToString().ToLowerInvariant()</span>
                                <strong>@f.FindingType</strong>
                                @if (!string.IsNullOrEmpty(f.Level)) { <span>at @f.Level</span> }
                                @if (f.Laterality != FindingLaterality.Unspecified) { <span>(@f.Laterality.ToString().ToLowerInvariant())</span> }
                                @if (!f.QuoteVerified)
                                {
                                    <span class="rf-chip rf-unverified" title="@f.VerificationNote">unverified quote</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(f.SourceQuote))
                            {
                                <div class="rf-quote">"@f.SourceQuote"</div>
                            }
                            @if (f.RequiresAcknowledgment)
                            {
                                @if (f.Acknowledgment == FindingAcknowledgment.Pending)
                                {
                                    <div class="rf-gate">
                                        <span class="rf-chip rf-pending">material — needs a decision</span>
                                        <button @onclick="() => AcknowledgeFinding(f.FindingId)" disabled="@saving" class="btn btn-primary btn-sm">Acknowledge</button>
                                        <button @onclick="() => rejectingFindingId = f.FindingId" disabled="@saving" class="btn btn-secondary btn-sm">Reject...</button>
                                    </div>
                                    @if (rejectingFindingId == f.FindingId)
                                    {
                                        <div class="rf-gate">
                                            <input type="text" @bind="rejectReason" class="rf-reason"
                                                   placeholder="Reason (required) — recorded and visible to the patient" />
                                            <button @onclick="() => RejectFinding(f.FindingId)"
                                                    disabled="@(saving || string.IsNullOrWhiteSpace(rejectReason))"
                                                    class="btn btn-primary btn-sm">Reject finding</button>
                                        </div>
                                    }
                                }
                                else if (f.Acknowledgment == FindingAcknowledgment.Acknowledged)
                                {
                                    <div class="rf-disposition">Acknowledged by @f.DispositionedBy on @f.DispositionedDate?.ToString("MM/dd/yyyy HH:mm")</div>
                                }
                                else
                                {
                                    <div class="rf-disposition rf-rejected">
                                        Rejected by @f.DispositionedBy on @f.DispositionedDate?.ToString("MM/dd/yyyy HH:mm"):
                                        @f.RejectionReason <em>(recorded; visible to the patient)</em>
                                    </div>
                                }
                            }
                        </div>
                    }
                    <div class="rf-disclaimer">
                        Assistive extraction from the radiologist's own report text — not an
                        interpretation of the images, and not a substitute for reading the report.
                    </div>
                }
            </div>
        }

        @* ── Report Actions ── *@
        <div class="section">
            <h4>Report Actions</h4>
            @if (!string.IsNullOrEmpty(detail.SignedByName))
            {
                <div class="detail-grid">
                    <div><strong>Signed By:</strong> @detail.SignedByName</div>
                    <div><strong>Signed At:</strong> @detail.SignedDateTime?.ToString("MM/dd/yyyy HH:mm")</div>
                    <div><strong>Report Status:</strong> @(detail.ReportStatus ?? "--")</div>
                </div>
            }
            @if (string.IsNullOrEmpty(detail.SignedByName) && !string.IsNullOrEmpty(detail.ReportText))
            {
                <div class="entry-form compact">
                    <div class="form-grid">
                        <div class="form-row"><label>Radiologist Name *</label><input type="text" @bind="sr_name" /></div>
                        <div class="form-row"><label>Radiologist ID</label><input type="text" @bind="sr_id" /></div>
                    </div>
                    <div class="form-actions">
                        <button @onclick="SignReport" disabled="@saving" class="btn btn-primary">Sign Report</button>
                    </div>
                </div>
            }
            <div class="entry-form compact">
                <div class="form-grid">
                    <div class="form-row full"><label>Amendment Text</label><textarea @bind="am_text" rows="3" placeholder="Amend the report..."></textarea></div>
                </div>
                <div class="form-actions">
                    <button @onclick="AmendReport" disabled="@(saving || string.IsNullOrWhiteSpace(am_text))" class="btn btn-primary">Amend Report</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private List<RadiologySummary>? items;
    private RadiologyState? detail;
    private bool loading, saving, showNew;
    private string? error, success;
    private string activeTab = "list";

    // Order form
    private string f_procedure = "", f_cpt = "", f_type = "", f_provider = "", f_urgency = "ROUTINE", f_location = "", f_history = "", f_reason = "";

    // Contrast form
    private string ct_agent = "", ct_route = "";
    private double? ct_volume;
    private string cr_reaction = "";

    // Radiation dose form
    private double? rd_msv, rd_ctdi, rd_dlp;

    // Critical notification
    private string cn_to = "", cn_ack = "";

    // Sign report
    private string sr_name = "", sr_id = "";

    // Amend report
    private string am_text = "";

    // AI findings
    private RadiologyExtractionState? findings;
    private bool extracting;
    private string? rejectingFindingId;
    private string rejectReason = "";

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(patientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
            patientId = PatientContext.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId)) await Load();
    }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }
    private void SetTab(string tab) { activeTab = tab; success = null; }
    private void ShowForm() { showNew = true; success = null; f_procedure = ""; f_cpt = ""; f_type = ""; f_provider = ""; f_urgency = "ROUTINE"; f_location = ""; f_history = ""; f_reason = ""; }
    private void CloseDetail() { detail = null; findings = null; rejectingFindingId = null; rejectReason = ""; activeTab = "list"; }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        // Clear per-patient panel state so a stale detail from the previous patient
        // never survives a patient switch.
        detail = null; findings = null; rejectingFindingId = null; rejectReason = ""; activeTab = "list"; showNew = false;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            items = await grain.GetRadiologyStudiesAsync(100);
            PatientContext.SetPatient(patientId.Trim());
        }
        catch (Exception ex) { error = ex.Message; } finally { loading = false; }
    }

    private async Task ViewDetail(string id)
    {
        error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            detail = await grain.GetRadiologyStudyAsync(id);
            findings = await grain.GetRadiologyFindingsAsync(id);
            activeTab = "detail";
            ResetForms();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private string CurrentClinician => Grains.CurrentUserName ?? Grains.CurrentUserId ?? "UNKNOWN";

    private static string SeverityCss(FindingSeverity s) => s switch
    {
        FindingSeverity.Severe => "rf-severe",
        FindingSeverity.Moderate => "rf-moderate",
        FindingSeverity.Mild or FindingSeverity.Minimal => "rf-mild",
        _ => "rf-unspec",
    };

    private async Task ExtractFindings()
    {
        if (detail is null) return;
        extracting = true; error = null;
        try
        {
            findings = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim())
                .ExtractRadiologyFindingsAsync(detail.RadiologyId, CurrentClinician);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { extracting = false; }
    }

    private async Task AcknowledgeFinding(string findingId)
    {
        if (detail is null) return;
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.AcknowledgeRadiologyFindingAsync(detail.RadiologyId, findingId, CurrentClinician);
            findings = await grain.GetRadiologyFindingsAsync(detail.RadiologyId);
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task RejectFinding(string findingId)
    {
        if (detail is null || string.IsNullOrWhiteSpace(rejectReason)) return;
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.RejectRadiologyFindingAsync(detail.RadiologyId, findingId, CurrentClinician, rejectReason.Trim());
            findings = await grain.GetRadiologyFindingsAsync(detail.RadiologyId);
            rejectingFindingId = null; rejectReason = "";
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private void ResetForms()
    {
        ct_agent = ""; ct_route = ""; ct_volume = null; cr_reaction = "";
        rd_msv = null; rd_ctdi = null; rd_dlp = null;
        cn_to = ""; cn_ack = ""; sr_name = ""; sr_id = ""; am_text = "";
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(f_procedure)) { error = "Procedure name is required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            // CPOE: creates the linked ORDER #100 so the study shows on the Orders tab.
            await grain.PlaceRadiologyOrderAsync(
                f_procedure, null, NullIfEmpty(f_cpt), NullIfEmpty(f_type),
                null, NullIfEmpty(f_provider), f_urgency,
                NullIfEmpty(f_history), NullIfEmpty(f_reason),
                null, NullIfEmpty(f_location));
            showNew = false; success = "Study ordered."; await Load();
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task CompleteStudy(string id)
    {
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.CompleteRadiologyAsync(id, "Study reviewed.", "No acute findings.", null, null);
            success = "Study completed."; await Load();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SubmitContrast()
    {
        if (string.IsNullOrWhiteSpace(ct_agent)) { error = "Contrast agent is required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.RecordRadiologyContrastAsync(detail!.RadiologyId, ct_agent, NullIfEmpty(ct_route), ct_volume);
            success = "Contrast recorded."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task SubmitContrastReaction()
    {
        if (string.IsNullOrWhiteSpace(cr_reaction)) { error = "Reaction details required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.RecordRadiologyContrastReactionAsync(detail!.RadiologyId, cr_reaction);
            success = "Contrast reaction recorded."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task SubmitRadiationDose()
    {
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.RecordRadiationDoseAsync(detail!.RadiologyId, rd_msv, rd_ctdi, rd_dlp);
            success = "Radiation dose recorded."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task FlagCritical()
    {
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.FlagCriticalRadiologyResultAsync(detail!.RadiologyId);
            success = "Flagged as critical."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task SubmitCriticalNotification()
    {
        if (string.IsNullOrWhiteSpace(cn_to)) { error = "Notified To is required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.RecordCriticalResultNotificationAsync(detail!.RadiologyId, cn_to);
            success = "Notification recorded."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task SubmitAcknowledgeCritical()
    {
        if (string.IsNullOrWhiteSpace(cn_ack)) { error = "Acknowledged By is required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.AcknowledgeCriticalResultAsync(detail!.RadiologyId, cn_ack);
            success = "Critical result acknowledged."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task SignReport()
    {
        if (string.IsNullOrWhiteSpace(sr_name)) { error = "Radiologist name required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.SignRadiologyReportAsync(detail!.RadiologyId, NullIfEmpty(sr_id) ?? "", sr_name);
            success = "Report signed."; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private async Task AmendReport()
    {
        if (string.IsNullOrWhiteSpace(am_text)) { error = "Amendment text required."; return; }
        saving = true; error = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            await grain.AmendRadiologyReportAsync(detail!.RadiologyId, am_text);
            success = "Report amended."; am_text = ""; await ViewDetail(detail.RadiologyId);
        }
        catch (Exception ex) { error = ex.Message; } finally { saving = false; }
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string StatusCss(string s) => s switch { "COMPLETE" => "badge-success", "CANCELLED" => "badge-danger", _ => "badge-info" };
}

