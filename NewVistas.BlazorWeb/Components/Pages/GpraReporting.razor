@page "/gpra-reporting"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<h2>GPRA Population Health Reporting</h2>
<p>Government Performance and Results Act measures with fiscal year trending (RPMS BQIGPRA).</p>

@if (error != null)
{
    <div style="color:red;margin-bottom:1rem;">@error</div>
}

<!-- Tab bar -->
<div style="display:flex;gap:.5rem;margin-bottom:1rem;border-bottom:2px solid #ccc;">
    <button class="tab-btn @(activeTab=="reports"?"active":"")" @onclick='()=>SwitchTab("reports")'>Reports</button>
    <button class="tab-btn @(activeTab=="detail"?"active":"")" @onclick='()=>SwitchTab("detail")'>Report Detail</button>
    <button class="tab-btn @(activeTab=="indicator"?"active":"")" @onclick='()=>SwitchTab("indicator")'>Add Indicator</button>
</div>

<!-- ── Reports Tab ──────────────────────────────────────────────────────── -->
@if (activeTab == "reports")
{
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem;">
        <h4 style="margin:0;">GPRA Reports</h4>
        <div style="display:flex;gap:.5rem;align-items:center;">
            <select @bind="fyFilter" style="padding:.3rem .5rem;">
                <option value="0">All Fiscal Years</option>
                @foreach (int fy in fiscalYears) { <option value="@fy">FY @fy</option> }
            </select>
            <button @onclick="ApplyFyFilter" style="padding:.3rem .7rem;">Filter</button>
            <button @onclick="()=>showCreateForm=!showCreateForm" style="padding:.3rem .7rem;">
                @(showCreateForm ? "Cancel" : "+ New Report")
            </button>
        </div>
    </div>

    @if (showCreateForm)
    {
        <div class="form-card">
            <h5 style="margin-top:0;">Create GPRA Report</h5>
            <div class="form-grid">
                <div class="form-row"><label>Fiscal Year</label><input type="number" @bind="newReport.FiscalYear" /></div>
                <div class="form-row"><label>Reporting Period</label>
                    <select @bind="newReport.ReportingPeriodStr">@foreach (string p in reportingPeriods) { <option>@p</option> }</select>
                </div>
                <div class="form-row"><label>Current Period Start</label><input type="date" @bind="newReport.CurrentPeriodStart" /></div>
                <div class="form-row"><label>Current Period End</label><input type="date" @bind="newReport.CurrentPeriodEnd" /></div>
                <div class="form-row"><label>Baseline Period Start</label><input type="date" @bind="newReport.BaselinePeriodStart" /></div>
                <div class="form-row"><label>Baseline Period End</label><input type="date" @bind="newReport.BaselinePeriodEnd" /></div>
                <div class="form-row"><label>Facility ID</label><input @bind="newReport.FacilityId" /></div>
                <div class="form-row"><label>Facility Name</label><input @bind="newReport.FacilityName" /></div>
                <div class="form-row"><label>Community Taxonomy</label><input @bind="newReport.CommunityTaxonomy" placeholder="(optional)" /></div>
                <div class="form-row"><label>Active User Population</label><input type="number" @bind="newReport.ActiveUserPopulation" /></div>
                <div class="form-row"><label>Generated By ID</label><input @bind="newReport.GeneratedById" placeholder="(optional)" /></div>
                <div class="form-row"><label>Generated By Name</label><input @bind="newReport.GeneratedByName" placeholder="(optional)" /></div>
            </div>
            <button @onclick="CreateReport" style="margin-top:.5rem;padding:.3rem .8rem;">Create Report</button>
            @if (createMsg != null) { <span style="margin-left:.5rem;color:green;">@createMsg</span> }
        </div>
    }

    @if (loadingReports) { <p>Loading...</p> }
    else if (reports.Count == 0) { <p style="color:#666;">No GPRA reports on record.</p> }
    else
    {
        <table class="gpra-table">
            <thead>
                <tr>
                    <th>FY</th>
                    <th>Period</th>
                    <th>Facility</th>
                    <th>Status</th>
                    <th>Population</th>
                    <th>Indicators</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ReportSummary r in reports)
                {
                    <tr>
                        <td>@r.FiscalYear</td>
                        <td>@r.ReportingPeriod</td>
                        <td>@r.FacilityName</td>
                        <td><span class="badge @StatusBadge(r.Status)">@r.Status</span></td>
                        <td>@r.ActiveUserPopulation.ToString("N0")</td>
                        <td>@r.IndicatorCount</td>
                        <td>@r.CreatedDate.ToLocalTime().ToString("MM/dd/yy")</td>
                        <td>
                            <button @onclick="()=>SelectReport(r.ReportId)" style="padding:.2rem .5rem;font-size:.8rem;">View</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<!-- ── Report Detail Tab ────────────────────────────────────────────────── -->
@if (activeTab == "detail")
{
    @if (string.IsNullOrEmpty(selectedReportId))
    {
        <p style="color:#666;">Select a report from the Reports tab to view details.</p>
    }
    else if (loadingDetail) { <p>Loading report detail...</p> }
    else if (reportDetail != null)
    {
        <div style="display:flex;gap:.5rem;margin-bottom:1rem;">
            <button @onclick="()=>CompleteReport(selectedReportId)" style="padding:.3rem .7rem;"
                    disabled="@(reportDetail.Status == "Completed" || reportDetail.Status == "Error")">
                Mark Completed
            </button>
        </div>

        <div class="form-card" style="margin-bottom:1rem;">
            <h5 style="margin-top:0;">Report Header</h5>
            <div class="form-grid">
                <div class="form-row"><label>Fiscal Year</label><span>FY @reportDetail.FiscalYear</span></div>
                <div class="form-row"><label>Period</label><span>@reportDetail.ReportingPeriod</span></div>
                <div class="form-row"><label>Facility</label><span>@reportDetail.FacilityName (@reportDetail.FacilityId)</span></div>
                <div class="form-row"><label>Community</label><span>@(reportDetail.CommunityTaxonomy ?? "N/A")</span></div>
                <div class="form-row"><label>Active Users</label><span>@reportDetail.ActiveUserPopulation.ToString("N0")</span></div>
                <div class="form-row"><label>Status</label><span class="badge @StatusBadge(reportDetail.Status)">@reportDetail.Status</span></div>
                <div class="form-row"><label>Current Period</label><span>@reportDetail.CurrentPeriodStart.ToString("MM/dd/yyyy") - @reportDetail.CurrentPeriodEnd.ToString("MM/dd/yyyy")</span></div>
                <div class="form-row"><label>Baseline Period</label><span>@reportDetail.BaselinePeriodStart.ToString("MM/dd/yyyy") - @reportDetail.BaselinePeriodEnd.ToString("MM/dd/yyyy")</span></div>
            </div>
        </div>

        @if (reportDetail.Indicators.Count > 0)
        {
            <h5>Indicator Results (@reportDetail.Indicators.Count)</h5>
            <table class="gpra-table">
                <thead>
                    <tr>
                        <th>Measure</th>
                        <th>Category</th>
                        <th>Current Rate %</th>
                        <th>Baseline Rate %</th>
                        <th>Change</th>
                        <th>Target</th>
                        <th>Met</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (IndicatorDto ind in reportDetail.Indicators)
                    {
                        <tr>
                            <td title="@ind.MeasureId">@ind.Title</td>
                            <td>@ind.Category</td>
                            <td>@ind.CurrentPerformanceRate.ToString("F1")% (@ind.CurrentNumerator/@ind.CurrentDenominator)</td>
                            <td>@ind.BaselinePerformanceRate.ToString("F1")% (@ind.BaselineNumerator/@ind.BaselineDenominator)</td>
                            <td style="color:@(ind.PercentagePointChange >= 0 ? "#166534" : "#991b1b");">
                                @(ind.PercentagePointChange >= 0 ? "+" : "")@ind.PercentagePointChange.ToString("F1")pp
                            </td>
                            <td>@(ind.TargetRate.HasValue ? $"{ind.TargetRate:F1}%" : "N/A")</td>
                            <td><span class="badge @(ind.TargetMet ? "badge-met" : "badge-notmet")">@(ind.TargetMet ? "Met" : "Not Met")</span></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem;">
                <div class="stat-box">
                    <div class="stat-num">@reportDetail.Indicators.Count(i => i.IsImproved)</div>
                    <div class="stat-lbl">Improved</div>
                </div>
                <div class="stat-box">
                    <div class="stat-num">@reportDetail.Indicators.Count(i => i.TargetMet)</div>
                    <div class="stat-lbl">Targets Met</div>
                </div>
                <div class="stat-box">
                    <div class="stat-num">@(reportDetail.Indicators.Count > 0 ? reportDetail.Indicators.Average(i => i.CurrentPerformanceRate).ToString("F1") : "0")%</div>
                    <div class="stat-lbl">Avg Performance</div>
                </div>
            </div>
        }
        else
        {
            <p style="color:#666;">No indicator results yet. Use the Add Indicator tab to add results.</p>
        }
    }
}

<!-- ── Add Indicator Tab ────────────────────────────────────────────────── -->
@if (activeTab == "indicator")
{
    @if (string.IsNullOrEmpty(selectedReportId))
    {
        <p style="color:#666;">Select a report from the Reports tab first.</p>
    }
    else
    {
        <div class="form-card">
            <h5 style="margin-top:0;">Add Indicator Result to @selectedReportId.Split(':').Last()[..8]...</h5>
            <div class="form-grid">
                <div class="form-row"><label>Measure ID</label><input @bind="newInd.MeasureId" placeholder="e.g. GPRA-DM-01" /></div>
                <div class="form-row"><label>Title</label><input @bind="newInd.Title" placeholder="e.g. Diabetes: HbA1c Testing" /></div>
                <div class="form-row"><label>Category</label>
                    <select @bind="newInd.CategoryStr">@foreach (string c in clinicalCategories) { <option>@c</option> }</select>
                </div>
                <div class="form-row"><label>Current Denominator</label><input type="number" @bind="newInd.CurrentDenominator" /></div>
                <div class="form-row"><label>Current Numerator</label><input type="number" @bind="newInd.CurrentNumerator" /></div>
                <div class="form-row"><label>Current Rate %</label><input type="number" step="0.1" @bind="newInd.CurrentPerformanceRate" /></div>
                <div class="form-row"><label>Baseline Denominator</label><input type="number" @bind="newInd.BaselineDenominator" /></div>
                <div class="form-row"><label>Baseline Numerator</label><input type="number" @bind="newInd.BaselineNumerator" /></div>
                <div class="form-row"><label>Baseline Rate %</label><input type="number" step="0.1" @bind="newInd.BaselinePerformanceRate" /></div>
                <div class="form-row"><label>Change (pp)</label><input type="number" step="0.1" @bind="newInd.PercentagePointChange" /></div>
                <div class="form-row"><label>Improved</label>
                    <input type="checkbox" @bind="newInd.IsImproved" style="width:auto;" />
                </div>
                <div class="form-row"><label>Target Rate %</label><input type="number" step="0.1" @bind="newInd.TargetRate" placeholder="(optional)" /></div>
                <div class="form-row"><label>Target Met</label>
                    <input type="checkbox" @bind="newInd.TargetMet" style="width:auto;" />
                </div>
            </div>
            <button @onclick="AddIndicator" style="margin-top:.5rem;padding:.3rem .8rem;">Add Indicator</button>
            @if (indMsg != null) { <span style="margin-left:.5rem;color:green;">@indMsg</span> }
        </div>
    }
}

<style>
    .tab-btn { padding:.4rem 1rem;border:1px solid #ccc;border-bottom:none;background:#f5f5f5;cursor:pointer;border-radius:4px 4px 0 0; }
    .tab-btn.active { background:white;font-weight:bold;border-bottom:2px solid white;margin-bottom:-2px; }
    .form-card { background:#f9f9f9;border:1px solid #ddd;border-radius:6px;padding:1rem;margin-bottom:1rem; }
    .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:.25rem; }
    .form-row { display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem; }
    .form-row label { width:160px;font-size:.85rem;color:#444;flex-shrink:0; }
    .form-row input, .form-row select { flex:1;padding:.25rem .5rem; }
    .gpra-table { width:100%;border-collapse:collapse;font-size:.9rem; }
    .gpra-table th, .gpra-table td { border:1px solid #ddd;padding:.4rem .6rem;text-align:left; }
    .gpra-table th { background:#f0f0f0;font-weight:600; }
    .gpra-table tr:hover { background:#fafafa; }
    .badge { display:inline-block;padding:.15rem .5rem;border-radius:10px;font-size:.78rem;font-weight:600; }
    .badge-draft     { background:#dbeafe;color:#1e40af; }
    .badge-eval      { background:#fef9c3;color:#854d0e; }
    .badge-completed { background:#dcfce7;color:#166534; }
    .badge-error     { background:#fee2e2;color:#991b1b; }
    .badge-met       { background:#dcfce7;color:#166534; }
    .badge-notmet    { background:#fee2e2;color:#991b1b; }
    .stat-box { background:#f0f4ff;border:1px solid #c7d7ff;border-radius:6px;padding:.6rem 1.2rem;text-align:center;min-width:110px; }
    .stat-num { font-size:1.6rem;font-weight:bold;color:#1e40af; }
    .stat-lbl { font-size:.78rem;color:#555; }
</style>

@code {
    string activeTab = "reports";
    string? error;

    // Reports tab
    bool loadingReports;
    bool showCreateForm;
    List<ReportSummary> reports = new();
    NewReportModel newReport = new();
    string? createMsg;
    int fyFilter;
    int[] fiscalYears = [2024, 2025, 2026, 2027];

    // Detail tab
    string? selectedReportId;
    bool loadingDetail;
    ReportDetailDto? reportDetail;

    // Indicator tab
    NewIndicatorModel newInd = new();
    string? indMsg;

    string[] reportingPeriods = Enum.GetNames(typeof(GpraReportingPeriodDto));
    string[] clinicalCategories = Enum.GetNames(typeof(GpraClinicalCategoryDto));

    protected override async Task OnInitializedAsync() => await SwitchTab("reports");

    async Task SwitchTab(string tab)
    {
        activeTab = tab;
        error = null;
        if (tab == "reports") await LoadReports();
        else if (tab == "detail" && selectedReportId != null) await LoadReportDetail();
    }

    private IGpraReportIndexGrain GetIndexGrain() => Grains.GetGrain<IGpraReportIndexGrain>("GPRA-REPORT-IDX");

    async Task LoadReports()
    {
        loadingReports = true;
        try
        {
            var grain = GetIndexGrain();
            var entries = await grain.GetAllAsync();
            reports = entries.Select(e => new ReportSummary
            {
                ReportId = e.ReportId, FiscalYear = e.FiscalYear, ReportingPeriod = e.ReportingPeriod.ToString(),
                Status = e.Status.ToString(), FacilityName = e.FacilityName,
                ActiveUserPopulation = e.ActiveUserPopulation, IndicatorCount = e.IndicatorCount, CreatedDate = e.CreatedDate
            }).ToList();
        }
        catch { reports = new(); }
        finally { loadingReports = false; }
    }

    async Task ApplyFyFilter()
    {
        if (fyFilter == 0) { await LoadReports(); return; }
        loadingReports = true;
        try
        {
            var grain = GetIndexGrain();
            var entries = await grain.GetByFiscalYearAsync(fyFilter);
            reports = entries.Select(e => new ReportSummary
            {
                ReportId = e.ReportId, FiscalYear = e.FiscalYear, ReportingPeriod = e.ReportingPeriod.ToString(),
                Status = e.Status.ToString(), FacilityName = e.FacilityName,
                ActiveUserPopulation = e.ActiveUserPopulation, IndicatorCount = e.IndicatorCount, CreatedDate = e.CreatedDate
            }).ToList();
        }
        catch { reports = new(); }
        finally { loadingReports = false; }
    }

    async Task CreateReport()
    {
        createMsg = null;
        try
        {
            var reportId = $"GPRA-REPORT:{Guid.NewGuid()}";
            var period = Enum.Parse<GpraReportingPeriod>(newReport.ReportingPeriodStr);
            var grain = Grains.GetGrain<IGpraReportGrain>(reportId);
            await grain.CreateAsync(newReport.FiscalYear, period,
                newReport.CurrentPeriodStart.ToUniversalTime(), newReport.CurrentPeriodEnd.ToUniversalTime(),
                newReport.BaselinePeriodStart.ToUniversalTime(), newReport.BaselinePeriodEnd.ToUniversalTime(),
                newReport.FacilityId, newReport.FacilityName,
                string.IsNullOrWhiteSpace(newReport.CommunityTaxonomy) ? null : newReport.CommunityTaxonomy,
                newReport.ActiveUserPopulation,
                string.IsNullOrWhiteSpace(newReport.GeneratedById) ? null : newReport.GeneratedById,
                string.IsNullOrWhiteSpace(newReport.GeneratedByName) ? null : newReport.GeneratedByName);

            var indexGrain = GetIndexGrain();
            await indexGrain.AddEntryAsync(new GpraReportIndexEntry
            {
                ReportId = reportId, FiscalYear = newReport.FiscalYear, ReportingPeriod = period,
                Status = GpraReportStatus.Draft, FacilityName = newReport.FacilityName,
                ActiveUserPopulation = newReport.ActiveUserPopulation, IndicatorCount = 0, CreatedDate = DateTime.UtcNow
            });

            createMsg = "Report created.";
            newReport = new();
            showCreateForm = false;
            await LoadReports();
        }
        catch { createMsg = "Error creating report."; }
    }

    async Task SelectReport(string reportId)
    {
        selectedReportId = reportId;
        activeTab = "detail";
        await LoadReportDetail();
    }

    async Task LoadReportDetail()
    {
        if (selectedReportId is null) return;
        loadingDetail = true;
        try
        {
            var grain = Grains.GetGrain<IGpraReportGrain>(selectedReportId);
            var state = await grain.GetAsync();
            reportDetail = new ReportDetailDto
            {
                ReportId = state.ReportId, Status = state.Status.ToString(), FiscalYear = state.FiscalYear,
                ReportingPeriod = state.ReportingPeriod.ToString(),
                CurrentPeriodStart = state.CurrentPeriodStart, CurrentPeriodEnd = state.CurrentPeriodEnd,
                BaselinePeriodStart = state.BaselinePeriodStart, BaselinePeriodEnd = state.BaselinePeriodEnd,
                FacilityId = state.FacilityId, FacilityName = state.FacilityName,
                CommunityTaxonomy = state.CommunityTaxonomy, ActiveUserPopulation = state.ActiveUserPopulation,
                Indicators = state.Indicators?.Select(i => new IndicatorDto
                {
                    MeasureId = i.MeasureId, Title = i.Title, Category = i.Category.ToString(),
                    CurrentDenominator = i.CurrentDenominator, CurrentNumerator = i.CurrentNumerator,
                    CurrentPerformanceRate = i.CurrentPerformanceRate,
                    BaselineDenominator = i.BaselineDenominator, BaselineNumerator = i.BaselineNumerator,
                    BaselinePerformanceRate = i.BaselinePerformanceRate,
                    PercentagePointChange = i.PercentagePointChange, IsImproved = i.IsImproved,
                    TargetRate = i.TargetRate, TargetMet = i.TargetMet
                }).ToList() ?? new(),
                CqmReportIds = state.CqmReportIds ?? new(), ErrorMessage = state.ErrorMessage
            };
        }
        catch { error = "Error loading report detail."; reportDetail = null; }
        finally { loadingDetail = false; }
    }

    async Task CompleteReport(string reportId)
    {
        try
        {
            var grain = Grains.GetGrain<IGpraReportGrain>(reportId);
            await grain.CompleteAsync();
            await LoadReportDetail();
            await LoadReports();
        }
        catch { error = "Error completing report."; }
    }

    async Task AddIndicator()
    {
        if (selectedReportId is null) return;
        indMsg = null;
        try
        {
            var category = Enum.Parse<GpraClinicalCategory>(newInd.CategoryStr);
            var grain = Grains.GetGrain<IGpraReportGrain>(selectedReportId);
            await grain.AddIndicatorResultAsync(new GpraIndicatorResult
            {
                MeasureId = newInd.MeasureId, Title = newInd.Title, Category = category,
                CurrentDenominator = newInd.CurrentDenominator, CurrentNumerator = newInd.CurrentNumerator,
                CurrentPerformanceRate = newInd.CurrentPerformanceRate,
                BaselineDenominator = newInd.BaselineDenominator, BaselineNumerator = newInd.BaselineNumerator,
                BaselinePerformanceRate = newInd.BaselinePerformanceRate,
                PercentagePointChange = newInd.PercentagePointChange, IsImproved = newInd.IsImproved,
                TargetRate = newInd.TargetRate, TargetMet = newInd.TargetMet
            });
            indMsg = "Indicator added.";
            newInd = new();
            await LoadReportDetail();
        }
        catch { indMsg = "Error adding indicator."; }
    }

    string StatusBadge(string s) => s.ToLower() switch
    {
        "draft"      => "badge-draft",
        "evaluating" => "badge-eval",
        "completed"  => "badge-completed",
        "error"      => "badge-error",
        _            => "badge-draft"
    };

    // ── Local enums (mirror server-side values) ─────────────────────────────

    enum GpraReportingPeriodDto { FullFiscalYear, Quarter1, Quarter2, Quarter3, Quarter4 }
    enum GpraClinicalCategoryDto { Diabetes, CardiovascularDisease, WomensHealth, Immunizations, BehavioralHealth, PreventiveCare, Asthma, ChildHealth, OralHealth, ObstetricsGynecology }

    // ── Local model classes ──────────────────────────────────────────────────

    class NewReportModel
    {
        public int FiscalYear { get; set; } = 2026;
        public string ReportingPeriodStr { get; set; } = "FullFiscalYear";
        public DateTime CurrentPeriodStart { get; set; } = new DateTime(2025, 10, 1);
        public DateTime CurrentPeriodEnd { get; set; } = new DateTime(2026, 9, 30);
        public DateTime BaselinePeriodStart { get; set; } = new DateTime(2022, 10, 1);
        public DateTime BaselinePeriodEnd { get; set; } = new DateTime(2023, 9, 30);
        public string FacilityId { get; set; } = string.Empty;
        public string FacilityName { get; set; } = string.Empty;
        public string? CommunityTaxonomy { get; set; }
        public int ActiveUserPopulation { get; set; }
        public string? GeneratedById { get; set; }
        public string? GeneratedByName { get; set; }
    }

    class NewIndicatorModel
    {
        public string MeasureId { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string CategoryStr { get; set; } = "Diabetes";
        public int CurrentDenominator { get; set; }
        public int CurrentNumerator { get; set; }
        public decimal CurrentPerformanceRate { get; set; }
        public int BaselineDenominator { get; set; }
        public int BaselineNumerator { get; set; }
        public decimal BaselinePerformanceRate { get; set; }
        public decimal PercentagePointChange { get; set; }
        public bool IsImproved { get; set; }
        public decimal? TargetRate { get; set; }
        public bool TargetMet { get; set; }
    }

    class ReportSummary
    {
        public string ReportId { get; set; } = string.Empty;
        public int FiscalYear { get; set; }
        public string ReportingPeriod { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string FacilityName { get; set; } = string.Empty;
        public int ActiveUserPopulation { get; set; }
        public int IndicatorCount { get; set; }
        public DateTime CreatedDate { get; set; }
    }

    class ReportDetailDto
    {
        public string ReportId { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int FiscalYear { get; set; }
        public string ReportingPeriod { get; set; } = string.Empty;
        public DateTime CurrentPeriodStart { get; set; }
        public DateTime CurrentPeriodEnd { get; set; }
        public DateTime BaselinePeriodStart { get; set; }
        public DateTime BaselinePeriodEnd { get; set; }
        public string FacilityId { get; set; } = string.Empty;
        public string FacilityName { get; set; } = string.Empty;
        public string? CommunityTaxonomy { get; set; }
        public int ActiveUserPopulation { get; set; }
        public List<IndicatorDto> Indicators { get; set; } = new();
        public List<string> CqmReportIds { get; set; } = new();
        public string? ErrorMessage { get; set; }
    }

    class IndicatorDto
    {
        public string MeasureId { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public int CurrentDenominator { get; set; }
        public int CurrentNumerator { get; set; }
        public decimal CurrentPerformanceRate { get; set; }
        public int BaselineDenominator { get; set; }
        public int BaselineNumerator { get; set; }
        public decimal BaselinePerformanceRate { get; set; }
        public decimal PercentagePointChange { get; set; }
        public bool IsImproved { get; set; }
        public decimal? TargetRate { get; set; }
        public bool TargetMet { get; set; }
    }
}
