@page "/agent-cashier"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Agent Cashier</PageTitle>

<h1>Agent Cashier</h1>

<AlertBanner Error="@error" />

<div class="tab-bar">
    <button class="tab @(activeTab == "window" ? "active" : "")"
            @onclick='() => activeTab = "window"'>Cashier Window</button>
    <button class="tab @(activeTab == "sessions" ? "active" : "")"
            @onclick='() => SetTab("sessions")'>Sessions</button>
</div>

@* ── TAB: Cashier Window ───────────────────────────────────────────────── *@
@if (activeTab == "window")
{
    <div class="tab-content">
        <div class="window-columns">

            @* Left: patient receipt history *@
            <div class="col-patient">
                <h4>Patient Receipt History</h4>
                <div class="lookup-bar">
                    <input class="lookup-input" placeholder="Patient ID" @bind="patientId" />
                    <button class="btn btn-primary" @onclick="LoadPatientReceipts">Load</button>
                </div>
                @if (patientReceipts.Count > 0)
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Receipt #</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ReceiptIndexEntry r in patientReceipts)
                            {
                                <tr>
                                    <td>@r.ReceiptNumber</td>
                                    <td>@r.Amount.ToString("C")</td>
                                    <td>@r.PaymentMethod</td>
                                    <td><span class="badge @BadgeClass(r.Status)">@r.Status</span></td>
                                    <td>@r.ReceiptDate.ToShortDateString()</td>
                                    <td>
                                        @if (r.Status == "Issued")
                                        {
                                            <button class="btn btn-primary"
                                                    @onclick="() => OpenVoidReceipt(r.ReceiptId, r.ReceiptNumber)">
                                                Void
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else if (patientLoaded)
                {
                    <p class="empty-state">No receipts on file.</p>
                }

                @* Void panel *@
                @if (!string.IsNullOrEmpty(voidingReceiptId))
                {
                    <div class="action-panel">
                        <h5>Void Receipt @voidingReceiptNumber</h5>
                        <div class="form-section">
                            <FormField Label="Void Reason"><input class="form-input" @bind="voidReason" /></FormField>
                            <FormField Label="Your User ID"><input class="form-input" @bind="voidUserId" /></FormField>
                        </div>
                        <AlertBanner Error="@voidError" />
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SubmitVoid">Confirm Void</button>
                            <button class="btn btn-primary" @onclick="() => voidingReceiptId = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>

            @* Right: issue receipt form *@
            <div class="col-issue">
                <h4>Issue Receipt</h4>
                <div class="form-section">
                    <FormField Label="Receipt Number">
                        <input class="form-input" placeholder="e.g. R-20260227-001" @bind="newReceipt.ReceiptNumber" />
                    </FormField>
                    <FormField Label="Patient ID">
                        <input class="form-input" @bind="newReceipt.PatientId" />
                    </FormField>
                    <FormField Label="Patient Name">
                        <input class="form-input" @bind="newReceipt.PatientName" />
                    </FormField>
                    <FormField Label="AR Account ID">
                        <input class="form-input" placeholder="AR-ACCOUNT:{id}" @bind="newReceipt.ARAccountId" />
                    </FormField>
                    <FormField Label="Amount">
                        <input type="number" class="form-input" @bind="newReceipt.Amount" />
                    </FormField>
                    <FormField Label="Payment Method">
                        <select class="form-input" @bind="newReceipt.PaymentMethod">
                            @foreach (string m in paymentMethods)
                            {
                                <option value="@m">@m</option>
                            }
                        </select>
                    </FormField>
                    @if (newReceipt.PaymentMethod == "Check" || newReceipt.PaymentMethod == "MoneyOrder")
                    {
                        <FormField Label="Check / MO Number">
                            <input class="form-input" @bind="newReceipt.CheckNumber" />
                        </FormField>
                    }
                    <FormField Label="Session ID">
                        <input class="form-input" placeholder="Paste session ID from Sessions tab" @bind="newReceipt.SessionId" />
                    </FormField>
                    <FormField Label="Cashier ID">
                        <input class="form-input" @bind="newReceipt.CashierId" />
                    </FormField>
                    <FormField Label="Cashier Name">
                        <input class="form-input" @bind="newReceipt.CashierName" />
                    </FormField>
                    <FormField Label="Notes (optional)">
                        <input class="form-input" @bind="newReceipt.Notes" />
                    </FormField>
                </div>
                <AlertBanner Error="@receiptFormError" Success="@receiptFormSuccess" />
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="IssueReceipt">Issue Receipt</button>
                </div>
            </div>

        </div>
    </div>
}

@* ── TAB: Sessions ─────────────────────────────────────────────────────── *@
@if (activeTab == "sessions")
{
    <div class="tab-content">
        <div class="session-columns">

            @* Left: open sessions *@
            <div class="col-open-sessions">
                <h4>Open Sessions</h4>
                @if (openSessions.Count == 0)
                {
                    <p class="empty-state">No open sessions.</p>
                }
                else
                {
                    @foreach (SessionIndexEntry s in openSessions)
                    {
                        <div class="session-card">
                            <div class="session-card-header">
                                <strong>@s.CashierName</strong>
                                <span class="badge badge-success">OPEN</span>
                            </div>
                            <div class="session-detail">Station: @s.StationId | @s.SessionDate.ToShortDateString()</div>
                            <div class="session-detail">Total Collected: @s.TotalCollected.ToString("C")</div>
                            <div class="session-id" style="font-size:.7rem">@s.SessionId</div>
                            <div class="session-actions mt-2">
                                <button class="btn btn-primary me-1"
                                        @onclick="() => OpenClosePanel(s.SessionId)">
                                    Close Session
                                </button>
                                <button class="btn btn-primary"
                                        @onclick="() => OpenTurnInPanel(s.SessionId)">
                                    Turn In
                                </button>
                            </div>
                        </div>
                    }
                }

                @* Close session panel *@
                @if (!string.IsNullOrEmpty(closingSessionId))
                {
                    <div class="action-panel">
                        <h5>Close Session</h5>
                        <div class="form-section">
                            <FormField Label="Actual Balance"><input type="number" class="form-input" @bind="actualBalance" /></FormField>
                            <FormField Label="Notes (optional)"><input class="form-input" @bind="closeNotes" /></FormField>
                        </div>
                        <AlertBanner Error="@sessionActionError" />
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SubmitClose">Close</button>
                            <button class="btn btn-primary" @onclick="() => closingSessionId = null">Cancel</button>
                        </div>
                    </div>
                }

                @* Turn-in panel *@
                @if (!string.IsNullOrEmpty(turningInSessionId))
                {
                    <div class="action-panel">
                        <h5>Turn In to Fiscal</h5>
                        <div class="form-section">
                            <FormField Label="Turned In Amount"><input type="number" class="form-input" @bind="turnInAmount" /></FormField>
                            <FormField Label="Receiving Officer User ID"><input class="form-input" @bind="turnInToUserId" /></FormField>
                            <FormField Label="Turn-In Receipt # (optional)"><input class="form-input" @bind="turnInReceiptNumber" /></FormField>
                        </div>
                        <AlertBanner Error="@sessionActionError" />
                        <div class="form-actions">
                            <button class="btn btn-primary" @onclick="SubmitTurnIn">Submit Turn-In</button>
                            <button class="btn btn-primary" @onclick="() => turningInSessionId = null">Cancel</button>
                        </div>
                    </div>
                }
            </div>

            @* Right: all sessions + open new session *@
            <div class="col-all-sessions">
                <h4>All Sessions</h4>
                @if (allSessions.Count > 0)
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Cashier</th>
                                <th>Station</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Turned In</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (SessionIndexEntry s in allSessions)
                            {
                                <tr>
                                    <td>@s.SessionDate.ToShortDateString()</td>
                                    <td>@s.CashierName</td>
                                    <td>@s.StationId</td>
                                    <td>@s.TotalCollected.ToString("C")</td>
                                    <td><span class="badge @BadgeClass(s.Status)">@s.Status</span></td>
                                    <td>@(s.TurnedInDate.HasValue ? s.TurnedInDate.Value.ToShortDateString() : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="empty-state">No sessions on file.</p>
                }

                <h5>Open New Session</h5>
                <div class="form-section">
                    <FormField Label="Station ID">
                        <input class="form-input" placeholder="e.g. WIN-1" @bind="newSession.StationId" />
                    </FormField>
                    <FormField Label="Station Name">
                        <input class="form-input" placeholder="e.g. Window 1" @bind="newSession.StationName" />
                    </FormField>
                    <FormField Label="Cashier ID">
                        <input class="form-input" @bind="newSession.CashierId" />
                    </FormField>
                    <FormField Label="Cashier Name">
                        <input class="form-input" @bind="newSession.CashierName" />
                    </FormField>
                    <FormField Label="Session Date">
                        <input type="date" class="form-input" @bind="newSession.SessionDate" />
                    </FormField>
                    <FormField Label="Opening Balance">
                        <input type="number" class="form-input" @bind="newSession.OpeningBalance" />
                    </FormField>
                </div>
                <AlertBanner Error="@sessionFormError" Success="@sessionFormSuccess" />
                <div class="form-actions">
                    <button class="btn btn-primary" @onclick="OpenSession">Open Session</button>
                </div>
            </div>

        </div>
    </div>
}

<style>
    /* Canonical classes (lookup-bar, lookup-input, tab, tab-bar, data-table, alert,
       btn, badge, form-section, empty-state) are defined once in app.css per
       UI-CONVENTIONS.md. Page-specific layout only below. */
    .tab-content { padding: 1rem 0; }
    .window-columns { display: flex; gap: 2rem; flex-wrap: wrap; }
    .col-patient { flex: 1; min-width: 320px; }
    .col-issue { flex: 0 0 340px; }
    .session-columns { display: flex; gap: 2rem; flex-wrap: wrap; }
    .col-open-sessions { flex: 1; min-width: 280px; }
    .col-all-sessions { flex: 2; min-width: 360px; }
    .action-panel { background: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; padding: 1rem; margin-top: 1rem; }
    .session-card { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: .75rem; margin-bottom: .75rem; }
    .session-card-header { display: flex; align-items: center; gap: .5rem; }
    .session-detail { font-size: .85rem; }
    .session-id { word-break: break-all; color: #6c757d; }
    .session-actions { display: flex; gap: .25rem; }
    .me-1 { margin-right: .25rem; }
    .mt-2 { margin-top: .5rem; }
</style>

@code {
    // ── state ─────────────────────────────────────────────────────────────────
    string activeTab = "window";
    string? error;

    // Window tab
    string patientId = string.Empty;
    bool patientLoaded;
    List<ReceiptIndexEntry> patientReceipts = new();

    // Void
    string? voidingReceiptId;
    string voidingReceiptNumber = string.Empty;
    string voidReason = string.Empty;
    string voidUserId = string.Empty;
    string? voidError;

    // Issue receipt
    NewReceiptForm newReceipt = new();
    string? receiptFormError;
    string? receiptFormSuccess;

    // Sessions tab
    List<SessionIndexEntry> openSessions = new();
    List<SessionIndexEntry> allSessions = new();

    // Close session
    string? closingSessionId;
    decimal actualBalance;
    string closeNotes = string.Empty;

    // Turn-in
    string? turningInSessionId;
    decimal turnInAmount;
    string turnInToUserId = string.Empty;
    string turnInReceiptNumber = string.Empty;

    string? sessionActionError;

    // New session
    NewSessionForm newSession = new();
    string? sessionFormError;
    string? sessionFormSuccess;

    static readonly string[] paymentMethods = ["Cash", "Check", "MoneyOrder", "CreditCard", "WireTransfer"];

    // ── helpers ───────────────────────────────────────────────────────────────

    static string BadgeClass(string status) => status switch
    {
        "Issued"   => "badge-success",
        "Voided"   => "badge-danger",
        "TurnedIn" => "badge-neutral",
        "Open"     => "badge-success",
        "Closed"   => "badge-warning",
        _          => "badge-neutral",
    };

    async Task SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "sessions") await LoadSessions();
    }

    // ── patient receipts ──────────────────────────────────────────────────────

    async Task LoadPatientReceipts()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Enter a Patient ID."; return; }
        try
        {
            var indexGrain = Grains.GetGrain<ICashierReceiptIndexGrain>($"CASHIER-RECEIPT-IDX:{patientId.Trim()}");
            List<CashierReceiptIndexEntry> entries = await indexGrain.GetAllAsync();
            patientReceipts = entries.Select(e => new ReceiptIndexEntry
            {
                ReceiptId = e.ReceiptId,
                ReceiptNumber = e.ReceiptNumber,
                PatientId = e.PatientId,
                ARAccountId = e.ARAccountId,
                Amount = e.Amount,
                PaymentMethod = e.PaymentMethod,
                Status = e.Status,
                ReceiptDate = e.ReceiptDate,
            }).ToList();
            patientLoaded = true;
        }
        catch (Exception ex) { error = $"Error loading receipts: {ex.Message}"; }
    }

    void OpenVoidReceipt(string id, string number)
    {
        voidingReceiptId     = id;
        voidingReceiptNumber = number;
        voidReason           = string.Empty;
        voidUserId           = string.Empty;
        voidError            = null;
    }

    async Task SubmitVoid()
    {
        voidError = null;
        if (string.IsNullOrWhiteSpace(voidReason)) { voidError = "Void reason is required."; return; }
        try
        {
            string grainKey = voidingReceiptId!.StartsWith("CASHIER-RECEIPT:") ? voidingReceiptId : $"CASHIER-RECEIPT:{voidingReceiptId}";
            var receiptGrain = Grains.GetGrain<ICashierReceiptGrain>(grainKey);
            await receiptGrain.VoidAsync(voidReason, voidUserId);
            voidingReceiptId = null;
            await LoadPatientReceipts();
        }
        catch (Exception ex) { voidError = ex.Message; }
    }

    // ── issue receipt ─────────────────────────────────────────────────────────

    async Task IssueReceipt()
    {
        receiptFormError = null; receiptFormSuccess = null;
        if (string.IsNullOrWhiteSpace(newReceipt.ReceiptNumber) || string.IsNullOrWhiteSpace(newReceipt.SessionId))
        {
            receiptFormError = "Receipt number and session ID are required."; return;
        }
        try
        {
            string receiptId = Guid.NewGuid().ToString();
            var receiptGrain = Grains.GetGrain<ICashierReceiptGrain>($"CASHIER-RECEIPT:{receiptId}");
            CashierPaymentMethod method = Enum.TryParse<CashierPaymentMethod>(newReceipt.PaymentMethod, out var pm) ? pm : CashierPaymentMethod.Cash;
            await receiptGrain.IssueAsync(
                newReceipt.ReceiptNumber, newReceipt.PatientId, newReceipt.PatientName,
                newReceipt.ARAccountId, newReceipt.Amount, method,
                newReceipt.CashierId, newReceipt.CashierName, newReceipt.SessionId,
                string.IsNullOrWhiteSpace(newReceipt.CheckNumber) ? null : newReceipt.CheckNumber,
                newReceipt.Notes);
            // Update receipt index for this patient
            var indexGrain = Grains.GetGrain<ICashierReceiptIndexGrain>($"CASHIER-RECEIPT-IDX:{newReceipt.PatientId}");
            await indexGrain.AddOrUpdateAsync(new CashierReceiptIndexEntry
            {
                ReceiptId = $"CASHIER-RECEIPT:{receiptId}",
                ReceiptNumber = newReceipt.ReceiptNumber,
                PatientId = newReceipt.PatientId,
                ARAccountId = newReceipt.ARAccountId,
                Amount = newReceipt.Amount,
                PaymentMethod = newReceipt.PaymentMethod,
                Status = "Issued",
                ReceiptDate = DateTime.UtcNow,
            });
            receiptFormSuccess = "Receipt issued successfully.";
            newReceipt = new NewReceiptForm();
            if (patientLoaded) await LoadPatientReceipts();
        }
        catch (Exception ex) { receiptFormError = ex.Message; }
    }

    // ── sessions ──────────────────────────────────────────────────────────────

    async Task LoadSessions()
    {
        try
        {
            var sessionIdx = Grains.GetGrain<ICashierSessionIndexGrain>("CASHIER-SESSION-IDX");
            List<CashierSessionIndexEntry> allEntries = await sessionIdx.GetAllAsync();
            List<CashierSessionIndexEntry> openEntries = await sessionIdx.GetOpenSessionsAsync();
            allSessions = allEntries.Select(MapSession).ToList();
            openSessions = openEntries.Select(MapSession).ToList();
        }
        catch (Exception ex) { error = $"Error loading sessions: {ex.Message}"; }
    }

    static SessionIndexEntry MapSession(CashierSessionIndexEntry s) => new()
    {
        SessionId = s.SessionId,
        StationId = s.StationId,
        CashierId = s.CashierId,
        CashierName = s.CashierName,
        SessionDate = s.SessionDate,
        TotalCollected = s.TotalCollected,
        Status = s.Status,
        TurnedInDate = s.TurnedInDate,
    };

    void OpenClosePanel(string id) { closingSessionId = id; turningInSessionId = null; sessionActionError = null; }
    void OpenTurnInPanel(string id) { turningInSessionId = id; closingSessionId = null; sessionActionError = null; }

    async Task SubmitClose()
    {
        sessionActionError = null;
        try
        {
            string grainKey = closingSessionId!.StartsWith("CASHIER-SESSION:") ? closingSessionId : $"CASHIER-SESSION:{closingSessionId}";
            var sessionGrain = Grains.GetGrain<ICashierSessionGrain>(grainKey);
            await sessionGrain.CloseAsync(actualBalance, string.IsNullOrWhiteSpace(closeNotes) ? null : closeNotes);
            closingSessionId = null;
            await LoadSessions();
        }
        catch (Exception ex) { sessionActionError = ex.Message; }
    }

    async Task SubmitTurnIn()
    {
        sessionActionError = null;
        try
        {
            string grainKey = turningInSessionId!.StartsWith("CASHIER-SESSION:") ? turningInSessionId : $"CASHIER-SESSION:{turningInSessionId}";
            var sessionGrain = Grains.GetGrain<ICashierSessionGrain>(grainKey);
            await sessionGrain.TurnInAsync(turnInAmount, turnInToUserId,
                string.IsNullOrWhiteSpace(turnInReceiptNumber) ? null : turnInReceiptNumber);
            turningInSessionId = null;
            await LoadSessions();
        }
        catch (Exception ex) { sessionActionError = ex.Message; }
    }

    async Task OpenSession()
    {
        sessionFormError = null; sessionFormSuccess = null;
        if (string.IsNullOrWhiteSpace(newSession.StationId) || string.IsNullOrWhiteSpace(newSession.CashierId))
        {
            sessionFormError = "Station ID and Cashier ID are required."; return;
        }
        try
        {
            string sessionId = Guid.NewGuid().ToString();
            var sessionGrain = Grains.GetGrain<ICashierSessionGrain>($"CASHIER-SESSION:{sessionId}");
            await sessionGrain.OpenAsync(newSession.StationId, newSession.StationName,
                newSession.CashierId, newSession.CashierName, newSession.SessionDate, newSession.OpeningBalance);
            var sessionIdx = Grains.GetGrain<ICashierSessionIndexGrain>("CASHIER-SESSION-IDX");
            await sessionIdx.AddOrUpdateAsync(new CashierSessionIndexEntry
            {
                SessionId = $"CASHIER-SESSION:{sessionId}",
                StationId = newSession.StationId,
                CashierId = newSession.CashierId,
                CashierName = newSession.CashierName,
                SessionDate = newSession.SessionDate,
                TotalCollected = 0,
                Status = "Open",
            });
            sessionFormSuccess = "Session opened.";
            newSession = new NewSessionForm();
            await LoadSessions();
        }
        catch (Exception ex) { sessionFormError = ex.Message; }
    }

    // ── DTOs ──────────────────────────────────────────────────────────────────

    class ReceiptIndexEntry
    {
        public string ReceiptId { get; set; } = string.Empty;
        public string ReceiptNumber { get; set; } = string.Empty;
        public string PatientId { get; set; } = string.Empty;
        public string ARAccountId { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string PaymentMethod { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateTime ReceiptDate { get; set; }
    }

    class SessionIndexEntry
    {
        public string SessionId { get; set; } = string.Empty;
        public string StationId { get; set; } = string.Empty;
        public string CashierId { get; set; } = string.Empty;
        public string CashierName { get; set; } = string.Empty;
        public DateTime SessionDate { get; set; }
        public decimal TotalCollected { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? TurnedInDate { get; set; }
    }

    // ── form models ───────────────────────────────────────────────────────────

    class NewReceiptForm
    {
        public string ReceiptNumber { get; set; } = string.Empty;
        public string PatientId { get; set; } = string.Empty;
        public string PatientName { get; set; } = string.Empty;
        public string ARAccountId { get; set; } = string.Empty;
        public decimal Amount { get; set; }
        public string PaymentMethod { get; set; } = "Cash";
        public string? CheckNumber { get; set; }
        public string SessionId { get; set; } = string.Empty;
        public string CashierId { get; set; } = string.Empty;
        public string CashierName { get; set; } = string.Empty;
        public string? Notes { get; set; }
    }

    class NewSessionForm
    {
        public string StationId { get; set; } = string.Empty;
        public string StationName { get; set; } = string.Empty;
        public string CashierId { get; set; } = string.Empty;
        public string CashierName { get; set; } = string.Empty;
        public DateTime SessionDate { get; set; } = DateTime.Today;
        public decimal OpeningBalance { get; set; }
    }
}
