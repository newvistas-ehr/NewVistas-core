@page "/claim-status"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Claim Status Inquiry (EDI 276/277)</PageTitle>

<h1>Claim Status Inquiry</h1>
<p class="page-subtitle">EDI 276 Inquiry / 277 Response — VistA IB Claim Status (IBCSC*.m)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadInquiries" />
<AlertBanner Error="@error" Success="@submitResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "list")
    {
        @if (inquiries == null) { <div class="empty-state">Enter a Patient ID and click Load.</div> }
        else if (inquiries.Count == 0) { <div class="empty-state">No claim status inquiries recorded.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Claim ID</th><th>Payer</th><th>Status</th><th>Claim Status</th><th>Submitted</th><th>Response</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in inquiries)
                    {
                        <tr>
                            <td>@i.ClaimId[..Math.Min(12, i.ClaimId.Length)]...</td>
                            <td>@i.PayerName</td>
                            <td><span class="badge @InqBadge(i.Status)">@i.Status</span></td>
                            <td><span class="badge @CatBadge(i.ClaimStatusCategory)">@i.ClaimStatusCategory</span></td>
                            <td>@i.SubmittedDate?.ToString("MM/dd HH:mm")</td>
                            <td>@i.ResponseDate?.ToString("MM/dd HH:mm")</td>
                            <td><button class="btn btn-primary" @onclick="() => ViewDetail(i.InquiryId)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tab == "detail" && selected != null)
    {
        <div class="form-section">
            <h3>Inquiry: @selected.InquiryId <span class="badge @InqBadge(selected.Status)">@selected.Status</span></h3>
            <p><strong>Claim ID:</strong> @selected.ClaimId</p>
            <p><strong>Payer:</strong> @selected.PayerName</p>
            <p><strong>Billed Amount:</strong> @(selected.TotalBilledAmount?.ToString("C") ?? "—")</p>
            <p><strong>Trace #:</strong> @(selected.TraceNumber ?? "—")</p>
            <p><strong>Claim Status:</strong> <span class="badge @CatBadge(selected.ClaimStatusCategory)">@selected.ClaimStatusCategory</span></p>
            <p><strong>Paid Amount:</strong> @(selected.ReportedPaidAmount?.ToString("C") ?? "—")</p>
            <p><strong>Payer Message:</strong> @(selected.PayerMessage ?? "—")</p>

            @if (selected.StatusDetails.Count > 0)
            {
                <h3>Status Details (STC Segments)</h3>
                <table class="data-table">
                    <thead><tr><th>Category</th><th>Description</th><th>Charge</th><th>Payment</th><th>Date</th><th>Message</th></tr></thead>
                    <tbody>
                        @foreach (var d in selected.StatusDetails)
                        {
                            <tr>
                                <td>@d.StatusCategoryCode</td><td>@d.StatusCategoryDescription</td>
                                <td>@(d.TotalChargeAmount?.ToString("C") ?? "—")</td>
                                <td>@(d.PaymentAmount?.ToString("C") ?? "—")</td>
                                <td>@(d.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@(d.Message ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @if (tab == "new")
    {
        <div class="form-section">
            <h3>Submit Claim Status Inquiry (EDI 276)</h3>
            <FormField Label="Claim ID" Required><input class="form-input" @bind="newClaimId" /></FormField>
            <FormField Label="Payer ID"><input class="form-input" @bind="newPayerId" /></FormField>
            <FormField Label="Payer Name"><input class="form-input" @bind="newPayerName" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Submit" disabled="@submitting">@(submitting ? "Submitting..." : "Submit 276 Inquiry")</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "list";
    private bool loading;
    private string? error;
    private List<ClaimStatusInquiryIndexEntry>? inquiries;
    private ClaimStatusInquiryState? selected;
    private string newClaimId = string.Empty, newPayerId = string.Empty, newPayerName = string.Empty;
    private bool submitting;
    private string? submitResult;
    private readonly (string, string)[] _tabs = new[] { ("list", "Inquiry History"), ("detail", "Inquiry Detail"), ("new", "New Inquiry") };

    private async Task LoadInquiries()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { inquiries = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetClaimStatusInquiriesAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task ViewDetail(string id)
    {
        try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetClaimStatusInquiryAsync(id); tab = "detail"; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newClaimId)) return;
        submitting = true; error = null; submitResult = null;
        try
        {
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .SubmitClaimStatusInquiryAsync(newClaimId, newPayerId, newPayerName, null, null, null);
            submitResult = $"Inquiry submitted: {id}";
            await LoadInquiries();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { submitting = false; }
    }

    private string InqBadge(ClaimStatusInquiryStatus s) => s switch
    {
        ClaimStatusInquiryStatus.ResponseReceived => "badge-success", ClaimStatusInquiryStatus.Submitted => "badge-info",
        ClaimStatusInquiryStatus.Error => "badge-danger", _ => "badge-neutral",
    };

    private string CatBadge(ClaimStatusCategory c) => c switch
    {
        ClaimStatusCategory.Finalized => "badge-success", ClaimStatusCategory.Pending => "badge-info",
        ClaimStatusCategory.Received => "badge-info", ClaimStatusCategory.Rejected => "badge-warning",
        ClaimStatusCategory.Denied => "badge-danger", ClaimStatusCategory.AdditionalInfoRequested => "badge-warning",
        _ => "badge-neutral",
    };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.5; }
</style>
