@page "/consult-services"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Consult Service Directory</PageTitle>

<h2>Consult Service Directory</h2>
<p class="subtitle">VistA File #49 — available consult services and specialties</p>

<div class="tab-bar">
    <button class="@TabClass("list")" @onclick='() => SetTab("list")'>Service List</button>
    <button class="@TabClass("search")" @onclick='() => SetTab("search")'>Search</button>
    <button class="@TabClass("add")" @onclick='() => SetTab("add")'>Add Service</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success">@successMsg</div>
}

@* ── Tab 1: Service List ──────────────────────────────────── *@
@if (activeTab == "list")
{
    <div class="toolbar">
        <button @onclick="LoadServices" disabled="@loading" class="btn btn-secondary">Refresh</button>
        <button @onclick="SeedDemo" disabled="@loading" class="btn btn-secondary">Seed Demo Data</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading...</p> }

    @if (services is not null)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service ID</th>
                    <th>Service Name</th>
                    <th>Specialty</th>
                    <th>Provider</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Interfacility</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ConsultServiceEntry svc in services)
                {
                    <tr>
                        <td>@svc.ServiceId</td>
                        <td>@svc.ServiceName</td>
                        <td>@(svc.Specialty ?? "—")</td>
                        <td>@(svc.DefaultProviderName ?? svc.DefaultProviderId ?? "—")</td>
                        <td>@(svc.LocationName ?? svc.LocationId ?? "—")</td>
                        <td>
                            @if (svc.IsActive)
                            {
                                <span class="badge badge-success">ACTIVE</span>
                            }
                            else
                            {
                                <span class="badge badge-neutral">INACTIVE</span>
                            }
                        </td>
                        <td>
                            @if (svc.AcceptsInterfacility)
                            {
                                <span class="badge badge-info">YES</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-primary" @onclick="() => RemoveService(svc.ServiceId)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="count-label">@services.Count service(s)</p>
    }
}

@* ── Tab 2: Search ──────────────────────────────────── *@
@if (activeTab == "search")
{
    <div class="toolbar">
        <input @bind="searchQuery" @bind:event="oninput" placeholder="Search by name or specialty..." class="input-search" />
        <button @onclick="SearchServices" disabled="@loading" class="btn btn-primary">Search</button>
    </div>

    @if (loading) { <p class="loading-msg">Searching...</p> }

    @if (searchResults is not null)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Service ID</th>
                    <th>Service Name</th>
                    <th>Specialty</th>
                    <th>Interfacility</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ConsultServiceEntry svc in searchResults)
                {
                    <tr>
                        <td>@svc.ServiceId</td>
                        <td>@svc.ServiceName</td>
                        <td>@(svc.Specialty ?? "—")</td>
                        <td>@(svc.AcceptsInterfacility ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="count-label">@searchResults.Count result(s)</p>
    }
}

@* ── Tab 3: Add Service ──────────────────────────────────── *@
@if (activeTab == "add")
{
    <div class="form-panel">
        <h3>Add Consult Service</h3>
        <label>Service ID: <input @bind="newServiceId" placeholder="e.g. SVC-NEWSERVICE" /></label>
        <label>Service Name: <input @bind="newServiceName" /></label>
        <label>Specialty: <input @bind="newSpecialty" placeholder="(optional)" /></label>
        <label>Default Provider ID: <input @bind="newProviderId" placeholder="(optional)" /></label>
        <label>Default Provider Name: <input @bind="newProviderName" placeholder="(optional)" /></label>
        <label>Location ID: <input @bind="newLocationId" placeholder="(optional)" /></label>
        <label>Location Name: <input @bind="newLocationName" placeholder="(optional)" /></label>
        <label>
            <input type="checkbox" @bind="newIsActive" /> Active
        </label>
        <label>
            <input type="checkbox" @bind="newAcceptsInterfacility" /> Accepts Interfacility Consults
        </label>
        <button @onclick="SubmitAddService" disabled="@(string.IsNullOrWhiteSpace(newServiceId) || string.IsNullOrWhiteSpace(newServiceName))" class="btn btn-primary">Add Service</button>
    </div>
}

@code {
    string activeTab = "list";
    bool loading;
    string? error;
    string? successMsg;

    // List
    List<ConsultServiceEntry>? services;

    // Search
    string searchQuery = string.Empty;
    List<ConsultServiceEntry>? searchResults;

    // Add
    string newServiceId = string.Empty;
    string newServiceName = string.Empty;
    string? newSpecialty;
    string? newProviderId;
    string? newProviderName;
    string? newLocationId;
    string? newLocationName;
    bool newIsActive = true;
    bool newAcceptsInterfacility;

    string TabClass(string tab) => activeTab == tab ? "tab active" : "tab";

    void SetTab(string tab) { activeTab = tab; error = null; successMsg = null; }

    private IConsultServiceDirectoryGrain GetDirectory() =>
        Grains.GetGrain<IConsultServiceDirectoryGrain>("CONSULT-SVC-DIR");

    protected override async Task OnInitializedAsync()
    {
        await LoadServices();
    }

    async Task LoadServices()
    {
        loading = true; error = null;
        try
        {
            services = await GetDirectory().GetAllServicesAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task SearchServices()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        loading = true; error = null;
        try
        {
            searchResults = await GetDirectory().SearchServicesAsync(searchQuery, 20);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task RemoveService(string serviceId)
    {
        error = null; successMsg = null;
        try
        {
            await GetDirectory().RemoveServiceAsync(serviceId);
            successMsg = $"Service {serviceId} removed.";
            await LoadServices();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task SubmitAddService()
    {
        if (string.IsNullOrWhiteSpace(newServiceId) || string.IsNullOrWhiteSpace(newServiceName)) return;
        error = null; successMsg = null;
        try
        {
            ConsultServiceEntry entry = new()
            {
                ServiceId = newServiceId,
                ServiceName = newServiceName,
                Specialty = newSpecialty,
                DefaultProviderId = newProviderId,
                DefaultProviderName = newProviderName,
                LocationId = newLocationId,
                LocationName = newLocationName,
                IsActive = newIsActive,
                AcceptsInterfacility = newAcceptsInterfacility
            };
            await GetDirectory().AddServiceAsync(entry);
            successMsg = $"Service {newServiceId} added.";
            newServiceId = string.Empty; newServiceName = string.Empty;
            newSpecialty = null; newProviderId = null; newProviderName = null;
            newLocationId = null; newLocationName = null;
            activeTab = "list";
            await LoadServices();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task SeedDemo()
    {
        loading = true; error = null; successMsg = null;
        try
        {
            await GetDirectory().SeedDemoDataAsync();
            successMsg = "Demo consult services seeded.";
            await LoadServices();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }
}

<style>
    /* Canonical classes (tab, tab-bar, data-table, badge, badge-*, btn, btn-primary,
       btn-secondary, alert) live in app.css. Only page-specific layout lives here. */
    .subtitle { color: #555; margin-top: -8px; font-size: 0.9em; }
    .toolbar { display: flex; gap: 8px; margin: 12px 0; align-items: center; }
    .input-search { padding: 6px; border: 1px solid #d4d9e0; border-radius: 4px; width: 300px; background: #f9fafb; color: #333; }
    .loading-msg { color: #555; }
    .selected-row td { background: #eaf2fb !important; }
    .count-label { color: #555; font-size: 0.85em; margin-top: 4px; }
    .form-panel { padding: 16px; background: #f4f6f9; border: 1px solid #d4d9e0; border-radius: 6px; display: flex; flex-direction: column; gap: 10px; max-width: 520px; }
    .form-panel label { display: flex; gap: 10px; align-items: center; color: #333; }
    .form-panel input[type="text"], .form-panel input:not([type]) { flex: 1; padding: 4px; border: 1px solid #d4d9e0; border-radius: 3px; background: #f9fafb; color: #333; }
</style>
