@page "/periodontal-chart"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Periodontal Charting</PageTitle>
<h1>Periodontal Charting</h1>

@if (loading) { <div class="empty-state">Loading...</div> }
else if (featureChecked && !featureEnabled)
{ <div class="alert alert-warning">The <strong>PERIODONTAL_CHARTING</strong> feature is not enabled. Enable it in <a href="/site-parameters">Site Parameters</a>.</div> }
@if (error != null) { <div class="alert alert-error">@error</div> }

@if (!loading)
{
    <div class="tab-bar">
        <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">Patient Charts</button>
        <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Dashboard</button>
    </div>

    @if (activeTab == 0)
    {
        <div class="form-section">
            <div class="form-row">
                <label>Patient ID</label>
                <input type="text" class="form-input" @bind="patientId" @bind:event="oninput" placeholder="Enter patient ID" />
                <button @onclick="LoadCharts" disabled="@(string.IsNullOrWhiteSpace(patientId) || loadingCharts)" class="btn btn-primary">
                    @if (loadingCharts) { <span>Loading...</span> } else { <span>Load</span> }
                </button>
            </div>
        </div>
        @if (charts != null && charts.Count > 0)
        {
            <table class="data-table">
                <thead><tr><th>Exam Date</th><th>Provider</th><th>Status</th><th>Classification</th><th>Teeth</th><th>Deep Pockets</th><th>Bleeding Sites</th></tr></thead>
                <tbody>
                    @foreach (var c in charts)
                    {
                        <tr>
                            <td>@c.ExamDate.ToString("MM/dd/yyyy")</td>
                            <td>@c.ProviderName</td>
                            <td><span class="status-badge" style="@GetStatusStyle(c.Status)">@c.Status</span></td>
                            <td><span class="classification-badge" style="@GetClassStyle(c.Classification)">@(c.Classification ?? "---")</span></td>
                            <td>@c.TeethCharted</td>
                            <td class="@(c.DeepPocketCount > 0 ? "highlight-red" : "")">@c.DeepPocketCount</td>
                            <td class="@(c.BleedingSiteCount > 0 ? "highlight-orange" : "")">@c.BleedingSiteCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (charts != null) { <div class="empty-state">No periodontal charts for this patient.</div> }
    }

    @if (activeTab == 1)
    {
        <div class="form-section">
            <div class="form-row"><label>Status</label>
                <select class="form-input" @bind="dashStatus">
                    <option value="">All</option><option value="DRAFT">DRAFT</option>
                    <option value="FINALIZED">FINALIZED</option><option value="ADDENDED">ADDENDED</option>
                </select>
            </div>
            <div class="form-actions">
                <button @onclick="SearchDashboard" disabled="@loadingDash" class="btn btn-primary">
                    @if (loadingDash) { <span>Searching...</span> } else { <span>Search</span> }
                </button>
            </div>
        </div>
        @if (dashResults != null && dashResults.Count > 0)
        {
            <table class="data-table">
                <thead><tr><th>Patient</th><th>Provider</th><th>Exam Date</th><th>Status</th><th>Classification</th><th>Teeth</th><th>Deep</th><th>Bleeding</th></tr></thead>
                <tbody>
                    @foreach (var c in dashResults)
                    {
                        <tr>
                            <td>@c.PatientName <span class="patient-id-small">(@c.PatientId)</span></td>
                            <td>@c.ProviderName</td>
                            <td>@c.ExamDate.ToString("MM/dd/yyyy")</td>
                            <td><span class="status-badge" style="@GetStatusStyle(c.Status)">@c.Status</span></td>
                            <td>@(c.Classification ?? "---")</td>
                            <td>@c.TeethCharted</td>
                            <td>@c.DeepPocketCount</td>
                            <td>@c.BleedingSiteCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (dashResults != null) { <div class="empty-state">No charts match.</div> }
    }
}

@code {
    private int activeTab; private bool loading = true, featureEnabled, featureChecked; private string? error;
    private string? patientId; private bool loadingCharts; private List<PeriodontalChartIndexEntry>? charts;
    private string dashStatus = ""; private bool loadingDash; private List<PeriodontalChartIndexEntry>? dashResults;

    protected override async Task OnInitializedAsync()
    {
        try { featureEnabled = await Grains.GetGrain<ISiteParametersGrain>("SITE:DEFAULT").IsFeatureEnabledAsync("PERIODONTAL_CHARTING"); }
        catch (Exception ex) { error = ex.Message; } finally { loading = false; featureChecked = true; }
    }

    private async Task LoadCharts() { if (string.IsNullOrWhiteSpace(patientId)) return; loadingCharts = true; error = null; try { charts = await Grains.GetGrain<IPeriodontalChartIndexGrain>("PERIO-IDX").GetByPatientAsync(patientId.Trim()); } catch (Exception ex) { error = ex.Message; } finally { loadingCharts = false; } }
    private async Task SearchDashboard() { loadingDash = true; error = null; try { dashResults = await Grains.GetGrain<IPeriodontalChartIndexGrain>("PERIO-IDX").SearchAsync(null, null, string.IsNullOrEmpty(dashStatus) ? null : dashStatus, 50); } catch (Exception ex) { error = ex.Message; } finally { loadingDash = false; } }

    private string GetStatusStyle(string s) => s switch { "DRAFT" => "background:#dbeafe;color:#1e40af;border:1px solid #93c5fd;", "FINALIZED" => "background:#dcfce7;color:#166534;border:1px solid #bbf7d0;", "ADDENDED" => "background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;", _ => "" };
    private string GetClassStyle(string? c) => c switch { "HEALTHY" => "background:#dcfce7;color:#166534;", "GINGIVITIS" => "background:#fef3c7;color:#92400e;", "STAGE_I" => "background:#fed7aa;color:#c2410c;", "STAGE_II" => "background:#fde8e8;color:#b91c1c;", "STAGE_III" => "background:#fde8e8;color:#991b1b;", "STAGE_IV" => "background:#1f2937;color:white;", _ => "" };
}

<style>
    .btn { padding: 0.5rem 1.25rem; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; }
    .btn-primary { background: #003f72; color: white; } .btn-primary:disabled { background: #999; cursor: not-allowed; }
    .alert { padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .alert-error { background: #fde8e8; color: #b91c1c; border: 1px solid #f5c6c6; }
    .alert-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; } .alert-warning a { color: #003f72; font-weight: 600; }
    .empty-state { color: #999; font-style: italic; padding: 2rem 0; }
    .tab-bar { display: flex; gap: 0; border-bottom: 2px solid #d4d9e0; margin-bottom: 1.5rem; }
    .tab-btn { padding: 0.6rem 1.25rem; border: none; background: transparent; cursor: pointer; font-size: 0.85rem; font-weight: 500; color: #666; border-bottom: 2px solid transparent; margin-bottom: -2px; }
    .tab-btn.active { color: #003f72; border-bottom-color: #003f72; font-weight: 600; }
    .form-section { max-width: 700px; } .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row label:first-child { width: 160px; font-size: 0.85rem; font-weight: 500; color: #333; flex-shrink: 0; }
    .form-input { flex: 1; padding: 0.4rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem; max-width: 350px; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1rem; margin-bottom: 1.5rem; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .data-table th { text-align: left; padding: 0.5rem; font-weight: 600; color: #003f72; border-bottom: 2px solid #d4d9e0; font-size: 0.75rem; text-transform: uppercase; background: #f4f6f9; }
    .data-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #f0f0f0; } .data-table tr:hover { background: #f9fafb; }
    .status-badge, .classification-badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 3px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; }
    .highlight-red { color: #dc2626; font-weight: 600; } .highlight-orange { color: #c2410c; font-weight: 600; }
    .patient-id-small { font-size: 0.75rem; color: #999; }
</style>
