@page "/top-matching"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>TOP Federal Debt Matching</PageTitle>

<h3>TOP Federal Debt Matching</h3>
<p class="text-muted">Treasury Offset Program — Offset Matching &amp; AR Posting (RCTP*.m, RCTOP*.m)</p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:260px" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadMatches" disabled="@loading">Load Matches</button>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == "matches" ? "active" : "")" @onclick='() => tab = "matches"'>Match History</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "detail" ? "active" : "")" @onclick='() => tab = "detail"'>Match Detail</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "process" ? "active" : "")" @onclick='() => tab = "process"'>Process Offset</button></li>
</ul>

@if (tab == "matches" && matches != null)
{
    <table class="table table-sm table-striped">
        <thead><tr><th>Treasury Tx</th><th>TIN</th><th>Amount</th><th>Source</th><th>Status</th><th>Received</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in matches)
            {
                <tr>
                    <td class="font-monospace small">@m.TreasuryTransactionId</td>
                    <td>@m.TaxpayerIdNumber</td>
                    <td>@m.OffsetAmount.ToString("C")</td>
                    <td>@m.OffsetSource</td>
                    <td><span class="badge @MatchBadge(m.Status)">@m.Status</span></td>
                    <td>@m.OffsetReceivedDate.ToString("MM/dd/yyyy")</td>
                    <td><button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetail(m.MatchId)">View</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (tab == "detail" && selected != null)
{
    <div class="card mb-3">
        <div class="card-header"><strong>TOP Match:</strong> @selected.MatchId <span class="badge @MatchBadge(selected.Status) ms-2">@selected.Status</span></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Treasury Tx ID</dt><dd class="col-sm-7">@selected.TreasuryTransactionId</dd>
                        <dt class="col-sm-5">TIN</dt><dd class="col-sm-7">@selected.TaxpayerIdNumber</dd>
                        <dt class="col-sm-5">Treasury Name</dt><dd class="col-sm-7">@selected.TreasuryPatientName</dd>
                        <dt class="col-sm-5">Offset Amount</dt><dd class="col-sm-7">@selected.OffsetAmount.ToString("C")</dd>
                        <dt class="col-sm-5">Source</dt><dd class="col-sm-7">@selected.OffsetSource</dd>
                        <dt class="col-sm-5">Received</dt><dd class="col-sm-7">@selected.OffsetReceivedDate.ToString("yyyy-MM-dd")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Matched Patient</dt><dd class="col-sm-7">@(selected.MatchedPatientId ?? "—")</dd>
                        <dt class="col-sm-5">Matched AR Acct</dt><dd class="col-sm-7">@(selected.MatchedARAccountId ?? "—")</dd>
                        <dt class="col-sm-5">Matched Referral</dt><dd class="col-sm-7">@(selected.MatchedTopReferralId ?? "—")</dd>
                        <dt class="col-sm-5">Applied</dt><dd class="col-sm-7">@selected.AppliedAmount.ToString("C")</dd>
                        <dt class="col-sm-5">Unmatched</dt><dd class="col-sm-7">@selected.UnmatchedAmount.ToString("C")</dd>
                        <dt class="col-sm-5">Processed</dt><dd class="col-sm-7">@(selected.MatchProcessedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    </dl>
                </div>
            </div>
            @if (selected.MatchReasons.Count > 0)
            {
                <div class="alert alert-info mt-2"><strong>Reasons:</strong> @string.Join("; ", selected.MatchReasons)</div>
            }
        </div>
    </div>
}

@if (tab == "process")
{
    <div class="card">
        <div class="card-header">Process Treasury Offset</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-3"><label class="form-label">Treasury Tx ID</label><input class="form-control" @bind="newTxId" /></div>
                <div class="col-md-3"><label class="form-label">Taxpayer ID (SSN)</label><input class="form-control" @bind="newTin" /></div>
                <div class="col-md-3"><label class="form-label">Treasury Name</label><input class="form-control" @bind="newTreasuryName" /></div>
                <div class="col-md-3"><label class="form-label">Offset Amount</label><input type="number" class="form-control" @bind="newAmount" /></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Source</label>
                    <select class="form-select" @bind="newSource">
                        <option>TAX_REFUND</option><option>SSA</option><option>OPM</option><option>VENDOR</option><option>OTHER</option>
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">Received Date</label><input type="date" class="form-control" @bind="newDate" /></div>
                <div class="col-md-4"><label class="form-label">Notes</label><input class="form-control" @bind="newNotes" /></div>
            </div>
            <button class="btn btn-success" @onclick="Process" disabled="@processing">@(processing ? "Processing..." : "Process Offset")</button>
            @if (processResult != null) { <div class="alert alert-success mt-2">@processResult</div> }
        </div>
    </div>
}

@code {
    private string patientId = string.Empty;
    private string tab = "matches";
    private bool loading;
    private string? error;
    private List<TopMatchIndexEntry>? matches;
    private TopMatchingState? selected;
    private string newTxId = string.Empty, newTin = string.Empty, newTreasuryName = string.Empty, newSource = "TAX_REFUND", newNotes = string.Empty;
    private decimal newAmount;
    private DateTime newDate = DateTime.Today;
    private bool processing;
    private string? processResult;

    private async Task LoadMatches()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { matches = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetTopMatchRecordsAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task ViewDetail(string id)
    {
        try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetTopMatchRecordAsync(id); tab = "detail"; }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Process()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newTxId)) return;
        processing = true; error = null; processResult = null;
        try
        {
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .ProcessTopOffsetMatchAsync(newTxId, newTin, newTreasuryName, newAmount, newSource, newDate, null, null, newNotes);
            processResult = $"Offset processed. Match ID: {id}";
            await LoadMatches();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { processing = false; }
    }

    private string MatchBadge(TopMatchStatus s) => s switch
    {
        TopMatchStatus.Matched => "bg-success", TopMatchStatus.PartialMatch => "bg-warning text-dark",
        TopMatchStatus.PendingMatch => "bg-info", TopMatchStatus.Unmatched => "bg-secondary",
        TopMatchStatus.Rejected => "bg-danger", _ => "bg-secondary",
    };
}
