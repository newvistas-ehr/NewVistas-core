@page "/patient-lookup"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext

<PageTitle>Patient Lookup</PageTitle>

<h1>🔍 Patient Lookup</h1>
<p class="subtitle">Pick a patient once — they stay selected as you move between clinical pages.</p>

<div class="lookup-panels">
    <div class="lookup-card">
        <label class="lookup-label">I know the Patient ID</label>
        <div class="lookup-row">
            <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleIdKey"
                   placeholder="e.g., P1 or P9001" class="lookup-input" />
            <button @onclick="OpenById" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)" class="btn btn-primary">Open</button>
        </div>
    </div>

    <div class="lookup-card">
        <label class="lookup-label">Search by name</label>
        <div class="lookup-row">
            <input type="text" @bind="nameQuery" @bind:event="oninput" @onkeydown="HandleNameKey"
                   placeholder="First letters of last name, e.g. SMI" class="lookup-input" />
            <button @onclick="SearchByName" disabled="@(string.IsNullOrWhiteSpace(nameQuery) || loading)" class="btn btn-primary">Search</button>
        </div>
        <span class="lookup-hint">Last-name prefix, or "LAST,FIRST". A 4-digit number matches SSN last-4.</span>
    </div>

    <div class="lookup-card">
        <label class="lookup-label">My panel</label>
        <div class="lookup-row">
            <button @onclick="LoadMyPatients" disabled="@loading" class="btn btn-secondary">Show My Patients</button>
        </div>
        <span class="lookup-hint">Patients on your care team, in alphabetical order.</span>
    </div>
</div>

@if (loading)
{
    <p class="loading-msg">Loading…</p>
}

@if (error != null)
{
    <div class="alert alert-error">@error</div>
}

@if (results != null)
{
    <div class="results">
        <h3>@resultsTitle</h3>
        @if (results.Count == 0)
        {
            <p class="empty-msg">No patients found.</p>
        }
        else
        {
            <table class="result-table">
                <thead>
                    <tr><th>Name</th><th>DOB</th><th>SSN</th><th>@resultsExtraHeader</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (ResultRow r in results)
                    {
                        <tr class="result-row" @onclick="() => SelectPatient(r.PatientId)">
                            <td class="rt-name">@r.Name</td>
                            <td>@(r.Dob?.ToString("MM/dd/yyyy") ?? "—")</td>
                            <td>@(string.IsNullOrEmpty(r.Ssn4) ? "—" : $"***-**-{r.Ssn4}")</td>
                            <td>@(string.IsNullOrEmpty(r.Extra) ? "—" : r.Extra)</td>
                            <td class="rt-open">Open ›</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@if (patient != null)
{
    <div class="patient-banner">
        <div class="banner-name">@patient.Name</div>
        <div class="banner-details">
            <span>ID: @patient.PatientId</span>
            <span>Sex: @patient.Sex</span>
            @if (patient.DateOfBirth.HasValue)
            {
                <span>DOB: @patient.DateOfBirth.Value.ToString("MM/dd/yyyy")</span>
            }
            @if (!string.IsNullOrEmpty(patient.Veteran) && patient.Veteran.ToUpper() == "Y")
            {
                <span class="badge badge-vet">Veteran</span>
            }
            @if (!patient.IsActive)
            {
                <span class="badge badge-inactive">Inactive</span>
            }
        </div>
        <div class="banner-confirm">✓ Selected — this patient now carries across clinical pages.</div>
    </div>

    <div class="patient-sections">
        <div class="section">
            <h3>Demographics</h3>
            <table class="detail-table">
                <tr><td class="label">Address</td><td>@FormatAddress()</td></tr>
                <tr><td class="label">Phone (Res)</td><td>@(patient.PhoneNumberResidence ?? "—")</td></tr>
                <tr><td class="label">Phone (Work)</td><td>@(patient.PhoneNumberWork ?? "—")</td></tr>
                <tr><td class="label">Email</td><td>@(patient.Email ?? "—")</td></tr>
                <tr><td class="label">Marital Status</td><td>@(patient.MaritalStatus ?? "—")</td></tr>
            </table>
        </div>

        <div class="section">
            <h3>Emergency Contact</h3>
            <table class="detail-table">
                <tr><td class="label">Name</td><td>@(patient.EmergencyContactName ?? "—")</td></tr>
                <tr><td class="label">Relationship</td><td>@(patient.EmergencyContactRelationship ?? "—")</td></tr>
                <tr><td class="label">Phone</td><td>@(patient.EmergencyContactPhone ?? "—")</td></tr>
            </table>
        </div>

        @if (patient.Veteran?.ToUpper() == "Y")
        {
            <div class="section">
                <h3>Veteran Info</h3>
                <table class="detail-table">
                    <tr><td class="label">SC %</td><td>@(patient.ServiceConnectedPercentage?.ToString() ?? "—")%</td></tr>
                    <tr><td class="label">Eligibility</td><td>@(patient.EligibilityCode ?? "—")</td></tr>
                    <tr><td class="label">Branch</td><td>@(patient.ServiceBranch ?? "—")</td></tr>
                </table>
            </div>
        }
    </div>

    <div class="patient-actions">
        <a href="/cover-sheet?patientId=@patientId">View Cover Sheet</a>
        <a href="/patient-edit?patientId=@patientId">Edit Patient</a>
        <a href="/labs?patientId=@patientId">View Labs</a>
    </div>
}

@code {
    private string patientId = "";
    private string nameQuery = "";
    private PatientResponse? patient;
    private bool loading;
    private string? error;

    private List<ResultRow>? results;
    private string resultsTitle = "";
    private string resultsExtraHeader = "";

    private async Task HandleIdKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OpenById();
    }

    private async Task HandleNameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchByName();
    }

    // ── Option 1: open directly by known Patient ID ──────────────────────────
    private async Task OpenById()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        await SelectPatient(patientId.Trim());
    }

    // ── Option 2: name / SSN-last-4 prefix search (ORWPT LOOKUP heuristic) ────
    private async Task SearchByName()
    {
        if (string.IsNullOrWhiteSpace(nameQuery)) return;
        loading = true; error = null; patient = null;
        try
        {
            IPatientSearchGrain search = Grains.GetGrain<IPatientSearchGrain>("PATIENT-SEARCH");
            List<PatientIndexEntry> hits = await search.SearchAsync(nameQuery.Trim(), 50);
            results = hits
                .Select(h => new ResultRow(h.PatientId, h.Name, h.DateOfBirth, h.SsnLast4, h.Sex))
                .ToList();
            resultsTitle = $"Search results ({results.Count})";
            resultsExtraHeader = "Sex";
        }
        catch (Exception ex) { error = $"Search failed: {ex.Message}"; }
        finally { loading = false; }
    }

    // ── Option 3: the signed-in provider's own panel, alphabetical ───────────
    private async Task LoadMyPatients()
    {
        string? userId = Grains.CurrentUserId;
        if (string.IsNullOrWhiteSpace(userId))
        {
            error = "You must be signed in to view your patients.";
            return;
        }

        loading = true; error = null; patient = null;
        try
        {
            IProviderPatientIndexGrain idx = Grains.GetGrain<IProviderPatientIndexGrain>($"PROV-PAT-IDX:{userId}");
            List<ProviderPatientEntry> mine = await idx.GetActivePatientsAsync();
            results = mine
                .Select(p => new ResultRow(p.PatientId, p.PatientName, p.DateOfBirth, p.SsnLast4, p.Relationship))
                .ToList();
            resultsTitle = $"My Patients ({results.Count})";
            resultsExtraHeader = "Relationship";
        }
        catch (Exception ex) { error = $"Could not load your patients: {ex.Message}"; }
        finally { loading = false; }
    }

    // ── Select a patient (from a result row, or a direct ID open) ────────────
    private async Task SelectPatient(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return;

        loading = true; error = null; patient = null;
        try
        {
            // Direct Orleans grain access — no HTTP API authorization needed.
            IPatientWorkflowGrain workflow = Grains.GetGrain<IPatientWorkflowGrain>(id.Trim());
            PatientState state = await workflow.GetPatientAsync();

            if (string.IsNullOrEmpty(state.Name))
            {
                error = $"Patient '{id}' not found.";
            }
            else
            {
                patientId = state.PatientId;
                PatientContext.SetPatient(state.PatientId, state.Name);
                patient = new PatientResponse
                {
                    PatientId = state.PatientId,
                    Name = state.Name,
                    Sex = state.Sex,
                    DateOfBirth = state.DateOfBirth,
                    SocialSecurityNumber = state.SocialSecurityNumber,
                    StreetAddress1 = state.StreetAddress1,
                    City = state.City,
                    State = state.State,
                    ZipCode = state.ZipCode,
                    PhoneNumberResidence = state.PhoneNumberResidence,
                    PhoneNumberWork = state.PhoneNumberWork,
                    Email = state.Email,
                    EmergencyContactName = state.EmergencyContactName,
                    EmergencyContactRelationship = state.EmergencyContactRelationship,
                    EmergencyContactPhone = state.EmergencyContactPhone,
                    MaritalStatus = state.MaritalStatus,
                    Veteran = state.Veteran,
                    ServiceConnectedPercentage = state.ServiceConnectedPercentage,
                    EligibilityCode = state.EligibilityCode,
                    ServiceBranch = state.ServiceBranch,
                    IsActive = state.IsActive
                };
            }
        }
        catch (Exception ex)
        {
            error = $"Error looking up patient: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string FormatAddress()
    {
        var parts = new[] { patient?.StreetAddress1, patient?.City, patient?.State, patient?.ZipCode }
            .Where(s => !string.IsNullOrWhiteSpace(s));
        var result = string.Join(", ", parts);
        return string.IsNullOrEmpty(result) ? "—" : result;
    }

    private record ResultRow(string PatientId, string Name, DateTime? Dob, string? Ssn4, string Extra);

    private class PatientResponse
    {
        public string PatientId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Sex { get; set; } = "";
        public DateTime? DateOfBirth { get; set; }
        public string? SocialSecurityNumber { get; set; }
        public string? StreetAddress1 { get; set; }
        public string? City { get; set; }
        public string? State { get; set; }
        public string? ZipCode { get; set; }
        public string? PhoneNumberResidence { get; set; }
        public string? PhoneNumberWork { get; set; }
        public string? Email { get; set; }
        public string? EmergencyContactName { get; set; }
        public string? EmergencyContactRelationship { get; set; }
        public string? EmergencyContactPhone { get; set; }
        public string? MaritalStatus { get; set; }
        public string? Veteran { get; set; }
        public int? ServiceConnectedPercentage { get; set; }
        public string? EligibilityCode { get; set; }
        public string? ServiceBranch { get; set; }
        public bool IsActive { get; set; } = true;
    }
}

<style>
    .subtitle { color: #555; margin-top: -0.5rem; margin-bottom: 1.25rem; }
    .loading-msg { color: #555; font-style: italic; }

    .lookup-panels { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
    .lookup-card {
        flex: 1; min-width: 260px; background: #f7f9fc; border: 1px solid #d6deea;
        border-radius: 6px; padding: 0.9rem 1rem;
    }
    .lookup-label { display: block; font-weight: 600; color: #003f72; margin-bottom: 0.5rem; font-size: 0.9rem; }
    .lookup-row { display: flex; gap: 0.5rem; align-items: center; }
    .lookup-input {
        flex: 1; padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem;
    }
    .lookup-hint { display: block; margin-top: 0.4rem; color: #777; font-size: 0.75rem; }

    .btn { padding: 0.5rem 1.1rem; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; white-space: nowrap; }
    .btn-primary { background: #003f72; color: white; }
    .btn-primary:hover { background: #002a4e; }
    .btn-primary:disabled { background: #999; cursor: not-allowed; }
    .btn-secondary { background: #e8edf4; color: #003f72; border: 1px solid #b9c7da; }
    .btn-secondary:hover { background: #dbe4f0; }
    .btn-secondary:disabled { color: #999; cursor: not-allowed; }

    .alert { padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .alert-error { background: #fde8e8; color: #b91c1c; border: 1px solid #f5c6c6; }

    .results { margin-bottom: 1.5rem; }
    .empty-msg { color: #666; font-style: italic; }
    .result-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .result-table th, .result-table td { padding: 0.45rem 0.6rem; border-bottom: 1px solid #e6e6e6; text-align: left; }
    .result-table th { background: #f3f5f8; color: #444; font-weight: 600; }
    .result-row { cursor: pointer; }
    .result-row:hover { background: #eef3f9; }
    .rt-name { font-weight: 600; color: #003f72; }
    .rt-open { color: #003f72; text-align: right; font-weight: 600; }

    .patient-banner {
        background: #eef3f9; border: 1px solid #c5d3e3; border-radius: 6px;
        padding: 1rem 1.25rem; margin-bottom: 1.5rem;
    }
    .banner-name { font-size: 1.3rem; font-weight: 700; color: #003f72; }
    .banner-details { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem; font-size: 0.85rem; color: #555; }
    .banner-confirm { margin-top: 0.5rem; color: #166534; font-size: 0.8rem; font-weight: 600; }
    .badge { padding: 2px 8px; border-radius: 3px; font-size: 0.75rem; font-weight: 600; }
    .badge-vet { background: #dcfce7; color: #166534; }
    .badge-inactive { background: #fde8e8; color: #b91c1c; }

    .patient-sections { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .section { border: 1px solid #e2e6ea; border-radius: 6px; padding: 1rem; }
    .section h3 { margin-bottom: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eee; }
    .detail-table { width: 100%; }
    .detail-table td { padding: 0.25rem 0; font-size: 0.85rem; }
    .detail-table .label { color: #666; width: 120px; font-weight: 500; }

    .patient-actions { display: flex; gap: 1rem; }
    .patient-actions a {
        color: #003f72; text-decoration: none; font-weight: 600;
        padding: 0.5rem 1rem; border: 1px solid #003f72; border-radius: 4px; font-size: 0.85rem;
    }
    .patient-actions a:hover { background: #eef3f9; }
</style>
