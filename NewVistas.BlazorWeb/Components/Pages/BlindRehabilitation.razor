@page "/blind-rehabilitation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Blind Rehabilitation</PageTitle>

<h1>Blind Rehabilitation</h1>
<p class="subtitle">VistA File #782 — Visual Impairment Services, Training &amp; Adaptive Equipment</p>

<div class="lookup-bar">
    <input type="text" @bind="patientId" @bind:event="oninput"
           @onkeydown="OnKeyDown" placeholder="Patient ID" class="lookup-input" />
    <button @onclick="LoadPatient" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)"
            class="btn btn-primary">
        @if (loading) { <span>Loading...</span> } else { <span>Load</span> }
    </button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (successMessage != null) { <div class="alert alert-success">@successMessage</div> }

@if (brRecord != null)
{
    <div class="tabs">
        <button class="tab @(activeTab == "vision" ? "active" : "")" @onclick='() => activeTab = "vision"'>Visual Acuity</button>
        <button class="tab @(activeTab == "admissions" ? "active" : "")" @onclick='() => SetTab("admissions")'>Admissions</button>
        <button class="tab @(activeTab == "visits" ? "active" : "")" @onclick='() => SetTab("visits")'>Outpatient Visits</button>
        <button class="tab @(activeTab == "centers" ? "active" : "")" @onclick='() => SetTab("centers")'>Training Centers</button>
    </div>

    <!-- ── Tab 1: Visual Acuity & Diagnosis ─────────────────────────────── -->
    @if (activeTab == "vision")
    {
        <div class="section-card">
            <div class="eligibility-badge @EligibilityClass(brRecord.EligibilityStatus)">
                @brRecord.EligibilityStatus.ToString().Replace("_", " ")
            </div>

            <div class="record-grid">
                <div class="record-col">
                    <h3>Visual Acuity</h3>
                    <div class="acuity-table">
                        <div class="acuity-row header">
                            <span></span><span>Distance</span><span>Best Corrected</span><span>Visual Field</span>
                        </div>
                        <div class="acuity-row">
                            <span class="eye-label">OD (Right)</span>
                            <span>@(string.IsNullOrEmpty(brRecord.RightEyeDistance) ? "—" : brRecord.RightEyeDistance)</span>
                            <span>@(string.IsNullOrEmpty(brRecord.BestCorrectedRight) ? "—" : brRecord.BestCorrectedRight)</span>
                            <span>@brRecord.VisualFieldRight</span>
                        </div>
                        <div class="acuity-row">
                            <span class="eye-label">OS (Left)</span>
                            <span>@(string.IsNullOrEmpty(brRecord.LeftEyeDistance) ? "—" : brRecord.LeftEyeDistance)</span>
                            <span>@(string.IsNullOrEmpty(brRecord.BestCorrectedLeft) ? "—" : brRecord.BestCorrectedLeft)</span>
                            <span>@brRecord.VisualFieldLeft</span>
                        </div>
                    </div>
                    @if (brRecord.LastExamDate.HasValue)
                    {
                        <p class="field-note">Last exam: @brRecord.LastExamDate.Value.ToString("MM/dd/yyyy") by @brRecord.ExaminerName</p>
                    }
                </div>
                <div class="record-col">
                    <h3>Diagnosis</h3>
                    @if (!string.IsNullOrEmpty(brRecord.PrimaryDiagnosis))
                    {
                        <div class="field-row"><label>Primary:</label><span>@brRecord.PrimaryDiagnosis</span></div>
                        @if (!string.IsNullOrEmpty(brRecord.SecondaryDiagnosis))
                        { <div class="field-row"><label>Secondary:</label><span>@brRecord.SecondaryDiagnosis</span></div> }
                        <div class="field-row"><label>Onset:</label><span>@brRecord.OnsetType</span></div>
                        <div class="field-row"><label>SC:</label><span>@(brRecord.ServiceConnected ? $"Yes ({brRecord.ServiceConnectedPercentage}%)" : "No")</span></div>
                        @if (!string.IsNullOrEmpty(brRecord.Icd10Code))
                        { <div class="field-row"><label>ICD-10:</label><span>@brRecord.Icd10Code</span></div> }
                    }
                    else
                    {
                        <p class="no-data">No diagnosis recorded.</p>
                    }
                </div>
            </div>

            <!-- Eligibility form -->
            <div class="action-bar">
                <button class="btn btn-secondary" @onclick='() => showEligibilityForm = !showEligibilityForm'>
                    @(showEligibilityForm ? "Cancel" : "Update Eligibility")
                </button>
                <button class="btn btn-secondary" @onclick='() => showAcuityForm = !showAcuityForm'>
                    @(showAcuityForm ? "Cancel" : "Record Visual Acuity")
                </button>
                <button class="btn btn-secondary" @onclick='() => showDiagnosisForm = !showDiagnosisForm'>
                    @(showDiagnosisForm ? "Cancel" : "Update Diagnosis")
                </button>
            </div>

            @if (showEligibilityForm)
            {
                <div class="form-section">
                    <h3>Update Eligibility</h3>
                    <div class="form-grid">
                        <div class="form-row">
                            <label>Eligibility Status *</label>
                            <select @bind="eligStatus">
                                <option value="Unknown">Unknown</option>
                                <option value="LegallyBlind">Legally Blind</option>
                                <option value="SevereImpairment">Severe Impairment</option>
                                <option value="ServiceConnected">Service Connected</option>
                                <option value="Pending">Pending Evaluation</option>
                                <option value="NotEligible">Not Eligible</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Reason / Notes</label>
                            <input type="text" @bind="eligReason" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitEligibility" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Save</span> }
                        </button>
                    </div>
                </div>
            }

            @if (showAcuityForm)
            {
                <div class="form-section">
                    <h3>Record Visual Acuity</h3>
                    <div class="form-grid">
                        <div class="form-row">
                            <label>Right Eye Distance (e.g. 20/200)</label>
                            <input type="text" @bind="acuityOdDist" placeholder="20/200" />
                        </div>
                        <div class="form-row">
                            <label>Left Eye Distance</label>
                            <input type="text" @bind="acuityOsDist" placeholder="20/400" />
                        </div>
                        <div class="form-row">
                            <label>Best Corrected Right</label>
                            <input type="text" @bind="acuityOdBc" placeholder="20/100" />
                        </div>
                        <div class="form-row">
                            <label>Best Corrected Left</label>
                            <input type="text" @bind="acuityOsBc" placeholder="20/200" />
                        </div>
                        <div class="form-row">
                            <label>Visual Field Right</label>
                            <select @bind="acuityVfRight">
                                <option value="NotTested">Not Tested</option>
                                <option value="Normal">Normal (&gt;120°)</option>
                                <option value="ModerateConstriction">Moderate (20-120°)</option>
                                <option value="SevereConstriction">Severe (&lt;20°)</option>
                                <option value="NoField">No Field</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Visual Field Left</label>
                            <select @bind="acuityVfLeft">
                                <option value="NotTested">Not Tested</option>
                                <option value="Normal">Normal (&gt;120°)</option>
                                <option value="ModerateConstriction">Moderate (20-120°)</option>
                                <option value="SevereConstriction">Severe (&lt;20°)</option>
                                <option value="NoField">No Field</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Exam Date *</label>
                            <input type="date" @bind="acuityExamDate" />
                        </div>
                        <div class="form-row">
                            <label>Examiner Name *</label>
                            <input type="text" @bind="acuityExaminer" />
                        </div>
                        <div class="form-row full">
                            <label>Notes</label>
                            <textarea @bind="acuityNotes" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitAcuity" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Save Acuity</span> }
                        </button>
                    </div>
                </div>
            }

            @if (showDiagnosisForm)
            {
                <div class="form-section">
                    <h3>Update Visual Diagnosis</h3>
                    <div class="form-grid">
                        <div class="form-row full">
                            <label>Primary Diagnosis *</label>
                            <input type="text" @bind="dxPrimary" placeholder="e.g. Age-Related Macular Degeneration" />
                        </div>
                        <div class="form-row full">
                            <label>Secondary Diagnosis</label>
                            <input type="text" @bind="dxSecondary" />
                        </div>
                        <div class="form-row">
                            <label>Onset Type</label>
                            <select @bind="dxOnsetType">
                                <option value="Unknown">Unknown</option>
                                <option value="Congenital">Congenital</option>
                                <option value="Acquired">Acquired</option>
                                <option value="Progressive">Progressive</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Onset Date</label>
                            <input type="date" @bind="dxOnsetDate" />
                        </div>
                        <div class="form-row">
                            <label>Service Connected</label>
                            <select @bind="dxScStr">
                                <option value="false">No</option>
                                <option value="true">Yes</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>SC Percentage</label>
                            <input type="number" @bind="dxScPct" min="0" max="100" />
                        </div>
                        <div class="form-row">
                            <label>ICD-10 Code</label>
                            <input type="text" @bind="dxIcd10" placeholder="H35.30" />
                        </div>
                        <div class="form-row full">
                            <label>Notes</label>
                            <textarea @bind="dxNotes" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitDiagnosis" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Save Diagnosis</span> }
                        </button>
                    </div>
                </div>
            }

            <!-- Devices & Goals -->
            @if (brRecord.Devices.Count > 0)
            {
                <h3 class="section-header">Issued Equipment</h3>
                <table class="data-table">
                    <thead>
                        <tr><th>Device</th><th>Category</th><th>Issued</th><th>Issued By</th><th>Returned</th></tr>
                    </thead>
                    <tbody>
                        @foreach (BRDeviceEntry d in brRecord.Devices)
                        {
                            <tr>
                                <td>@d.DeviceName</td>
                                <td>@d.Category</td>
                                <td>@d.IssuedDate.ToString("MM/dd/yyyy")</td>
                                <td>@d.IssuedBy</td>
                                <td>@(d.Returned ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="action-bar mt-1">
                <button class="btn btn-secondary" @onclick='() => showDeviceForm = !showDeviceForm'>
                    @(showDeviceForm ? "Cancel" : "+ Issue Device")
                </button>
                <button class="btn btn-secondary" @onclick='() => showGoalForm = !showGoalForm'>
                    @(showGoalForm ? "Cancel" : "+ Add Training Goal")
                </button>
            </div>

            @if (showDeviceForm)
            {
                <div class="form-section">
                    <h3>Issue Assistive Device</h3>
                    <div class="form-grid">
                        <div class="form-row">
                            <label>Device Name *</label>
                            <input type="text" @bind="devName" placeholder="e.g. Long White Cane" />
                        </div>
                        <div class="form-row">
                            <label>Category *</label>
                            <select @bind="devCategory">
                                <option value="Mobility">Mobility</option>
                                <option value="Low Vision">Low Vision</option>
                                <option value="Technology">Technology</option>
                                <option value="Daily Living">Daily Living</option>
                                <option value="Communication">Communication</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Serial Number</label>
                            <input type="text" @bind="devSerial" />
                        </div>
                        <div class="form-row">
                            <label>Issue Date *</label>
                            <input type="date" @bind="devIssuedDate" />
                        </div>
                        <div class="form-row">
                            <label>Issued By *</label>
                            <input type="text" @bind="devIssuedBy" />
                        </div>
                        <div class="form-row full">
                            <label>Notes</label>
                            <input type="text" @bind="devNotes" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitDevice" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Issue Device</span> }
                        </button>
                    </div>
                </div>
            }

            @if (showGoalForm)
            {
                <div class="form-section">
                    <h3>Add Training Goal</h3>
                    <div class="form-grid">
                        <div class="form-row full">
                            <label>Goal Description *</label>
                            <input type="text" @bind="goalText" placeholder="e.g. Navigate safely to cafeteria independently" />
                        </div>
                        <div class="form-row">
                            <label>Training Area *</label>
                            <select @bind="goalArea">
                                @foreach (string area in TrainingAreas)
                                { <option value="@area">@area.Replace("And", " &amp; ")</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitGoal" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Add Goal</span> }
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <!-- ── Tab 2: Admissions ──────────────────────────────────────────────── -->
    @if (activeTab == "admissions")
    {
        <div class="section-card">
            <div class="section-header-row">
                <h2>BR Center Admissions</h2>
                <button class="btn btn-primary" @onclick='() => showAdmitForm = !showAdmitForm'>
                    @(showAdmitForm ? "Cancel" : "+ New Admission Referral")
                </button>
            </div>

            @if (showAdmitForm)
            {
                <div class="form-section">
                    <h3>Create Admission Referral</h3>
                    <div class="form-grid">
                        <div class="form-row">
                            <label>Center *</label>
                            <select @bind="admitCenterId" @bind:after="OnCenterSelected">
                                <option value="">-- Select Center --</option>
                                @foreach (BRCenterIndexEntry c in centers)
                                { <option value="@c.CenterId">@c.Name (@c.City, @c.State)</option> }
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Admit Date *</label>
                            <input type="date" @bind="admitDate" />
                        </div>
                        <div class="form-row">
                            <label>Planned Discharge Date</label>
                            <input type="date" @bind="admitPlannedDischarge" />
                        </div>
                        <div class="form-row">
                            <label>Priority</label>
                            <select @bind="admitPriority">
                                <option value="Routine">Routine</option>
                                <option value="Urgent">Urgent</option>
                                <option value="Emergency">Emergency</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Referring Provider *</label>
                            <ProviderPicker @bind-ProviderName="admitProviderName" Label="" DefaultToSelf="true" />
                        </div>
                        <div class="form-row full">
                            <label>Program Areas</label>
                            <div class="checkbox-group">
                                @foreach (string area in TrainingAreas)
                                {
                                    <label class="checkbox-label">
                                        <input type="checkbox" @onchange="e => ToggleAdmitArea(area, (bool)(e.Value ?? false))" />
                                        @area.Replace("And", " &amp; ")
                                    </label>
                                }
                            </div>
                        </div>
                        <div class="form-row full">
                            <label>Goals</label>
                            <textarea @bind="admitGoals" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitAdmission" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Submit Referral</span> }
                        </button>
                    </div>
                </div>
            }

            @if (admissions.Count == 0)
            {
                <p class="no-data">No admission records found.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Center</th><th>Admit Date</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (BRAdmissionIndexEntry a in admissions)
                        {
                            <tr>
                                <td>@a.CenterName</td>
                                <td>@a.AdmitDate.ToString("MM/dd/yyyy")</td>
                                <td><span class="status-badge @AdmitStatusClass(a.Status)">@a.Status</span></td>
                                <td>
                                    <button class="btn-link" @onclick="() => ViewAdmission(a.AdmitId)">View</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (selectedAdmission != null)
            {
                <div class="detail-panel">
                    <h3>Admission Detail — @selectedAdmission.CenterName</h3>
                    <div class="field-row"><label>Status:</label><span>@selectedAdmission.Status</span></div>
                    <div class="field-row"><label>Priority:</label><span>@selectedAdmission.Priority</span></div>
                    <div class="field-row"><label>Admit Date:</label><span>@selectedAdmission.AdmitDate.ToString("MM/dd/yyyy")</span></div>
                    @if (selectedAdmission.ActualDischargeDate.HasValue)
                    { <div class="field-row"><label>Discharged:</label><span>@selectedAdmission.ActualDischargeDate.Value.ToString("MM/dd/yyyy")</span></div> }
                    @if (!string.IsNullOrEmpty(selectedAdmission.Goals))
                    { <div class="field-row"><label>Goals:</label><span>@selectedAdmission.Goals</span></div> }
                    @if (selectedAdmission.ProgressNotes.Count > 0)
                    {
                        <h4>Progress Notes</h4>
                        @foreach (BRProgressNote pn in selectedAdmission.ProgressNotes)
                        {
                            <div class="progress-note">
                                <div class="pn-header">@pn.AuthorName — @pn.RecordedDate.ToString("MM/dd/yyyy HH:mm")</div>
                                <div class="pn-body">@pn.Note</div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }

    <!-- ── Tab 3: Outpatient Visits ───────────────────────────────────────── -->
    @if (activeTab == "visits")
    {
        <div class="section-card">
            <div class="section-header-row">
                <h2>Outpatient BR Visits</h2>
                <button class="btn btn-primary" @onclick='() => showVisitForm = !showVisitForm'>
                    @(showVisitForm ? "Cancel" : "+ Schedule Visit")
                </button>
            </div>

            @if (showVisitForm)
            {
                <div class="form-section">
                    <h3>Schedule Outpatient Visit</h3>
                    <div class="form-grid">
                        <div class="form-row">
                            <label>Visit Date *</label>
                            <input type="date" @bind="visitDate" />
                        </div>
                        <div class="form-row">
                            <label>Training Area *</label>
                            <select @bind="visitArea">
                                @foreach (string area in TrainingAreas)
                                { <option value="@area">@area.Replace("And", " &amp; ")</option> }
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Therapist Name *</label>
                            <input type="text" @bind="visitTherapistName" />
                        </div>
                        <div class="form-row">
                            <label>Location *</label>
                            <input type="text" @bind="visitLocation" placeholder="e.g. Clinic Room 3A" />
                        </div>
                        <div class="form-row">
                            <label>Duration (minutes)</label>
                            <input type="number" @bind="visitDuration" min="15" max="480" />
                        </div>
                        <div class="form-row full">
                            <label>Session Notes</label>
                            <textarea @bind="visitNotes" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="SubmitVisit" disabled="@saving">
                            @if (saving) { <span>Saving...</span> } else { <span>Schedule Visit</span> }
                        </button>
                    </div>
                </div>
            }

            @if (visits.Count == 0)
            {
                <p class="no-data">No outpatient visit records found.</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Date</th><th>Training Area</th><th>Therapist</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        @foreach (BROutpatientVisitIndexEntry v in visits)
                        {
                            <tr>
                                <td>@v.VisitDate.ToString("MM/dd/yyyy")</td>
                                <td>@v.TrainingArea.ToString().Replace("And", " &amp; ")</td>
                                <td>@v.TherapistName</td>
                                <td><span class="status-badge @VisitStatusClass(v.Status)">@v.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <!-- ── Tab 4: Training Centers ────────────────────────────────────────── -->
    @if (activeTab == "centers")
    {
        <div class="section-card">
            <h2>VA Blind Rehabilitation Training Centers</h2>
            @if (centers.Count == 0)
            {
                <p class="no-data">Loading centers...</p>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr><th>Center</th><th>Location</th><th>Type</th><th>Accepting</th></tr>
                    </thead>
                    <tbody>
                        @foreach (BRCenterIndexEntry c in centers)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.City, @c.State</td>
                                <td>@c.CenterType.ToString().Replace("_", " ")</td>
                                <td>@(c.AcceptingPatients ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}

@code {
    // ─── State ───────────────────────────────────────────────────────────────
    private string patientId = string.Empty;
    private string activeTab = "vision";
    private bool loading;
    private bool saving;
    private string? error;
    private string? successMessage;

    private BRPatientState? brRecord;
    private List<BRAdmissionIndexEntry> admissions = new();
    private List<BROutpatientVisitIndexEntry> visits = new();
    private List<BRCenterIndexEntry> centers = new();
    private BRAdmissionState? selectedAdmission;

    // ─── Form toggles ────────────────────────────────────────────────────────
    private bool showEligibilityForm;
    private bool showAcuityForm;
    private bool showDiagnosisForm;
    private bool showDeviceForm;
    private bool showGoalForm;
    private bool showAdmitForm;
    private bool showVisitForm;

    // ─── Eligibility form ────────────────────────────────────────────────────
    private string eligStatus = "Unknown";
    private string? eligReason;

    // ─── Visual Acuity form ──────────────────────────────────────────────────
    private string acuityOdDist = string.Empty;
    private string acuityOsDist = string.Empty;
    private string acuityOdBc  = string.Empty;
    private string acuityOsBc  = string.Empty;
    private string acuityVfRight = "NotTested";
    private string acuityVfLeft  = "NotTested";
    private DateTime acuityExamDate = DateTime.Today;
    private string acuityExaminer = string.Empty;
    private string? acuityNotes;

    // ─── Diagnosis form ──────────────────────────────────────────────────────
    private string dxPrimary    = string.Empty;
    private string? dxSecondary;
    private string dxOnsetType  = "Unknown";
    private DateTime? dxOnsetDate;
    private string dxScStr      = "false";
    private int? dxScPct;
    private string? dxIcd10;
    private string? dxNotes;

    // ─── Device form ─────────────────────────────────────────────────────────
    private string devName        = string.Empty;
    private string devCategory    = "Mobility";
    private string? devSerial;
    private DateTime devIssuedDate = DateTime.Today;
    private string devIssuedBy     = string.Empty;
    private string? devNotes;

    // ─── Goal form ───────────────────────────────────────────────────────────
    private string goalText = string.Empty;
    private string goalArea = "OrientationAndMobility";

    // ─── Admission form ──────────────────────────────────────────────────────
    private string admitCenterId    = string.Empty;
    private string admitCenterName  = string.Empty;
    private DateTime admitDate      = DateTime.Today;
    private DateTime? admitPlannedDischarge;
    private string admitPriority    = "Routine";
    private string admitProviderName = string.Empty;
    private List<string> admitAreas  = new();
    private string? admitGoals;

    // ─── Visit form ──────────────────────────────────────────────────────────
    private DateTime visitDate        = DateTime.Today;
    private string visitArea          = "OrientationAndMobility";
    private string visitTherapistName = string.Empty;
    private string visitLocation      = string.Empty;
    private int visitDuration         = 60;
    private string? visitNotes;

    // ─── Constants ───────────────────────────────────────────────────────────
    private static readonly string[] TrainingAreas =
    {
        "OrientationAndMobility", "ActivitiesOfDailyLiving", "LowVision",
        "ManualSkills", "ComputerAccessTechnology", "CommunicationSkills",
        "RecreationalTherapy", "GuideDog", "VisualSkillsTraining"
    };

    // ─── Helpers ─────────────────────────────────────────────────────────────
    private string Pid => Uri.EscapeDataString(patientId.Trim());

    private void ClearMessages() { error = null; successMessage = null; }

    private void CloseAllForms()
    {
        showEligibilityForm = showAcuityForm = showDiagnosisForm =
        showDeviceForm = showGoalForm = showAdmitForm = showVisitForm = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadPatient();
    }

    private async Task SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "admissions" && admissions.Count == 0) await LoadAdmissions();
        else if (tab == "visits" && visits.Count == 0) await LoadVisits();
        else if (tab == "centers" && centers.Count == 0) await LoadCenters();
    }

    private static string EligibilityClass(object eligibility) => eligibility.ToString() switch
    {
        "LegallyBlind"      => "elig-blind",
        "ServiceConnected"  => "elig-sc",
        "SevereImpairment"  => "elig-severe",
        "Pending"           => "elig-pending",
        "NotEligible"       => "elig-none",
        _                   => "elig-unknown"
    };

    private static string AdmitStatusClass(object status) => status.ToString() switch
    {
        "Active"     => "status-active",
        "Discharged" => "status-discharged",
        "Cancelled"  => "status-cancelled",
        "Pending"    => "status-pending",
        _            => string.Empty
    };

    private static string VisitStatusClass(object status) => status.ToString() switch
    {
        "Completed"  => "status-discharged",
        "Cancelled"  => "status-cancelled",
        "InProgress" => "status-active",
        _            => "status-pending"
    };

    private void ToggleAdmitArea(string area, bool selected)
    {
        if (selected && !admitAreas.Contains(area)) admitAreas.Add(area);
        else admitAreas.Remove(area);
    }

    private void OnCenterSelected()
    {
        BRCenterIndexEntry? center = centers.FirstOrDefault(c => c.CenterId == admitCenterId);
        admitCenterName = center?.Name ?? string.Empty;
    }

    // ─── Load ─────────────────────────────────────────────────────────────────
    private async Task LoadPatient()
    {
        ClearMessages();
        loading = true;
        brRecord = null;
        admissions.Clear();
        visits.Clear();
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            brRecord = await workflow.GetBRPatientAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadAdmissions()
    {
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            admissions = await workflow.GetBRAdmissionsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadVisits()
    {
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            visits = await workflow.GetBROutpatientVisitsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadCenters()
    {
        try
        {
            var centerIndex = Grains.GetGrain<IBRCenterIndexGrain>("BR-CENTER-IDX");
            centers = await centerIndex.GetAllAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ViewAdmission(string admitId)
    {
        try
        {
            var admitGrain = Grains.GetGrain<IBRAdmissionGrain>($"BR-ADMIT:{admitId}");
            selectedAdmission = await admitGrain.GetAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    // ─── Submit Handlers ──────────────────────────────────────────────────────
    private async Task SubmitEligibility()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.UpdateBREligibilityAsync(Enum.Parse<BREligibilityStatus>(eligStatus), eligReason);
            successMessage = "Eligibility updated."; showEligibilityForm = false; await LoadPatient();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitAcuity()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.RecordVisualAcuityAsync(
                acuityOdDist, acuityOsDist, acuityOdBc, acuityOsBc,
                Enum.Parse<VisualField>(acuityVfRight), Enum.Parse<VisualField>(acuityVfLeft),
                null, acuityExamDate, "EXAMINER-1", acuityExaminer, acuityNotes);
            successMessage = "Visual acuity recorded."; showAcuityForm = false; await LoadPatient();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitDiagnosis()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.UpdateBRDiagnosisAsync(
                dxPrimary, dxSecondary, Enum.Parse<BROnsetType>(dxOnsetType), dxOnsetDate,
                dxScStr == "true", dxScPct, dxIcd10, dxNotes);
            successMessage = "Diagnosis updated."; showDiagnosisForm = false; await LoadPatient();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitDevice()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            var device = new BRDeviceEntry
            {
                DeviceName = devName,
                Category = devCategory,
                SerialNumber = devSerial,
                IssuedDate = devIssuedDate,
                IssuedBy = devIssuedBy,
                Notes = devNotes
            };
            await workflow.AddBRDeviceAsync(device);
            successMessage = "Device issued."; showDeviceForm = false; await LoadPatient();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitGoal()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.AddBRTrainingGoalAsync(goalText, Enum.Parse<BRTrainingArea>(goalArea));
            successMessage = "Training goal added."; showGoalForm = false; goalText = string.Empty; await LoadPatient();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitAdmission()
    {
        ClearMessages(); saving = true;
        if (centers.Count == 0) await LoadCenters();
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.CreateBRAdmissionAsync(
                admitCenterId, admitCenterName, admitDate, admitPlannedDischarge,
                admitAreas.Select(a => Enum.Parse<BRTrainingArea>(a)).ToList(),
                Enum.Parse<BRAdmissionPriority>(admitPriority),
                "PROVIDER-1", admitProviderName, admitGoals, null);
            successMessage = "Admission referral created."; showAdmitForm = false; await LoadAdmissions();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitVisit()
    {
        ClearMessages(); saving = true;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.ScheduleBROutpatientVisitAsync(
                visitDate, Enum.Parse<BRTrainingArea>(visitArea),
                "THERAPIST-1", visitTherapistName, visitLocation, visitDuration,
                visitNotes, new List<string>());
            successMessage = "Visit scheduled."; showVisitForm = false; await LoadVisits();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

}

