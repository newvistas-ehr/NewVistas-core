@page "/auto-eligibility"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Automatic Eligibility Determination</PageTitle>

<h3>Automatic Eligibility Determination</h3>
<p class="text-muted">DG/IB Integration — Means Test → Copay → Enrollment (DGENELA.m)</p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:260px" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-success" @onclick="RunDetermination" disabled="@loading">Run Determination</button>
    <button class="btn btn-outline-primary" @onclick="LoadExisting" disabled="@loading">Load Existing</button>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

@if (det != null)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between">
            <span><strong>Eligibility Determination</strong> <span class="badge @ResultBadge(det.Result) ms-2">@det.Result</span></span>
            <span class="text-muted">@det.DeterminationDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-3"><div class="card text-center"><div class="card-body"><h5 class="@ResultColor(det.Result)">@det.Result</h5><p class="text-muted small">Determination</p></div></div></div>
                <div class="col-md-3"><div class="card text-center"><div class="card-body"><h5>@(det.CopayRequired ? "Yes" : "No")</h5><p class="text-muted small">Copay Required</p></div></div></div>
                <div class="col-md-3"><div class="card text-center"><div class="card-body"><h5>@(det.AssignedPriorityGroup ?? "—")</h5><p class="text-muted small">Priority Group</p></div></div></div>
                <div class="col-md-3"><div class="card text-center"><div class="card-body"><h5>@(det.AutoApplied ? "Yes" : "No")</h5><p class="text-muted small">Auto-Applied</p></div></div></div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <h6>Input Factors</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Enrollment Status</dt><dd class="col-sm-6">@det.EnrollmentStatus</dd>
                        <dt class="col-sm-6">Priority Group</dt><dd class="col-sm-6">@(det.PriorityGroup ?? "—")</dd>
                        <dt class="col-sm-6">Means Test Required</dt><dd class="col-sm-6">@det.MeansTestRequired</dd>
                        <dt class="col-sm-6">Means Test Completed</dt><dd class="col-sm-6">@det.MeansTestCompleted</dd>
                        <dt class="col-sm-6">SC 50%+</dt><dd class="col-sm-6">@det.IsServiceConnected50Plus</dd>
                        <dt class="col-sm-6">SC %</dt><dd class="col-sm-6">@(det.ServiceConnectedPercent?.ToString() ?? "—")</dd>
                        <dt class="col-sm-6">VA Pension</dt><dd class="col-sm-6">@det.ReceivesVaPension</dd>
                        <dt class="col-sm-6">Cat. Disabled</dt><dd class="col-sm-6">@det.IsCatastrophicallyDisabled</dd>
                        <dt class="col-sm-6">Former POW</dt><dd class="col-sm-6">@det.IsFormerPOW</dd>
                        <dt class="col-sm-6">Purple Heart</dt><dd class="col-sm-6">@det.IsPurpleHeart</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h6>Output</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Copay Exemption</dt><dd class="col-sm-6">@(det.CopayExemptionReason ?? "—")</dd>
                        <dt class="col-sm-6">Adjusted Income</dt><dd class="col-sm-6">@(det.AdjustedIncome?.ToString("C") ?? "—")</dd>
                        <dt class="col-sm-6">GMT Threshold</dt><dd class="col-sm-6">@(det.GmtThreshold?.ToString("C") ?? "—")</dd>
                    </dl>

                    <h6 class="mt-3">Determination Factors</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var f in det.DeterminationFactors)
                        {
                            <li class="list-group-item py-1 small">@f</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string patientId = string.Empty;
    private bool loading;
    private string? error;
    private AutoEligibilityDeterminationState? det;

    private async Task RunDetermination()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { det = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RunAutoEligibilityDeterminationAsync(null, null); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadExisting()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { det = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetAutoEligibilityDeterminationAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private string ResultBadge(EligibilityDeterminationResult r) => r switch
    {
        EligibilityDeterminationResult.Exempt or EligibilityDeterminationResult.HardshipExempt => "bg-success",
        EligibilityDeterminationResult.CopayRequired => "bg-warning text-dark",
        EligibilityDeterminationResult.NotEligible or EligibilityDeterminationResult.NotEligibleIncome => "bg-danger",
        EligibilityDeterminationResult.Pending => "bg-info",
        _ => "bg-secondary",
    };

    private string ResultColor(EligibilityDeterminationResult r) => r switch
    {
        EligibilityDeterminationResult.Exempt or EligibilityDeterminationResult.HardshipExempt => "text-success",
        EligibilityDeterminationResult.CopayRequired => "text-warning",
        EligibilityDeterminationResult.NotEligible or EligibilityDeterminationResult.NotEligibleIncome => "text-danger",
        _ => "",
    };
}
