@page "/auto-eligibility"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Automatic Eligibility Determination</PageTitle>

<h1>Automatic Eligibility Determination</h1>
<p class="page-subtitle">DG/IB Integration — Means Test → Copay → Enrollment (DGENELA.m)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="RunDetermination" LoadText="Run Determination" />
<div class="form-actions" style="margin-top:-0.75rem;margin-bottom:1.5rem">
    <button class="btn btn-secondary" @onclick="LoadExisting" disabled="@loading">Load Existing</button>
</div>

<AlertBanner Error="@error" />

@if (det != null)
{
    <div class="form-section" style="max-width:900px">
        <h3>
            Eligibility Determination
            <span class="badge @ResultBadge(det.Result)">@det.Result</span>
            <span class="page-subtitle" style="margin:0">@det.DeterminationDate.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </h3>

        <p>
            <strong>Determination:</strong> @det.Result &nbsp;&nbsp;
            <strong>Copay Required:</strong> @(det.CopayRequired ? "Yes" : "No") &nbsp;&nbsp;
            <strong>Priority Group:</strong> @(det.AssignedPriorityGroup ?? "—") &nbsp;&nbsp;
            <strong>Auto-Applied:</strong> @(det.AutoApplied ? "Yes" : "No")
        </p>

        <h3>Input Factors</h3>
        <p>
            <strong>Enrollment Status:</strong> @det.EnrollmentStatus &nbsp;&nbsp;
            <strong>Priority Group:</strong> @(det.PriorityGroup ?? "—") &nbsp;&nbsp;
            <strong>Means Test Required:</strong> @det.MeansTestRequired &nbsp;&nbsp;
            <strong>Means Test Completed:</strong> @det.MeansTestCompleted
        </p>
        <p>
            <strong>SC 50%+:</strong> @det.IsServiceConnected50Plus &nbsp;&nbsp;
            <strong>SC %:</strong> @(det.ServiceConnectedPercent?.ToString() ?? "—") &nbsp;&nbsp;
            <strong>VA Pension:</strong> @det.ReceivesVaPension &nbsp;&nbsp;
            <strong>Cat. Disabled:</strong> @det.IsCatastrophicallyDisabled
        </p>
        <p>
            <strong>Former POW:</strong> @det.IsFormerPOW &nbsp;&nbsp;
            <strong>Purple Heart:</strong> @det.IsPurpleHeart
        </p>

        <h3>Output</h3>
        <p>
            <strong>Copay Exemption:</strong> @(det.CopayExemptionReason ?? "—") &nbsp;&nbsp;
            <strong>Adjusted Income:</strong> @(det.AdjustedIncome?.ToString("C") ?? "—") &nbsp;&nbsp;
            <strong>GMT Threshold:</strong> @(det.GmtThreshold?.ToString("C") ?? "—")
        </p>

        @if (det.DeterminationFactors.Count > 0)
        {
            <h3>Determination Factors</h3>
            <ul>
                @foreach (var f in det.DeterminationFactors)
                {
                    <li>@f</li>
                }
            </ul>
        }
    </div>
}

@code {
    private string? patientId;
    private bool loading;
    private string? error;
    private AutoEligibilityDeterminationState? det;

    private async Task RunDetermination()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { det = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RunAutoEligibilityDeterminationAsync(null, null); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadExisting()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { det = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetAutoEligibilityDeterminationAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private string ResultBadge(EligibilityDeterminationResult r) => r switch
    {
        EligibilityDeterminationResult.Exempt or EligibilityDeterminationResult.HardshipExempt => "badge-success",
        EligibilityDeterminationResult.CopayRequired => "badge-warning",
        EligibilityDeterminationResult.NotEligible or EligibilityDeterminationResult.NotEligibleIncome => "badge-danger",
        EligibilityDeterminationResult.Pending => "badge-info",
        _ => "badge-neutral",
    };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.6; }
</style>
