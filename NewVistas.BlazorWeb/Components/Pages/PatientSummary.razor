@page "/patient-summary"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext

<PageTitle>Clinical Summary</PageTitle>

<h1>Clinical Summary</h1>
<p class="ps-subtitle">AI-drafted from the chart, grounded in discrete facts, verified, and signed by a clinician.</p>

<div class="ps-toolbar">
    <div class="ps-field">
        <label>Patient ID</label>
        <input @bind="patientId" placeholder="e.g. PATIENT-123" />
    </div>
    <div class="ps-field">
        <label>Purpose</label>
        <input @bind="purpose" placeholder="e.g. Pre-op review" />
    </div>
    <button class="ps-btn primary" @onclick="Generate"
            disabled="@(busy || string.IsNullOrWhiteSpace(patientId))">
        @(busy ? "Working…" : "Generate")
    </button>
    <button class="ps-btn" @onclick="LoadCurrent"
            disabled="@(busy || string.IsNullOrWhiteSpace(patientId))">
        Load current
    </button>
</div>

@if (error != null)
{
    <div class="ps-error">@error</div>
}

@if (draft != null)
{
    <div class="ps-draft">
        <div class="ps-meta">
            @if (draft.Status == SummaryStatus.Signed)
            {
                <span class="ps-badge signed">Signed by @draft.SignedBy · @(draft.SignedDate?.ToString("g"))</span>
            }
            else
            {
                <span class="ps-badge draft">Draft — pending sign-off</span>
            }
            <span class="ps-prov">@draft.Purpose · generated by @draft.ModelProvider · @draft.GeneratedDate.ToString("g")</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(draft.ConfigurationNotice))
        {
            <div class="ps-setup">@draft.ConfigurationNotice</div>
        }

        @if (draft.UnverifiedClaimCount > 0)
        {
            <div class="ps-warn">
                ⚠ @draft.UnverifiedClaimCount claim(s) could not be verified against the chart — review before signing.
            </div>
        }

        <h3>Summary</h3>
        <p class="ps-narrative">@draft.Narrative</p>

        <h3>Claims <span class="ps-muted">(each traced to source facts)</span></h3>
        <ul class="ps-claims">
            @foreach (SummaryClaim claim in draft.Claims)
            {
                <li class="@(claim.Verified ? "ok" : "flag")">
                    <span class="ps-mark">@(claim.Verified ? "✓" : "⚠")</span>
                    <span class="ps-ctext">@claim.Text</span>
                    @if (claim.SupportingFactIds.Count > 0)
                    {
                        <span class="ps-cites">cites @string.Join(", ", claim.SupportingFactIds)</span>
                    }
                    @if (!claim.Verified && claim.VerificationNote != null)
                    {
                        <div class="ps-note">@claim.VerificationNote</div>
                    }
                </li>
            }
        </ul>

        <h3>Grounding facts <span class="ps-muted">(provenance)</span></h3>
        <table class="ps-facts">
            <thead>
                <tr><th>ID</th><th>Category</th><th>Fact</th><th>Source</th></tr>
            </thead>
            <tbody>
                @foreach (ClinicalFact fact in draft.GroundingFacts)
                {
                    <tr>
                        <td>@fact.FactId</td>
                        <td>@fact.Category</td>
                        <td>@fact.Text</td>
                        <td class="ps-muted">@fact.SourceGrain@(string.IsNullOrEmpty(fact.SourceId) ? "" : $" · {fact.SourceId}")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (draft.Status != SummaryStatus.Signed)
        {
            <div class="ps-sign">
                <ProviderPicker @bind-ProviderId="clinicianId" Label="Clinician" DefaultToSelf="true" />
                <button class="ps-btn primary" @onclick="SignOff"
                        disabled="@(busy || string.IsNullOrWhiteSpace(clinicianId))">
                    Review complete — sign off
                </button>
            </div>
        }
    </div>
}

<style>
    .ps-subtitle { color: #555; margin-top: -0.25rem; }
    .ps-toolbar { display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; margin: 1rem 0; }
    .ps-field { display: flex; flex-direction: column; }
    .ps-field label { font-size: 0.8rem; color: #555; margin-bottom: 0.2rem; }
    .ps-field input { padding: 0.4rem 0.5rem; border: 1px solid #ccc; border-radius: 4px; min-width: 16rem; }
    .ps-btn { padding: 0.45rem 0.9rem; border: 1px solid #ccc; border-radius: 4px; background: #f4f4f4; cursor: pointer; }
    .ps-btn.primary { background: #1565c0; color: #fff; border-color: #1565c0; }
    .ps-btn:disabled { opacity: 0.5; cursor: default; }
    .ps-error { background: #fdecea; color: #b71c1c; padding: 0.6rem 0.8rem; border-radius: 4px; margin: 0.5rem 0; }
    .ps-draft { border: 1px solid #e0e0e0; border-radius: 6px; padding: 1rem 1.25rem; margin-top: 1rem; }
    .ps-meta { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; }
    .ps-badge { font-weight: 600; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.85rem; }
    .ps-badge.draft { background: #fff3e0; color: #e65100; }
    .ps-badge.signed { background: #e8f5e9; color: #2e7d32; }
    .ps-prov { color: #777; font-size: 0.85rem; }
    .ps-warn { background: #fff3e0; color: #b54708; border: 1px solid #ffcc80; padding: 0.6rem 0.8rem; border-radius: 4px; margin: 0.75rem 0; }
    .ps-setup { background: #e8f1fc; color: #1a4480; border: 1px solid #aac6ec; padding: 0.7rem 0.9rem; border-radius: 4px; margin: 0.75rem 0; font-size: 0.88rem; white-space: pre-line; }
    .ps-narrative { line-height: 1.5; }
    .ps-muted { color: #999; font-weight: 400; font-size: 0.85rem; }
    .ps-claims { list-style: none; padding: 0; }
    .ps-claims li { padding: 0.4rem 0.6rem; border-left: 3px solid #ccc; margin-bottom: 0.4rem; background: #fafafa; }
    .ps-claims li.ok { border-left-color: #2e7d32; }
    .ps-claims li.flag { border-left-color: #e65100; background: #fff8f2; }
    .ps-mark { font-weight: 700; margin-right: 0.4rem; }
    .ps-claims li.ok .ps-mark { color: #2e7d32; }
    .ps-claims li.flag .ps-mark { color: #e65100; }
    .ps-cites { color: #777; font-size: 0.78rem; margin-left: 0.5rem; }
    .ps-note { color: #b54708; font-size: 0.82rem; margin-top: 0.25rem; }
    .ps-facts { border-collapse: collapse; width: 100%; font-size: 0.88rem; margin-top: 0.25rem; }
    .ps-facts th, .ps-facts td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid #eee; }
    .ps-sign { display: flex; gap: 0.6rem; align-items: center; margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid #eee; }
    .ps-sign input { padding: 0.4rem 0.5rem; border: 1px solid #ccc; border-radius: 4px; min-width: 14rem; }
</style>

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private string purpose = "Pre-op review";
    private string clinicianId = string.Empty;
    private ClinicalSummaryDraft? draft;
    private bool busy;
    private string? error;

    private IPatientSummaryGrain Summary() =>
        Grains.GetGrain<IPatientSummaryGrain>(patientId!.Trim());

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(patientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
            patientId = PatientContext.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId))
            await LoadCurrent();
    }

    private async Task Generate()
    {
        error = null;
        busy = true;
        try
        {
            draft = await Summary().GenerateAsync(
                string.IsNullOrWhiteSpace(purpose) ? "summary" : purpose.Trim());
        }
        catch (Exception ex)
        {
            error = $"Could not generate summary: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadCurrent()
    {
        error = null;
        busy = true;
        try
        {
            draft = await Summary().GetCurrentDraftAsync();
            PatientContext.SetPatient(patientId!.Trim());
            if (draft is null)
                error = "No summary on file for this patient yet — generate one.";
        }
        catch (Exception ex)
        {
            error = $"Could not load summary: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SignOff()
    {
        if (draft is null || string.IsNullOrWhiteSpace(clinicianId))
            return;

        error = null;
        busy = true;
        try
        {
            await Summary().SignOffAsync(clinicianId.Trim());
            draft = await Summary().GetCurrentDraftAsync();
        }
        catch (Exception ex)
        {
            error = $"Could not sign off: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
