@page "/adt"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>ADT</PageTitle>
<h1>ADT — Admit / Discharge / Transfer</h1>

<div class="lookup-bar">
    <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="Patient ID" class="lookup-input" />
    <button @onclick="Load" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)" class="btn btn-primary">@(loading ? "Loading..." : "Load")</button>
    <button @onclick="ShowAdmitForm" disabled="@(string.IsNullOrWhiteSpace(patientId))" class="btn btn-secondary">+ Admit Patient</button>
    <button @onclick="DemoLoad" disabled="@(string.IsNullOrWhiteSpace(patientId) || saving)" class="btn btn-demo">Demo Load</button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }

<div class="tab-bar">
    <button @onclick="@(() => tab = "movements")" class="tab @(tab == "movements" ? "active" : "")">Patient Movements</button>
    <button @onclick="@(() => { tab = "census"; _ = LoadCensus(); })" class="tab @(tab == "census" ? "active" : "")">Ward Census</button>
    <button @onclick="@(() => { tab = "wards"; _ = LoadWards(); })" class="tab @(tab == "wards" ? "active" : "")">Ward Directory</button>
</div>

@if (tab == "movements")
{
    @if (showAdmit)
    {
        <div class="entry-form">
            <h3>Record Admission</h3>
            <div class="form-grid">
                <div class="form-row"><label>Admission Date/Time *</label><input type="datetime-local" @bind="f_admitDate" /></div>
                <div class="form-row">
                    <label>Ward</label>
                    <select @bind="f_wardId" @bind:after="OnWardSelected">
                        <option value="">— Select Ward —</option>
                        @foreach (var w in wards) { <option value="@w.WardId">@w.Name (@w.WardType)</option> }
                    </select>
                </div>
                <div class="form-row"><label>Room-Bed</label><input type="text" @bind="f_room" placeholder="e.g. 301-A" /></div>
                <div class="form-row"><label>Treating Specialty</label><input type="text" @bind="f_specialty" placeholder="e.g. Internal Medicine" /></div>
                <div class="form-row"><label>Attending Physician</label><ProviderPicker @bind-ProviderId="f_attendingId" @bind-ProviderName="f_attending" Label="" DefaultToSelf="false" /></div>
                <div class="form-row full"><label>Admission Diagnosis</label><input type="text" @bind="f_diagnosis" /></div>
                <div class="form-row full"><label>Comments</label><textarea @bind="f_comments" rows="2"></textarea></div>
            </div>
            <div class="form-actions">
                <button @onclick="SubmitAdmit" disabled="@saving" class="btn btn-primary">@(saving ? "Saving..." : "Admit")</button>
                <button @onclick="() => showAdmit = false" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (showTransfer)
    {
        <div class="entry-form">
            <h3>Record Transfer</h3>
            <div class="form-grid">
                <div class="form-row"><label>Transfer Date/Time *</label><input type="datetime-local" @bind="f_transferDate" /></div>
                <div class="form-row">
                    <label>To Ward</label>
                    <select @bind="f_toWardId" @bind:after="OnToWardSelected">
                        <option value="">— Select Ward —</option>
                        @foreach (var w in wards) { <option value="@w.WardId">@w.Name (@w.WardType)</option> }
                    </select>
                </div>
                <div class="form-row"><label>Room-Bed</label><input type="text" @bind="f_toRoom" placeholder="e.g. ICU-5" /></div>
                <div class="form-row"><label>Treating Specialty</label><input type="text" @bind="f_toSpecialty" /></div>
                <div class="form-row"><label>Attending Physician</label><ProviderPicker @bind-ProviderName="f_toAttending" Label="" DefaultToSelf="false" /></div>
                <div class="form-row full"><label>Comments</label><textarea @bind="f_transferComments" rows="2"></textarea></div>
            </div>
            <div class="form-actions">
                <button @onclick="SubmitTransfer" disabled="@saving" class="btn btn-primary">@(saving ? "Saving..." : "Transfer")</button>
                <button @onclick="() => showTransfer = false" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (items != null)
    {
        @if (items.Count == 0) { <div class="empty-state">No ADT movements found.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Date</th><th>Type</th><th>Ward</th><th>Room</th><th>Attending</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var s in items)
                    {
                        <tr>
                            <td class="date">@s.MovementDateTime.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>@s.MovementType</td><td>@s.WardLocationName</td><td>@s.RoomBed</td>
                            <td>@s.AttendingPhysicianName</td>
                            <td><span class="badge @StatusCss(s.Status)">@s.Status</span></td>
                            <td class="actions">
                                @if (s.Status == "ADMITTED")
                                {
                                    <button @onclick="() => ShowTransferForm(s.MovementId)" class="btn btn-primary">Transfer</button>
                                    <button @onclick="() => Discharge(s.MovementId)" class="btn btn-secondary">Discharge</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@if (tab == "census")
{
    <div class="census-bar">
        <label>Select Ward:</label>
        <select @bind="censusWardId" @bind:after="LoadCensus">
            <option value="">— Select a Ward —</option>
            @foreach (var w in wards) { <option value="@w.WardId">@w.Name</option> }
        </select>
    </div>

    @if (censusItems != null)
    {
        @if (censusItems.Count == 0) { <div class="empty-state">No patients currently on this ward.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Patient ID</th><th>Name</th><th>Room-Bed</th><th>Specialty</th><th>Attending</th><th>Admit Date</th><th>Last Movement</th></tr></thead>
                <tbody>
                    @foreach (var c in censusItems)
                    {
                        <tr>
                            <td>@c.PatientId</td>
                            <td>@(c.PatientName ?? "—")</td>
                            <td>@(c.RoomBed ?? "—")</td>
                            <td>@(c.TreatingSpecialty ?? "—")</td>
                            <td>@(c.AttendingPhysicianName ?? "—")</td>
                            <td class="date">@c.AdmitDate.ToString("MM/dd/yyyy")</td>
                            <td class="date">@c.LastMovementDate.ToString("MM/dd/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@if (tab == "wards")
{
    <div class="search-bar">
        <input type="text" @bind="wardSearch" @bind:event="oninput" placeholder="Search wards..." class="lookup-input" />
    </div>
    @if (wards.Count == 0) { <div class="empty-state">Loading wards...</div> }
    else
    {
        List<WardLocationEntry> filtered = string.IsNullOrWhiteSpace(wardSearch)
            ? wards
            : wards.Where(w => w.Name.Contains(wardSearch, StringComparison.OrdinalIgnoreCase) || w.WardType.Contains(wardSearch, StringComparison.OrdinalIgnoreCase)).ToList();
        <table class="data-table">
            <thead><tr><th>Ward ID</th><th>Name</th><th>Type</th><th>Division</th><th>Capacity</th></tr></thead>
            <tbody>
                @foreach (var w in filtered)
                {
                    <tr>
                        <td>@w.WardId</td><td>@w.Name</td>
                        <td><span class="badge badge-neutral">@w.WardType</span></td>
                        <td>@(w.Division ?? "—")</td><td>@w.BedCapacity</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private string tab = "movements";
    private List<AdtSummary>? items;
    private List<WardCensusEntry>? censusItems;
    private List<WardLocationEntry> wards = new();
    private bool loading, saving, showAdmit, showTransfer;
    private string? error, success;
    private string? transferMovementId;
    private string censusWardId = "", wardSearch = "";

    // Admit form
    private string f_wardId = "", f_wardName = "", f_room = "", f_specialty = "", f_attendingId = "", f_attending = "", f_diagnosis = "", f_comments = "";
    private DateTime f_admitDate = DateTime.Now;

    // Transfer form
    private string f_toWardId = "", f_toWardName = "", f_toRoom = "", f_toSpecialty = "", f_toAttending = "", f_transferComments = "";
    private DateTime f_transferDate = DateTime.Now;

    protected override async Task OnParametersSetAsync()
    {
        await LoadWards();
        if (!string.IsNullOrWhiteSpace(patientId)) await Load();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }

    private void ShowAdmitForm()
    {
        showAdmit = true; showTransfer = false; success = null;
        f_wardId = ""; f_wardName = ""; f_room = ""; f_specialty = ""; f_attendingId = ""; f_attending = ""; f_diagnosis = ""; f_comments = "";
        f_admitDate = DateTime.Now;
    }

    private void ShowTransferForm(string movementId)
    {
        showTransfer = true; showAdmit = false; success = null;
        transferMovementId = movementId;
        f_toWardId = ""; f_toWardName = ""; f_toRoom = ""; f_toSpecialty = ""; f_toAttending = ""; f_transferComments = "";
        f_transferDate = DateTime.Now;
    }

    private void OnWardSelected()
    {
        WardLocationEntry? w = wards.FirstOrDefault(x => x.WardId == f_wardId);
        f_wardName = w?.Name ?? string.Empty;
    }

    private void OnToWardSelected()
    {
        WardLocationEntry? w = wards.FirstOrDefault(x => x.WardId == f_toWardId);
        f_toWardName = w?.Name ?? string.Empty;
    }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            items = await wf.GetAdtMovementsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadWards()
    {
        try
        {
            var idx = Grains.GetGrain<IWardLocationIndexGrain>("WARD-LOCATION-INDEX");
            wards = await idx.GetAllWardsAsync();
        }
        catch { wards = new(); }
    }

    private async Task LoadCensus()
    {
        if (string.IsNullOrWhiteSpace(censusWardId)) { censusItems = null; return; }
        try
        {
            var census = Grains.GetGrain<IWardCensusGrain>($"WARD-CENSUS:{censusWardId}");
            censusItems = await census.GetCensusAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SubmitAdmit()
    {
        saving = true; error = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!);
            await wf.RecordAdmissionAsync(
                f_admitDate,
                NullIfEmpty(f_wardId), NullIfEmpty(f_wardName),
                NullIfEmpty(f_room), NullIfEmpty(f_specialty),
                NullIfEmpty(f_attendingId), NullIfEmpty(f_attending),
                NullIfEmpty(f_diagnosis), NullIfEmpty(f_comments));
            showAdmit = false; success = "Patient admitted."; await Load();
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task SubmitTransfer()
    {
        saving = true; error = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!);
            await wf.RecordTransferAsync(
                transferMovementId!,
                f_transferDate,
                NullIfEmpty(f_toWardId), NullIfEmpty(f_toWardName),
                NullIfEmpty(f_toRoom),
                null, NullIfEmpty(f_toSpecialty),
                null, NullIfEmpty(f_toAttending),
                NullIfEmpty(f_transferComments));
            showTransfer = false; success = "Patient transferred."; await Load();
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private async Task Discharge(string movementId)
    {
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!);
            await wf.RecordDischargeAsync(movementId, DateTime.UtcNow, null, "REGULAR", null);
            success = "Patient discharged."; await Load();
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DemoLoad()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        saving = true; error = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!);
            string admitId = await wf.RecordAdmissionAsync(
                DateTime.UtcNow.AddDays(-3), "WARD-MED-3A", "Medical Ward 3A",
                "301-A", "Internal Medicine", "PROV-001", "Dr. Smith",
                "Community-acquired pneumonia", "Demo admission");
            await wf.RecordTransferAsync(
                admitId, DateTime.UtcNow.AddDays(-2),
                "WARD-ICU-1", "Intensive Care Unit", "ICU-5",
                null, "Critical Care", "PROV-002", "Dr. Jones",
                "Deteriorating respiratory status");
            success = "Demo data loaded."; await Load();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    private static string? NullIfEmpty(string s) => string.IsNullOrWhiteSpace(s) ? null : s;
    private static string StatusCss(string s) => s switch
    {
        "ADMITTED" => "badge-warning",
        "DISCHARGED" => "badge-success",
        "TRANSFERRED" => "badge-info",
        _ => "badge-neutral"
    };

    // Use grain state types directly — WardDto replaced by WardLocationEntry
    // MovementDto replaced by AdtSummary, CensusDto replaced by WardCensusEntry
}

<style>
    /* Canonical classes (lookup-bar, lookup-input, btn, btn-primary, btn-secondary,
       tab-bar, tab, alert*, empty-state, data-table, badge, badge-*) live in app.css
       per UI-CONVENTIONS.md. Only page-specific styles below. */
    .search-bar { margin-bottom: 1rem; }
    .btn-demo { background: #7c3aed; color: white; } .btn-demo:disabled { background: #999; }
    .census-bar { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
    .census-bar select { padding: .4rem .6rem; border: 1px solid #ccc; border-radius: 4px; font-size: .85rem; min-width: 220px; }
    .entry-form { border: 1px solid #d4d9e0; border-radius: 6px; padding: 1.25rem; margin-bottom: 1.5rem; background: #f9fafb; }
    .entry-form h3 { margin-bottom: 1rem; color: #003f72; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
    .form-row { display: flex; flex-direction: column; gap: .25rem; }
    .form-row.full { grid-column: 1 / -1; }
    .form-row label { font-size: .8rem; font-weight: 600; color: #555; }
    .form-row input, .form-row select, .form-row textarea { padding: .4rem .6rem; border: 1px solid #ccc; border-radius: 4px; font-size: .85rem; }
    .form-actions { display: flex; gap: .5rem; margin-top: .75rem; }
    .date { color: #888; font-size: .8rem; white-space: nowrap; }
    .actions { white-space: nowrap; }
</style>
