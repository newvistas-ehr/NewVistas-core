@page "/lab-tech"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Lab Technologist Worklist</PageTitle>

<h1>Lab Technologist Workflows</h1>
<p class="page-subtitle">Worklist, Accessioning, QC, Specimen Rejection, Delta Checks (LRACE.m, LRVER.m)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadAll" />
<div class="form-section">
    <FormField Label="Location ID"><input class="form-input" @bind="locationId" /></FormField>
</div>
<AlertBanner Error="@error" Success="@accResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "worklist" && worklist != null)
    {
        <table class="data-table">
            <thead><tr><th>Test</th><th>Patient</th><th>Category</th><th>Status</th><th>Specimen</th><th>Critical</th><th>Ordered</th></tr></thead>
            <tbody>
                @foreach (var i in worklist.Items)
                {
                    <tr class="@(i.IsCritical ? "row-danger" : "")">
                        <td>@i.TestName</td>
                        <td>@i.PatientId[..Math.Min(12, i.PatientId.Length)]</td>
                        <td><span class="badge @WlBadge(i.WorklistCategory)">@i.WorklistCategory</span></td>
                        <td>@i.Status</td>
                        <td>@(i.SpecimenType ?? "—")</td>
                        <td>@(i.IsCritical ? "CRITICAL" : "")</td>
                        <td>@i.OrderedDate.ToString("MM/dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="page-subtitle">Refreshed: @worklist.LastRefreshedDate.ToString("HH:mm:ss")</p>
    }

    @if (tab == "accession" && accessions != null)
    {
        <table class="data-table">
            <thead><tr><th>Accession #</th><th>Specimen</th><th>Status</th><th>Tests</th><th>Collected</th><th>Rejected?</th></tr></thead>
            <tbody>
                @foreach (var a in accessions)
                {
                    <tr class="@(a.IsRejected ? "row-danger" : "")">
                        <td>@a.AccessionNumber</td>
                        <td>@a.SpecimenType</td>
                        <td><span class="badge @AccBadge(a.Status)">@a.Status</span></td>
                        <td>@a.TestCount</td>
                        <td>@a.CollectionDateTime.ToString("MM/dd HH:mm")</td>
                        <td>@(a.IsRejected ? "Yes" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="form-section">
            <h3>Accession New Specimen</h3>
            <FormField Label="Lab Test IDs (comma-sep)"><input class="form-input" @bind="nTestIds" /></FormField>
            <FormField Label="Specimen"><input class="form-input" @bind="nSpecType" placeholder="Blood" /></FormField>
            <FormField Label="Tube"><input class="form-input" @bind="nTube" placeholder="LAVENDER" /></FormField>
            <FormField Label="Section"><input class="form-input" @bind="nSection" placeholder="CHEM" /></FormField>
            <FormField Label="Tech ID"><ProviderPicker @bind-ProviderId="nTechId" Label="" DefaultToSelf="true" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Accession">Accession</button>
            </div>
        </div>
    }

    @if (tab == "qc")
    {
        <div class="form-section">
            <h3>Record QC Run</h3>
            <FormField Label="Instrument"><input class="form-input" @bind="qInst" /></FormField>
            <FormField Label="LOINC"><input class="form-input" @bind="qLoinc" /></FormField>
            <FormField Label="Level"><input class="form-input" @bind="qLevel" placeholder="Level 1" /></FormField>
            <FormField Label="Measured"><input type="number" step="0.01" class="form-input" @bind="qMeasured" /></FormField>
            <FormField Label="Mean"><input type="number" step="0.01" class="form-input" @bind="qMean" /></FormField>
            <FormField Label="SD"><input type="number" step="0.01" class="form-input" @bind="qSD" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="RunQc">Run QC</button>
            </div>
            @if (qcResult != null)
            {
                <div class="alert @(qcResult.Status == QcResultStatus.Pass ? "alert-success" : qcResult.Status == QcResultStatus.Warning ? "alert-error" : "alert-error")"><strong>@qcResult.Status</strong> — Z-score: @qcResult.ZScore @(qcResult.WestgardViolation != null ? $"(Westgard: {qcResult.WestgardViolation})" : "")</div>
            }
        </div>
    }

    @if (tab == "reject")
    {
        <div class="form-section">
            <h3>Reject Specimen</h3>
            <FormField Label="Accession #"><input class="form-input" @bind="rAccNum" /></FormField>
            <FormField Label="Reason">
                <select class="form-input" @bind="rReason">
                    <option value="@SpecimenRejectReason.Hemolyzed">Hemolyzed</option>
                    <option value="@SpecimenRejectReason.Clotted">Clotted</option>
                    <option value="@SpecimenRejectReason.QuantityNotSufficient">QNS</option>
                    <option value="@SpecimenRejectReason.WrongTube">Wrong Tube</option>
                    <option value="@SpecimenRejectReason.Unlabeled">Unlabeled</option>
                    <option value="@SpecimenRejectReason.MislabeledPatient">Mislabeled</option>
                    <option value="@SpecimenRejectReason.Contaminated">Contaminated</option>
                    <option value="@SpecimenRejectReason.Other">Other</option>
                </select>
            </FormField>
            <FormField Label="Notes"><input class="form-input" @bind="rNotes" /></FormField>
            <FormField Label="Order Recollect"><input type="checkbox" @bind="rRecollect" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Reject">Reject Specimen</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string locationId = "LAB-MAIN", tab = "worklist";
    private bool loading; private string? error;
    private LabWorklistState? worklist;
    private List<LabAccessionIndexEntry>? accessions;
    private string nTestIds = string.Empty, nSpecType = "Blood", nTube = "LAVENDER", nSection = "CHEM", nTechId = string.Empty;
    private string? accResult;
    private string qInst = string.Empty, qLoinc = string.Empty, qLevel = "Level 1 Normal"; private decimal qMeasured, qMean, qSD;
    private LabQcResult? qcResult;
    private string rAccNum = string.Empty, rNotes = string.Empty; private SpecimenRejectReason rReason = SpecimenRejectReason.Hemolyzed; private bool rRecollect;
    private readonly (string, string)[] _tabs = new[] { ("worklist", "Worklist"), ("accession", "Accessioning"), ("qc", "QC"), ("reject", "Specimen Reject") };

    private async Task LoadAll()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            worklist = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RefreshLabWorklistAsync(locationId);
            accessions = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetAccessionsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task Accession()
    {
        if (string.IsNullOrWhiteSpace(nTestIds)) return; error = null; accResult = null;
        try
        {
            List<string> ids = nTestIds.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
            string num = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).AccessionSpecimenAsync(ids, nSpecType, nTube, DateTime.UtcNow, nSection, nTechId, "Tech", null);
            accResult = $"Accessioned: {num}";
            accessions = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetAccessionsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RunQc()
    {
        error = null; qcResult = null;
        try { qcResult = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).RecordLabQcRunAsync(qInst, qLoinc, "Test", qLevel, "LOT-001", qMeasured, qMean, qSD, nTechId, "Tech", null); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Reject()
    {
        if (string.IsNullOrWhiteSpace(rAccNum)) return; error = null;
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).RejectSpecimenAsync(rAccNum, rReason, rNotes, nTechId, rRecollect); accessions = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetAccessionsAsync(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private string WlBadge(LabWorklistCategory c) => c switch { LabWorklistCategory.PendingCollection => "badge-warning", LabWorklistCategory.PendingResult => "badge-info", LabWorklistCategory.PendingVerification => "badge-info", LabWorklistCategory.CriticalPending => "badge-danger", _ => "badge-neutral" };
    private string AccBadge(SpecimenStatus s) => s switch { SpecimenStatus.Accessioned => "badge-info", SpecimenStatus.InProcess => "badge-info", SpecimenStatus.Completed => "badge-success", SpecimenStatus.Rejected => "badge-danger", _ => "badge-neutral" };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
</style>
