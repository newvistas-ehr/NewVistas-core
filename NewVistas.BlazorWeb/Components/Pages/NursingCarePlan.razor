@page "/nursing-careplan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Nursing Care Plan</PageTitle>

<h1>Nursing Care Plan</h1>
<p class="page-subtitle">NANDA Nursing Diagnoses, Goals, Interventions &amp; Outcomes (VistA File #212)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadCarePlan" />
<AlertBanner Error="@error" Success="@addResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "plan" && carePlan != null)
    {
        @if (carePlan.Problems.Count == 0)
        {
            <div class="empty-state">No nursing diagnoses on care plan. Use the Add Diagnosis tab to start.</div>
        }
        @foreach (var p in carePlan.Problems)
        {
            <div class="form-section">
                <div class="problem-header">
                    <span>
                        <strong>@p.NursingDiagnosis</strong>
                        @if (!string.IsNullOrEmpty(p.RelatedTo)) { <span class="muted"> R/T @p.RelatedTo</span> }
                        <span class="status-tag">@p.Status</span>
                    </span>
                    <span class="muted">Priority: @(p.Priority?.ToString() ?? "—") | @p.CreatedDateTime.ToString("MM/dd/yyyy")</span>
                </div>

                @if (!string.IsNullOrEmpty(p.EvidencedBy)) { <p class="muted"><strong>AEB:</strong> @p.EvidencedBy</p> }

                <div class="problem-columns">
                    <div>
                        <h3>Goals</h3>
                        @if (p.Goals.Count > 0)
                        {
                            <ul class="plain-list">
                                @foreach (var g in p.Goals)
                                {
                                    <li><span>@g.GoalText</span> <span class="status-tag">@g.Status</span></li>
                                }
                            </ul>
                        }
                        else { <p class="muted">No goals</p> }

                        <div class="inline-add">
                            <input class="form-input" placeholder="New goal..." @bind="newGoalText" />
                            <button class="btn btn-primary" @onclick="() => AddGoal(p.ProblemId)">Add</button>
                        </div>
                    </div>
                    <div>
                        <h3>Interventions</h3>
                        @if (p.Interventions.Count > 0)
                        {
                            <ul class="plain-list">
                                @foreach (var i in p.Interventions.Where(x => x.IsActive))
                                {
                                    <li><span>@i.InterventionText</span> <span class="muted">(@(i.Frequency ?? "PRN"))</span></li>
                                }
                            </ul>
                        }
                        else { <p class="muted">No interventions</p> }

                        <div class="inline-add">
                            <input class="form-input" placeholder="New intervention..." @bind="newInterventionText" />
                            <input class="form-input freq-input" placeholder="Freq" @bind="newFrequency" />
                            <button class="btn btn-primary" @onclick="() => AddIntervention(p.ProblemId)">Add</button>
                        </div>
                    </div>
                </div>

                @if (p.OutcomeEvaluations.Count > 0)
                {
                    <h3>Outcome Evaluations</h3>
                    <table class="data-table">
                        <thead><tr><th>Date</th><th>By</th><th>Rating</th><th>Notes</th></tr></thead>
                        <tbody>
                            @foreach (var o in p.OutcomeEvaluations.OrderByDescending(x => x.EvaluationDateTime))
                            {
                                <tr><td>@o.EvaluationDateTime.ToString("MM/dd HH:mm")</td><td>@o.EvaluatedByName</td><td>@o.OutcomeRating</td><td>@(o.Notes ?? "—")</td></tr>
                            }
                        </tbody>
                    </table>
                }

                @if (p.Status == NursingCarePlanStatus.Active)
                {
                    <div class="form-actions">
                        <button class="btn btn-primary" @onclick="() => Resolve(p.ProblemId)">Resolve Diagnosis</button>
                    </div>
                }
            </div>
        }
    }

    @if (tab == "add")
    {
        <div class="form-section">
            <h3>Add Nursing Diagnosis (NANDA)</h3>
            <FormField Label="Nursing Diagnosis" Required><input class="form-input" @bind="newDiagnosis" placeholder="e.g. Acute Pain" /></FormField>
            <FormField Label="Related To"><input class="form-input" @bind="newRelatedTo" placeholder="Etiology" /></FormField>
            <FormField Label="As Evidenced By"><input class="form-input" @bind="newEvidencedBy" placeholder="Defining characteristics" /></FormField>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="AddDiagnosis" disabled="@adding">@(adding ? "Adding..." : "Add to Care Plan")</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "plan";
    private bool loading, adding;
    private string? error, addResult;
    private NursingCarePlanState? carePlan;
    private string newDiagnosis = string.Empty, newRelatedTo = string.Empty, newEvidencedBy = string.Empty;
    private string newGoalText = string.Empty, newInterventionText = string.Empty, newFrequency = string.Empty;
    private readonly (string, string)[] _tabs = new[] { ("plan", "Care Plan"), ("add", "Add Diagnosis") };

    private async Task LoadCarePlan()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { carePlan = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetNursingCarePlanAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task AddDiagnosis()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newDiagnosis)) return;
        adding = true; error = null; addResult = null;
        try
        {
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .AddNursingDiagnosisAsync(newDiagnosis, newRelatedTo, newEvidencedBy, null, null, null);
            addResult = $"Diagnosis added: {id}";
            newDiagnosis = newRelatedTo = newEvidencedBy = string.Empty;
            await LoadCarePlan();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { adding = false; }
    }

    private async Task AddGoal(string problemId)
    {
        if (string.IsNullOrWhiteSpace(newGoalText)) return;
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).AddCarePlanGoalAsync(problemId, newGoalText, null); newGoalText = string.Empty; await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AddIntervention(string problemId)
    {
        if (string.IsNullOrWhiteSpace(newInterventionText)) return;
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).AddCarePlanInterventionAsync(problemId, newInterventionText, newFrequency, null, null); newInterventionText = newFrequency = string.Empty; await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Resolve(string problemId)
    {
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).ResolveNursingDiagnosisAsync(problemId, "Resolved via UI"); await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }
}

<style>
    /* Canonical clinical classes live in app.css. Page-specific only: */
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .muted { color: #666; font-size: 0.9rem; }
    .status-tag { margin-left: 0.5rem; color: #444; font-size: 0.85rem; }
    .problem-header { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
    .problem-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 0.5rem; }
    .plain-list { list-style: none; padding: 0; margin: 0 0 0.5rem; }
    .plain-list li { display: flex; justify-content: space-between; padding: 0.25rem 0; font-size: 0.9rem; }
    .inline-add { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
    .inline-add .freq-input { max-width: 100px; }
</style>
