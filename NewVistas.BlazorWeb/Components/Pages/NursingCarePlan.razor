@page "/nursing-careplan"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Nursing Care Plan</PageTitle>

<h3>Nursing Care Plan</h3>
<p class="text-muted">NANDA Nursing Diagnoses, Goals, Interventions &amp; Outcomes (VistA File #212)</p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:260px" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadCarePlan" disabled="@loading">Load</button>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == "plan" ? "active" : "")" @onclick='() => tab = "plan"'>Care Plan</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "add" ? "active" : "")" @onclick='() => tab = "add"'>Add Diagnosis</button></li>
</ul>

@if (tab == "plan" && carePlan != null)
{
    @if (carePlan.Problems.Count == 0)
    {
        <p class="text-muted">No nursing diagnoses on care plan. Use the Add Diagnosis tab to start.</p>
    }
    @foreach (var p in carePlan.Problems)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>
                    <strong>@p.NursingDiagnosis</strong>
                    @if (!string.IsNullOrEmpty(p.RelatedTo)) { <span class="text-muted"> R/T @p.RelatedTo</span> }
                    <span class="badge @StatusBadge(p.Status) ms-2">@p.Status</span>
                </span>
                <span class="text-muted small">Priority: @(p.Priority?.ToString() ?? "—") | @p.CreatedDateTime.ToString("MM/dd/yyyy")</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(p.EvidencedBy)) { <p class="small text-muted mb-2"><strong>AEB:</strong> @p.EvidencedBy</p> }

                <div class="row">
                    <div class="col-md-6">
                        <h6>Goals</h6>
                        @if (p.Goals.Count > 0)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var g in p.Goals)
                                {
                                    <li class="list-group-item py-1 d-flex justify-content-between">
                                        <span>@g.GoalText</span>
                                        <span class="badge @GoalBadge(g.Status)">@g.Status</span>
                                    </li>
                                }
                            </ul>
                        }
                        else { <p class="text-muted small">No goals</p> }

                        <div class="mt-2">
                            <div class="input-group input-group-sm">
                                <input class="form-control" placeholder="New goal..." @bind="newGoalText" />
                                <button class="btn btn-outline-success btn-sm" @onclick="() => AddGoal(p.ProblemId)">Add</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>Interventions</h6>
                        @if (p.Interventions.Count > 0)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var i in p.Interventions.Where(x => x.IsActive))
                                {
                                    <li class="list-group-item py-1"><span>@i.InterventionText</span> <span class="text-muted small">(@(i.Frequency ?? "PRN"))</span></li>
                                }
                            </ul>
                        }
                        else { <p class="text-muted small">No interventions</p> }

                        <div class="mt-2">
                            <div class="input-group input-group-sm">
                                <input class="form-control" placeholder="New intervention..." @bind="newInterventionText" />
                                <input class="form-control" style="max-width:100px" placeholder="Freq" @bind="newFrequency" />
                                <button class="btn btn-outline-success btn-sm" @onclick="() => AddIntervention(p.ProblemId)">Add</button>
                            </div>
                        </div>
                    </div>
                </div>

                @if (p.OutcomeEvaluations.Count > 0)
                {
                    <h6 class="mt-3">Outcome Evaluations</h6>
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>By</th><th>Rating</th><th>Notes</th></tr></thead>
                        <tbody>
                            @foreach (var o in p.OutcomeEvaluations.OrderByDescending(x => x.EvaluationDateTime))
                            {
                                <tr><td>@o.EvaluationDateTime.ToString("MM/dd HH:mm")</td><td>@o.EvaluatedByName</td><td><span class="badge @OutcomeBadge(o.OutcomeRating)">@o.OutcomeRating</span></td><td>@(o.Notes ?? "—")</td></tr>
                            }
                        </tbody>
                    </table>
                }

                @if (p.Status == NursingCarePlanStatus.Active)
                {
                    <button class="btn btn-sm btn-outline-danger mt-2" @onclick="() => Resolve(p.ProblemId)">Resolve Diagnosis</button>
                }
            </div>
        </div>
    }
}

@if (tab == "add")
{
    <div class="card">
        <div class="card-header">Add Nursing Diagnosis (NANDA)</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-4"><label class="form-label">Nursing Diagnosis</label><input class="form-control" @bind="newDiagnosis" placeholder="e.g. Acute Pain" /></div>
                <div class="col-md-4"><label class="form-label">Related To</label><input class="form-control" @bind="newRelatedTo" placeholder="Etiology" /></div>
                <div class="col-md-4"><label class="form-label">As Evidenced By</label><input class="form-control" @bind="newEvidencedBy" placeholder="Defining characteristics" /></div>
            </div>
            <button class="btn btn-success" @onclick="AddDiagnosis" disabled="@adding">@(adding ? "Adding..." : "Add to Care Plan")</button>
            @if (addResult != null) { <div class="alert alert-success mt-2">@addResult</div> }
        </div>
    </div>
}

@code {
    private string patientId = string.Empty;
    private string tab = "plan";
    private bool loading, adding;
    private string? error, addResult;
    private NursingCarePlanState? carePlan;
    private string newDiagnosis = string.Empty, newRelatedTo = string.Empty, newEvidencedBy = string.Empty;
    private string newGoalText = string.Empty, newInterventionText = string.Empty, newFrequency = string.Empty;

    private async Task LoadCarePlan()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try { carePlan = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetNursingCarePlanAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task AddDiagnosis()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newDiagnosis)) return;
        adding = true; error = null; addResult = null;
        try
        {
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .AddNursingDiagnosisAsync(newDiagnosis, newRelatedTo, newEvidencedBy, null, null, null);
            addResult = $"Diagnosis added: {id}";
            newDiagnosis = newRelatedTo = newEvidencedBy = string.Empty;
            await LoadCarePlan();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { adding = false; }
    }

    private async Task AddGoal(string problemId)
    {
        if (string.IsNullOrWhiteSpace(newGoalText)) return;
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).AddCarePlanGoalAsync(problemId, newGoalText, null); newGoalText = string.Empty; await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AddIntervention(string problemId)
    {
        if (string.IsNullOrWhiteSpace(newInterventionText)) return;
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).AddCarePlanInterventionAsync(problemId, newInterventionText, newFrequency, null, null); newInterventionText = newFrequency = string.Empty; await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task Resolve(string problemId)
    {
        try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).ResolveNursingDiagnosisAsync(problemId, "Resolved via UI"); await LoadCarePlan(); }
        catch (Exception ex) { error = ex.Message; }
    }

    private string StatusBadge(NursingCarePlanStatus s) => s switch { NursingCarePlanStatus.Active => "bg-success", NursingCarePlanStatus.Resolved => "bg-secondary", NursingCarePlanStatus.OnHold => "bg-warning text-dark", _ => "bg-danger" };
    private string GoalBadge(NursingGoalStatus s) => s switch { NursingGoalStatus.Achieved => "bg-success", NursingGoalStatus.Pending => "bg-info", NursingGoalStatus.PartiallyAchieved => "bg-warning text-dark", _ => "bg-secondary" };
    private string OutcomeBadge(NursingOutcomeRating r) => r switch { NursingOutcomeRating.GoalMet => "bg-success", NursingOutcomeRating.GoalPartiallyMet => "bg-warning text-dark", NursingOutcomeRating.GoalNotMet => "bg-danger", _ => "bg-info" };
}
