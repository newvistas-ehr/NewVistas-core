@page "/pharmacy-pos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<h3>Pharmacy Point of Sale (POS)</h3>

<SafetyConfirm Visible="_safetyPending" Hazard="@_safetyHazard" ConfirmValue="@_safetyConfirmValue"
               RequireCosign="_safetyCosign" OnOverride="OnSafetyOverride" OnCancel="OnSafetyCancel" />

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

@* ── Tab Bar ─────────────────────────────────────────────────────────── *@
<div class="tab-bar">
    <button class="tab @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">POS Claims</button>
    <button class="tab @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Claim Detail</button>
    <button class="tab @(activeTab == 2 ? "active" : "")" @onclick="async () => { activeTab = 2; await LoadInsurers(); }">Insurers</button>
</div>

@* ── Tab 0: POS Claims ──────────────────────────────────────────────── *@
@if (activeTab == 0)
{
    <div class="lookup-bar">
        <input type="text" @bind="patientId" placeholder="Patient ID" class="lookup-input" />
        <button class="btn btn-primary" @onclick="LoadClaims" disabled="@loading">Load</button>
        <button class="btn btn-primary" @onclick="() => showClaimForm = !showClaimForm">New Claim</button>
        <select class="form-input" style="width:160px" @bind="statusFilter" @bind:after="LoadClaims">
            <option value="">All Statuses</option>
            <option value="0">Pending</option>
            <option value="1">Transmitted</option>
            <option value="2">Paid</option>
            <option value="3">Rejected</option>
            <option value="4">Reversed</option>
            <option value="5">DuplicatePaid</option>
            <option value="6">PartialPay</option>
            <option value="7">Cancelled</option>
        </select>
    </div>

    @if (showClaimForm)
    {
        <div class="card mt-3 p-3">
            <h5>Submit POS Claim</h5>
            <div class="row g-2">
                <div class="col-md-3">
                    <label>Transaction Type *</label>
                    <select class="form-input" @bind="newClaim.TransactionType">
                        <option value="0">B1 — Billing</option>
                        <option value="1">B2 — Reversal</option>
                        <option value="2">B3 — Rebill</option>
                        <option value="3">E1 — Eligibility</option>
                        <option value="4">D1 — Downtime</option>
                        <option value="5">P1 — Prior Auth</option>
                    </select>
                </div>
                <div class="col-md-3"><label>BIN *</label><input type="text" class="form-input" @bind="newClaim.Bin" /></div>
                <div class="col-md-3"><label>PCN *</label><input type="text" class="form-input" @bind="newClaim.Pcn" /></div>
                <div class="col-md-3"><label>NCPDP Version *</label><input type="text" class="form-input" @bind="newClaim.NcpdpVersion" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label>Prescription ID</label><input type="text" class="form-input" @bind="newClaim.PrescriptionId" /></div>
                <div class="col-md-3"><label>Group Number</label><input type="text" class="form-input" @bind="newClaim.GroupNumber" /></div>
                <div class="col-md-3"><label>Cardholder ID</label><input type="text" class="form-input" @bind="newClaim.CardholderId" /></div>
                <div class="col-md-3"><label>Relationship Code</label><input type="text" class="form-input" @bind="newClaim.RelationshipCode" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label>Insurer ID</label><input type="text" class="form-input" @bind="newClaim.InsurerId" /></div>
                <div class="col-md-3"><label>Insurer Name</label><input type="text" class="form-input" @bind="newClaim.InsurerName" /></div>
                <div class="col-md-3"><label>NDC</label><input type="text" class="form-input" @bind="newClaim.Ndc" /></div>
                <div class="col-md-3"><label>Drug Name</label><input type="text" class="form-input" @bind="newClaim.DrugName" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-2"><label>Qty Dispensed</label><input type="number" step="0.001" class="form-input" @bind="newClaim.QuantityDispensed" /></div>
                <div class="col-md-2"><label>Days Supply</label><input type="number" class="form-input" @bind="newClaim.DaysSupply" /></div>
                <div class="col-md-2"><label>Date of Service</label><input type="date" class="form-input" @bind="newClaim.DateOfService" /></div>
                <div class="col-md-2"><label>Ingredient Cost</label><input type="number" step="0.01" class="form-input" @bind="newClaim.IngredientCostSubmitted" /></div>
                <div class="col-md-2"><label>Dispensing Fee</label><input type="number" step="0.01" class="form-input" @bind="newClaim.DispensingFeeSubmitted" /></div>
                <div class="col-md-2"><label>U&amp;C</label><input type="number" step="0.01" class="form-input" @bind="newClaim.UsualAndCustomary" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label>Pharmacy NCPDP ID</label><input type="text" class="form-input" @bind="newClaim.PharmacyNcpdpId" /></div>
                <div class="col-md-3"><label>Pharmacist Name</label><input type="text" class="form-input" @bind="newClaim.PharmacistName" /></div>
                <div class="col-md-3"><label>Prescriber NPI</label><input type="text" class="form-input" @bind="newClaim.PrescriberNpi" /></div>
                <div class="col-md-3"><label>Prescriber Name</label><input type="text" class="form-input" @bind="newClaim.PrescriberName" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-4"><label>Original Claim ID (for B2 reversal)</label><input type="text" class="form-input" @bind="newClaim.OriginalClaimId" /></div>
            </div>
            <button class="btn btn-primary" @onclick="SubmitClaim">Submit Claim</button>
        </div>
    }

    @if (loading)
    {
        <div class="spinner-border mt-3" role="status"><span class="visually-hidden">Loading...</span></div>
    }
    else if (claims != null)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Date of Service</th>
                    <th>Drug</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Insurer</th>
                    <th>Ins Paid</th>
                    <th>Patient Resp</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in claims)
                {
                    <tr>
                        <td>@c.DateOfService?.ToString("MM/dd/yyyy")</td>
                        <td>@c.DrugName</td>
                        <td><span class="badge badge-info">@TxTypeName(c.TransactionType)</span></td>
                        <td><span class="badge @StatusBadge(c.Status)">@StatusName(c.Status)</span></td>
                        <td>@c.InsurerName</td>
                        <td>@FormatCurrency(c.InsurancePaidAmount)</td>
                        <td>@FormatCurrency(c.PatientResponsibility)</td>
                        <td>
                            <button class="btn btn-primary" @onclick="() => SelectClaim(c.ClaimId)">View</button>
                            @if (c.Status == 0)
                            {
                                <button class="btn btn-primary" @onclick="() => ShowAdjudicateForm(c.ClaimId)">Adjudicate</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (showAdjudicateForm)
    {
        <div class="card mt-3 p-3">
            <h5>Adjudicate Claim: @adjudicateClaimId</h5>
            <div class="row g-2">
                <div class="col-md-3">
                    <label>Status *</label>
                    <select class="form-input" @bind="adjReq.Status">
                        <option value="2">Paid</option>
                        <option value="3">Rejected</option>
                        <option value="5">DuplicatePaid</option>
                        <option value="6">PartialPay</option>
                    </select>
                </div>
                <div class="col-md-3"><label>Insurance Paid</label><input type="number" step="0.01" class="form-input" @bind="adjReq.InsurancePaidAmount" /></div>
                <div class="col-md-3"><label>Patient Responsibility</label><input type="number" step="0.01" class="form-input" @bind="adjReq.PatientResponsibility" /></div>
                <div class="col-md-3"><label>Authorization #</label><input type="text" class="form-input" @bind="adjReq.AuthorizationNumber" /></div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-3"><label>Copay</label><input type="number" step="0.01" class="form-input" @bind="adjReq.CopayAmount" /></div>
                <div class="col-md-3"><label>Coinsurance</label><input type="number" step="0.01" class="form-input" @bind="adjReq.CoinsuranceAmount" /></div>
                <div class="col-md-3"><label>Deductible</label><input type="number" step="0.01" class="form-input" @bind="adjReq.DeductibleAmount" /></div>
            </div>
            <button class="btn btn-primary" @onclick="AdjudicateClaim">Submit Adjudication</button>
            <button class="btn btn-secondary" @onclick="() => showAdjudicateForm = false">Cancel</button>
        </div>
    }
}

@* ── Tab 1: Claim Detail ────────────────────────────────────────────── *@
@if (activeTab == 1)
{
    <div class="mt-3">
        @if (selectedClaim == null)
        {
            <div class="alert alert-info">Select a claim from the POS Claims tab to view details.</div>
        }
        else
        {
            <h5>Claim @selectedClaim.ClaimId — <span class="badge @StatusBadge((int)selectedClaim.Status)">@selectedClaim.Status</span></h5>

            @* NCPDP Header *@
            <div class="card p-3 mb-3">
                <h6>NCPDP Header</h6>
                <div class="row">
                    <div class="col-md-3"><strong>Transaction Type:</strong> @selectedClaim.TransactionType</div>
                    <div class="col-md-3"><strong>BIN:</strong> @selectedClaim.Bin</div>
                    <div class="col-md-3"><strong>PCN:</strong> @selectedClaim.Pcn</div>
                    <div class="col-md-3"><strong>Version:</strong> @selectedClaim.NcpdpVersion</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Pharmacy NCPDP:</strong> @selectedClaim.PharmacyNcpdpId</div>
                    <div class="col-md-3"><strong>Pharmacist:</strong> @selectedClaim.PharmacistName</div>
                    <div class="col-md-3"><strong>Prescriber NPI:</strong> @selectedClaim.PrescriberNpi</div>
                    <div class="col-md-3"><strong>Prescriber:</strong> @selectedClaim.PrescriberName</div>
                </div>
                @if (!string.IsNullOrEmpty(selectedClaim.OriginalClaimId))
                {
                    <div class="row mt-2">
                        <div class="col-md-6"><strong>Original Claim ID:</strong> @selectedClaim.OriginalClaimId</div>
                    </div>
                }
            </div>

            @* Insurance Segment *@
            <div class="card p-3 mb-3">
                <h6>Insurance</h6>
                <div class="row">
                    <div class="col-md-3"><strong>Insurer:</strong> @selectedClaim.InsurerName</div>
                    <div class="col-md-3"><strong>Group #:</strong> @selectedClaim.GroupNumber</div>
                    <div class="col-md-3"><strong>Cardholder ID:</strong> @selectedClaim.CardholderId</div>
                    <div class="col-md-3"><strong>Relationship:</strong> @selectedClaim.RelationshipCode</div>
                </div>
            </div>

            @* Drug / Prescription Segment *@
            <div class="card p-3 mb-3">
                <h6>Drug / Prescription</h6>
                <div class="row">
                    <div class="col-md-3"><strong>NDC:</strong> @selectedClaim.Ndc</div>
                    <div class="col-md-3"><strong>Drug:</strong> @selectedClaim.DrugName</div>
                    <div class="col-md-3"><strong>Qty Dispensed:</strong> @selectedClaim.QuantityDispensed</div>
                    <div class="col-md-3"><strong>Days Supply:</strong> @selectedClaim.DaysSupply</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Date of Service:</strong> @selectedClaim.DateOfService?.ToString("MM/dd/yyyy")</div>
                    <div class="col-md-3"><strong>Prescription ID:</strong> @selectedClaim.PrescriptionId</div>
                </div>
            </div>

            @* Pricing Segment *@
            <div class="card p-3 mb-3">
                <h6>Pricing</h6>
                <div class="row">
                    <div class="col-md-3"><strong>Ingredient Cost:</strong> @FormatCurrency(selectedClaim.IngredientCostSubmitted)</div>
                    <div class="col-md-3"><strong>Dispensing Fee:</strong> @FormatCurrency(selectedClaim.DispensingFeeSubmitted)</div>
                    <div class="col-md-3"><strong>U&amp;C:</strong> @FormatCurrency(selectedClaim.UsualAndCustomary)</div>
                    <div class="col-md-3"><strong>Gross Due:</strong> @FormatCurrency(selectedClaim.GrossAmountDue)</div>
                </div>
            </div>

            @* Response / Adjudication *@
            <div class="card p-3 mb-3">
                <h6>Response / Adjudication</h6>
                <div class="row">
                    <div class="col-md-3"><strong>Insurance Paid:</strong> @FormatCurrency(selectedClaim.InsurancePaidAmount)</div>
                    <div class="col-md-3"><strong>Patient Resp:</strong> @FormatCurrency(selectedClaim.PatientResponsibility)</div>
                    <div class="col-md-3"><strong>Copay:</strong> @FormatCurrency(selectedClaim.CopayAmount)</div>
                    <div class="col-md-3"><strong>Auth #:</strong> @selectedClaim.AuthorizationNumber</div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-3"><strong>Coinsurance:</strong> @FormatCurrency(selectedClaim.CoinsuranceAmount)</div>
                    <div class="col-md-3"><strong>Deductible:</strong> @FormatCurrency(selectedClaim.DeductibleAmount)</div>
                </div>
            </div>

            @* Rejections *@
            @if (selectedClaim.Rejections != null && selectedClaim.Rejections.Count > 0)
            {
                <div class="card p-3 mb-3">
                    <h6>Rejections</h6>
                    <table class="data-table">
                        <thead>
                            <tr><th>Code</th><th>Description</th><th>Category</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var rej in selectedClaim.Rejections)
                            {
                                <tr>
                                    <td>@rej.Code</td>
                                    <td>@rej.Description</td>
                                    <td>@rej.Category</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @* DUR Messages *@
            @if (selectedClaim.DurMessages != null && selectedClaim.DurMessages.Count > 0)
            {
                <div class="card p-3 mb-3">
                    <h6>DUR Messages</h6>
                    <table class="data-table">
                        <thead>
                            <tr><th>Reason Code</th><th>Level</th><th>Significance</th><th>Conflicting NDC</th><th>Message</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var dur in selectedClaim.DurMessages)
                            {
                                <tr>
                                    <td>@dur.ReasonCode</td>
                                    <td><span class="badge @DurBadge(dur.Level)">@DurLevelName(dur.Level)</span></td>
                                    <td>@dur.ClinicalSignificance</td>
                                    <td>@dur.ConflictingDrugNdc</td>
                                    <td>@dur.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="mt-2 text-muted">
                <small>Created: @selectedClaim.CreatedDate.ToString("MM/dd/yyyy HH:mm") | Last Modified: @selectedClaim.LastModifiedDate.ToString("MM/dd/yyyy HH:mm")</small>
            </div>
        }
    </div>
}

@* ── Tab 2: Insurers ────────────────────────────────────────────────── *@
@if (activeTab == 2)
{
    <div class="mt-3">
        <button class="btn btn-primary" @onclick="() => showInsurerForm = !showInsurerForm">Add / Edit Insurer</button>

        @if (showInsurerForm)
        {
            <div class="card p-3 mb-3">
                <h6>@(string.IsNullOrEmpty(newInsurer.InsurerId) ? "New Insurer" : "Edit Insurer")</h6>
                <div class="row g-2">
                    <div class="col-md-3"><label>Insurer ID *</label><input type="text" class="form-input" @bind="newInsurer.InsurerId" /></div>
                    <div class="col-md-3"><label>Insurer Name *</label><input type="text" class="form-input" @bind="newInsurer.InsurerName" /></div>
                    <div class="col-md-3"><label>BIN *</label><input type="text" class="form-input" @bind="newInsurer.Bin" /></div>
                    <div class="col-md-3"><label>PCN *</label><input type="text" class="form-input" @bind="newInsurer.Pcn" /></div>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-md-3"><label>NCPDP Version</label><input type="text" class="form-input" @bind="newInsurer.NcpdpVersion" /></div>
                    <div class="col-md-3"><label>Pharmacy NCPDP ID</label><input type="text" class="form-input" @bind="newInsurer.PharmacyNcpdpId" /></div>
                    <div class="col-md-3"><label>Svc Provider ID Qualifier</label><input type="text" class="form-input" @bind="newInsurer.ServiceProviderIdQualifier" /></div>
                    <div class="col-md-3"><label>Plan Name</label><input type="text" class="form-input" @bind="newInsurer.PlanName" /></div>
                </div>
                <div class="row g-2 mt-2">
                    <div class="col-md-3"><label>Help Desk Phone</label><input type="text" class="form-input" @bind="newInsurer.HelpDeskPhone" /></div>
                    <div class="col-md-3">
                        <label>Active</label>
                        <select class="form-input" @bind="newInsurer.IsActive">
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                </div>
                <button class="btn btn-primary" @onclick="SaveInsurer">Save Insurer</button>
            </div>
        }

        @if (loadingInsurers)
        {
            <div class="spinner-border mt-3" role="status"><span class="visually-hidden">Loading...</span></div>
        }
        else if (insurers != null)
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Insurer ID</th>
                        <th>Name</th>
                        <th>BIN</th>
                        <th>PCN</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ins in insurers)
                    {
                        <tr>
                            <td>@ins.InsurerId</td>
                            <td>@ins.InsurerName</td>
                            <td>@ins.Bin</td>
                            <td>@ins.Pcn</td>
                            <td>
                                @if (ins.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-neutral">Inactive</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-primary" @onclick="() => EditInsurer(ins)">Edit</button>
                                @if (ins.IsActive)
                                {
                                    <button class="btn btn-primary" @onclick="() => DeactivateInsurer(ins.InsurerId)">Deactivate</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<style>
    /* Canonical interaction classes (lookup-bar, lookup-input, tab-bar, tab, btn,
       btn-primary, btn-secondary, alert, alert-error, data-table, form-input, badge,
       badge-*, empty-state) are defined once in app.css per UI-CONVENTIONS.md.
       No page-specific styles are needed here. */
</style>

@code {
    private string patientId = "";
    private string? error;
    private bool loading;
    private bool loadingInsurers;
    private int activeTab;
    private bool showClaimForm;
    private bool showAdjudicateForm;
    private bool showInsurerForm;
    private string statusFilter = "";

    private List<ClaimIndexDto>? claims;
    private ClaimDetailDto? selectedClaim;
    private string adjudicateClaimId = "";
    private AdjudicateForm adjReq = new();

    private List<InsurerIndexDto>? insurers;

    private NewClaimForm newClaim = new();
    private InsurerForm newInsurer = new();

    private IPatientWorkflowGrain GetWorkflow() =>
        Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());

    private IPharmacyPosInsurerIndexGrain GetInsurerIndex() =>
        Grains.GetGrain<IPharmacyPosInsurerIndexGrain>("POS-INSURER-IDX");

    private IPharmacyPosInsurerGrain GetInsurerGrain(string insurerId) =>
        Grains.GetGrain<IPharmacyPosInsurerGrain>($"POS-INSURER:{insurerId}");

    private static string Esc(string id) => Uri.EscapeDataString(id.Trim());

    private static string FormatCurrency(decimal? value) =>
        value.HasValue ? value.Value.ToString("C2") : "";

    private static string TxTypeName(int txType) => txType switch
    {
        0 => "B1",
        1 => "B2",
        2 => "B3",
        3 => "E1",
        4 => "D1",
        5 => "P1",
        _ => "?"
    };

    private static string StatusName(int status) => status switch
    {
        0 => "Pending",
        1 => "Transmitted",
        2 => "Paid",
        3 => "Rejected",
        4 => "Reversed",
        5 => "DuplicatePaid",
        6 => "PartialPay",
        7 => "Cancelled",
        _ => "Unknown"
    };

    private static string StatusBadge(int status) => status switch
    {
        0 => "badge-warning",
        1 => "badge-info",
        2 => "badge-success",
        3 => "badge-danger",
        4 => "badge-neutral",
        5 => "badge-success",
        6 => "badge-warning",
        7 => "badge-neutral",
        _ => "badge-neutral"
    };

    private static string DurBadge(int level) => level switch
    {
        0 => "badge-info",
        1 => "badge-warning",
        2 => "badge-danger",
        _ => "badge-neutral"
    };

    private static string DurLevelName(int level) => level switch
    {
        0 => "Info",
        1 => "Warning",
        2 => "Critical",
        _ => "Unknown"
    };

    private async Task LoadClaims()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        error = null;
        loading = true;
        try
        {
            List<PosClaimIndexEntry> entries;
            if (!string.IsNullOrEmpty(statusFilter) && int.TryParse(statusFilter, out int s))
                entries = await GetWorkflow().GetPosClaimsByStatusAsync((PosClaimStatus)s);
            else
                entries = await GetWorkflow().GetPosClaimsAsync();
            claims = entries.Select(e => new ClaimIndexDto
            {
                ClaimId = e.ClaimId, PatientId = e.PatientId, TransactionType = (int)e.TransactionType,
                Status = (int)e.Status, DrugName = e.DrugName, DateOfService = e.DateOfService,
                InsurancePaidAmount = e.InsurancePaidAmount, PatientResponsibility = e.PatientResponsibility,
                InsurerName = e.InsurerName
            }).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task SelectClaim(string claimId)
    {
        if (string.IsNullOrWhiteSpace(claimId)) return;
        error = null;
        try
        {
            PharmacyPosClaimState state = await GetWorkflow().GetPosClaimAsync(claimId);
            selectedClaim = new ClaimDetailDto
            {
                ClaimId = state.ClaimId, PatientId = state.PatientId, PrescriptionId = state.PrescriptionId,
                TransactionType = (int)state.TransactionType, Status = (int)state.Status,
                Bin = state.Bin, Pcn = state.Pcn, NcpdpVersion = state.NcpdpVersion,
                GroupNumber = state.GroupNumber, CardholderId = state.CardholderId,
                RelationshipCode = state.RelationshipCode, InsurerId = state.InsurerId,
                InsurerName = state.InsurerName, Ndc = state.Ndc, DrugName = state.DrugName,
                QuantityDispensed = state.QuantityDispensed, DaysSupply = state.DaysSupply,
                DateOfService = state.DateOfService, IngredientCostSubmitted = state.IngredientCostSubmitted,
                DispensingFeeSubmitted = state.DispensingFeeSubmitted, UsualAndCustomary = state.UsualAndCustomary,
                GrossAmountDue = state.GrossAmountDue, InsurancePaidAmount = state.InsurancePaidAmount,
                PatientResponsibility = state.PatientResponsibility, CopayAmount = state.CopayAmount,
                CoinsuranceAmount = state.CoinsuranceAmount, DeductibleAmount = state.DeductibleAmount,
                AuthorizationNumber = state.AuthorizationNumber,
                PharmacyNcpdpId = state.PharmacyNcpdpId, PharmacistName = state.PharmacistName,
                PrescriberNpi = state.PrescriberNpi, PrescriberName = state.PrescriberName,
                OriginalClaimId = state.OriginalClaimId,
                CreatedDate = state.CreatedDate, LastModifiedDate = state.LastModifiedDate,
                Rejections = state.Rejections.Select(r => new RejectionDto { Code = r.Code, Description = r.Description, Category = r.Category }).ToList(),
                DurMessages = state.DurMessages.Select(d => new DurMessageDto { ReasonCode = d.ReasonCode, ClinicalSignificance = d.ClinicalSignificance, ConflictingDrugNdc = d.ConflictingDrugNdc, Level = (int)d.Level, Message = d.Message }).ToList()
            };
            activeTab = 1;
        }
        catch (Exception ex) { error = ex.Message; }
    }

