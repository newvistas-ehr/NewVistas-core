    // Patient-safety Tier-2 confirmation gate state (UI-CONVENTIONS.md §8).
    private bool _safetyPending;
    private string _safetyHazard = string.Empty;
    private string _safetyConfirmValue = string.Empty;
    private bool _safetyCosign;

    private async Task SubmitClaim()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        // Patient-safety Tier-2 gate (UI-CONVENTIONS.md §8): dispensing an implausibly high daily
        // quantity must defeat muscle-memory before the claim is submitted.
        var risk = AssessDispenseSafety();
        if (risk.Dangerous)
        {
            _safetyHazard = risk.Hazard;
            _safetyConfirmValue = string.IsNullOrWhiteSpace(newClaim.DrugName) ? "CONFIRM" : newClaim.DrugName!.Trim();
            _safetyCosign = risk.Lethal;
            _safetyPending = true;
            return;
        }
        await DoSubmitClaim();
    }

    /// <summary>Daily-quantity risk check for the dispense about to be claimed. No DEA schedule is
    /// captured at POS, so this uses generic doses/day thresholds.</summary>
    private (bool Dangerous, string Hazard, bool Lethal) AssessDispenseSafety()
    {
        decimal qty = newClaim.QuantityDispensed ?? 0m;
        int days = newClaim.DaysSupply is int d && d > 0 ? d : 1;
        if (qty <= 0) return (false, string.Empty, false);
        decimal perDay = qty / days;
        const decimal warnAt = 20m, lethalAt = 40m;
        if (perDay >= lethalAt)
            return (true, $"{Disp(newClaim.DrugName)} — {qty:0.##} dispensed over {days} day(s) = {perDay:0.#}/day. This is an implausibly high daily quantity and is in the LETHAL range.", true);
        if (perDay > warnAt)
            return (true, $"{Disp(newClaim.DrugName)} — {qty:0.##} dispensed over {days} day(s) = {perDay:0.#}/day, far above a normal daily quantity. Confirm this is intentional.", false);
        return (false, string.Empty, false);
    }

    private static string Disp(string? s) => string.IsNullOrWhiteSpace(s) ? "(unspecified)" : s;

    private async Task OnSafetyOverride(string reason)
    {
        _safetyPending = false;
        await DoSubmitClaim();
    }

    private void OnSafetyCancel() => _safetyPending = false;

    private async Task DoSubmitClaim()
    {
        error = null;
        try
        {
            await GetWorkflow().SubmitPosClaimAsync(
                string.IsNullOrEmpty(newClaim.PrescriptionId) ? null : newClaim.PrescriptionId,
                (NcpdpTransactionType)newClaim.TransactionType,
                newClaim.Bin, newClaim.Pcn, newClaim.NcpdpVersion,
                string.IsNullOrEmpty(newClaim.GroupNumber) ? null : newClaim.GroupNumber,
                string.IsNullOrEmpty(newClaim.CardholderId) ? null : newClaim.CardholderId,
                string.IsNullOrEmpty(newClaim.RelationshipCode) ? null : newClaim.RelationshipCode,
                string.IsNullOrEmpty(newClaim.InsurerId) ? null : newClaim.InsurerId,
                string.IsNullOrEmpty(newClaim.InsurerName) ? null : newClaim.InsurerName,
                string.IsNullOrEmpty(newClaim.Ndc) ? null : newClaim.Ndc,
                string.IsNullOrEmpty(newClaim.DrugName) ? null : newClaim.DrugName,
                newClaim.QuantityDispensed, newClaim.DaysSupply, newClaim.DateOfService,
                newClaim.IngredientCostSubmitted, newClaim.DispensingFeeSubmitted, newClaim.UsualAndCustomary,
                string.IsNullOrEmpty(newClaim.PharmacyNcpdpId) ? null : newClaim.PharmacyNcpdpId,
                string.IsNullOrEmpty(newClaim.PharmacistName) ? null : newClaim.PharmacistName,
                string.IsNullOrEmpty(newClaim.PrescriberNpi) ? null : newClaim.PrescriberNpi,
                string.IsNullOrEmpty(newClaim.PrescriberName) ? null : newClaim.PrescriberName,
                string.IsNullOrEmpty(newClaim.OriginalClaimId) ? null : newClaim.OriginalClaimId);
            showClaimForm = false;
            newClaim = new();
            await LoadClaims();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task AdjudicateClaim()
    {
        if (string.IsNullOrWhiteSpace(adjudicateClaimId)) return;
        error = null;
        try
        {
            await GetWorkflow().AdjudicatePosClaimAsync(
                adjudicateClaimId, (PosClaimStatus)adjReq.Status,
                adjReq.InsurancePaidAmount, adjReq.PatientResponsibility,
                adjReq.CopayAmount, adjReq.CoinsuranceAmount, adjReq.DeductibleAmount,
                string.IsNullOrEmpty(adjReq.AuthorizationNumber) ? null : adjReq.AuthorizationNumber,
                null, null);
            showAdjudicateForm = false;
            adjReq = new();
            await LoadClaims();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadInsurers()
    {
        error = null;
        loadingInsurers = true;
        try
        {
            List<PosInsurerIndexEntry> entries = await GetInsurerIndex().GetAllAsync();
            insurers = entries.Select(e => new InsurerIndexDto
            {
                InsurerId = e.InsurerId, InsurerName = e.InsurerName,
                Bin = e.Bin, Pcn = e.Pcn, IsActive = e.IsActive
            }).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingInsurers = false; }
    }

    private void EditInsurer(InsurerIndexDto ins)
    {
        newInsurer = new InsurerForm
        {
            InsurerId = ins.InsurerId,
            InsurerName = ins.InsurerName,
            Bin = ins.Bin,
            Pcn = ins.Pcn,
            IsActive = ins.IsActive,
        };
        showInsurerForm = true;
    }

    private async Task SaveInsurer()
    {
        error = null;
        try
        {
            var grain = GetInsurerGrain(newInsurer.InsurerId);
            await grain.SaveAsync(
                newInsurer.InsurerName, newInsurer.Bin, newInsurer.Pcn,
                string.IsNullOrEmpty(newInsurer.NcpdpVersion) ? "D0" : newInsurer.NcpdpVersion,
                string.IsNullOrEmpty(newInsurer.PharmacyNcpdpId) ? null : newInsurer.PharmacyNcpdpId,
                string.IsNullOrEmpty(newInsurer.ServiceProviderIdQualifier) ? null : newInsurer.ServiceProviderIdQualifier,
                string.IsNullOrEmpty(newInsurer.PlanName) ? null : newInsurer.PlanName,
                string.IsNullOrEmpty(newInsurer.HelpDeskPhone) ? null : newInsurer.HelpDeskPhone,
                newInsurer.IsActive);
            showInsurerForm = false;
            newInsurer = new();
            await LoadInsurers();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DeactivateInsurer(string insurerId)
    {
        error = null;
        try
        {
            await GetInsurerGrain(insurerId).DeactivateAsync();
            await LoadInsurers();
        }
        catch (Exception ex) { error = ex.Message; }
    }

