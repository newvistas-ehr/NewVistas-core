@page "/pt/referrals"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.PT.GrainInterfaces
@using NewVistas.PT.GrainStates
@using NewVistas.PT.Models
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext
@inject NavigationManager Nav

<PageTitle>PT Referrals</PageTitle>

<div class="page-header">
    <button class="btn btn-back" @onclick='() => Nav.NavigateTo($"/pt?patientId={Uri.EscapeDataString(patientId ?? "")}")'>Back to PT Hub</button>
    <h1>PT Referrals</h1>
</div>

<div class="lookup-bar">
    <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleKeyDown"
           placeholder="Patient ID" class="lookup-input" />
    <button @onclick="Load" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)" class="btn btn-primary">
        @if (loading) { <span>Loading...</span> } else { <span>Load</span> }
    </button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (successMessage != null) { <div class="alert alert-success">@successMessage</div> }

@if (loaded)
{
    <div class="tab-bar">
        <button class="tab @(activeTab == "list" ? "active" : "")" @onclick="LoadReferrals">Referrals</button>
        <button class="tab @(activeTab == "add" ? "active" : "")" @onclick='() => activeTab = "add"'>New Referral</button>
    </div>

    @if (activeTab == "list")
    {
        @if (referrals != null && referrals.Count > 0)
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Referring Provider</th>
                        <th>Facility</th>
                        <th>Diagnosis</th>
                        <th>Body Groups</th>
                        <th>Visits</th>
                        <th>Referral Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in referrals)
                    {
                        <tr class="@(r.Status != PTReferralStatus.Active ? "inactive-row" : "")">
                            <td><span class="status-badge @GetStatusClass(r.Status)">@r.Status</span></td>
                            <td>@(r.ReferringProviderName ?? "Unknown")</td>
                            <td>@(r.ReferringFacilityName ?? "—")</td>
                            <td>
                                <div>@(r.Diagnosis ?? "—")</div>
                                @if (r.DiagnosisCode != null) { <div class="code-label">@r.DiagnosisCode</div> }
                            </td>
                            <td>@(r.BodyGroups.Count > 0 ? string.Join(", ", r.BodyGroups) : "—")</td>
                            <td>
                                <span class="visit-count @GetVisitClass(r.UsedVisits, r.AuthorizedVisits)">
                                    @r.UsedVisits / @(r.AuthorizedVisits == 0 ? "Unlimited" : r.AuthorizedVisits.ToString())
                                </span>
                            </td>
                            <td class="date">@r.ReferralDate.ToString("MM/dd/yyyy")</td>
                            <td>
                                @if (r.Status == PTReferralStatus.Active)
                                {
                                    <button class="btn btn-sm" @onclick="() => CompleteReferral(r.ReferralId)">Complete</button>
                                    <button class="btn btn-sm btn-cancel" @onclick="() => CancelReferral(r.ReferralId)">Cancel</button>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(r.ReasonForReferral))
                        {
                            <tr class="detail-row">
                                <td colspan="8">
                                    <strong>Reason:</strong> @r.ReasonForReferral
                                    @if (!string.IsNullOrWhiteSpace(r.Precautions))
                                    {
                                        <span class="precautions"> | <strong>Precautions:</strong> @r.Precautions</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                                    {
                                        <span> | <strong>Notes:</strong> @r.Notes</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">No referrals found for this patient.</div>
        }
    }

    @if (activeTab == "add")
    {
        <div class="form-section">
            <h3 class="form-subhead">Referring Provider</h3>
            <div class="form-row">
                <label>Provider Name</label>
                <input type="text" @bind="refProviderName" placeholder="e.g., Dr. Smith" class="form-input" />
            </div>
            <div class="form-row">
                <label>Provider ID (NPI)</label>
                <input type="text" @bind="refProviderId" placeholder="NPI number" class="form-input" />
            </div>
            <div class="form-row">
                <label>Specialty</label>
                <input type="text" @bind="refSpecialty" placeholder="e.g., Orthopedics" class="form-input" />
            </div>
            <div class="form-row">
                <label>Facility</label>
                <input type="text" @bind="refFacility" placeholder="Practice/facility name" class="form-input" />
            </div>

            <h3 class="form-subhead">Clinical Information</h3>
            <div class="form-row">
                <label>Diagnosis</label>
                <input type="text" @bind="refDiagnosis" placeholder="e.g., L shoulder rotator cuff tendinopathy" class="form-input" />
            </div>
            <div class="form-row">
                <label>ICD-10 Code</label>
                <input type="text" @bind="refDiagnosisCode" placeholder="e.g., M75.110" class="form-input" />
            </div>
            <div class="form-row">
                <label>Body Groups</label>
                <select @bind="selectedBodyGroup" class="form-input" style="flex: 0.5;">
                    @foreach (var bg in allBodyGroups)
                    {
                        <option value="@bg">@bg</option>
                    }
                </select>
                <button class="btn btn-sm" @onclick="AddBodyGroup">Add</button>
            </div>
            @if (refBodyGroups.Count > 0)
            {
                <div class="form-row">
                    <label></label>
                    <div class="tag-list">
                        @foreach (var bg in refBodyGroups)
                        {
                            <span class="tag">@bg <button class="tag-remove" @onclick="() => refBodyGroups.Remove(bg)">x</button></span>
                        }
                    </div>
                </div>
            }
            <div class="form-row">
                <label>Reason for Referral</label>
                <textarea @bind="refReason" placeholder="What the provider wants addressed..." class="form-input" rows="3"></textarea>
            </div>
            <div class="form-row">
                <label>Precautions</label>
                <input type="text" @bind="refPrecautions" placeholder="e.g., no overhead > 90 deg" class="form-input" />
            </div>

            <h3 class="form-subhead">Visit Authorization</h3>
            <div class="form-row">
                <label>Authorized Visits</label>
                <input type="number" @bind="refAuthorizedVisits" min="0" class="form-input" style="width: 100px;" />
                <span class="help-text">(0 = unlimited)</span>
            </div>
            <div class="form-row">
                <label>Expiration Date</label>
                <input type="date" @bind="refExpirationDate" class="form-input" />
            </div>

            <h3 class="form-subhead">Dates & Notes</h3>
            <div class="form-row">
                <label>Referral Date</label>
                <input type="date" @bind="refDate" class="form-input" />
            </div>
            <div class="form-row">
                <label>Received Date</label>
                <input type="date" @bind="refReceivedDate" class="form-input" />
            </div>
            <div class="form-row">
                <label>Notes</label>
                <textarea @bind="refNotes" placeholder="Additional notes..." class="form-input" rows="2"></textarea>
            </div>

            <div class="form-actions">
                <button @onclick="SubmitReferral" disabled="@submitting" class="btn btn-primary">
                    @(submitting ? "Saving..." : "Create Referral")
                </button>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private bool loading, loaded, submitting;
    private string? error, successMessage;
    private string activeTab = "list";
    private List<PTReferralState>? referrals;
    private List<BodyGroup> allBodyGroups = BodyGroupDefinitions.GetAllBodyGroups().ToList();

    // Form state
    private string? refProviderName, refProviderId, refSpecialty, refFacility;
    private string? refDiagnosis, refDiagnosisCode, refReason, refPrecautions, refNotes;
    private int refAuthorizedVisits = 12;
    private DateTime? refExpirationDate;
    private DateTime refDate = DateTime.Today;
    private DateTime? refReceivedDate = DateTime.Today;
    private BodyGroup selectedBodyGroup = BodyGroup.LumbarSpine;
    private List<BodyGroup> refBodyGroups = new();

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(patientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
            patientId = PatientContext.PatientId;
        if (!string.IsNullOrWhiteSpace(patientId))
            await Load();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null;
        try
        {
            PatientContext.SetPatient(patientId.Trim());
            await LoadReferrals();
            loaded = true;
        }
        catch (Exception ex) { error = $"Error loading referrals: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task LoadReferrals()
    {
        activeTab = "list";
        if (string.IsNullOrWhiteSpace(patientId)) return;
        try
        {
            var grain = Grains.GetGrain<IPTWorkflowGrain>(patientId.Trim());
            referrals = await grain.GetAllReferralsAsync();
        }
        catch (Exception ex) { error = $"Error: {ex.Message}"; }
    }

    private void AddBodyGroup()
    {
        if (!refBodyGroups.Contains(selectedBodyGroup))
            refBodyGroups.Add(selectedBodyGroup);
    }

    private async Task SubmitReferral()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        submitting = true; error = null; successMessage = null;
        try
        {
            var grain = Grains.GetGrain<IPTWorkflowGrain>(patientId.Trim());
            await grain.CreateReferralAsync(
                patientName: "",
                referringProviderName: refProviderName,
                referringProviderId: refProviderId,
                referringProviderSpecialty: refSpecialty,
                referringFacilityName: refFacility,
                diagnosis: refDiagnosis,
                diagnosisCode: refDiagnosisCode,
                bodyGroups: refBodyGroups.Count > 0 ? refBodyGroups : null,
                reasonForReferral: refReason,
                precautions: refPrecautions,
                authorizedVisits: refAuthorizedVisits,
                authorizationExpirationDate: refExpirationDate,
                referralDate: refDate,
                receivedDate: refReceivedDate,
                notes: refNotes);

            successMessage = "Referral created successfully.";
            ResetForm();
            await LoadReferrals();
        }
        catch (Exception ex) { error = $"Error creating referral: {ex.Message}"; }
        finally { submitting = false; }
    }

    private async Task CompleteReferral(string referralId)
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        try
        {
            var grain = Grains.GetGrain<IPTWorkflowGrain>(patientId.Trim());
            await grain.UpdateReferralStatusAsync(referralId, PTReferralStatus.Completed, null);
            successMessage = "Referral marked as completed.";
            await LoadReferrals();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CancelReferral(string referralId)
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        try
        {
            var grain = Grains.GetGrain<IPTWorkflowGrain>(patientId.Trim());
            await grain.UpdateReferralStatusAsync(referralId, PTReferralStatus.Cancelled, null);
            successMessage = "Referral cancelled.";
            await LoadReferrals();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void ResetForm()
    {
        refProviderName = refProviderId = refSpecialty = refFacility = null;
        refDiagnosis = refDiagnosisCode = refReason = refPrecautions = refNotes = null;
        refAuthorizedVisits = 12;
        refExpirationDate = null;
        refDate = DateTime.Today;
        refReceivedDate = DateTime.Today;
        refBodyGroups = new();
    }

    private static string GetStatusClass(PTReferralStatus status) => status switch
    {
        PTReferralStatus.Active => "status-active",
        PTReferralStatus.Completed => "status-completed",
        PTReferralStatus.Expired => "status-expired",
        PTReferralStatus.Cancelled => "status-cancelled",
        _ => ""
    };

    private static string GetVisitClass(int used, int authorized) =>
        authorized == 0 ? "visit-ok"
        : used >= authorized ? "visit-over"
        : used >= (int)(authorized * 0.75) ? "visit-warn"
        : "visit-ok";
}

<style>
    .page-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .page-header h1 { margin: 0; }
    .btn-back { background: none; border: 1px solid #ccc; border-radius: 4px; padding: 0.3rem 0.75rem; cursor: pointer; font-size: 0.8rem; color: #003f72; }
    .btn-back:hover { background: #f4f6f9; }

    .lookup-bar { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .lookup-input { width: 280px; padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
    .btn { padding: 0.5rem 1.25rem; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; }
    .btn-sm { padding: 0.25rem 0.75rem; font-size: 0.75rem; background: #003f72; color: white; border: none; border-radius: 3px; cursor: pointer; }
    .btn-cancel { background: #b91c1c; color: white; }
    .btn-primary { background: #003f72; color: white; }
    .btn-primary:disabled { background: #999; cursor: not-allowed; }
    .alert-error { background: #fde8e8; color: #b91c1c; border: 1px solid #f5c6c6; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .empty-state { color: #999; font-style: italic; padding: 2rem 0; }

    .tab-bar { display: flex; gap: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #d4d9e0; }
    .tab { padding: 0.5rem 1.25rem; border: none; background: none; cursor: pointer; font-size: 0.85rem; color: #555; border-bottom: 2px solid transparent; margin-bottom: -2px; }
    .tab.active { color: #003f72; border-bottom-color: #003f72; font-weight: 600; }

    .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; border: 1px solid #d4d9e0; margin-bottom: 1rem; }
    .data-table thead { background: #f4f6f9; }
    .data-table th { text-align: left; padding: 0.5rem; font-weight: 600; color: #003f72; border-bottom: 2px solid #d4d9e0; font-size: 0.75rem; text-transform: uppercase; }
    .data-table td { padding: 0.35rem 0.5rem; border-bottom: 1px solid #f0f0f0; }
    .data-table tr:hover { background: #f9fafb; }
    .inactive-row { opacity: 0.6; }
    .detail-row td { font-size: 0.8rem; color: #555; background: #fafbfc; padding: 0.4rem 0.75rem; }
    .date { color: #888; font-size: 0.8rem; white-space: nowrap; }
    .code-label { font-size: 0.7rem; color: #888; }
    .precautions { color: #b91c1c; }

    .status-badge { font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 10px; font-weight: 600; }
    .status-active { background: #dcfce7; color: #166534; }
    .status-completed { background: #e0f2fe; color: #075985; }
    .status-expired { background: #fef3c7; color: #92400e; }
    .status-cancelled { background: #fde8e8; color: #b91c1c; }

    .visit-count { font-size: 0.8rem; font-weight: 600; padding: 0.15rem 0.5rem; border-radius: 10px; }
    .visit-ok { background: #dcfce7; color: #166534; }
    .visit-warn { background: #fef3c7; color: #92400e; }
    .visit-over { background: #fde8e8; color: #b91c1c; }

    .form-section { max-width: 700px; }
    .form-subhead { font-size: 0.85rem; font-weight: 600; color: #003f72; margin: 1.25rem 0 0.75rem; border-top: 1px solid #e5e7eb; padding-top: 1rem; }
    .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row label { width: 140px; font-size: 0.85rem; font-weight: 500; color: #333; flex-shrink: 0; }
    .form-input { flex: 1; padding: 0.4rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem; }
    .form-actions { margin-top: 1.25rem; }
    .help-text { font-size: 0.75rem; color: #888; }

    .tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; }
    .tag { display: inline-flex; align-items: center; gap: 0.3rem; background: #e0f2fe; color: #075985; padding: 0.2rem 0.6rem; border-radius: 10px; font-size: 0.75rem; }
    .tag-remove { background: none; border: none; cursor: pointer; color: #075985; font-weight: bold; font-size: 0.8rem; padding: 0; }
</style>
