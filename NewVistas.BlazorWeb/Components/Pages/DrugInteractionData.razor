@page "/drug-interactions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Drug Interaction Dataset</PageTitle>

<h2>Drug Interaction Dataset Management</h2>
<p class="subtitle">VistA Files #56-1 through #56-6 — drug-drug interaction checking</p>

<div class="tab-bar">
    <button class="@TabClass("status")" @onclick='() => SetTab("status")'>Dataset Status</button>
    <button class="@TabClass("browse")" @onclick='() => SetTab("browse")'>Browse Interactions</button>
    <button class="@TabClass("check")" @onclick='() => SetTab("check")'>Check Interactions</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="error">@error</div>
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="success">@successMsg</div>
}

@* ── Tab 1: Dataset Status ──────────────────────────────────── *@
@if (activeTab == "status")
{
    <div class="toolbar">
        <button @onclick="LoadStatus" disabled="@loading">Refresh Status</button>
        <button @onclick="LoadDemo" disabled="@loading" class="btn-demo">Load Demo Dataset</button>
        <button @onclick="ClearDataset" disabled="@loading" class="btn-danger">Clear Dataset</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading...</p> }

    @if (status is not null)
    {
        <div class="detail-panel">
            <h3>Dataset Status</h3>
            <div class="status-grid">
                <div class="status-card @(status.IsLoaded ? "status-loaded" : "status-empty")">
                    <div class="status-label">Dataset</div>
                    <div class="status-value">@(status.IsLoaded ? "LOADED" : "EMPTY")</div>
                </div>
                <div class="status-card @(status.IsCachePopulated ? "status-loaded" : "status-empty")">
                    <div class="status-label">Cache</div>
                    <div class="status-value">@(status.IsCachePopulated ? "READY" : "NOT READY")</div>
                </div>
                <div class="status-card">
                    <div class="status-label">Total Pairs</div>
                    <div class="status-value">@status.TotalPairs</div>
                </div>
                <div class="status-card">
                    <div class="status-label">Last Loaded</div>
                    <div class="status-value">@(status.LastLoadedDate?.ToLocalTime().ToString("MM/dd/yyyy HH:mm") ?? "Never")</div>
                </div>
            </div>
        </div>
    }

    @if (cacheReady is not null)
    {
        <p class="cache-info">Silo cache ready: <strong>@(cacheReady.Value ? "Yes" : "No")</strong></p>
    }
}

@* ── Tab 2: Browse Interactions ──────────────────────────────────── *@
@if (activeTab == "browse")
{
    <div class="toolbar">
        <button @onclick="LoadAllPairs" disabled="@loading">Load All Pairs</button>
    </div>

    <div class="toolbar">
        <input @bind="lookupIen1" placeholder="Ingredient IEN 1" class="input-id" />
        <input @bind="lookupIen2" placeholder="Ingredient IEN 2" class="input-id" />
        <button @onclick="LookupPair" disabled="@loading">Lookup Pair</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading...</p> }

    @if (lookupResult is not null)
    {
        <div class="detail-panel">
            <h4>Interaction: @lookupResult.IngredientName1 + @lookupResult.IngredientName2</h4>
            <div class="interaction-detail">
                <div class="info-item">
                    <span class="label">Severity:</span>
                    <span class="badge @SeverityBadge(lookupResult.Severity)">@lookupResult.Severity</span>
                </div>
                <div class="info-item"><span class="label">Description:</span> @lookupResult.Description</div>
                @if (lookupResult.ClinicalEffects is not null)
                {
                    <div class="info-item"><span class="label">Clinical Effects:</span> @lookupResult.ClinicalEffects</div>
                }
                @if (lookupResult.Mechanism is not null)
                {
                    <div class="info-item"><span class="label">Mechanism:</span> @lookupResult.Mechanism</div>
                }
                @if (lookupResult.Management is not null)
                {
                    <div class="info-item"><span class="label">Management:</span> @lookupResult.Management</div>
                }
            </div>
        </div>
    }

    @if (allPairs is not null)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Ingredient 1</th>
                    <th>Ingredient 2</th>
                    <th>Severity</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DrugInteractionPair pair in allPairs)
                {
                    <tr @onclick="() => SelectPair(pair)">
                        <td>@pair.IngredientName1 <span class="ien">(@pair.IngredientIen1)</span></td>
                        <td>@pair.IngredientName2 <span class="ien">(@pair.IngredientIen2)</span></td>
                        <td><span class="badge @SeverityBadge(pair.Severity)">@pair.Severity</span></td>
                        <td class="desc-cell">@pair.Description</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="count-label">@allPairs.Count interaction pair(s)</p>
    }
}

@* ── Tab 3: Check Interactions ──────────────────────────────────── *@
@if (activeTab == "check")
{
    <div class="form-panel">
        <h3>Check Drug-Drug Interactions</h3>
        <p class="hint">Enter ingredient IENs and names (one per line) to check all pairwise interactions.</p>

        @for (int i = 0; i < checkIngredients.Count; i++)
        {
            int idx = i;
            <div class="ingredient-row">
                <input @bind="checkIngredients[idx].IngredientIen" placeholder="IEN (e.g. 1836)" />
                <input @bind="checkIngredients[idx].Name" placeholder="Name (e.g. WARFARIN SODIUM)" />
                <button class="btn-sm btn-remove" @onclick="() => RemoveIngredient(idx)">X</button>
            </div>
        }
        <div class="ingredient-actions">
            <button @onclick="AddIngredient">+ Add Ingredient</button>
            <button @onclick="RunCheck" disabled="@(loading || checkIngredients.Count < 2)">Check Interactions</button>
        </div>
    </div>

    @if (loading) { <p class="loading-msg">Checking...</p> }

    @if (checkResults is not null)
    {
        @if (checkResults.Count == 0)
        {
            <div class="result-panel result-ok">
                <strong>No interactions detected.</strong>
            </div>
        }
        else
        {
            <div class="result-panel result-alert">
                <strong>@checkResults.Count interaction(s) found:</strong>
            </div>

            @foreach (DrugInteractionResult result in checkResults)
            {
                <div class="detail-panel interaction-card">
                    <div class="interaction-header">
                        <span class="badge @SeverityBadge(result.Interaction.Severity)">@result.Interaction.Severity</span>
                        <strong>@result.Drug1.Name</strong> + <strong>@result.Drug2.Name</strong>
                    </div>
                    <div class="info-item"><span class="label">Description:</span> @result.Interaction.Description</div>
                    @if (result.Interaction.Management is not null)
                    {
                        <div class="info-item"><span class="label">Management:</span> @result.Interaction.Management</div>
                    }
                </div>
            }
        }
    }
}

@code {
    string activeTab = "status";
    bool loading;
    string? error;
    string? successMsg;

    // Status
    DrugInteractionStatus? status;
    bool? cacheReady;

    // Browse
    List<DrugInteractionPair>? allPairs;
    string lookupIen1 = string.Empty;
    string lookupIen2 = string.Empty;
    DrugInteractionPair? lookupResult;

    // Check
    List<DrugIngredient> checkIngredients = new()
    {
        new DrugIngredient { IngredientIen = string.Empty, Name = string.Empty },
        new DrugIngredient { IngredientIen = string.Empty, Name = string.Empty }
    };
    List<DrugInteractionResult>? checkResults;

    string TabClass(string tab) => activeTab == tab ? "tab active" : "tab";

    void SetTab(string tab) { activeTab = tab; error = null; successMsg = null; }

    private IDrugInteractionDatasetGrain GetDataset() =>
        Grains.GetGrain<IDrugInteractionDatasetGrain>("DI-DATASET");

    private IDrugInteractionCheckerGrain GetChecker() =>
        Grains.GetGrain<IDrugInteractionCheckerGrain>("CHECKER");

    string SeverityBadge(InteractionSeverity severity) => severity switch
    {
        InteractionSeverity.Minor => "badge-minor",
        InteractionSeverity.Moderate => "badge-moderate",
        InteractionSeverity.Significant => "badge-significant",
        InteractionSeverity.Contraindicated => "badge-contraindicated",
        _ => "badge-unknown"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStatus();
    }

    async Task LoadStatus()
    {
        loading = true; error = null;
        try
        {
            status = await GetDataset().GetStatusAsync();
            cacheReady = await GetChecker().IsCacheReadyAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task LoadAllPairs()
    {
        loading = true; error = null;
        try
        {
            allPairs = await GetDataset().GetAllInteractionsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task LookupPair()
    {
        if (string.IsNullOrWhiteSpace(lookupIen1) || string.IsNullOrWhiteSpace(lookupIen2)) return;
        error = null; lookupResult = null;
        try
        {
            lookupResult = await GetDataset().GetInteractionAsync(lookupIen1.Trim(), lookupIen2.Trim());
            if (lookupResult is null)
                error = "No interaction found between these ingredients.";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    void SelectPair(DrugInteractionPair pair)
    {
        lookupResult = pair;
    }

    void AddIngredient()
    {
        checkIngredients.Add(new DrugIngredient { IngredientIen = string.Empty, Name = string.Empty });
    }

    void RemoveIngredient(int index)
    {
        if (checkIngredients.Count > 2 && index >= 0 && index < checkIngredients.Count)
            checkIngredients.RemoveAt(index);
    }

    async Task RunCheck()
    {
        List<DrugIngredient> valid = checkIngredients
            .Where(i => !string.IsNullOrWhiteSpace(i.IngredientIen))
            .ToList();
        if (valid.Count < 2) return;
        loading = true; error = null; checkResults = null;
        try
        {
            DrugInteractionCheckResponse response = await GetChecker().CheckInteractionsAsync(valid);
            if (response.Status == DrugInteractionCheckStatus.DataUnavailable)
                error = "Drug interaction dataset is not loaded — interactions cannot be verified.";
            else
                checkResults = response.Results;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task ClearDataset()
    {
        error = null; successMsg = null;
        try
        {
            await GetDataset().ClearAsync();
            successMsg = "Dataset cleared.";
            await LoadStatus();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task LoadDemo()
    {
        loading = true; error = null; successMsg = null;
        try
        {
            List<DrugInteractionPair> demoPairs = new()
            {
                new DrugInteractionPair
                {
                    IngredientIen1 = "1836", IngredientName1 = "WARFARIN SODIUM",
                    IngredientIen2 = "60", IngredientName2 = "ASPIRIN",
                    Severity = InteractionSeverity.Significant,
                    Description = "Concurrent use increases risk of bleeding.",
                    ClinicalEffects = "Increased anticoagulant effect and risk of hemorrhage.",
                    Mechanism = "Aspirin inhibits platelet aggregation and may displace warfarin from protein binding.",
                    Management = "Monitor INR closely. Consider alternative analgesic."
                },
                new DrugInteractionPair
                {
                    IngredientIen1 = "1836", IngredientName1 = "WARFARIN SODIUM",
                    IngredientIen2 = "3603", IngredientName2 = "METRONIDAZOLE",
                    Severity = InteractionSeverity.Significant,
                    Description = "Metronidazole inhibits warfarin metabolism.",
                    ClinicalEffects = "Increased anticoagulant effect.",
                    Mechanism = "CYP2C9 inhibition by metronidazole.",
                    Management = "Monitor INR. Reduce warfarin dose if needed."
                },
                new DrugInteractionPair
                {
                    IngredientIen1 = "1464", IngredientName1 = "SIMVASTATIN",
                    IngredientIen2 = "3241", IngredientName2 = "ERYTHROMYCIN",
                    Severity = InteractionSeverity.Contraindicated,
                    Description = "Erythromycin significantly increases simvastatin levels.",
                    ClinicalEffects = "Risk of rhabdomyolysis.",
                    Mechanism = "CYP3A4 inhibition by erythromycin.",
                    Management = "Avoid combination. Use alternative statin or antibiotic."
                },
                new DrugInteractionPair
                {
                    IngredientIen1 = "2466", IngredientName1 = "LISINOPRIL",
                    IngredientIen2 = "4073", IngredientName2 = "POTASSIUM CHLORIDE",
                    Severity = InteractionSeverity.Moderate,
                    Description = "ACE inhibitors may increase potassium retention.",
                    ClinicalEffects = "Risk of hyperkalemia.",
                    Mechanism = "ACE inhibitors reduce aldosterone secretion, decreasing renal potassium excretion.",
                    Management = "Monitor serum potassium levels. Adjust potassium supplementation."
                },
                new DrugInteractionPair
                {
                    IngredientIen1 = "2780", IngredientName1 = "FLUOXETINE",
                    IngredientIen2 = "3850", IngredientName2 = "TRAMADOL",
                    Severity = InteractionSeverity.Significant,
                    Description = "Risk of serotonin syndrome and seizures.",
                    ClinicalEffects = "Serotonin syndrome, lowered seizure threshold.",
                    Mechanism = "Both agents increase serotonergic activity.",
                    Management = "Avoid if possible. Monitor for signs of serotonin syndrome."
                }
            };

            await GetDataset().LoadInteractionsAsync(demoPairs);
            successMsg = $"Demo dataset loaded with {demoPairs.Count} interaction pairs.";
            await LoadStatus();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }
}

<style>
    .subtitle { color: #888; margin-top: -8px; font-size: 0.9em; }
    .tabs { display: flex; gap: 4px; margin: 16px 0 12px; }
    .toolbar { display: flex; gap: 8px; margin: 12px 0; align-items: center; }
    .input-id { padding: 6px; border: 1px solid #555; border-radius: 4px; width: 200px; background: #1a1a2e; color: #eee; }
    button { padding: 6px 14px; border: 1px solid #555; border-radius: 4px; cursor: pointer; background: #2a2a3e; color: #eee; }
    button:hover:not(:disabled) { background: #3a3a5e; }
    button:disabled { opacity: .5; cursor: not-allowed; }
    .btn-demo { background: #1a3a5a; }
    .btn-danger { background: #4a1a1a; color: #faa; }
    .btn-sm { padding: 2px 7px; font-size: 0.78em; }
    .btn-remove { background: #4a1a1a; color: #faa; }
    .loading-msg { color: #aaa; }
    .error { color: #f66; margin: 8px 0; padding: 8px; background: #3a1a1a; border-radius: 4px; }
    .success { color: #6f6; margin: 8px 0; padding: 8px; background: #1a3a1a; border-radius: 4px; }
    .detail-panel { margin-top: 16px; padding: 16px; background: #1a1a2e; border: 1px solid #444; border-radius: 6px; }
    .status-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
    .status-card { padding: 12px; background: #1e1e38; border: 1px solid #444; border-radius: 6px; text-align: center; }
    .status-label { color: #999; font-size: 0.85em; margin-bottom: 4px; }
    .status-value { color: #fff; font-size: 1.2em; font-weight: bold; }
    .status-loaded { border-left: 3px solid #4a4; }
    .status-empty { border-left: 3px solid #c44; }
    .cache-info { color: #aaa; margin-top: 12px; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 8px; margin-bottom: 8px; }
    .info-item { padding: 4px 0; color: #ccc; }
    .info-item .label { color: #888; font-weight: bold; }
    .interaction-detail { display: flex; flex-direction: column; gap: 6px; }
    .data-table { width: 100%; border-collapse: collapse; font-size: 0.88em; margin-top: 10px; }
    .data-table th { background: #2a2a4e; color: #ddd; padding: 6px 10px; text-align: left; }
    .data-table td { padding: 5px 10px; border-bottom: 1px solid #333; color: #ccc; }
    .data-table tr:hover { background: #252540; cursor: pointer; }
    .desc-cell { max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ien { color: #777; font-size: 0.8em; }
    .count-label { color: #888; font-size: 0.85em; margin-top: 4px; }
    .badge { padding: 2px 8px; border-radius: 10px; font-size: 0.78em; font-weight: bold; }
    .badge-minor { background: #4a4; color: #fff; }
    .badge-moderate { background: #d80; color: #fff; }
    .badge-significant { background: #c44; color: #fff; }
    .badge-contraindicated { background: #a00; color: #fff; font-size: 0.72em; }
    .badge-unknown { background: #666; color: #fff; }
    .form-panel { padding: 16px; background: #1a1a2e; border: 1px solid #444; border-radius: 6px; max-width: 600px; }
    .form-panel h3 { color: #ddd; margin-top: 0; }
    .hint { color: #888; font-size: 0.85em; margin-bottom: 12px; }
    .ingredient-row { display: flex; gap: 8px; margin-bottom: 6px; align-items: center; }
    .ingredient-row input { padding: 4px; border: 1px solid #555; border-radius: 3px; background: #12122a; color: #eee; flex: 1; }
    .ingredient-actions { display: flex; gap: 8px; margin-top: 12px; }
    .result-panel { padding: 12px; border-radius: 6px; margin-top: 16px; }
    .result-ok { background: #1a3a1a; color: #6f6; border: 1px solid #4a4; }
    .result-alert { background: #3a1a1a; color: #f66; border: 1px solid #c44; }
    .interaction-card { margin-top: 8px; }
    .interaction-header { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; color: #eee; }
</style>
