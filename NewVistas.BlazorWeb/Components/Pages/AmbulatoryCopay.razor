@page "/ambulatory-copay"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Ambulatory Copay Check-Off Sheet</PageTitle>

<h1>Ambulatory Copay Check-Off Sheet</h1>
<p class="subtitle">VistA File #350.7 — billable item capture for outpatient visits</p>

<div class="tab-bar">
    <button class="@TabClass("lookup")" @onclick='() => SetTab("lookup")'>Sheet Lookup</button>
    <button class="@TabClass("create")" @onclick='() => SetTab("create")'>Create Sheet</button>
</div>

<AlertBanner Error="@error" Success="@result" />

@* ── Tab 1: Sheet Lookup ──────────────────────────────────── *@
@if (activeTab == "lookup")
{
    <div class="lookup-bar">
        <input @bind="sheetIdInput" placeholder="Sheet ID (e.g. DEMO-SHEET-001)" class="lookup-input" />
        <button class="btn btn-primary" @onclick="LoadSheet" disabled="@loading">Load Sheet</button>
        <button class="btn btn-primary" @onclick="LoadDemo" disabled="@loading">Load Demo Data</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading...</p> }

    @if (sheet is not null)
    {
        <div class="detail-panel">
            <h3>Sheet: @sheet.SheetId</h3>
            <div class="info-grid">
                <div class="info-item"><span class="label">Patient:</span> @sheet.PatientId</div>
                <div class="info-item"><span class="label">Encounter:</span> @(sheet.EncounterId ?? "N/A")</div>
                <div class="info-item"><span class="label">Visit Date:</span> @sheet.VisitDate.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</div>
                <div class="info-item"><span class="label">Clinic:</span> @(sheet.ClinicName ?? sheet.ClinicId ?? "N/A")</div>
                <div class="info-item">
                    <span class="label">Status:</span>
                    @if (sheet.IsComplete)
                    {
                        <span class="badge badge-success">COMPLETE</span>
                    }
                    else
                    {
                        <span class="badge badge-warning">OPEN</span>
                    }
                </div>
                <div class="info-item"><span class="label">Billable Items:</span> @sheet.TotalBillableItems</div>
            </div>

            @if (sheet.IsComplete && sheet.CompletedByUserName is not null)
            {
                <p class="completed-info">Completed by @sheet.CompletedByUserName on @(sheet.CompletedDateTime?.ToLocalTime().ToString("MM/dd/yyyy HH:mm") ?? "N/A")</p>
            }

            <h4>Checklist Items</h4>
            @if (sheet.ChecklistItems.Count > 0)
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Checked</th>
                            <th>Checked By</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CopayChecklistItem item in sheet.ChecklistItems)
                        {
                            <tr>
                                <td>@item.ItemCode</td>
                                <td>@item.ItemDescription</td>
                                <td>
                                    @if (item.IsChecked)
                                    {
                                        <span class="badge badge-success">YES</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-neutral">NO</span>
                                    }
                                </td>
                                <td>@(item.CheckedByUserName ?? "—")</td>
                                <td>@(item.CheckedDateTime?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No items on this sheet yet.</p>
            }

            @if (sheet.BillingActionIds.Count > 0)
            {
                <h4>Linked Billing Actions</h4>
                <ul>
                    @foreach (string baId in sheet.BillingActionIds)
                    {
                        <li>@baId</li>
                    }
                </ul>
            }

            @if (!sheet.IsComplete)
            {
                <div class="form-section">
                    <h4>Check Item</h4>
                    <FormField Label="Item Code"><input class="form-input" @bind="checkItemCode" placeholder="e.g. 99213" /></FormField>
                    <FormField Label="Description"><input class="form-input" @bind="checkItemDesc" placeholder="Office visit level 3" /></FormField>
                    <FormField Label="User ID"><input class="form-input" @bind="checkUserId" /></FormField>
                    <FormField Label="User Name"><input class="form-input" @bind="checkUserName" /></FormField>
                    <button class="btn btn-primary" @onclick="SubmitCheckItem">Check Item</button>
                </div>

                <div class="form-section">
                    <h4>Complete Sheet</h4>
                    <FormField Label="User ID"><input class="form-input" @bind="completeUserId" /></FormField>
                    <FormField Label="User Name"><input class="form-input" @bind="completeUserName" /></FormField>
                    <button class="btn btn-primary" @onclick="SubmitComplete">Mark Complete</button>
                </div>
            }

            <div class="form-section">
                <h4>Link Billing Action</h4>
                <FormField Label="Billing Action ID"><input class="form-input" @bind="linkBillingId" /></FormField>
                <button class="btn btn-primary" @onclick="SubmitLinkBilling">Link</button>
            </div>
        </div>
    }
}

@* ── Tab 2: Create Sheet ──────────────────────────────────── *@
@if (activeTab == "create")
{
    <div class="form-section">
        <h3>Create New Check-Off Sheet</h3>
        <FormField Label="Patient ID"><input class="form-input" @bind="newPatientId" /></FormField>
        <FormField Label="Encounter ID"><input class="form-input" @bind="newEncounterId" placeholder="(optional)" /></FormField>
        <FormField Label="Visit Date"><input class="form-input" type="datetime-local" @bind="newVisitDate" /></FormField>
        <FormField Label="Clinic ID"><input class="form-input" @bind="newClinicId" placeholder="(optional)" /></FormField>
        <FormField Label="Clinic Name"><input class="form-input" @bind="newClinicName" placeholder="(optional)" /></FormField>
        <button class="btn btn-primary" @onclick="SubmitCreate" disabled="@(loading || string.IsNullOrWhiteSpace(newPatientId))">Create Sheet</button>
    </div>
}

@code {
    string activeTab = "lookup";
    bool loading;
    string? error;
    string? result;

    // Lookup
    string sheetIdInput = string.Empty;
    AmbulatoryCopaySheetState? sheet;

    // Check item fields
    string checkItemCode = string.Empty;
    string checkItemDesc = string.Empty;
    string checkUserId = string.Empty;
    string checkUserName = string.Empty;

    // Complete fields
    string completeUserId = string.Empty;
    string completeUserName = string.Empty;

    // Link billing fields
    string linkBillingId = string.Empty;

    // Create fields
    string newPatientId = string.Empty;
    string? newEncounterId;
    DateTime newVisitDate = DateTime.Now;
    string? newClinicId;
    string? newClinicName;

    string TabClass(string tab) => activeTab == tab ? "tab active" : "tab";

    void SetTab(string tab) { activeTab = tab; error = null; result = null; }

    private IAmbulatoryCopaySheetGrain GetSheetGrain(string id) =>
        Grains.GetGrain<IAmbulatoryCopaySheetGrain>($"IB-SHEET:{id.Trim()}");

    async Task LoadSheet()
    {
        if (string.IsNullOrWhiteSpace(sheetIdInput)) return;
        loading = true; error = null; result = null;
        try
        {
            sheet = await GetSheetGrain(sheetIdInput).GetAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task SubmitCheckItem()
    {
        if (sheet is null || string.IsNullOrWhiteSpace(checkItemCode)) return;
        error = null; result = null;
        try
        {
            await GetSheetGrain(sheet.SheetId).CheckItemAsync(checkItemCode, checkItemDesc, checkUserId, checkUserName);
            result = $"Item {checkItemCode} checked.";
            checkItemCode = string.Empty; checkItemDesc = string.Empty;
            await LoadSheet();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task SubmitComplete()
    {
        if (sheet is null) return;
        error = null; result = null;
        try
        {
            await GetSheetGrain(sheet.SheetId).CompleteAsync(completeUserId, completeUserName);
            result = "Sheet marked complete.";
            await LoadSheet();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task SubmitLinkBilling()
    {
        if (sheet is null || string.IsNullOrWhiteSpace(linkBillingId)) return;
        error = null; result = null;
        try
        {
            await GetSheetGrain(sheet.SheetId).LinkBillingActionAsync(linkBillingId);
            result = $"Billing action {linkBillingId} linked.";
            linkBillingId = string.Empty;
            await LoadSheet();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    async Task SubmitCreate()
    {
        if (string.IsNullOrWhiteSpace(newPatientId)) return;
        loading = true; error = null; result = null;
        try
        {
            string newId = Guid.NewGuid().ToString();
            IAmbulatoryCopaySheetGrain grain = GetSheetGrain(newId);
            string createdId = await grain.CreateAsync(
                newPatientId, newEncounterId, newVisitDate.ToUniversalTime(), newClinicId, newClinicName);
            result = $"Sheet created: {createdId}";
            sheetIdInput = createdId;
            activeTab = "lookup";
            await LoadSheet();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task LoadDemo()
    {
        loading = true; error = null; result = null;
        try
        {
            // Create demo sheets directly via grains
            IAmbulatoryCopaySheetGrain s1 = GetSheetGrain("DEMO-SHEET-001");
            await s1.CreateAsync("P-001", "ENC-001", DateTime.UtcNow.AddDays(-3), "CL-PRIMARY", "Primary Care Clinic");
            await s1.CheckItemAsync("99213", "Office visit, established patient, level 3", "USR-CLERK-1", "Mary Johnson");
            await s1.CheckItemAsync("85025", "CBC with differential", "USR-CLERK-1", "Mary Johnson");
            await s1.CompleteAsync("USR-CLERK-1", "Mary Johnson");

            IAmbulatoryCopaySheetGrain s2 = GetSheetGrain("DEMO-SHEET-002");
            await s2.CreateAsync("P-002", "ENC-002", DateTime.UtcNow, "CL-CARDIO", "Cardiology Clinic");
            await s2.CheckItemAsync("99214", "Office visit, established patient, level 4", "USR-CLERK-2", "Robert Davis");

            result = "Demo data loaded. Try sheet IDs: DEMO-SHEET-001, DEMO-SHEET-002";
            sheetIdInput = "DEMO-SHEET-001";
            await LoadSheet();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }
}

<style>
    /* Canonical classes (lookup-bar, lookup-input, tab-bar, tab, data-table, alert, btn,
       badge, form-section, form-input) live in app.css per UI-CONVENTIONS.md.
       Page-specific only below. */
    .subtitle { color: #666; margin-top: -8px; font-size: 0.9em; }
    .loading-msg { color: #666; }
    .detail-panel { margin-top: 16px; padding: 16px; background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 6px; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; margin-bottom: 16px; }
    .info-item { padding: 4px 0; }
    .info-item .label { color: #555; font-weight: bold; }
    .completed-info { color: #166534; font-style: italic; }
</style>
