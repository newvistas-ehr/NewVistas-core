    string PercentileText(int? grams)
    {
        if (newborn == null) return "—";
        int p = NeonatalClassifier.WeightPercentileForGestationalAge(newborn.GestationalAgeWeeks, grams);
        return p < 0 ? "—" : $"{p}%";
    }
