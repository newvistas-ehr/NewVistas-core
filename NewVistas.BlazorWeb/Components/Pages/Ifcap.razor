    private string newVendorAddress = string.Empty;
    private string newVendorCity = string.Empty;
    private string newVendorState = string.Empty;
    private string newVendorZip = string.Empty;
    private string? newVendorPhone;
    private string? newVendorEmail;
    private string? newVendorContact;
    private string? newVendorDuns;
    private bool newVendorSb;
    private bool newVendorWo;
    private bool newVendorVo;
    private string? createVendorMsg;

    // ─── Site Parameters ──────────────────────────────────────────────────────

    private SiteParamsDto? siteParams;
    private string spSiteName = string.Empty;
    private string spFacilityNumber = string.Empty;
    private int spFiscalYear = DateTime.Now.Year;
    private int spDeliveryDays = 30;
    private decimal spAutoApprovalThreshold;
    private string spPoPrefix = string.Empty;
    private bool spAutoApproval;
    private string spUpdatedByUserId = string.Empty;
    private string? siteParamsMsg;

    // ─── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadControlPoints();
    }

    private async Task LoadControlPoints()
    {
        error = null;
        try
        {
            var cpIdx = Grains.GetGrain<IControlPointIndexGrain>("IFCAP-CP-IDX");
            List<ControlPointIndexEntry> entries = cpFiscalYearFilter > 0
                ? await cpIdx.GetByFiscalYearAsync(cpFiscalYearFilter)
                : await cpIdx.GetAllAsync();
            controlPoints = entries.Select(e => new CpIndexDto(
                e.ControlPointId, e.Name, e.FacilityId,
                e.FiscalYear, e.RemainingBalance, e.Status.ToString())).ToList();
        }
        catch (Exception ex) { error = $"Error loading control points: {ex.Message}"; }
    }

    private async Task SelectControlPoint(string cpId)
    {
        selectedCpId = cpId;
        try
        {
            string grainKey = cpId.StartsWith("IFCAP-CP:") ? cpId : $"IFCAP-CP:{cpId}";
            var cpGrain = Grains.GetGrain<IControlPointGrain>(grainKey);
            ControlPointState s = await cpGrain.GetAsync();
            selectedCp = new CpDetailDto(s.ControlPointId, s.Name, s.FacilityId, s.ServiceId,
                s.FiscalYear, s.BudgetCode, s.Status.ToString(),
                s.AllocatedAmount, s.ObligatedAmount, s.ExpendedAmount, s.RemainingBalance,
                s.ControlPointOfficerId, s.ControlPointOfficerName,
                s.RequestIds, s.CreatedDate, s.LastModifiedDate);
            var prIdx = Grains.GetGrain<IPurchaseRequestIndexGrain>($"IFCAP-PR-IDX:{cpId}");
            List<PurchaseRequestIndexEntry> pendingEntries = await prIdx.GetPendingAsync();
            cpPendingRequests = pendingEntries.Select(MapPrIndex).ToList();
        }
        catch (Exception ex) { error = $"Error loading control point details: {ex.Message}"; }
    }

    private static PrIndexDto MapPrIndex(PurchaseRequestIndexEntry e) => new(
        e.RequestId, e.ControlPointId, e.RequestorName,
        e.EstimatedCost, e.Status,
        e.Priority, e.RequestDate);

    private async Task SubmitAllocateFunds()
    {
        allocateMsg = null;
        if (selectedCpId == null) return;
        try
        {
            string grainKey = selectedCpId.StartsWith("IFCAP-CP:") ? selectedCpId : $"IFCAP-CP:{selectedCpId}";
            var cpGrain = Grains.GetGrain<IControlPointGrain>(grainKey);
            await cpGrain.AllocateFundsAsync(allocateAmount, allocateUserId);
            allocateMsg = "Funds allocated.";
            await SelectControlPoint(selectedCpId);
        }
        catch (Exception ex) { allocateMsg = $"Error: {ex.Message}"; }
    }

    private async Task CreateControlPoint()
    {
        createCpMsg = null;
        try
        {
            string cpId = Guid.NewGuid().ToString();
            var cpGrain = Grains.GetGrain<IControlPointGrain>($"IFCAP-CP:{cpId}");
            await cpGrain.CreateAsync(newCpName, newCpFacilityId, newCpServiceId,
                newCpFiscalYear, newCpBudgetCode, newCpAllocated, newCpOfficerId, newCpOfficerName);
            createCpMsg = "Control point created.";
            showCreateCp = false;
            await LoadControlPoints();
        }
        catch (Exception ex) { createCpMsg = $"Error: {ex.Message}"; }
    }

    // ─── Purchase Request actions ──────────────────────────────────────────────

    private async Task LoadControlPointsForPr()
    {
        await LoadControlPoints();
    }

    private async Task LoadPrForCp()
    {
        if (string.IsNullOrEmpty(selectedPrCpId)) return;
        try
        {
            var prIdx = Grains.GetGrain<IPurchaseRequestIndexGrain>($"IFCAP-PR-IDX:{selectedPrCpId}");
            List<PurchaseRequestIndexEntry> entries = await prIdx.GetAllAsync();
            cpRequests = entries.Select(MapPrIndex).ToList();
        }
        catch (Exception ex) { error = $"Error loading requests: {ex.Message}"; }
    }

    private void TogglePrSubmitPanel(string rid) { prSubmitId = prSubmitId == rid ? null : rid; prApproveId = null; prRejectId = null; prCancelId = null; prActionMsg = null; }
    private void TogglePrApprovePanel(string rid) { prApproveId = prApproveId == rid ? null : rid; prSubmitId = null; prRejectId = null; prCancelId = null; prActionMsg = null; }
    private void TogglePrRejectPanel(string rid) { prRejectId = prRejectId == rid ? null : rid; prSubmitId = null; prApproveId = null; prCancelId = null; prActionMsg = null; }
    private void TogglePrCancelPanel(string rid) { prCancelId = prCancelId == rid ? null : rid; prSubmitId = null; prApproveId = null; prRejectId = null; prActionMsg = null; }

    private async Task SubmitPr(string rid)
    {
        prActionMsg = null;
        try
        {
            string grainKey = rid.StartsWith("IFCAP-PR:") ? rid : $"IFCAP-PR:{rid}";
            var prGrain = Grains.GetGrain<IPurchaseRequestGrain>(grainKey);
            await prGrain.SubmitAsync(prActionUserId);
            prActionMsg = "Submitted."; prSubmitId = null; await LoadPrForCp();
        }
        catch (Exception ex) { prActionMsg = $"Error: {ex.Message}"; }
    }

    private async Task ApprovePr(string rid)
    {
        prActionMsg = null;
        try
        {
            string grainKey = rid.StartsWith("IFCAP-PR:") ? rid : $"IFCAP-PR:{rid}";
            var prGrain = Grains.GetGrain<IPurchaseRequestGrain>(grainKey);
            await prGrain.ApproveAsync(prActionUserId, prActionUserName);
            prActionMsg = "Approved."; prApproveId = null; await LoadPrForCp();
        }
        catch (Exception ex) { prActionMsg = $"Error: {ex.Message}"; }
    }

    private async Task RejectPr(string rid)
    {
        prActionMsg = null;
        try
        {
            string grainKey = rid.StartsWith("IFCAP-PR:") ? rid : $"IFCAP-PR:{rid}";
            var prGrain = Grains.GetGrain<IPurchaseRequestGrain>(grainKey);
            await prGrain.RejectAsync(prActionUserId, prActionReason);
            prActionMsg = "Rejected."; prRejectId = null; await LoadPrForCp();
        }
        catch (Exception ex) { prActionMsg = $"Error: {ex.Message}"; }
    }

    private async Task CancelPr(string rid)
    {
        prActionMsg = null;
        try
        {
            string grainKey = rid.StartsWith("IFCAP-PR:") ? rid : $"IFCAP-PR:{rid}";
            var prGrain = Grains.GetGrain<IPurchaseRequestGrain>(grainKey);
            await prGrain.CancelAsync(prActionReason);
            prActionMsg = "Cancelled."; prCancelId = null; await LoadPrForCp();
        }
        catch (Exception ex) { prActionMsg = $"Error: {ex.Message}"; }
    }

    private void AddPrLine() => newPrLines.Add(new PrLineForm { LineNumber = newPrLines.Count + 1 });

    private async Task CreatePurchaseRequest()
    {
        createPrMsg = null;
        try
        {
            string reqId = Guid.NewGuid().ToString();
            var lineItems = newPrLines.Select(l => new PurchaseRequestLineItem(
                l.LineNumber, l.ItemDescription, l.Quantity, l.UnitOfIssue, l.UnitCost,
                l.Quantity * l.UnitCost, null, null, null)).ToList();
            string cpKey = selectedPrCpId.StartsWith("IFCAP-CP:") ? selectedPrCpId : $"IFCAP-CP:{selectedPrCpId}";
            var prGrain = Grains.GetGrain<IPurchaseRequestGrain>($"IFCAP-PR:{reqId}");
            PurchaseRequestPriority priority = Enum.Parse<PurchaseRequestPriority>(newPrPriority);
            await prGrain.CreateAsync(cpKey, newPrRequestorId, newPrRequestorName,
                newPrFiscalYear, priority, newPrNeedByDate,
                newPrDescription, newPrJustification, newPrEstimatedCost, lineItems,
                newPrVendorId, newPrVendorName, newPrNotes);
            createPrMsg = "Request created.";
            showCreatePr = false;
            newPrLines = new() { new PrLineForm { LineNumber = 1 } };
            await LoadPrForCp();
        }
        catch (Exception ex) { createPrMsg = $"Error: {ex.Message}"; }
    }

    // ─── Purchase Order actions ────────────────────────────────────────────────

    private async Task LoadPurchaseOrders()
    {
        error = null;
        try
        {
            var poIdx = Grains.GetGrain<IPurchaseOrderIndexGrain>("IFCAP-PO-IDX");
            List<PurchaseOrderIndexEntry> openEntries = await poIdx.GetOpenAsync();
            openPOs = openEntries.Select(MapPoIndex).ToList();
            List<PurchaseOrderIndexEntry> allEntries = await poIdx.GetAllAsync();
            allPOs = allEntries.Select(MapPoIndex).ToList();
        }
        catch (Exception ex) { error = $"Error loading purchase orders: {ex.Message}"; }
    }

    private static PoIndexDto MapPoIndex(PurchaseOrderIndexEntry e) => new(
        e.PurchaseOrderId, e.ControlPointId, e.VendorName,
        e.TotalAmount, e.AmountReceived,
        e.Status, e.IssuedDate, e.RequestId);

    private async Task ToggleReceivePanel(string poId)
    {
        if (receivingPoId == poId) { receivingPoId = null; rrLines = new(); return; }
        receivingPoId = poId;
        cancelPoId = null;
        rrMsg = null;
        try
        {
            string grainKey = poId.StartsWith("IFCAP-PO:") ? poId : $"IFCAP-PO:{poId}";
            var poGrain = Grains.GetGrain<IPurchaseOrderGrain>(grainKey);
            PurchaseOrderState po = await poGrain.GetAsync();
            rrLines = po.LineItems.Select(l => new RrLineForm { LineNumber = l.LineNumber }).ToList();
        }
        catch { rrLines = new() { new RrLineForm { LineNumber = 1 } }; }
    }

    private void ToggleCancelPoPanel(string poId)
    {
        cancelPoId = cancelPoId == poId ? null : poId;
        receivingPoId = null;
        cancelPoMsg = null;
    }

    private async Task SubmitReceivingReport(string poId)
    {
        rrMsg = null;
        try
        {
            string rrId = Guid.NewGuid().ToString();
            string poKey = poId.StartsWith("IFCAP-PO:") ? poId : $"IFCAP-PO:{poId}";
            var poGrain = Grains.GetGrain<IPurchaseOrderGrain>(poKey);
            PurchaseOrderState po = await poGrain.GetAsync();
            var lineItems = rrLines.Select(l => new RrLineItem(
                l.LineNumber, string.Empty, 0, l.QuantityReceived, l.QuantityAccepted, 0, 0, l.Condition)).ToList();
            var rrGrain = Grains.GetGrain<IReceivingReportGrain>($"IFCAP-RR:{rrId}");
            await rrGrain.CreateAsync(poKey, po.ControlPointId, rrUserId, rrUserName, lineItems, rrNotes);
            var lineReceipts = rrLines.Select(l => (l.LineNumber, l.QuantityAccepted)).ToList();
            await poGrain.RecordReceiptAsync(rrId, lineReceipts);
            rrMsg = "Receiving report submitted.";
            receivingPoId = null;
            rrLines = new();
            await LoadPurchaseOrders();
        }
        catch (Exception ex) { rrMsg = $"Error: {ex.Message}"; }
    }

    private async Task CancelPurchaseOrder(string poId)
    {
        cancelPoMsg = null;
        try
        {
            string grainKey = poId.StartsWith("IFCAP-PO:") ? poId : $"IFCAP-PO:{poId}";
            var poGrain = Grains.GetGrain<IPurchaseOrderGrain>(grainKey);
            await poGrain.CancelAsync(cancelPoReason, cancelPoUserId);
            cancelPoMsg = "Purchase order cancelled.";
            cancelPoId = null;
            await LoadPurchaseOrders();
        }
        catch (Exception ex) { cancelPoMsg = $"Error: {ex.Message}"; }
    }

    private async Task ClosePoConfirm(string poId)
    {
        try
        {
            string grainKey = poId.StartsWith("IFCAP-PO:") ? poId : $"IFCAP-PO:{poId}";
            var poGrain = Grains.GetGrain<IPurchaseOrderGrain>(grainKey);
            await poGrain.CloseAsync("SYSTEM");
            await LoadPurchaseOrders();
        }
        catch (Exception ex) { error = $"Error closing PO: {ex.Message}"; }
    }

    private void AddPoLine() => newPoLines.Add(new PrLineForm { LineNumber = newPoLines.Count + 1 });

    private async Task CreatePurchaseOrder()
    {
        createPoMsg = null;
        try
        {
            string poId = Guid.NewGuid().ToString();
            var lineItems = newPoLines.Select(l => new PoLineItem(
                l.LineNumber, l.ItemDescription, l.Quantity, 0, l.UnitOfIssue, l.UnitCost,
                l.Quantity * l.UnitCost, null, null)).ToList();
            var poGrain = Grains.GetGrain<IPurchaseOrderGrain>($"IFCAP-PO:{poId}");
            await poGrain.CreateAsync(newPoRequestId, newPoControlPointId,
                newPoVendorId, newPoVendorName, newPoVendorAddress,
                newPoRequiredDelivery, lineItems, newPoIssuedByUserId, newPoIssuedByUserName);
            createPoMsg = "Purchase order issued.";
            showCreatePo = false;
            newPoLines = new() { new PrLineForm { LineNumber = 1 } };
            await LoadPurchaseOrders();
        }
        catch (Exception ex) { createPoMsg = $"Error: {ex.Message}"; }
    }

    // ─── Vendor actions ───────────────────────────────────────────────────────

    private async Task LoadVendors()
    {
        error = null;
        try
        {
            var vendorIdx = Grains.GetGrain<IIfcapVendorIndexGrain>("IFCAP-VENDOR-IDX");
            List<IfcapVendorIndexEntry> entries = await vendorIdx.GetAllAsync();
            vendors = entries.Select(v => new VendorIndexDto(
                v.VendorId, v.Name, v.VendorNumber,
                v.IsActive, v.IsSmallBusiness, v.IsVeteranOwned)).ToList();
        }
        catch (Exception ex) { error = $"Error loading vendors: {ex.Message}"; }
    }

    private async Task SearchVendors()
    {
        error = null;
        try
        {
            var vendorIdx = Grains.GetGrain<IIfcapVendorIndexGrain>("IFCAP-VENDOR-IDX");
            List<IfcapVendorIndexEntry> entries = string.IsNullOrWhiteSpace(vendorSearch)
                ? await vendorIdx.GetAllAsync()
                : await vendorIdx.SearchAsync(vendorSearch);
            vendors = entries.Select(v => new VendorIndexDto(
                v.VendorId, v.Name, v.VendorNumber,
                v.IsActive, v.IsSmallBusiness, v.IsVeteranOwned)).ToList();
        }
        catch (Exception ex) { error = $"Error searching vendors: {ex.Message}"; }
    }

    private async Task CreateVendor()
    {
        createVendorMsg = null;
        try
        {
            string vendorId = Guid.NewGuid().ToString();
            var vendorGrain = Grains.GetGrain<IIfcapVendorGrain>($"IFCAP-VENDOR:{vendorId}");
            await vendorGrain.CreateAsync(newVendorName, newVendorNumber,
                newVendorAddress, newVendorCity, newVendorState, newVendorZip,
                newVendorPhone, null, newVendorEmail,
                newVendorSb, newVendorWo, newVendorVo, newVendorDuns, newVendorContact);
            createVendorMsg = "Vendor registered.";
            showCreateVendor = false;
            await LoadVendors();
        }
        catch (Exception ex) { createVendorMsg = $"Error: {ex.Message}"; }
    }

    // ─── Site Parameters ──────────────────────────────────────────────────────

    private async Task LoadSiteParams()
    {
        error = null;
        try
        {
            var spGrain = Grains.GetGrain<IIfcapSiteParametersGrain>("IFCAP-SITE-PARAMS");
            IfcapSiteParametersState sp = await spGrain.GetAsync();
            siteParams = new SiteParamsDto(sp.SiteId, sp.SiteName, sp.FacilityNumber,
                sp.FiscalYear, sp.DefaultDeliveryDays,
                sp.IsAutoApprovalEnabled, sp.AutoApprovalThreshold,
                sp.PONumberPrefix, sp.IsActive, sp.UpdatedByUserId, sp.LastUpdatedDate);
            if (siteParams != null)
            {
                spSiteName              = siteParams.SiteName ?? string.Empty;
                spFacilityNumber        = siteParams.FacilityNumber ?? string.Empty;
                spFiscalYear            = siteParams.FiscalYear;
                spDeliveryDays          = siteParams.DefaultDeliveryDays;
                spAutoApprovalThreshold = siteParams.AutoApprovalThreshold;
                spPoPrefix              = siteParams.PONumberPrefix ?? string.Empty;
                spAutoApproval          = siteParams.IsAutoApprovalEnabled;
            }
        }
        catch (Exception ex) { error = $"Error loading site parameters: {ex.Message}"; }
    }

    private async Task UpdateSiteParams()
    {
        siteParamsMsg = null;
        try
        {
            var spGrain = Grains.GetGrain<IIfcapSiteParametersGrain>("IFCAP-SITE-PARAMS");
            await spGrain.UpdateAsync(spSiteName, spFacilityNumber, spFiscalYear,
                spDeliveryDays, spAutoApproval, spAutoApprovalThreshold, spPoPrefix, spUpdatedByUserId);
            siteParamsMsg = "Site parameters updated.";
            await LoadSiteParams();
        }
        catch (Exception ex) { siteParamsMsg = $"Error: {ex.Message}"; }
    }

    // ─── Badge helpers ────────────────────────────────────────────────────────

    private static string CpStatusBadge(string s) => s switch
    {
        "Active"    => "badge-success",
        "Inactive"  => "badge-secondary",
        "Suspended" => "badge-warning",
        _           => "badge-secondary",
    };

    private static string PrStatusBadge(string s) => s switch
    {
        "Draft"     => "badge-secondary",
        "Submitted" => "badge-warning",
        "Approved"  => "badge-info",
        "Funded"    => "badge-success",
        "Cancelled" => "badge-secondary",
        "Rejected"  => "badge-danger",
        _           => "badge-secondary",
    };

    private static string PoStatusBadge(string s) => s switch
    {
        "Draft"             => "badge-secondary",
        "Open"              => "badge-primary",
        "PartiallyReceived" => "badge-warning",
        "Received"          => "badge-info",
        "Cancelled"         => "badge-secondary",
        "Closed"            => "badge-success",
        _                   => "badge-secondary",
    };

    // ─── Local form helpers ───────────────────────────────────────────────────

    private class PrLineForm
    {
        public int LineNumber { get; set; }
        public string ItemDescription { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1;
        public string UnitOfIssue { get; set; } = "EA";
        public decimal UnitCost { get; set; }
    }

    private class RrLineForm
    {
        public int LineNumber { get; set; }
        public decimal QuantityReceived { get; set; }
        public decimal QuantityAccepted { get; set; }
        public string? Condition { get; set; }
    }

    // ─── Local DTOs ───────────────────────────────────────────────────────────

    private record CpIndexDto(
        string ControlPointId, string Name, string FacilityId,
        int FiscalYear, decimal RemainingBalance, string Status);

    private record CpDetailDto(
        string ControlPointId, string Name, string FacilityId, string ServiceId,
        int FiscalYear, string BudgetCode, string Status,
        decimal AllocatedAmount, decimal ObligatedAmount, decimal ExpendedAmount, decimal RemainingBalance,
        string ControlPointOfficerId, string ControlPointOfficerName,
        List<string> RequestIds, DateTime CreatedDate, DateTime LastModifiedDate);

    private record PrIndexDto(
        string RequestId, string ControlPointId, string RequestorName,
        decimal EstimatedCost, PurchaseRequestStatus Status,
