@page "/ifcap"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>IFCAP — Procurement</PageTitle>

<div class="ifcap-container">
    <div class="ifcap-header">
        <h2>Integrated Funds Distribution, Control Point Activity &amp; Procurement</h2>
    </div>

    @if (error != null)
    {
        <div class="alert-danger">@error</div>
    }

    <div class="ifcap-tabs">
        <button class="tab-btn @(activeTab == "cp" ? "active" : "")" @onclick='async () => { activeTab = "cp"; await LoadControlPoints(); }'>Control Points</button>
        <button class="tab-btn @(activeTab == "pr" ? "active" : "")" @onclick='() => activeTab = "pr"'>Purchase Requests</button>
        <button class="tab-btn @(activeTab == "po" ? "active" : "")" @onclick='async () => { activeTab = "po"; await LoadPurchaseOrders(); }'>Purchase Orders</button>
        <button class="tab-btn @(activeTab == "vendor" ? "active" : "")" @onclick='async () => { activeTab = "vendor"; await LoadVendors(); }'>Vendors</button>
        <button class="tab-btn @(activeTab == "site" ? "active" : "")" @onclick='async () => { activeTab = "site"; await LoadSiteParams(); }'>Site Parameters</button>
    </div>

    <!-- ─── Control Points Tab ───────────────────────────────────────────────── -->
    @if (activeTab == "cp")
    {
        <div class="tab-panel">
            <h3>Control Points</h3>

            <div class="form-row">
                <input class="form-control" type="number" placeholder="Fiscal Year" @bind="cpFiscalYearFilter" />
                <button class="btn btn-primary" @onclick="LoadControlPoints">Load</button>
            </div>

            @if (controlPoints == null || controlPoints.Count == 0)
            {
                <p class="text-muted">No control points found.</p>
            }
            else
            {
                <table class="table ifcap-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>FY</th>
                            <th>Budget Code</th>
                            <th>Remaining</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cp in controlPoints)
                        {
                            <tr class="@(selectedCpId == cp.ControlPointId ? "selected-row" : "")">
                                <td>@cp.Name</td>
                                <td>@cp.FiscalYear</td>
                                <td>—</td>
                                <td>@cp.RemainingBalance.ToString("C")</td>
                                <td><span class="badge @CpStatusBadge(cp.Status.ToString())">@cp.Status</span></td>
                                <td><button class="btn btn-sm btn-outline-primary" @onclick="() => SelectControlPoint(cp.ControlPointId)">Details</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <!-- CP Detail Panel -->
            @if (selectedCpId != null && selectedCp != null)
            {
                <div class="detail-panel">
                    <h4>@selectedCp.Name</h4>
                    <div class="detail-grid">
                        <div><strong>Status:</strong> <span class="badge @CpStatusBadge(selectedCp.Status.ToString())">@selectedCp.Status</span></div>
                        <div><strong>Facility:</strong> @selectedCp.FacilityId</div>
                        <div><strong>Service:</strong> @selectedCp.ServiceId</div>
                        <div><strong>Fiscal Year:</strong> @selectedCp.FiscalYear</div>
                        <div><strong>Budget Code:</strong> @selectedCp.BudgetCode</div>
                        <div><strong>Officer:</strong> @selectedCp.ControlPointOfficerName</div>
                        <div><strong>Allocated:</strong> @selectedCp.AllocatedAmount.ToString("C")</div>
                        <div><strong>Obligated:</strong> @selectedCp.ObligatedAmount.ToString("C")</div>
                        <div><strong>Expended:</strong> @selectedCp.ExpendedAmount.ToString("C")</div>
                        <div><strong>Remaining:</strong> @selectedCp.RemainingBalance.ToString("C")</div>
                    </div>

                    <!-- Allocate Funds -->
                    <div class="action-section">
                        <h5>Allocate Additional Funds</h5>
                        <div class="form-row">
                            <input class="form-control" type="number" step="0.01" placeholder="Amount ($)" @bind="allocateAmount" />
                            <input class="form-control" placeholder="Authorized By User ID" @bind="allocateUserId" />
                            <button class="btn btn-success" @onclick="SubmitAllocateFunds">Allocate</button>
                        </div>
                        @if (allocateMsg != null) { <span class="form-msg">@allocateMsg</span> }
                    </div>

                    <!-- Pending Requests sub-table -->
                    @if (cpPendingRequests != null && cpPendingRequests.Count > 0)
                    {
                        <div class="action-section">
                            <h5>Pending Requests</h5>
                            <table class="table ifcap-table">
                                <thead>
                                    <tr><th>Requestor</th><th>Priority</th><th>Est. Cost</th><th>Status</th><th>Date</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var pr in cpPendingRequests)
                                    {
                                        <tr>
                                            <td>@pr.RequestorName</td>
                                            <td>@pr.Priority</td>
                                            <td>@pr.EstimatedCost.ToString("C")</td>
                                            <td><span class="badge @PrStatusBadge(pr.Status.ToString())">@pr.Status</span></td>
                                            <td>@pr.RequestDate.ToString("MM/dd/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            <!-- Create CP form -->
            <button class="btn btn-success btn-sm" style="margin-top:1rem;" @onclick='() => showCreateCp = !showCreateCp'>+ New Control Point</button>
            @if (showCreateCp)
            {
                <div class="form-panel">
                    <h4>Create Control Point</h4>
                    <div class="form-row">
                        <input class="form-control" placeholder="Name" @bind="newCpName" />
                        <input class="form-control" placeholder="Facility ID" @bind="newCpFacilityId" />
                        <input class="form-control" placeholder="Service ID" @bind="newCpServiceId" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" type="number" placeholder="Fiscal Year" @bind="newCpFiscalYear" />
                        <input class="form-control" placeholder="Budget Code" @bind="newCpBudgetCode" />
                        <input class="form-control" type="number" step="0.01" placeholder="Allocated Amount ($)" @bind="newCpAllocated" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Officer User ID" @bind="newCpOfficerId" />
                        <input class="form-control" placeholder="Officer Name" @bind="newCpOfficerName" />
                    </div>
                    <button class="btn btn-primary" @onclick="CreateControlPoint">Create</button>
                    @if (createCpMsg != null) { <span class="form-msg">@createCpMsg</span> }
                </div>
            }
        </div>
    }

    <!-- ─── Purchase Requests Tab ──────────────────────────────────────────────── -->
    @if (activeTab == "pr")
    {
        <div class="tab-panel">
            <h3>Purchase Requests (VA Form 2237)</h3>

            <div class="form-row">
                <select class="form-control" @bind="selectedPrCpId" @bind:after="LoadPrForCp">
                    <option value="">-- Select Control Point --</option>
                    @if (controlPoints != null)
                    {
                        @foreach (var cp in controlPoints)
                        {
                            <option value="@cp.ControlPointId">@cp.Name (FY@cp.FiscalYear)</option>
                        }
                    }
                </select>
                <button class="btn btn-primary" @onclick="LoadControlPointsForPr">Load CPs</button>
            </div>

            @if (!string.IsNullOrEmpty(selectedPrCpId) && cpRequests != null)
            {
                @if (cpRequests.Count == 0)
                {
                    <p class="text-muted">No purchase requests for this control point.</p>
                }
                else
                {
                    <table class="table ifcap-table">
                        <thead>
                            <tr>
                                <th>Requestor</th>
                                <th>Priority</th>
                                <th>Est. Cost</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pr in cpRequests)
                            {
                                <tr>
                                    <td>@pr.RequestorName</td>
                                    <td>@pr.Priority</td>
                                    <td>@pr.EstimatedCost.ToString("C")</td>
                                    <td><span class="badge @PrStatusBadge(pr.Status.ToString())">@pr.Status</span></td>
                                    <td>@pr.RequestDate.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        @if (pr.Status == PurchaseRequestStatus.Draft)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick='() => TogglePrSubmitPanel(pr.RequestId)'>Submit</button>
                                        }
                                        @if (pr.Status == PurchaseRequestStatus.Submitted)
                                        {
                                            <button class="btn btn-sm btn-success" @onclick='() => TogglePrApprovePanel(pr.RequestId)'>Approve</button>
                                            <button class="btn btn-sm btn-danger" @onclick='() => TogglePrRejectPanel(pr.RequestId)'>Reject</button>
                                        }
                                        @if (pr.Status == PurchaseRequestStatus.Draft || pr.Status == PurchaseRequestStatus.Submitted)
                                        {
                                            <button class="btn btn-sm btn-warning" @onclick='() => TogglePrCancelPanel(pr.RequestId)'>Cancel</button>
                                        }
                                    </td>
                                </tr>
                                @if (prSubmitId == pr.RequestId)
                                {
                                    <tr><td colspan="6"><div class="form-panel">
                                        <div class="form-row">
                                            <input class="form-control" placeholder="Your User ID" @bind="prActionUserId" />
                                            <button class="btn btn-primary" @onclick='() => SubmitPr(pr.RequestId)'>Confirm Submit</button>
                                        </div>
                                        @if (prActionMsg != null) { <span class="form-msg">@prActionMsg</span> }
                                    </div></td></tr>
                                }
                                @if (prApproveId == pr.RequestId)
                                {
                                    <tr><td colspan="6"><div class="form-panel">
                                        <div class="form-row">
                                            <input class="form-control" placeholder="Approver User ID" @bind="prActionUserId" />
                                            <input class="form-control" placeholder="Approver Name" @bind="prActionUserName" />
                                            <button class="btn btn-success" @onclick='() => ApprovePr(pr.RequestId)'>Confirm Approve</button>
                                        </div>
                                        @if (prActionMsg != null) { <span class="form-msg">@prActionMsg</span> }
                                    </div></td></tr>
                                }
                                @if (prRejectId == pr.RequestId || prCancelId == pr.RequestId)
                                {
                                    <tr><td colspan="6"><div class="form-panel">
                                        <div class="form-row">
                                            <input class="form-control" placeholder="User ID" @bind="prActionUserId" />
                                            <input class="form-control" placeholder="Reason" @bind="prActionReason" />
                                            @if (prRejectId == pr.RequestId)
                                            {
                                                <button class="btn btn-danger" @onclick='() => RejectPr(pr.RequestId)'>Confirm Reject</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-warning" @onclick='() => CancelPr(pr.RequestId)'>Confirm Cancel</button>
                                            }
                                        </div>
                                        @if (prActionMsg != null) { <span class="form-msg">@prActionMsg</span> }
                                    </div></td></tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }

            <!-- Create 2237 form -->
            @if (!string.IsNullOrEmpty(selectedPrCpId))
            {
                <button class="btn btn-success btn-sm" style="margin-top:1rem;" @onclick='() => showCreatePr = !showCreatePr'>+ New 2237 Request</button>
                @if (showCreatePr)
                {
                    <div class="form-panel">
                        <h4>Create VA Form 2237 (Purchase Request)</h4>
                        <div class="form-row">
                            <input class="form-control" placeholder="Requestor User ID" @bind="newPrRequestorId" />
                            <input class="form-control" placeholder="Requestor Name" @bind="newPrRequestorName" />
                            <input class="form-control" type="number" placeholder="Fiscal Year" @bind="newPrFiscalYear" />
                        </div>
                        <div class="form-row">
                            <select class="form-control" @bind="newPrPriority">
                                <option value="Routine">Routine</option>
                                <option value="Urgent">Urgent</option>
                                <option value="Emergency">Emergency</option>
                            </select>
                            <input class="form-control" type="date" @bind="newPrNeedByDate" />
                            <input class="form-control" type="number" step="0.01" placeholder="Est. Cost ($)" @bind="newPrEstimatedCost" />
                        </div>
                        <div class="form-row">
                            <input class="form-control" placeholder="Description" @bind="newPrDescription" />
                        </div>
                        <div class="form-row">
                            <input class="form-control" placeholder="Justification" @bind="newPrJustification" />
                        </div>
                        <div class="form-row">
                            <input class="form-control" placeholder="Preferred Vendor ID (optional)" @bind="newPrVendorId" />
                            <input class="form-control" placeholder="Preferred Vendor Name (optional)" @bind="newPrVendorName" />
                        </div>
                        <div class="form-row">
                            <input class="form-control" placeholder="Notes (optional)" @bind="newPrNotes" />
                        </div>
                        <h5 style="margin-top:0.5rem;">Line Items</h5>
                        @foreach (var line in newPrLines)
                        {
                            <div class="form-row">
                                <span style="color:#aaa;font-size:0.8rem;padding-top:0.4rem;">Line @line.LineNumber</span>
                                <input class="form-control" placeholder="Description" @bind="line.ItemDescription" />
                                <input class="form-control" type="number" step="1" placeholder="Qty" @bind="line.Quantity" />
                                <input class="form-control" placeholder="Unit" @bind="line.UnitOfIssue" />
                                <input class="form-control" type="number" step="0.01" placeholder="Unit Cost" @bind="line.UnitCost" />
                            </div>
                        }
                        <button class="btn btn-sm btn-secondary" @onclick="AddPrLine">+ Add Line</button>
                        <button class="btn btn-primary" style="margin-left:0.5rem;" @onclick="CreatePurchaseRequest">Submit Request</button>
                        @if (createPrMsg != null) { <span class="form-msg">@createPrMsg</span> }
                    </div>
                }
            }
        </div>
    }

    <!-- ─── Purchase Orders Tab ────────────────────────────────────────────────── -->
    @if (activeTab == "po")
    {
        <div class="tab-panel">
            <h3>Purchase Orders</h3>

            <!-- Open POs -->
            <h4>Open / Partially Received</h4>
            @if (openPOs == null || openPOs.Count == 0)
            {
                <p class="text-muted">No open purchase orders.</p>
            }
            else
            {
                <table class="table ifcap-table">
                    <thead>
                        <tr>
                            <th>PO ID</th>
                            <th>Vendor</th>
                            <th>Total</th>
                            <th>Received</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in openPOs)
                        {
                            <tr>
                                <td>@po.PurchaseOrderId</td>
                                <td>@po.VendorName</td>
                                <td>@po.TotalAmount.ToString("C")</td>
                                <td>@po.AmountReceived.ToString("C")</td>
                                <td><span class="badge @PoStatusBadge(po.Status.ToString())">@po.Status</span></td>
                                <td>@po.IssuedDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    <button class="btn btn-sm btn-success" @onclick='() => ToggleReceivePanel(po.PurchaseOrderId)'>Receive Goods</button>
                                    <button class="btn btn-sm btn-danger" @onclick='() => ToggleCancelPoPanel(po.PurchaseOrderId)'>Cancel</button>
                                </td>
                            </tr>
                            @if (receivingPoId == po.PurchaseOrderId)
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="form-panel">
                                            <div class="form-row">
                                                <input class="form-control" placeholder="Received By User ID" @bind="rrUserId" />
                                                <input class="form-control" placeholder="Received By Name" @bind="rrUserName" />
                                                <input class="form-control" placeholder="Notes (optional)" @bind="rrNotes" />
                                            </div>
                                            @foreach (var line in rrLines)
                                            {
                                                <div class="form-row">
                                                    <span style="color:#aaa;font-size:0.8rem;padding-top:0.4rem;">Line @line.LineNumber</span>
                                                    <input class="form-control" type="number" step="0.01" placeholder="Qty Received" @bind="line.QuantityReceived" />
                                                    <input class="form-control" type="number" step="0.01" placeholder="Qty Accepted" @bind="line.QuantityAccepted" />
                                                    <input class="form-control" placeholder="Condition (optional)" @bind="line.Condition" />
                                                </div>
                                            }
                                            <button class="btn btn-success" @onclick='() => SubmitReceivingReport(po.PurchaseOrderId)'>Submit Receiving Report</button>
                                            @if (rrMsg != null) { <span class="form-msg">@rrMsg</span> }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (cancelPoId == po.PurchaseOrderId)
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="form-panel">
                                            <div class="form-row">
                                                <input class="form-control" placeholder="User ID" @bind="cancelPoUserId" />
                                                <input class="form-control" placeholder="Reason" @bind="cancelPoReason" />
                                                <button class="btn btn-danger" @onclick='() => CancelPurchaseOrder(po.PurchaseOrderId)'>Confirm Cancel</button>
                                            </div>
                                            @if (cancelPoMsg != null) { <span class="form-msg">@cancelPoMsg</span> }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }

            <!-- All POs -->
            <h4 style="margin-top:1.5rem;">All Purchase Orders</h4>
            @if (allPOs == null || allPOs.Count == 0)
            {
                <p class="text-muted">No purchase orders on file.</p>
            }
            else
            {
                <table class="table ifcap-table">
                    <thead>
                        <tr>
                            <th>PO ID</th>
                            <th>Vendor</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Issued</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var po in allPOs)
                        {
                            <tr>
                                <td>@po.PurchaseOrderId</td>
                                <td>@po.VendorName</td>
                                <td>@po.TotalAmount.ToString("C")</td>
                                <td><span class="badge @PoStatusBadge(po.Status.ToString())">@po.Status</span></td>
                                <td>@po.IssuedDate.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @if (po.Status == PurchaseOrderStatus.Received)
                                    {
                                        <button class="btn btn-sm btn-secondary" @onclick='() => ClosePoConfirm(po.PurchaseOrderId)'>Close</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <!-- Create PO from Approved PR -->
            <button class="btn btn-success btn-sm" style="margin-top:1rem;" @onclick='() => showCreatePo = !showCreatePo'>+ Create Purchase Order</button>
            @if (showCreatePo)
            {
                <div class="form-panel">
                    <h4>Issue Purchase Order from Approved Request</h4>
                    <div class="form-row">
                        <input class="form-control" placeholder="Request ID (approved 2237)" @bind="newPoRequestId" />
                        <input class="form-control" placeholder="Control Point ID" @bind="newPoControlPointId" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Vendor ID" @bind="newPoVendorId" />
                        <input class="form-control" placeholder="Vendor Name" @bind="newPoVendorName" />
                        <input class="form-control" placeholder="Vendor Address (optional)" @bind="newPoVendorAddress" />
                    </div>
                    <div class="form-row">
                        <label>Required Delivery Date</label>
                        <input class="form-control" type="date" @bind="newPoRequiredDelivery" />
                        <input class="form-control" placeholder="Issued By User ID" @bind="newPoIssuedByUserId" />
                        <input class="form-control" placeholder="Issued By Name" @bind="newPoIssuedByUserName" />
                    </div>
                    <h5 style="margin-top:0.5rem;">Line Items</h5>
                    @foreach (var line in newPoLines)
                    {
                        <div class="form-row">
                            <span style="color:#aaa;font-size:0.8rem;padding-top:0.4rem;">Line @line.LineNumber</span>
                            <input class="form-control" placeholder="Description" @bind="line.ItemDescription" />
                            <input class="form-control" type="number" step="1" placeholder="Qty" @bind="line.Quantity" />
                            <input class="form-control" placeholder="Unit" @bind="line.UnitOfIssue" />
                            <input class="form-control" type="number" step="0.01" placeholder="Unit Cost" @bind="line.UnitCost" />
                        </div>
                    }
                    <button class="btn btn-sm btn-secondary" @onclick="AddPoLine">+ Add Line</button>
                    <button class="btn btn-primary" style="margin-left:0.5rem;" @onclick="CreatePurchaseOrder">Issue PO</button>
                    @if (createPoMsg != null) { <span class="form-msg">@createPoMsg</span> }
                </div>
            }
        </div>
    }

    <!-- ─── Vendors Tab ─────────────────────────────────────────────────────────── -->
    @if (activeTab == "vendor")
    {
        <div class="tab-panel">
            <h3>Vendor Directory</h3>

            <div class="form-row">
                <input class="form-control" placeholder="Search name or vendor number" @bind="vendorSearch" />
                <button class="btn btn-primary" @onclick="SearchVendors">Search</button>
                <button class="btn btn-secondary" @onclick="LoadVendors">All</button>
            </div>

            @if (vendors == null || vendors.Count == 0)
            {
                <p class="text-muted">No vendors found.</p>
            }
            else
            {
                <table class="table ifcap-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Vendor #</th>
                            <th>SB</th>
                            <th>WO</th>
                            <th>SDVO</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in vendors)
                        {
                            <tr>
                                <td>@v.Name</td>
                                <td>@v.VendorNumber</td>
                                <td>@(v.IsSmallBusiness ? "✓" : "—")</td>
                                <td>—</td>
                                <td>@(v.IsVeteranOwned ? "✓" : "—")</td>
                                <td><span class="badge @(v.IsActive ? "badge-success" : "badge-secondary")">@(v.IsActive ? "Active" : "Inactive")</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <button class="btn btn-success btn-sm" style="margin-top:1rem;" @onclick='() => showCreateVendor = !showCreateVendor'>+ New Vendor</button>
            @if (showCreateVendor)
            {
                <div class="form-panel">
                    <h4>Register Vendor</h4>
                    <div class="form-row">
                        <input class="form-control" placeholder="Vendor Name" @bind="newVendorName" />
                        <input class="form-control" placeholder="Vendor Number" @bind="newVendorNumber" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Address" @bind="newVendorAddress" />
                        <input class="form-control" placeholder="City" @bind="newVendorCity" />
                        <input class="form-control" placeholder="State" @bind="newVendorState" />
                        <input class="form-control" placeholder="ZIP" @bind="newVendorZip" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Phone (optional)" @bind="newVendorPhone" />
                        <input class="form-control" placeholder="Email (optional)" @bind="newVendorEmail" />
                        <input class="form-control" placeholder="Contact Name (optional)" @bind="newVendorContact" />
                        <input class="form-control" placeholder="DUNS/SAM (optional)" @bind="newVendorDuns" />
                    </div>
                    <div class="form-row checkboxes">
                        <label><input type="checkbox" @bind="newVendorSb" /> Small Business</label>
                        <label><input type="checkbox" @bind="newVendorWo" /> Woman-Owned</label>
                        <label><input type="checkbox" @bind="newVendorVo" /> Veteran-Owned (SDVO)</label>
                    </div>
                    <button class="btn btn-primary" @onclick="CreateVendor">Register</button>
                    @if (createVendorMsg != null) { <span class="form-msg">@createVendorMsg</span> }
                </div>
            }
        </div>
    }

    <!-- ─── Site Parameters Tab ────────────────────────────────────────────────── -->
    @if (activeTab == "site")
    {
        <div class="tab-panel">
            <h3>IFCAP Site Parameters</h3>

            @if (siteParams != null)
            {
                <div class="detail-grid">
                    <div><strong>Site Name:</strong> @siteParams.SiteName</div>
                    <div><strong>Facility #:</strong> @siteParams.FacilityNumber</div>
                    <div><strong>Fiscal Year:</strong> @siteParams.FiscalYear</div>
                    <div><strong>Default Delivery Days:</strong> @siteParams.DefaultDeliveryDays</div>
                    <div><strong>Auto-Approval:</strong> @(siteParams.IsAutoApprovalEnabled ? "Yes" : "No")</div>
                    <div><strong>Auto-Approval Threshold:</strong> @siteParams.AutoApprovalThreshold.ToString("C")</div>
                    <div><strong>PO Number Prefix:</strong> @siteParams.PONumberPrefix</div>
                </div>
            }

            <div class="form-panel">
                <h4>Update Site Parameters</h4>
                <div class="form-row">
                    <input class="form-control" placeholder="Site Name" @bind="spSiteName" />
                    <input class="form-control" placeholder="Facility Number" @bind="spFacilityNumber" />
                    <input class="form-control" type="number" placeholder="Fiscal Year" @bind="spFiscalYear" />
                </div>
                <div class="form-row">
                    <input class="form-control" type="number" placeholder="Default Delivery Days" @bind="spDeliveryDays" />
                    <input class="form-control" type="number" step="0.01" placeholder="Auto-Approval Threshold ($)" @bind="spAutoApprovalThreshold" />
                    <input class="form-control" placeholder="PO Number Prefix" @bind="spPoPrefix" />
                </div>
                <div class="form-row checkboxes">
                    <label><input type="checkbox" @bind="spAutoApproval" /> Auto-Approval Enabled</label>
                </div>
                <div class="form-row">
                    <input class="form-control" placeholder="Updated By User ID" @bind="spUpdatedByUserId" />
                </div>
                <button class="btn btn-primary" @onclick="UpdateSiteParams">Update Parameters</button>
                @if (siteParamsMsg != null) { <span class="form-msg">@siteParamsMsg</span> }
            </div>
        </div>
    }
</div>

@code {
