    private string newPoIssuedByUserName = string.Empty;
    private List<PrLineForm> newPoLines = new() { new PrLineForm { LineNumber = 1 } };
    private string? createPoMsg;
    private string? receivingPoId;
    private List<RrLineForm> rrLines = new();
    private string rrUserId = string.Empty;
