@page "/cqm"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Clinical Quality Measures</PageTitle>
<h1>Clinical Quality Measures (eCQM)</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }

<div class="tab-bar">
    <button class="tab @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">Measures</button>
    <button class="tab @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Reports</button>
    <button class="tab @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">Run Measure</button>
</div>

@* ── Measures Tab ── *@
@if (activeTab == 0)
{
    <div class="form-actions">
        <button @onclick="LoadAllMeasures" disabled="@loadingMeasures" class="btn btn-primary">
            @if (loadingMeasures) { <span>Loading...</span> } else { <span>Load All Measures</span> }
        </button>
        <button @onclick="LoadActiveMeasures" disabled="@loadingMeasures" class="btn btn-secondary">Active Only</button>
    </div>

    @if (measures != null && measures.Count > 0)
    {
        <table class="data-table">
            <thead><tr><th>Measure ID</th><th>Title</th><th>Domain</th><th>Type</th><th>NQF #</th><th>Active</th></tr></thead>
            <tbody>
                @foreach (var m in measures)
                {
                    <tr>
                        <td class="code">@m.MeasureId</td>
                        <td>@m.Title</td>
                        <td>@m.ClinicalDomain</td>
                        <td>@m.MeasureType</td>
                        <td>@(m.NqfNumber ?? "---")</td>
                        <td>@(m.IsActive ? "Yes" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (measures != null) { <div class="empty-state">No quality measures found.</div> }
}

@* ── Reports Tab ── *@
@if (activeTab == 1)
{
    <div class="form-section">
        <div class="form-row">
            <label>Report ID</label>
            <input type="text" class="form-input" @bind="viewReportId" @bind:event="oninput" placeholder="CQM-REPORT:{id}" />
            <button @onclick="LoadReport" disabled="@(string.IsNullOrWhiteSpace(viewReportId) || loadingReport)" class="btn btn-primary">
                @if (loadingReport) { <span>Loading...</span> } else { <span>Load Report</span> }
            </button>
        </div>
    </div>

    @if (report != null)
    {
        <div class="detail-card">
            <h3>Report: @report.MeasureId</h3>
            <div class="detail-grid">
                <div><strong>Report ID:</strong> <span class="code">@report.ReportId</span></div>
                <div><strong>Status:</strong> <span class="badge @StatusBadgeClass(report.Status)">@report.Status</span></div>
                <div><strong>Period:</strong> @report.PeriodStart.ToString("MM/dd/yyyy") - @report.PeriodEnd.ToString("MM/dd/yyyy")</div>
                <div><strong>Initial Population:</strong> @report.InitialPopulationCount</div>
            </div>
            @if (report.PatientResults.Count > 0)
            {
                <h4>Patient Results (@report.PatientResults.Count)</h4>
                <table class="data-table">
                    <thead><tr><th>Patient ID</th><th>In IPP</th><th>In Denominator</th><th>In Numerator</th><th>Excluded</th></tr></thead>
                    <tbody>
                        @foreach (var pr in report.PatientResults)
                        {
                            <tr>
                                <td class="code">@pr.PatientId</td>
                                <td>@(pr.InInitialPopulation ? "Yes" : "No")</td>
                                <td>@(pr.InDenominator ? "Yes" : "No")</td>
                                <td>@(pr.InNumerator ? "Yes" : "No")</td>
                                <td>@(pr.IsDenominatorExclusion ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }
}

@* ── Run Measure Tab ── *@
@if (activeTab == 2)
{
    <div class="form-section">
        <h3>Evaluate a Quality Measure</h3>
        <div class="form-row">
            <label>Measure ID</label>
            <input type="text" class="form-input" @bind="evalMeasureId" placeholder="CMS122v12" />
        </div>
        <div class="form-row">
            <label>Patient IDs</label>
            <input type="text" class="form-input" @bind="evalPatientIds" placeholder="Comma-separated patient IDs" />
        </div>
        <div class="form-row">
            <label>Period Start</label>
            <input type="date" class="form-input" @bind="evalPeriodStart" />
        </div>
        <div class="form-row">
            <label>Period End</label>
            <input type="date" class="form-input" @bind="evalPeriodEnd" />
        </div>
        <div class="form-actions">
            <button @onclick="RunEvaluation" disabled="@(string.IsNullOrWhiteSpace(evalMeasureId) || string.IsNullOrWhiteSpace(evalPatientIds) || evaluating)" class="btn btn-primary">
                @if (evaluating) { <span>Evaluating...</span> } else { <span>Evaluate Measure</span> }
            </button>
        </div>
    </div>

    @if (evalResult != null)
    {
        <div class="detail-card">
            <h3>Evaluation Result</h3>
            <div class="detail-grid">
                <div><strong>Report ID:</strong> <span class="code">@evalResult.ReportId</span></div>
                <div><strong>Status:</strong> @evalResult.Status</div>
                <div><strong>Initial Population:</strong> @evalResult.InitialPopulationCount</div>
                <div><strong>Patients Evaluated:</strong> @evalResult.PatientResults.Count</div>
            </div>
        </div>
    }
}

@code {
    private int activeTab;
    private string? error, success;

    // Measures Tab
    private bool loadingMeasures;
    private List<CqmMeasureSummary>? measures;

    // Reports Tab
    private string? viewReportId;
    private bool loadingReport;
    private CqmReportState? report;

    // Run Measure Tab
    private string evalMeasureId = string.Empty, evalPatientIds = string.Empty;
    private DateTime evalPeriodStart = new(2025, 1, 1), evalPeriodEnd = new(2025, 12, 31);
    private bool evaluating;
    private CqmReportState? evalResult;

    private static string StatusBadgeClass(string status) => status?.ToLower() switch
    {
        "completed"  => "badge-success",
        "pending"    => "badge-warning",
        "evaluating" => "badge-info",
        "error"      => "badge-danger",
        _            => "badge-neutral",
    };

    private ICqmMeasureIndexGrain GetIndex() => Grains.GetGrain<ICqmMeasureIndexGrain>("CQM-INDEX");

    private async Task LoadAllMeasures()
    {
        loadingMeasures = true; error = null;
        try { measures = await GetIndex().GetAllMeasuresAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingMeasures = false; }
    }

    private async Task LoadActiveMeasures()
    {
        loadingMeasures = true; error = null;
        try { measures = await GetIndex().GetActiveMeasuresAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingMeasures = false; }
    }

    private async Task LoadReport()
    {
        if (string.IsNullOrWhiteSpace(viewReportId)) return;
        loadingReport = true; error = null;
        try
        {
            var grain = Grains.GetGrain<ICqmReportGrain>(viewReportId.Trim());
            report = await grain.GetReportAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingReport = false; }
    }

    private async Task RunEvaluation()
    {
        if (string.IsNullOrWhiteSpace(evalMeasureId) || string.IsNullOrWhiteSpace(evalPatientIds)) return;
        evaluating = true; error = null; success = null;
        try
        {
            string reportId = $"CQM-REPORT:{Guid.NewGuid():N}";
            var grain = Grains.GetGrain<ICqmReportGrain>(reportId);
            List<string> patientList = evalPatientIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            await grain.EvaluateAsync(evalMeasureId.Trim(), patientList, evalPeriodStart, evalPeriodEnd, null);
            evalResult = await grain.GetReportAsync();
            success = $"Evaluation complete. Report ID: {reportId}";
            viewReportId = reportId;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { evaluating = false; }
    }
}

<style>
    /* Canonical interaction classes (tab-bar, tab, btn, btn-primary, btn-secondary,
       alert, alert-error, alert-success, data-table, form-input, badge, badge-*,
       empty-state) are defined once in app.css per UI-CONVENTIONS.md.
       Only page-specific styles (layout, report detail card, code text) live here. */
    .form-section { max-width: 700px; } .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row label:first-child { width: 160px; font-size: 0.85rem; font-weight: 500; color: #333; flex-shrink: 0; }
    .form-input { max-width: 350px; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1rem; margin-bottom: 1.5rem; }
    .code { font-family: inherit; color: #003f72; }
    .detail-card { background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 6px; padding: 1.5rem; margin-bottom: 1rem; }
    .detail-card h3 { color: #003f72; margin-top: 0; } .detail-card h4 { color: #003f72; margin-bottom: 0.5rem; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 2rem; font-size: 0.85rem; color: #333; margin-bottom: 1rem; }
    .detail-grid strong { color: #003f72; }
</style>
