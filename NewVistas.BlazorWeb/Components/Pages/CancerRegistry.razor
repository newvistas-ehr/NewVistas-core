@page "/cancerregistry"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@using NewVistas.Abstractions.Security
@inject OrleansGrainService Grains
@inject UserSecurityContext SecurityContext

<PageTitle>Cancer Registry</PageTitle>
<h1>Cancer Registry -- NAACCR Reporting</h1>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (success != null) { <div class="alert alert-success">@success</div> }
@if (!CanEdit) { <div class="alert alert-info">👁 Read-only — viewing oncology. Editing requires the ONCO MANAGER security key (oncologists).</div> }

<div class="tab-bar">
    <button class="tab @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">Report List</button>
    <button class="tab @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">Report Detail</button>
    @if (CanEdit)
    {
        <button class="tab @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">New Report</button>
    }
</div>

@* ── Report List Tab ── *@
@if (activeTab == 0)
{
    <div class="form-actions">
        <button @onclick="LoadAllReports" disabled="@loadingReports" class="btn btn-primary">
            @if (loadingReports) { <span>Loading...</span> } else { <span>Load All Reports</span> }
        </button>
        <button @onclick="LoadPendingReports" disabled="@loadingReports" class="btn btn-secondary">Pending Only</button>
    </div>

    <div class="form-section">
        <div class="form-row">
            <label>Filter by Patient</label>
            <input type="text" class="form-input" @bind="filterPatientId" @bind:event="oninput" placeholder="Patient ID" />
            <button @onclick="LoadPatientReports" disabled="@(string.IsNullOrWhiteSpace(filterPatientId) || loadingReports)" class="btn btn-primary">Filter</button>
        </div>
    </div>

    @if (reports != null && reports.Count > 0)
    {
        <table class="data-table">
            <thead><tr><th>Report ID</th><th>Patient</th><th>Primary Site</th><th>Diagnosis</th><th>Status</th><th>Facility</th><th>Created</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in reports)
                {
                    <tr>
                        <td class="code">@r.ReportId</td>
                        <td>@r.PatientName<br /><span class="id-small">@r.PatientId</span></td>
                        <td>@r.PrimarySiteText</td>
                        <td>@r.DateOfDiagnosis.ToString("MM/dd/yyyy")</td>
                        <td><span class="badge @StatusBadgeClass(r.Status.ToString())">@r.Status</span></td>
                        <td>@r.ReportingFacility</td>
                        <td>@r.CreatedDate.ToString("MM/dd/yyyy")</td>
                        <td><button class="btn btn-primary" @onclick="() => ViewReport(r.PatientId, r.ReportId)">View</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (reports != null) { <div class="empty-state">No cancer registry reports found.</div> }
}

@* ── Report Detail Tab ── *@
@if (activeTab == 1)
{
    <div class="form-section">
        <div class="form-row">
            <label>Patient ID</label>
            <input type="text" class="form-input" @bind="detailPatientId" @bind:event="oninput" placeholder="Patient ID" />
        </div>
        <div class="form-row">
            <label>Report ID</label>
            <input type="text" class="form-input" @bind="detailReportId" @bind:event="oninput" placeholder="CR-REPORT:{id}" />
            <button @onclick="LoadReportDetail" disabled="@(string.IsNullOrWhiteSpace(detailPatientId) || string.IsNullOrWhiteSpace(detailReportId) || loadingDetail)" class="btn btn-primary">
                @if (loadingDetail) { <span>Loading...</span> } else { <span>Load Report</span> }
            </button>
        </div>
    </div>

    @if (reportDetail != null)
    {
        <div class="detail-card">
            <h3>@reportDetail.PatientName -- @reportDetail.PrimarySiteText</h3>
            <div class="detail-grid">
                <div><strong>Report ID:</strong> <span class="code">@reportDetail.ReportId</span></div>
                <div><strong>Patient ID:</strong> @reportDetail.PatientId</div>
                <div><strong>Tumor ID:</strong> <span class="code">@reportDetail.TumorId</span></div>
                <div><strong>Primary Site:</strong> @reportDetail.PrimarySite (@reportDetail.PrimarySiteText)</div>
                <div><strong>Histology:</strong> @reportDetail.Histology (@reportDetail.HistologyText)</div>
                <div><strong>Date of Diagnosis:</strong> @reportDetail.DateOfDiagnosis.ToString("MM/dd/yyyy")</div>
                <div><strong>Stage Group:</strong> @(reportDetail.StageGroup ?? "---")</div>
                <div><strong>SEER Summary Stage:</strong> @(reportDetail.SeerSummaryStage ?? "---")</div>
                <div><strong>Treatment Summary:</strong> @reportDetail.TreatmentSummary</div>
                <div><strong>Status:</strong> <span class="badge @StatusBadgeClass(reportDetail.Status.ToString())">@reportDetail.Status</span></div>
                <div><strong>Facility:</strong> @reportDetail.ReportingFacility</div>
                <div><strong>Registrar:</strong> @reportDetail.RegistrarName</div>
                @if (reportDetail.RegistryName != null) { <div><strong>Registry:</strong> @reportDetail.RegistryName</div> }
                @if (reportDetail.SubmittedDate != null) { <div><strong>Submitted:</strong> @reportDetail.SubmittedDate.Value.ToString("MM/dd/yyyy HH:mm")</div> }
            </div>

            @if (CanEdit && reportDetail.Status == CancerRegistryReportStatus.Generated)
            {
                <div class="action-section">
                    <h4>Submit to Registry</h4>
                    <div class="form-row">
                        <label>Registry Name</label>
                        <input type="text" class="form-input" @bind="submitRegistryName" placeholder="State Cancer Registry" />
                    </div>
                    <div class="form-row">
                        <label>Confirmation #</label>
                        <input type="text" class="form-input" @bind="submitConfirmation" placeholder="Optional" />
                    </div>
                    <button @onclick="SubmitReport" disabled="@(string.IsNullOrWhiteSpace(submitRegistryName) || submitting)" class="btn btn-primary">Submit Report</button>
                </div>
            }
        </div>
    }
}

@* ── New Report Tab ── *@
@if (CanEdit && activeTab == 2)
{
    <div class="form-section">
        <h3>Generate NAACCR Cancer Registry Report</h3>
        <div class="form-row">
            <label>Patient ID</label>
            <input type="text" class="form-input" @bind="newPatientId" placeholder="Patient ID" />
        </div>
        <div class="form-row">
            <label>Tumor ID</label>
            <input type="text" class="form-input" @bind="newTumorId" placeholder="ONCO-TUMOR:{id}" />
        </div>
        <div class="form-row">
            <label>Reporting Facility</label>
            <input type="text" class="form-input" @bind="newFacility" placeholder="VA Medical Center" />
        </div>
        <div class="form-row">
            <label>Registrar ID</label>
            <input type="text" class="form-input" @bind="newRegistrarId" placeholder="REG001" />
        </div>
        <div class="form-row">
            <label>Registrar Name</label>
            <input type="text" class="form-input" @bind="newRegistrarName" placeholder="J. Smith, CTR" />
        </div>
        <div class="form-actions">
            <button @onclick="GenerateReport" disabled="@(string.IsNullOrWhiteSpace(newPatientId) || string.IsNullOrWhiteSpace(newTumorId) || generating)" class="btn btn-primary">
                @if (generating) { <span>Generating...</span> } else { <span>Generate Report</span> }
            </button>
        </div>
    </div>
}

@code {
    private bool CanEdit => SecurityContext.HasKey(SecurityKeys.ONCO_MANAGER);
    private int activeTab;
    private string? error, success;

    // Report List
    private bool loadingReports;
    private List<CancerRegistryReportIndexEntry>? reports;
    private string? filterPatientId;

    // Report Detail
    private string? detailPatientId, detailReportId;
    private bool loadingDetail;
    private CancerRegistryReportState? reportDetail;
    private string? submitRegistryName, submitConfirmation;
    private bool submitting;

    // New Report
    private string newPatientId = string.Empty, newTumorId = string.Empty;
    private string newFacility = string.Empty, newRegistrarId = string.Empty, newRegistrarName = string.Empty;
    private bool generating;

    private static string StatusBadgeClass(string status) => status?.ToLowerInvariant() switch
    {
        "generated" => "badge-info",
        "submitted" => "badge-warning",
        "accepted"  => "badge-success",
        "rejected"  => "badge-danger",
        _           => "badge-neutral",
    };

    private ICancerRegistryReportIndexGrain GetIndex() => Grains.GetGrain<ICancerRegistryReportIndexGrain>("CR-REPORT-INDEX");

    private async Task LoadAllReports()
    {
        loadingReports = true; error = null;
        try { reports = await GetIndex().GetAllReportsAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingReports = false; }
    }

    private async Task LoadPendingReports()
    {
        loadingReports = true; error = null;
        try { reports = await GetIndex().GetPendingReportsAsync(); }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingReports = false; }
    }

    private async Task LoadPatientReports()
    {
        if (string.IsNullOrWhiteSpace(filterPatientId)) return;
        loadingReports = true; error = null;
        try { reports = await GetIndex().GetReportsByPatientAsync(filterPatientId.Trim()); }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingReports = false; }
    }

    private async Task ViewReport(string patientId, string reportId)
    {
        detailPatientId = patientId; detailReportId = reportId;
        activeTab = 1;
        await LoadReportDetail();
    }

    private async Task LoadReportDetail()
    {
        if (string.IsNullOrWhiteSpace(detailPatientId) || string.IsNullOrWhiteSpace(detailReportId)) return;
        loadingDetail = true; error = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(detailPatientId.Trim());
            reportDetail = await workflow.GetCancerRegistryReportAsync(detailReportId.Trim());
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingDetail = false; }
    }

    private async Task SubmitReport()
    {
        if (reportDetail == null || string.IsNullOrWhiteSpace(submitRegistryName)) return;
        submitting = true; error = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(reportDetail.PatientId);
            await workflow.SubmitCancerRegistryReportAsync(reportDetail.ReportId, submitRegistryName, submitConfirmation);
            success = $"Report {reportDetail.ReportId} submitted to {submitRegistryName}.";
            await LoadReportDetail();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { submitting = false; }
    }

    private async Task GenerateReport()
    {
        if (string.IsNullOrWhiteSpace(newPatientId) || string.IsNullOrWhiteSpace(newTumorId)) return;
        generating = true; error = null; success = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(newPatientId.Trim());
            string reportId = await workflow.GenerateCancerRegistryReportAsync(
                newTumorId.Trim(), newFacility, newRegistrarId, newRegistrarName);
            success = $"Report generated: {reportId}";
            detailPatientId = newPatientId.Trim(); detailReportId = reportId;
            activeTab = 1;
            await LoadReportDetail();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { generating = false; }
    }
}

<style>
    /* Canonical interaction classes (tab-bar, tab, btn, btn-primary, btn-secondary,
       alert, alert-error, alert-success, data-table, form-input, badge, badge-*,
       empty-state) are defined once in app.css per UI-CONVENTIONS.md.
       Only page-specific styles (layout, report detail card, code/id text) live here. */
    .form-section { max-width: 700px; } .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row label:first-child { width: 160px; font-size: 0.85rem; font-weight: 500; color: #333; flex-shrink: 0; }
    .form-input { max-width: 350px; }
    .form-actions { display: flex; gap: 0.75rem; margin-top: 1rem; margin-bottom: 1.5rem; }
    .code { font-family: inherit; color: #003f72; }
    .id-small { font-size: 0.75rem; color: #555; }
    .detail-card { background: #f9fafb; border: 1px solid #d4d9e0; border-radius: 6px; padding: 1.5rem; }
    .detail-card h3 { color: #003f72; margin-top: 0; }
    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 2rem; font-size: 0.85rem; color: #333; margin-bottom: 1rem; }
    .detail-grid strong { color: #003f72; }
    .action-section { border-top: 1px solid #d4d9e0; padding-top: 1rem; margin-top: 1rem; }
    .action-section h4 { color: #003f72; margin-top: 0; }
</style>
