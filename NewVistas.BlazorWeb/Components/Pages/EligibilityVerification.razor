@page "/eligibility-verification"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Insurance Eligibility Verification (EDI 270/271)</PageTitle>

<h1>Insurance Eligibility Verification</h1>
<p class="page-subtitle">EDI 270 Inquiry / 271 Response — VistA IB Eligibility Verification (IBCNEDE*.m)</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadHistory" />
<div class="form-actions">
    <button class="btn btn-primary" @onclick="LoadDemo" disabled="@loading">Load Demo Data</button>
</div>
<AlertBanner Error="@error" Success="@submitResult" />

<TabStrip Tabs="_tabs" @bind-Active="ActiveTab" />

@* ─── Verification History Tab ─────────────────────────────────────────── *@
@if (activeTab == "history")
{
    @if (history != null && history.Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Payer</th>
                    <th>Subscriber ID</th>
                    <th>Service Date</th>
                    <th>Status</th>
                    <th>Coverage</th>
                    <th>Submitted</th>
                    <th>Response</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in history)
                {
                    <tr>
                        <td>@entry.PayerName</td>
                        <td>@entry.SubscriberId</td>
                        <td>@entry.ServiceDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @GetStatusBadge(entry.Status)">@entry.Status</span></td>
                        <td><span class="badge @GetCoverageBadge(entry.CoverageLevel)">@entry.CoverageLevel</span></td>
                        <td>@entry.SubmittedDate?.ToString("MM/dd HH:mm")</td>
                        <td>@entry.ResponseDate?.ToString("MM/dd HH:mm")</td>
                        <td><button class="btn btn-primary" @onclick="() => ViewDetail(entry.InquiryId)">View</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (!loading)
    {
        <div class="empty-state">No eligibility verifications found. Enter a Patient ID and click Load.</div>
    }
}

@* ─── Inquiry Detail Tab ───────────────────────────────────────────────── *@
@if (activeTab == "detail" && selectedInquiry != null)
{
    <div class="form-section">
        <h3>Inquiry: @selectedInquiry.InquiryId <span class="badge @GetStatusBadge(selectedInquiry.Status)">@selectedInquiry.Status</span></h3>

        <h3>270 Inquiry Details</h3>
        <p><strong>Payer:</strong> @selectedInquiry.PayerName (@selectedInquiry.PayerId)</p>
        <p><strong>Subscriber ID:</strong> @selectedInquiry.SubscriberId</p>
        <p><strong>Subscriber Name:</strong> @(selectedInquiry.SubscriberName ?? "—")</p>
        <p><strong>Relationship:</strong> @(selectedInquiry.RelationshipToSubscriber ?? "—")</p>
        <p><strong>Service Date:</strong> @selectedInquiry.ServiceDate.ToString("yyyy-MM-dd")</p>
        <p><strong>Service Types:</strong> @string.Join(", ", selectedInquiry.ServiceTypeCodes)</p>
        <p><strong>Trace #:</strong> @(selectedInquiry.TraceNumber ?? "—")</p>
        <p><strong>Submitted:</strong> @selectedInquiry.SubmittedDate?.ToString("yyyy-MM-dd HH:mm:ss")</p>
        <p><strong>Initiated By:</strong> @(selectedInquiry.InitiatedByUserName ?? "—")</p>

        <h3>271 Response</h3>
        <p><strong>Coverage Level:</strong> <span class="badge @GetCoverageBadge(selectedInquiry.CoverageLevel)">@selectedInquiry.CoverageLevel</span></p>
        <p><strong>Plan Name:</strong> @(selectedInquiry.ResponsePlanName ?? "—")</p>
        <p><strong>Group #:</strong> @(selectedInquiry.ResponseGroupNumber ?? "—")</p>
        <p><strong>Effective:</strong> @(selectedInquiry.CoverageEffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</p>
        <p><strong>Terminates:</strong> @(selectedInquiry.CoverageTerminationDate?.ToString("yyyy-MM-dd") ?? "—")</p>
        <p><strong>Response Date:</strong> @selectedInquiry.ResponseDate?.ToString("yyyy-MM-dd HH:mm:ss")</p>
        <p><strong>Payer Message:</strong> @(selectedInquiry.PayerMessage ?? "—")</p>

        @if (selectedInquiry.BenefitDetails.Count > 0)
        {
            <h3>Benefit Details (EB Segments)</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Service</th>
                        <th>Period</th>
                        <th>Amount</th>
                        <th>%</th>
                        <th>Network</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in selectedInquiry.BenefitDetails)
                    {
                        <tr>
                            <td>@b.BenefitType</td>
                            <td>@(b.ServiceTypeDescription ?? b.ServiceTypeCode)</td>
                            <td>@(b.TimePeriod ?? "—")</td>
                            <td>@(b.Amount?.ToString("C") ?? "—")</td>
                            <td>@(b.Percentage?.ToString("P0") ?? "—")</td>
                            <td>@(b.NetworkIndicator ?? "—")</td>
                            <td>@(b.Message ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (selectedInquiry.RejectReasonCodes.Count > 0)
        {
            <div class="alert alert-error"><strong>Reject Reason Codes:</strong> @string.Join(", ", selectedInquiry.RejectReasonCodes)</div>
        }
    </div>
}

@* ─── New Inquiry Tab ──────────────────────────────────────────────────── *@
@if (activeTab == "new")
{
    <div class="form-section">
        <h3>Submit Eligibility Inquiry (EDI 270)</h3>
        <FormField Label="Payer ID" Required><input class="form-input" @bind="newPayerId" placeholder="e.g. PAYER-MEDICARE" /></FormField>
        <FormField Label="Payer Name"><input class="form-input" @bind="newPayerName" placeholder="e.g. Medicare Part A/B" /></FormField>
        <FormField Label="Subscriber ID"><input class="form-input" @bind="newSubscriberId" placeholder="Member number" /></FormField>
        <FormField Label="Subscriber Name"><input class="form-input" @bind="newSubscriberName" placeholder="LAST,FIRST" /></FormField>
        <FormField Label="Relationship">
            <select class="form-input" @bind="newRelationship">
                <option value="SELF">Self</option>
                <option value="SPOUSE">Spouse</option>
                <option value="CHILD">Child</option>
                <option value="OTHER">Other</option>
            </select>
        </FormField>
        <FormField Label="Service Date"><input type="date" class="form-input" @bind="newServiceDate" /></FormField>
        <FormField Label="Insurance Plan ID (optional)"><input class="form-input" @bind="newInsurancePlanId" /></FormField>
        <FormField Label="Personal Policy ID (optional)"><input class="form-input" @bind="newPersonalPolicyId" /></FormField>
        <FormField Label="Notes (optional)"><input class="form-input" @bind="newNotes" /></FormField>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="SubmitInquiry" disabled="@submitting">@(submitting ? "Submitting..." : "Submit 270 Inquiry")</button>
        </div>
    </div>
}

@* ─── Payer Directory Tab ──────────────────────────────────────────────── *@
@if (activeTab == "payers")
{
    <div class="lookup-bar">
        <input class="lookup-input" placeholder="Search payers..." @bind="payerSearch" @bind:event="oninput" />
        <button class="btn btn-primary" @onclick="SearchPayers">Search</button>
        <button class="btn btn-primary" @onclick="LoadRealTimePayers">Real-Time Only</button>
    </div>

    @if (payers != null && payers.Count > 0)
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Payer ID</th>
                    <th>Payer Name</th>
                    <th>Real-Time 270/271</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in payers)
                {
                    <tr>
                        <td>@p.PayerId</td>
                        <td>@p.PayerName</td>
                        <td>@(p.SupportsRealTimeEligibility ? "Yes" : "No")</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Inactive</span>
                            }
                        </td>
                        <td><button class="btn btn-primary" @onclick="() => SelectPayer(p)">Use</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">No payers found.</div>
    }
}

@code {
    private string? patientId;
    private string activeTab = "history";
    private bool loading;
    private string? error;

    // History tab
    private List<EligibilityVerificationIndexEntry>? history;

    // Detail tab
    private EligibilityInquiryState? selectedInquiry;

    // New inquiry tab
    private string newPayerId = string.Empty;
    private string newPayerName = string.Empty;
    private string newSubscriberId = string.Empty;
    private string? newSubscriberName;
    private string newRelationship = "SELF";
    private DateTime newServiceDate = DateTime.Today;
    private string? newInsurancePlanId;
    private string? newPersonalPolicyId;
    private string? newNotes;
    private bool submitting;
    private string? submitResult;

    // Payer directory tab
    private List<PayerConfigIndexEntry>? payers;
    private string payerSearch = string.Empty;

    private readonly (string, string)[] _tabs = new[]
    {
        ("history", "Verification History"),
        ("detail", "Inquiry Detail"),
        ("new", "New Inquiry"),
        ("payers", "Payer Directory"),
    };

    private string ActiveTab
    {
        get => activeTab;
        set
        {
            activeTab = value;
            if (value == "payers" && payers == null) _ = LoadPayers();
        }
    }

    private async Task LoadHistory()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            history = await wf.GetEligibilityVerificationHistoryAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task ViewDetail(string inquiryId)
    {
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());
            selectedInquiry = await wf.GetEligibilityInquiryAsync(inquiryId);
            activeTab = "detail";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SubmitInquiry()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newPayerId)) return;
        submitting = true;
        error = null;
        submitResult = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            string inquiryId = await wf.SubmitEligibilityInquiryAsync(
                newInsurancePlanId, newPersonalPolicyId,
                newPayerId, newPayerName,
                newSubscriberId, newSubscriberName,
                newRelationship, null,
                new List<string> { "30" }, newServiceDate,
                null, null, newNotes);
            submitResult = $"Inquiry submitted successfully. ID: {inquiryId}";
            await LoadHistory();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { submitting = false; }
    }

    private async Task LoadDemo()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await wf.SubmitEligibilityInquiryAsync(
                null, null, "PAYER-MEDICARE", "Medicare Part A/B",
                "1EG4-TE5-MK72", "PATIENT,TEST", "SELF", null,
                new List<string> { "30" }, DateTime.UtcNow,
                "DEMO-USER", "Demo User", "Demo eligibility check");
            await wf.SubmitEligibilityInquiryAsync(
                null, null, "PAYER-BCBS", "Blue Cross Blue Shield",
                "XYZ123456789", "PATIENT,TEST", "SELF", null,
                new List<string> { "30", "1" }, DateTime.UtcNow,
                "DEMO-USER", "Demo User", "Demo supplemental check");
            history = await wf.GetEligibilityVerificationHistoryAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadPayers()
    {
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = await index.GetAllAsync();
            StateHasChanged();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SearchPayers()
    {
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = string.IsNullOrWhiteSpace(payerSearch)
                ? await index.GetAllAsync()
                : await index.SearchAsync(payerSearch);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadRealTimePayers()
    {
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = await index.GetRealTimePayersAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void SelectPayer(PayerConfigIndexEntry p)
    {
        newPayerId = p.PayerId;
        newPayerName = p.PayerName;
        activeTab = "new";
    }

    private string GetStatusBadge(EligibilityInquiryStatus status) => status switch
    {
        EligibilityInquiryStatus.Eligible => "badge-success",
        EligibilityInquiryStatus.Ineligible => "badge-danger",
        EligibilityInquiryStatus.Error => "badge-warning",
        EligibilityInquiryStatus.Submitted => "badge-info",
        EligibilityInquiryStatus.Draft => "badge-neutral",
        EligibilityInquiryStatus.Expired => "badge-neutral",
        _ => "badge-neutral",
    };

    private string GetCoverageBadge(CoverageLevel level) => level switch
    {
        CoverageLevel.ActiveCoverage => "badge-success",
        CoverageLevel.ActiveLimited => "badge-warning",
        CoverageLevel.Inactive => "badge-danger",
        CoverageLevel.Terminated => "badge-danger",
        CoverageLevel.Pending => "badge-info",
        _ => "badge-neutral",
    };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.5; }
</style>
