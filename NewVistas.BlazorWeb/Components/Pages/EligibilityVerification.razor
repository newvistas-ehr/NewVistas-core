@page "/eligibility-verification"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Insurance Eligibility Verification (EDI 270/271)</PageTitle>

<h3>Insurance Eligibility Verification</h3>
<p class="text-muted">EDI 270 Inquiry / 271 Response — VistA IB Eligibility Verification (IBCNEDE*.m)</p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:260px" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadHistory" disabled="@loading">Load</button>
    <button class="btn btn-outline-secondary" @onclick="LoadDemo" disabled="@loading">Load Demo Data</button>
</div>

@if (error != null)
{
    <div class="alert alert-danger">@error</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(activeTab == "history" ? "active" : "")" @onclick='() => activeTab = "history"'>Verification History</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "detail" ? "active" : "")" @onclick='() => activeTab = "detail"'>Inquiry Detail</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "new" ? "active" : "")" @onclick='() => activeTab = "new"'>New Inquiry</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(activeTab == "payers" ? "active" : "")" @onclick="LoadPayers">Payer Directory</button>
    </li>
</ul>

@* ─── Verification History Tab ─────────────────────────────────────────── *@
@if (activeTab == "history")
{
    @if (history != null && history.Count > 0)
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Payer</th>
                    <th>Subscriber ID</th>
                    <th>Service Date</th>
                    <th>Status</th>
                    <th>Coverage</th>
                    <th>Submitted</th>
                    <th>Response</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in history)
                {
                    <tr>
                        <td>@entry.PayerName</td>
                        <td>@entry.SubscriberId</td>
                        <td>@entry.ServiceDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            <span class="badge @GetStatusBadge(entry.Status)">@entry.Status</span>
                        </td>
                        <td>
                            <span class="badge @GetCoverageBadge(entry.CoverageLevel)">@entry.CoverageLevel</span>
                        </td>
                        <td>@entry.SubmittedDate?.ToString("MM/dd HH:mm")</td>
                        <td>@entry.ResponseDate?.ToString("MM/dd HH:mm")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetail(entry.InquiryId)">View</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else if (!loading)
    {
        <p class="text-muted">No eligibility verifications found. Enter a Patient ID and click Load.</p>
    }
}

@* ─── Inquiry Detail Tab ───────────────────────────────────────────────── *@
@if (activeTab == "detail" && selectedInquiry != null)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>Inquiry:</strong> @selectedInquiry.InquiryId
            <span class="badge @GetStatusBadge(selectedInquiry.Status) ms-2">@selectedInquiry.Status</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h6>270 Inquiry Details</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Payer</dt>
                        <dd class="col-sm-7">@selectedInquiry.PayerName (@selectedInquiry.PayerId)</dd>
                        <dt class="col-sm-5">Subscriber ID</dt>
                        <dd class="col-sm-7">@selectedInquiry.SubscriberId</dd>
                        <dt class="col-sm-5">Subscriber Name</dt>
                        <dd class="col-sm-7">@(selectedInquiry.SubscriberName ?? "—")</dd>
                        <dt class="col-sm-5">Relationship</dt>
                        <dd class="col-sm-7">@(selectedInquiry.RelationshipToSubscriber ?? "—")</dd>
                        <dt class="col-sm-5">Service Date</dt>
                        <dd class="col-sm-7">@selectedInquiry.ServiceDate.ToString("yyyy-MM-dd")</dd>
                        <dt class="col-sm-5">Service Types</dt>
                        <dd class="col-sm-7">@string.Join(", ", selectedInquiry.ServiceTypeCodes)</dd>
                        <dt class="col-sm-5">Trace #</dt>
                        <dd class="col-sm-7">@(selectedInquiry.TraceNumber ?? "—")</dd>
                        <dt class="col-sm-5">Submitted</dt>
                        <dd class="col-sm-7">@selectedInquiry.SubmittedDate?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt class="col-sm-5">Initiated By</dt>
                        <dd class="col-sm-7">@(selectedInquiry.InitiatedByUserName ?? "—")</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <h6>271 Response</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Coverage Level</dt>
                        <dd class="col-sm-7">
                            <span class="badge @GetCoverageBadge(selectedInquiry.CoverageLevel)">@selectedInquiry.CoverageLevel</span>
                        </dd>
                        <dt class="col-sm-5">Plan Name</dt>
                        <dd class="col-sm-7">@(selectedInquiry.ResponsePlanName ?? "—")</dd>
                        <dt class="col-sm-5">Group #</dt>
                        <dd class="col-sm-7">@(selectedInquiry.ResponseGroupNumber ?? "—")</dd>
                        <dt class="col-sm-5">Effective</dt>
                        <dd class="col-sm-7">@(selectedInquiry.CoverageEffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt class="col-sm-5">Terminates</dt>
                        <dd class="col-sm-7">@(selectedInquiry.CoverageTerminationDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                        <dt class="col-sm-5">Response Date</dt>
                        <dd class="col-sm-7">@selectedInquiry.ResponseDate?.ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        <dt class="col-sm-5">Payer Message</dt>
                        <dd class="col-sm-7">@(selectedInquiry.PayerMessage ?? "—")</dd>
                    </dl>
                </div>
            </div>

            @if (selectedInquiry.BenefitDetails.Count > 0)
            {
                <h6 class="mt-3">Benefit Details (EB Segments)</h6>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Service</th>
                            <th>Period</th>
                            <th>Amount</th>
                            <th>%</th>
                            <th>Network</th>
                            <th>Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in selectedInquiry.BenefitDetails)
                        {
                            <tr>
                                <td>@b.BenefitType</td>
                                <td>@(b.ServiceTypeDescription ?? b.ServiceTypeCode)</td>
                                <td>@(b.TimePeriod ?? "—")</td>
                                <td>@(b.Amount?.ToString("C") ?? "—")</td>
                                <td>@(b.Percentage?.ToString("P0") ?? "—")</td>
                                <td>@(b.NetworkIndicator ?? "—")</td>
                                <td>@(b.Message ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (selectedInquiry.RejectReasonCodes.Count > 0)
            {
                <div class="alert alert-warning mt-2">
                    <strong>Reject Reason Codes:</strong> @string.Join(", ", selectedInquiry.RejectReasonCodes)
                </div>
            }
        </div>
    </div>
}

@* ─── New Inquiry Tab ──────────────────────────────────────────────────── *@
@if (activeTab == "new")
{
    <div class="card">
        <div class="card-header">Submit Eligibility Inquiry (EDI 270)</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label">Payer ID</label>
                    <input class="form-control" @bind="newPayerId" placeholder="e.g. PAYER-MEDICARE" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Payer Name</label>
                    <input class="form-control" @bind="newPayerName" placeholder="e.g. Medicare Part A/B" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Subscriber ID</label>
                    <input class="form-control" @bind="newSubscriberId" placeholder="Member number" />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label">Subscriber Name</label>
                    <input class="form-control" @bind="newSubscriberName" placeholder="LAST,FIRST" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Relationship</label>
                    <select class="form-select" @bind="newRelationship">
                        <option value="SELF">Self</option>
                        <option value="SPOUSE">Spouse</option>
                        <option value="CHILD">Child</option>
                        <option value="OTHER">Other</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Service Date</label>
                    <input type="date" class="form-control" @bind="newServiceDate" />
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Insurance Plan ID (optional)</label>
                    <input class="form-control" @bind="newInsurancePlanId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Personal Policy ID (optional)</label>
                    <input class="form-control" @bind="newPersonalPolicyId" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Notes (optional)</label>
                    <input class="form-control" @bind="newNotes" />
                </div>
            </div>
            <button class="btn btn-success" @onclick="SubmitInquiry" disabled="@submitting">
                @(submitting ? "Submitting..." : "Submit 270 Inquiry")
            </button>
            @if (submitResult != null)
            {
                <div class="alert alert-success mt-2">@submitResult</div>
            }
        </div>
    </div>
}

@* ─── Payer Directory Tab ──────────────────────────────────────────────── *@
@if (activeTab == "payers")
{
    <div class="mb-2 d-flex gap-2">
        <input class="form-control" style="max-width:260px" placeholder="Search payers..." @bind="payerSearch" @bind:event="oninput" />
        <button class="btn btn-outline-primary btn-sm" @onclick="SearchPayers">Search</button>
        <button class="btn btn-outline-success btn-sm" @onclick="LoadRealTimePayers">Real-Time Only</button>
    </div>

    @if (payers != null && payers.Count > 0)
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th>Payer ID</th>
                    <th>Payer Name</th>
                    <th>Real-Time 270/271</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in payers)
                {
                    <tr>
                        <td>@p.PayerId</td>
                        <td>@p.PayerName</td>
                        <td>
                            @if (p.SupportsRealTimeEligibility)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectPayer(p)">Use</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No payers found.</p>
    }
}

<style>
    dl.row dt { font-weight: 600; }
    dl.row dd { margin-bottom: 0.25rem; }
</style>

@code {
    private string patientId = string.Empty;
    private string activeTab = "history";
    private bool loading;
    private string? error;

    // History tab
    private List<EligibilityVerificationIndexEntry>? history;

    // Detail tab
    private EligibilityInquiryState? selectedInquiry;

    // New inquiry tab
    private string newPayerId = string.Empty;
    private string newPayerName = string.Empty;
    private string newSubscriberId = string.Empty;
    private string? newSubscriberName;
    private string newRelationship = "SELF";
    private DateTime newServiceDate = DateTime.Today;
    private string? newInsurancePlanId;
    private string? newPersonalPolicyId;
    private string? newNotes;
    private bool submitting;
    private string? submitResult;

    // Payer directory tab
    private List<PayerConfigIndexEntry>? payers;
    private string payerSearch = string.Empty;

    private async Task LoadHistory()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            history = await wf.GetEligibilityVerificationHistoryAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task ViewDetail(string inquiryId)
    {
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            selectedInquiry = await wf.GetEligibilityInquiryAsync(inquiryId);
            activeTab = "detail";
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SubmitInquiry()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(newPayerId)) return;
        submitting = true;
        error = null;
        submitResult = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            string inquiryId = await wf.SubmitEligibilityInquiryAsync(
                newInsurancePlanId, newPersonalPolicyId,
                newPayerId, newPayerName,
                newSubscriberId, newSubscriberName,
                newRelationship, null,
                new List<string> { "30" }, newServiceDate,
                null, null, newNotes);
            submitResult = $"Inquiry submitted successfully. ID: {inquiryId}";
            await LoadHistory();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { submitting = false; }
    }

    private async Task LoadDemo()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        error = null;
        try
        {
            IPatientWorkflowGrain wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await wf.SubmitEligibilityInquiryAsync(
                null, null, "PAYER-MEDICARE", "Medicare Part A/B",
                "1EG4-TE5-MK72", "PATIENT,TEST", "SELF", null,
                new List<string> { "30" }, DateTime.UtcNow,
                "DEMO-USER", "Demo User", "Demo eligibility check");
            await wf.SubmitEligibilityInquiryAsync(
                null, null, "PAYER-BCBS", "Blue Cross Blue Shield",
                "XYZ123456789", "PATIENT,TEST", "SELF", null,
                new List<string> { "30", "1" }, DateTime.UtcNow,
                "DEMO-USER", "Demo User", "Demo supplemental check");
            history = await wf.GetEligibilityVerificationHistoryAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    private async Task LoadPayers()
    {
        activeTab = "payers";
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = await index.GetAllAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SearchPayers()
    {
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = string.IsNullOrWhiteSpace(payerSearch)
                ? await index.GetAllAsync()
                : await index.SearchAsync(payerSearch);
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task LoadRealTimePayers()
    {
        error = null;
        try
        {
            IPayerConfigIndexGrain index = Grains.GetGrain<IPayerConfigIndexGrain>("PAYER-CFG-INDEX");
            payers = await index.GetRealTimePayersAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void SelectPayer(PayerConfigIndexEntry p)
    {
        newPayerId = p.PayerId;
        newPayerName = p.PayerName;
        activeTab = "new";
    }

    private string GetStatusBadge(EligibilityInquiryStatus status) => status switch
    {
        EligibilityInquiryStatus.Eligible => "bg-success",
        EligibilityInquiryStatus.Ineligible => "bg-danger",
        EligibilityInquiryStatus.Error => "bg-warning text-dark",
        EligibilityInquiryStatus.Submitted => "bg-info",
        EligibilityInquiryStatus.Draft => "bg-secondary",
        EligibilityInquiryStatus.Expired => "bg-dark",
        _ => "bg-secondary",
    };

    private string GetCoverageBadge(CoverageLevel level) => level switch
    {
        CoverageLevel.ActiveCoverage => "bg-success",
        CoverageLevel.ActiveLimited => "bg-warning text-dark",
        CoverageLevel.Inactive => "bg-danger",
        CoverageLevel.Terminated => "bg-danger",
        CoverageLevel.Pending => "bg-info",
        _ => "bg-secondary",
    };
}
