@page "/labs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains
@inject PatientContextService PatientContext

<PageTitle>Laboratory — LR</PageTitle>

<h2>Laboratory Information System (LR)</h2>
<p class="subtitle">VistA File #63 — lab orders, results, and panels</p>

<div class="tab-bar">
    <button class="@TabClass("results")" @onclick='() => SetTab("results")'>Results</button>
    <button class="@TabClass("summary")" @onclick='() => SetTab("summary")'>Current Summary</button>
    <button class="@TabClass("order")" @onclick='() => SetTab("order")'>Order / Submit</button>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-error">@error</div>
}

@if (!string.IsNullOrEmpty(successMsg))
{
    <div class="alert alert-success">@successMsg</div>
}

@* ── Tab 1: Results ─────────────────────────────────────────── *@
@if (activeTab == "results")
{
    <div class="lookup-bar">
        <input @bind="patientId" placeholder="Patient ID" class="lookup-input" />
        <button class="btn btn-primary" @onclick="LoadResults" disabled="@loading">Load Results</button>
        <button class="btn btn-secondary" @onclick="LoadDemo" disabled="@loading">Load Demo</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading…</p> }

    @if (results is not null)
    {
        <div class="summary-cards">
            <div class="card">
                <span class="card-num">@results.Count</span>
                <span class="card-label">Total Orders</span>
            </div>
            <div class="card card-warn">
                <span class="card-num">@results.Count(r => !string.IsNullOrEmpty(r.Flag))</span>
                <span class="card-label">Abnormal</span>
            </div>
            <div class="card card-pending">
                <span class="card-num">@results.Count(r => r.Status is "Ordered" or "Collected" or "Pending")</span>
                <span class="card-label">Pending</span>
            </div>
        </div>

        @if (results.Count == 0)
        {
            <p class="empty-msg">No lab orders found for this patient.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Test</th>
                        <th>Result</th>
                        <th>Units</th>
                        <th>Flag</th>
                        <th>Status</th>
                        <th>Collected</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (LabResult r in results)
                    {
                        <tr class="@RowClass(r)">
                            <td class="test-name">@r.TestName</td>
                            <td class="result-val @(string.IsNullOrEmpty(r.Flag) ? "" : "flagged")">@(r.ResultValue ?? "—")</td>
                            <td>@(r.Units ?? "—")</td>
                            <td>@if (!string.IsNullOrEmpty(r.Flag)) { <span class="badge @FlagBadge(r.Flag)">@r.Flag</span> } else { <span>—</span> }</td>
                            <td><span class="badge @StatusBadge(r.Status)">@r.Status</span></td>
                            <td class="date-col">@r.CollectionDate?.ToString("MM/dd/yy HH:mm")</td>
                            <td>
                                @if (r.Status == "Ordered")
                                {
                                    <button class="btn btn-primary" @onclick="() => OpenCollect(r.LabTestId)" disabled="@loading">Collect</button>
                                }
                                @if (r.Status == "Collected")
                                {
                                    <button class="btn btn-primary" @onclick="() => OpenResult(r.LabTestId, r.TestName)" disabled="@loading">Enter Result</button>
                                }
                                @if (r.Status == "Completed" && string.IsNullOrEmpty(r.VerifyingProviderName))
                                {
                                    <button class="btn btn-primary" @onclick="() => OpenVerify(r.LabTestId)" disabled="@loading">Verify</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @* Inline collect/result/verify panels *@
    @if (collectLabTestId is not null)
    {
        <div class="action-panel">
            <h4>Record Specimen Collection</h4>
            <div class="form-row">
                <label>Collection Time</label>
                <input type="datetime-local" @bind="collectDateTime" />
            </div>
            <div class="form-row">
                <label>Collection Sample</label>
                <input @bind="collectSample" placeholder="e.g. LAVENDER" />
            </div>
            <div class="form-row">
                <label>Performing Lab</label>
                <input @bind="collectLab" placeholder="e.g. Hematology Lab" />
            </div>
            <div class="panel-actions">
                <button @onclick="SubmitCollect" disabled="@loading" class="btn btn-primary">Submit</button>
                <button @onclick="() => collectLabTestId = null" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (resultLabTestId is not null)
    {
        <div class="action-panel">
            <h4>Enter Result — @resultTestName</h4>
            <div class="form-row">
                <label>Result Value</label>
                <input @bind="resultValue" placeholder="e.g. 7.5" />
            </div>
            <div class="form-row">
                <label>Units</label>
                <input @bind="resultUnit" placeholder="e.g. K/cmm" />
            </div>
            <div class="form-row">
                <label>Reference Low</label>
                <input @bind="resultRefLow" placeholder="e.g. 4.5" />
            </div>
            <div class="form-row">
                <label>Reference High</label>
                <input @bind="resultRefHigh" placeholder="e.g. 11.0" />
            </div>
            <div class="form-row">
                <label>Abnormal Flag</label>
                <select @bind="resultFlag">
                    <option value="">Normal</option>
                    <option value="H">H — High</option>
                    <option value="L">L — Low</option>
                    <option value="CH">CH — Critical High</option>
                    <option value="CL">CL — Critical Low</option>
                    <option value="A">A — Abnormal</option>
                </select>
            </div>
            <div class="panel-actions">
                <button @onclick="SubmitResult" disabled="@loading" class="btn btn-primary">Submit</button>
                <button @onclick="() => resultLabTestId = null" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }

    @if (verifyLabTestId is not null)
    {
        <div class="action-panel">
            <h4>Verify Result</h4>
            <div class="form-row">
                <label>Verifying Provider ID</label>
                <input @bind="verifyProviderId" placeholder="Provider ID" />
            </div>
            <div class="form-row">
                <label>Verifying Provider Name</label>
                <input @bind="verifyProviderName" placeholder="Dr. Name" />
            </div>
            <div class="panel-actions">
                <button @onclick="SubmitVerify" disabled="@loading" class="btn btn-primary">Verify</button>
                <button @onclick="() => verifyLabTestId = null" class="btn btn-secondary">Cancel</button>
            </div>
        </div>
    }
}

@* ── Tab 2: Current Summary ──────────────────────────────────── *@
@if (activeTab == "summary")
{
    <div class="lookup-bar">
        <input @bind="patientId" placeholder="Patient ID" class="lookup-input" />
        <button class="btn btn-primary" @onclick="LoadSummary" disabled="@loading">Load Summary</button>
    </div>

    @if (loading) { <p class="loading-msg">Loading…</p> }

    @if (summary is not null)
    {
        @if (summary.Count == 0)
        {
            <p class="empty-msg">No ingested lab results found. Use the Order/Submit tab or Load Demo.</p>
        }
        else
        {
            @if (AbnormalSummary.Count > 0)
            {
                <div class="abnormal-banner">
                    <strong>Abnormal Results (@AbnormalSummary.Count):</strong>
                    @foreach (LabSummary a in AbnormalSummary)
                    {
                        <span class="badge @FlagBadge(a.AbnormalFlag)">@a.TestName @a.Value @a.Units</span>
                    }
                </div>
            }

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Test</th>
                        <th>LOINC</th>
                        <th>Value</th>
                        <th>Units</th>
                        <th>Ref Range</th>
                        <th>Flag</th>
                        <th>Date</th>
                        <th>Trend (last 3)</th>
                        <th>Facility</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (LabSummary s in summary)
                    {
                        <tr>
                            <td class="test-name">@s.TestName</td>
                            <td class="loinc-col">@s.LoincCode</td>
                            <td class="result-val @(s.AbnormalFlag is not "Normal" and not "" ? "flagged" : "")">@s.Value</td>
                            <td>@s.Units</td>
                            <td class="ref-range">@s.ReferenceRange</td>
                            <td>@if (s.AbnormalFlag is not "Normal" and not "") { <span class="badge @FlagBadge(s.AbnormalFlag)">@s.AbnormalFlag</span> } else { <span>—</span> }</td>
                            <td class="date-col">@s.ResultDate.ToString("MM/dd/yy")</td>
                            <td class="trend-col">@TrendDisplay(s.RecentTrend)</td>
                            <td>@s.FacilityCode</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@* ── Tab 3: Order / Submit ───────────────────────────────────── *@
@if (activeTab == "order")
{
    <div class="form-section">
        <div class="form-row">
            <label>Patient ID</label>
            <input @bind="patientId" placeholder="Patient ID" class="input-id" />
        </div>
    </div>

    <div class="form-card">
        <h3>Order New Lab Test</h3>
        <div class="form-grid">
            <label>Test Name</label>
            <input @bind="newTestName" placeholder="e.g. CBC, BMP, Creatinine" />

            <label>LOINC / Test Code</label>
            <input @bind="newTestCode" placeholder="e.g. 2160-0" />

            <label>Category</label>
            <select @bind="newCategory">
                <option value="">— Select —</option>
                <option value="HEMATOLOGY">HEMATOLOGY</option>
                <option value="CHEMISTRY">CHEMISTRY</option>
                <option value="MICROBIOLOGY">MICROBIOLOGY</option>
                <option value="COAGULATION">COAGULATION</option>
                <option value="URINALYSIS">URINALYSIS</option>
                <option value="SEROLOGY">SEROLOGY</option>
                <option value="BLOOD BANK">BLOOD BANK</option>
            </select>

            <label>Specimen Type</label>
            <select @bind="newSpecimen">
                <option value="">— Select —</option>
                <option value="Blood">Blood</option>
                <option value="Serum">Serum</option>
                <option value="Urine">Urine</option>
                <option value="CSF">CSF</option>
                <option value="Tissue">Tissue</option>
                <option value="Stool">Stool</option>
                <option value="Sputum">Sputum</option>
                <option value="Swab">Swab</option>
            </select>

            <label>Ordering Provider</label>
            <input @bind="newOrderingProvider" placeholder="Provider name" />
        </div>
        <div class="form-actions">
            <button @onclick="SubmitOrder" disabled="@loading" class="btn btn-primary">Place Order</button>
        </div>
    </div>

    <div class="form-card">
        <h3>Ingest Result (HL7-style)</h3>
        <p class="form-hint">Use this to submit a completed result directly — e.g., from a HL7 feed or external lab.</p>
        <div class="form-grid">
            <label>LOINC Code</label>
            <input @bind="ingestLoinc" placeholder="e.g. 2160-0" />

            <label>Test Name</label>
            <input @bind="ingestTestName" placeholder="e.g. Creatinine" />

            <label>Value</label>
            <input @bind="ingestValue" placeholder="e.g. 1.1" />

            <label>Units</label>
            <input @bind="ingestUnits" placeholder="e.g. mg/dL" />

            <label>Reference Range</label>
            <input @bind="ingestRefRange" placeholder="e.g. 0.7-1.3" />

            <label>Abnormal Flag</label>
            <select @bind="ingestFlag">
                <option value="Normal">Normal</option>
                <option value="High">High</option>
                <option value="Low">Low</option>
                <option value="CriticalHigh">Critical High</option>
                <option value="CriticalLow">Critical Low</option>
                <option value="Abnormal">Abnormal</option>
            </select>

            <label>Facility Code</label>
            <input @bind="ingestFacilityCode" placeholder="e.g. 688" />

            <label>Panel Name</label>
            <input @bind="ingestPanel" placeholder="e.g. CBC, BMP (optional)" />
        </div>
        <div class="form-actions">
            <button @onclick="SubmitIngest" disabled="@loading" class="btn btn-primary">Ingest Result</button>
        </div>
    </div>
}

<style>
    /* Canonical classes (lookup-bar, lookup-input, tab, tab-bar, btn, btn-primary,
       btn-secondary, alert, alert-error, alert-success, data-table + th/td/tr, badge,
       badge-*, empty-state) are defined once in app.css per UI-CONVENTIONS.md.
       Only page-specific styles (lab summary cards, panels, row tints) live here. */
    .subtitle { color: #555; font-size: 0.85rem; margin-bottom: 1rem; }
    .loading-msg { color: #555; font-style: italic; }
    .empty-msg { color: #555; font-style: italic; padding: 1.5rem 0; }

    .summary-cards { display: flex; gap: 0.75rem; margin-bottom: 1rem; }
    .card { padding: 0.6rem 1.1rem; border: 1px solid #d4d9e0; border-radius: 6px; text-align: center; min-width: 90px; background: #f9fafb; }
    .card-num { display: block; font-size: 1.6rem; font-weight: 700; color: #003f72; }
    .card-label { font-size: 0.72rem; color: #555; text-transform: uppercase; letter-spacing: 0.04em; }
    .card-warn .card-num { color: #b45309; }
    .card-pending .card-num { color: #1e40af; }

    .row-abnormal > td { background: #fffbeb; }
    .row-critical > td { background: #fef2f2; }
    .test-name { font-weight: 500; }
    .result-val.flagged { color: #b91c1c; font-weight: 600; }
    .date-col { color: #555; font-size: 0.78rem; white-space: nowrap; }
    .loinc-col { color: #555; font-size: 0.78rem; }
    .ref-range { color: #555; font-size: 0.78rem; }
    .trend-col { font-size: 0.82rem; color: #333; }

    .abnormal-banner { background: #fffbeb; border: 1px solid #fcd34d; padding: 0.6rem 1rem; border-radius: 4px; margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; color: #333; }

    .action-panel { border: 1px solid #d4d9e0; background: #f4f6f9; border-radius: 6px; padding: 1rem 1.25rem; margin-top: 1rem; max-width: 500px; }
    .action-panel h4 { margin: 0 0 0.75rem; color: #003f72; }
    .form-row { display: flex; gap: 0.75rem; margin-bottom: 0.5rem; align-items: center; }
    .form-row label { width: 140px; font-size: 0.83rem; color: #333; text-align: right; flex-shrink: 0; }
    .form-row input, .form-row select { flex: 1; padding: 0.3rem 0.5rem; border: 1px solid #d4d9e0; border-radius: 3px; font-size: 0.83rem; }
    .panel-actions { display: flex; gap: 0.5rem; margin-top: 0.75rem; }

    .form-card { border: 1px solid #d4d9e0; border-radius: 6px; padding: 1.25rem; margin-bottom: 1.25rem; max-width: 560px; background: #f9fafb; }
    .form-card h3 { margin: 0 0 1rem; font-size: 1rem; color: #003f72; }
    .form-grid { display: grid; grid-template-columns: 160px 1fr; gap: 0.5rem 0.75rem; align-items: center; margin-bottom: 0.75rem; }
    .form-grid label { font-size: 0.83rem; color: #333; text-align: right; }
    .form-grid input, .form-grid select { padding: 0.3rem 0.5rem; border: 1px solid #d4d9e0; border-radius: 3px; font-size: 0.83rem; }
    .form-actions { display: flex; justify-content: flex-end; margin-top: 0.5rem; }
    .form-section { margin-bottom: 0.75rem; }
    .form-hint { font-size: 0.8rem; color: #555; margin-bottom: 0.75rem; }
</style>

@code {
    string activeTab = "results";
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    string _loadedFor = string.Empty;
    bool loading;
    string? error;
    string? successMsg;

    protected override async Task OnParametersSetAsync()
    {
        // Carry the selected patient across pages (CPRS DFN-style): use the ?patientId=
        // query param if present, else the session's current patient (the one shown in the
        // patient bar). Auto-load so the user never re-types a patient they already picked —
        // they shouldn't have to detour through the Cover Sheet to reach the Labs page.
        if (string.IsNullOrWhiteSpace(patientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
            patientId = PatientContext.PatientId;

        if (!string.IsNullOrWhiteSpace(patientId)
            && !string.Equals(_loadedFor, patientId, StringComparison.OrdinalIgnoreCase))
        {
            _loadedFor = patientId;
            await LoadResults();
        }
    }

    // Tab 1 — Results
    List<LabResult>? results;

    // Tab 1 — Collect panel
    string? collectLabTestId;
    DateTime collectDateTime = DateTime.Now;
    string collectSample = string.Empty;
    string collectLab = string.Empty;

    // Tab 1 — Record result panel
    string? resultLabTestId;
    string? resultTestName;
    DateTime resultDateTime = DateTime.Now;
    string resultValue = string.Empty;
    string resultUnit = string.Empty;
    string resultRefLow = string.Empty;
    string resultRefHigh = string.Empty;
    string resultFlag = string.Empty;

    // Tab 1 — Verify panel
    string? verifyLabTestId;
    string verifyProviderId = string.Empty;
    string verifyProviderName = string.Empty;

    // Tab 2 — Summary
    List<LabSummary>? summary;

    // Tab 3 — New order form
    string newTestName = string.Empty;
    string newTestCode = string.Empty;
    string newCategory = string.Empty;
    string newSpecimen = string.Empty;
    string newOrderingProvider = string.Empty;

    // Tab 3 — Ingest form
    string ingestLoinc = string.Empty;
    string ingestTestName = string.Empty;
    string ingestValue = string.Empty;
    string ingestUnits = string.Empty;
    string ingestRefRange = string.Empty;
    string ingestFlag = "Normal";
    string ingestFacilityCode = "688";
    string ingestPanel = string.Empty;

    List<LabSummary> AbnormalSummary =>
        summary?.Where(s => s.AbnormalFlag is not "Normal" and not "").ToList() ?? new();

    string TabClass(string tab) => activeTab == tab ? "tab active" : "tab";

    void SetTab(string tab)
    {
        activeTab = tab;
        error = null;
        successMsg = null;
    }

    void ClearMessages() { error = null; successMsg = null; }

    string RowClass(LabResult r)
    {
        if (r.Flag is "CH" or "CL") return "row-critical";
        if (!string.IsNullOrEmpty(r.Flag)) return "row-abnormal";
        return string.Empty;
    }

    string FlagBadge(string? flag) => flag switch
    {
        "H" or "High" => "badge-warning",
        "L" or "Low" => "badge-info",
        "CH" or "CriticalHigh" or "Critical" => "badge-danger",
        "CL" or "CriticalLow" => "badge-danger",
        "A" or "Abnormal" => "badge-warning",
        _ => "badge-success"
    };

    string StatusBadge(string status) => status switch
    {
        "Ordered" => "badge-info",
        "Collected" => "badge-info",
        "Pending" => "badge-info",
        "Completed" => "badge-success",
        "Verified" => "badge-success",
        "Cancelled" => "badge-neutral",
        _ => "badge-success"
    };

    string TrendDisplay(List<TrendPoint> trend)
    {
        if (trend.Count == 0) return "—";
        return string.Join(" → ", trend.Select(t =>
        {
            string indicator = t.AbnormalFlag is not "Normal" and not "" ? "!" : "";
            return $"{t.Value}{indicator}";
        }));
    }

    // ── Results tab ──────────────────────────────────────────────────────

    async Task LoadResults()
    {
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Patient ID required."; return; }
        ClearMessages();
        loading = true;
        results = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            var labResults = await grain.GetLabResultsAsync();
            results = labResults.Select(r => new LabResult(
                r.LabTestId, r.TestName, r.ResultValue, r.Units, r.Flag, r.Status, r.CollectionDate)).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task LoadDemo()
    {
        if (string.IsNullOrWhiteSpace(patientId)) patientId = "PATIENT-DEMO-001";
        ClearMessages();
        loading = true;
        try
        {
            // Demo load requires specific lab orders to be placed — seed a few via grain calls
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.OrderLabTestAsync("LR-CBC", "CBC", "58410-2", null, null, "Demo Provider", "Blood", "HEMATOLOGY");
            await grain.OrderLabTestAsync("LR-BMP", "Basic Metabolic Panel", "51990-0", null, null, "Demo Provider", "Serum", "CHEMISTRY");
            successMsg = "Demo data loaded successfully.";
            await LoadResults();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    void OpenCollect(string labTestId)
    {
        ClearMessages();
        collectLabTestId = labTestId;
        collectDateTime = DateTime.Now;
        collectSample = string.Empty;
        collectLab = string.Empty;
        resultLabTestId = null;
        verifyLabTestId = null;
    }

    void OpenResult(string labTestId, string testName)
    {
        ClearMessages();
        resultLabTestId = labTestId;
        resultTestName = testName;
        resultDateTime = DateTime.Now;
        resultValue = string.Empty;
        resultUnit = string.Empty;
        resultRefLow = string.Empty;
        resultRefHigh = string.Empty;
        resultFlag = string.Empty;
        collectLabTestId = null;
        verifyLabTestId = null;
    }

    void OpenVerify(string labTestId)
    {
        ClearMessages();
        verifyLabTestId = labTestId;
        verifyProviderId = string.Empty;
        verifyProviderName = string.Empty;
        collectLabTestId = null;
        resultLabTestId = null;
    }

    async Task SubmitCollect()
    {
        if (collectLabTestId is null || string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.CollectSpecimenAsync(collectLabTestId, collectDateTime.ToUniversalTime(), collectSample, collectLab);
            collectLabTestId = null;
            successMsg = "Specimen collection recorded.";
            await LoadResults();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task SubmitResult()
    {
        if (resultLabTestId is null || string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.RecordLabResultAsync(
                resultLabTestId,
                resultDateTime.ToUniversalTime(),
                resultValue,
                string.IsNullOrWhiteSpace(resultUnit) ? null : resultUnit,
                string.IsNullOrWhiteSpace(resultRefLow) ? null : resultRefLow,
                string.IsNullOrWhiteSpace(resultRefHigh) ? null : resultRefHigh,
                string.IsNullOrWhiteSpace(resultFlag) ? null : resultFlag);
            resultLabTestId = null;
            successMsg = "Lab result recorded.";
            await LoadResults();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task SubmitVerify()
    {
        if (verifyLabTestId is null || string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.VerifyLabResultAsync(verifyLabTestId, verifyProviderId, verifyProviderName, DateTime.UtcNow);
            verifyLabTestId = null;
            successMsg = "Lab result verified.";
            await LoadResults();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    // ── Summary tab ──────────────────────────────────────────────────────

    async Task LoadSummary()
    {
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Patient ID required."; return; }
        ClearMessages();
        loading = true;
        summary = null;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            var entries = await grain.GetLabSummaryAsync();
            summary = entries.Select(e => new LabSummary(
                e.LoincCode, e.TestName, e.Value, e.Units, e.ReferenceRange,
                e.AbnormalFlag.ToString(), e.ResultDate, e.FacilityCode,
                e.RecentTrend.Select(t => new TrendPoint(t.Value, t.ResultDate, t.AbnormalFlag.ToString())).ToList()
            )).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    // ── Order tab ────────────────────────────────────────────────────────

    async Task SubmitOrder()
    {
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Patient ID required."; return; }
        if (string.IsNullOrWhiteSpace(newTestName)) { error = "Test name required."; return; }
        ClearMessages();
        loading = true;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.OrderLabTestAsync(
                $"LR-{newTestCode}", newTestName,
                string.IsNullOrWhiteSpace(newTestCode) ? null : newTestCode,
                null, null,
                string.IsNullOrWhiteSpace(newOrderingProvider) ? null : newOrderingProvider,
                string.IsNullOrWhiteSpace(newSpecimen) ? null : newSpecimen,
                string.IsNullOrWhiteSpace(newCategory) ? null : newCategory);
            successMsg = $"Lab order placed: {newTestName}";
            newTestName = string.Empty;
            newTestCode = string.Empty;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task SubmitIngest()
    {
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Patient ID required."; return; }
        if (string.IsNullOrWhiteSpace(ingestLoinc) || string.IsNullOrWhiteSpace(ingestValue)) { error = "LOINC code and value required."; return; }
        ClearMessages();
        loading = true;
        try
        {
            var grain = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await grain.IngestLabResultAsync(
                $"MANUAL-{Guid.NewGuid()}", ingestLoinc, ingestTestName, ingestValue, ingestUnits,
                string.IsNullOrWhiteSpace(ingestRefRange) ? null : ingestRefRange,
                Enum.Parse<LabAbnormalFlag>(ingestFlag),
                DateTimeOffset.UtcNow, ingestFacilityCode, null, null,
                string.IsNullOrWhiteSpace(ingestPanel) ? null : ingestPanel);
            successMsg = $"Result ingested: {ingestTestName} = {ingestValue} {ingestUnits}";
            ingestLoinc = string.Empty;
            ingestTestName = string.Empty;
            ingestValue = string.Empty;
            ingestUnits = string.Empty;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    // ── DTOs ─────────────────────────────────────────────────────────────

    record LabResult(
        string LabTestId,
        string TestName,
        string? ResultValue,
        string? Units,
        string? Flag,
        string Status,
        DateTime? CollectionDate,
        string? VerifyingProviderName = null);

    record LabSummary(
        string LoincCode,
        string TestName,
        string Value,
        string Units,
        string ReferenceRange,
        string AbnormalFlag,
        DateTimeOffset ResultDate,
        string FacilityCode,
        List<TrendPoint> RecentTrend);

    record TrendPoint(string Value, DateTimeOffset ResultDate, string AbnormalFlag);
}
