    private async Task LoadProviders()
    {
        error = null;
        loadingProviders = true;
        try
        {
            List<EpcsProviderIndexEntry> entries = await GetProviderIndex().GetAllAsync();
            providers = entries.Select(e => new ProviderIndexDto
            {
                CredentialId = e.CredentialId, ProviderId = e.ProviderId,
                ProviderName = e.ProviderName, DeaNumber = e.DeaNumber,
                CredentialStatus = (int)e.CredentialStatus, IdentityProofingLevel = (int)e.IdentityProofingLevel
            }).ToList();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingProviders = false; }
    }

    private void EditProvider(ProviderIndexDto p)
    {
        newProvider = new ProviderForm
        {
            CredentialId = p.CredentialId,
            ProviderId = p.ProviderId,
            ProviderName = p.ProviderName,
            DeaNumber = p.DeaNumber,
            IdentityProofingLevel = (int)p.IdentityProofingLevel,
        };
        showProviderForm = true;
    }

    private async Task SaveProvider()
    {
        error = null;
        try
        {
            List<EpcsTwoFactorMethod> methods = new();
            if (newProvider.TfHardwareToken) methods.Add(EpcsTwoFactorMethod.HardwareToken);
            if (newProvider.TfBiometric) methods.Add(EpcsTwoFactorMethod.Biometric);
            if (newProvider.TfOneTimePassword) methods.Add(EpcsTwoFactorMethod.OneTimePassword);
            if (newProvider.TfSmartCard) methods.Add(EpcsTwoFactorMethod.SmartCard);
            if (newProvider.TfMobileAuth) methods.Add(EpcsTwoFactorMethod.MobileAuthenticator);

            var grain = GetProviderGrain(newProvider.CredentialId);
            await grain.SaveAsync(
                newProvider.ProviderId, newProvider.ProviderName,
                string.IsNullOrEmpty(newProvider.Npi) ? null : newProvider.Npi,
                string.IsNullOrEmpty(newProvider.DeaNumber) ? null : newProvider.DeaNumber,
                (IdentityProofingLevel)newProvider.IdentityProofingLevel,
                newProvider.IdentityProofingDate,
                methods.Count > 0 ? methods : null,
                string.IsNullOrEmpty(newProvider.CertificateThumbprint) ? null : newProvider.CertificateThumbprint,
                newProvider.CertificateExpiration);
            showProviderForm = false;
            newProvider = new();
            await LoadProviders();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task ActivateProvider(string credentialId)
    {
        error = null;
        try { await GetProviderGrain(credentialId).ActivateAsync(); await LoadProviders(); }
