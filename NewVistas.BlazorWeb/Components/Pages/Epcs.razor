    private async Task CreatePrescription()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        error = null;
        try
        {
            EpcsPharmacyDestination? dest = null;
            if (!string.IsNullOrEmpty(newRx.PharmacyNcpdpId))
                dest = new EpcsPharmacyDestination { NcpdpId = newRx.PharmacyNcpdpId, PharmacyName = newRx.PharmacyName ?? "", Address = newRx.PharmacyAddress };

            await GetWorkflow().CreateEpcsPrescriptionAsync(
                string.IsNullOrEmpty(newRx.PrescriptionId) ? null : newRx.PrescriptionId,
                (EpcsScriptTransactionType)newRx.TransactionType,
                newRx.DrugName, string.IsNullOrEmpty(newRx.Ndc) ? null : newRx.Ndc, newRx.DeaSchedule,
                newRx.Quantity, newRx.DaysSupply, newRx.RefillsAuthorized,
                string.IsNullOrEmpty(newRx.Sig) ? null : newRx.Sig,
                string.IsNullOrEmpty(newRx.DiagnosisCode) ? null : newRx.DiagnosisCode,
                string.IsNullOrEmpty(newRx.PrescriberNpi) ? null : newRx.PrescriberNpi,
                string.IsNullOrEmpty(newRx.PrescriberDea) ? null : newRx.PrescriberDea,
                string.IsNullOrEmpty(newRx.PrescriberName) ? null : newRx.PrescriberName,
                string.IsNullOrEmpty(newRx.PrescriberCredentialId) ? null : newRx.PrescriberCredentialId,
                dest);
            showCreateForm = false;
            newRx = new();
            await LoadPrescriptions();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task SignPrescription()
    {
        if (string.IsNullOrWhiteSpace(signEpcsId)) return;
        error = null;
        try
        {
            DateTime now = DateTime.UtcNow;
            await GetWorkflow().SignEpcsPrescriptionAsync(signEpcsId, new EpcsSignatureRecord
            {
                PrescriptionHash = signReq.PrescriptionHash,
                CertificateThumbprint = signReq.CertificateThumbprint,
                SigningTime = now,
                TwoFactorMethod = (EpcsTwoFactorMethod)signReq.TwoFactorMethod,
                TwoFactorVerificationTime = now,
                IsValid = signReq.IsValid
            });
            showSignForm = false;
            signReq = new();
            await LoadPrescriptions();
        }
        catch (Exception ex) { error = ex.Message; }
    }

