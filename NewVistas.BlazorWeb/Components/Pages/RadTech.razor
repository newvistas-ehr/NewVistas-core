@page "/rad-tech"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Radiology Technologist</PageTitle>

<h1>Radiology Technologist Workflow</h1>
<p class="page-subtitle">Exam Tracking, Protocols, Worklist, Image Library (RARTE.m)</p>

<div class="lookup-bar">
    <input class="lookup-input" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <input class="lookup-input" placeholder="Location" @bind="locationId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadAll" disabled="@loading">Load</button>
</div>
<AlertBanner Error="@error" />

<TabStrip Tabs="_tabs" @bind-Active="Tab" />

@if (tab == "worklist" && worklist != null)
{
    <table class="data-table">
        <thead><tr><th>Procedure</th><th>Type</th><th>Patient</th><th>Urgency</th><th>Status</th><th>Body Part</th><th>Protocol</th><th>Tech</th><th></th></tr></thead>
        <tbody>
            @foreach (var i in worklist.Items)
            {
                <tr class="@(i.Urgency == "STAT" ? "row-danger" : i.Urgency == "URGENT" ? "row-warning" : "")">
                    <td>@i.ProcedureName</td>
                    <td>@(i.ImagingType ?? "—")</td>
                    <td>@i.PatientId[..Math.Min(12, i.PatientId.Length)]</td>
                    <td><span class="badge @(i.Urgency == "STAT" ? "badge-danger" : i.Urgency == "URGENT" ? "badge-warning" : "badge-neutral")">@(i.Urgency ?? "ROUTINE")</span></td>
                    <td><span class="badge @ExamBadge(i.ExamStatus)">@i.ExamStatus</span></td>
                    <td>@(i.BodyPart ?? "—") @(i.Laterality ?? "")</td>
                    <td>@(i.ProtocolName ?? "—")</td>
                    <td>@(i.TechnicianName ?? "—")</td>
                    <td><button class="btn btn-primary" @onclick="() => ViewExam(i.RadiologyId)">Track</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (tab == "exam" && exam != null)
{
    <div class="form-section">
        <h3>Exam: @exam.RadiologyId <span class="badge @ExamBadge(exam.ExamStatus)">@exam.ExamStatus</span></h3>
        <div class="exam-grid">
            <p><strong>Protocol:</strong> @(exam.ProtocolName ?? "Not assigned")</p>
            <p><strong>Exam Start:</strong> @(exam.ExamStartDateTime?.ToString("HH:mm") ?? "—")</p>
            <p><strong>Room:</strong> @(exam.Room ?? "—")</p>
            <p><strong>Exam Complete:</strong> @(exam.ExamCompleteDateTime?.ToString("HH:mm") ?? "—")</p>
            <p><strong>Scheduled:</strong> @(exam.ScheduledDateTime?.ToString("MM/dd HH:mm") ?? "—")</p>
            <p><strong>Images:</strong> @(exam.ImageCount?.ToString() ?? "—") (@exam.LinkedImageIds.Count linked)</p>
            <p><strong>Prepped:</strong> @(exam.PatientPreppedDateTime?.ToString("HH:mm") ?? "—")</p>
            <p><strong>PACS Sent:</strong> @(exam.ImagesSentDateTime?.ToString("HH:mm") ?? "—")</p>
        </div>
        <div class="form-actions">
            @if (exam.ExamStatus == RadExamStatus.Ordered || exam.ExamStatus == RadExamStatus.Scheduled)
            { <button class="btn btn-primary" @onclick="() => Prep(exam.RadiologyId)">Mark Prepped</button> }
            @if (exam.ExamStatus == RadExamStatus.PatientPrepped)
            { <button class="btn btn-primary" @onclick="() => Start(exam.RadiologyId)">Start Exam</button> }
            @if (exam.ExamStatus == RadExamStatus.InProgress)
            { <button class="btn btn-primary" @onclick="() => Complete(exam.RadiologyId)">Complete Exam</button> }
            @if (exam.ExamStatus == RadExamStatus.ExamComplete)
            { <button class="btn btn-primary" @onclick="() => SendPacs(exam.RadiologyId)">Send to PACS</button> }
        </div>
    </div>
}

@if (tab == "protocols" && protocols != null)
{
    <table class="data-table">
        <thead><tr><th>Protocol</th><th>Imaging Type</th><th>Body Part</th><th>Active</th></tr></thead>
        <tbody>
            @foreach (var p in protocols)
            {
                <tr><td>@p.ProtocolName</td><td>@p.ImagingType</td><td>@(p.BodyPart ?? "—")</td><td><span class="badge @(p.IsActive ? "badge-success" : "badge-neutral")">@(p.IsActive ? "Active" : "Inactive")</span></td></tr>
            }
        </tbody>
    </table>
}

@code {
    private string patientId = string.Empty, locationId = "RAD-MAIN", tab = "worklist";
    private bool loading; private string? error;
    private RadWorklistState? worklist;
    private RadExamTrackingState? exam;
    private List<RadProtocolIndexEntry>? protocols;
    private readonly (string, string)[] _tabs = new[] { ("worklist", "Worklist"), ("exam", "Exam Detail"), ("protocols", "Protocols") };

    private string Tab
    {
        get => tab;
        set { tab = value; if (value == "protocols") _ = LoadProtocols(); }
    }

    private async Task LoadAll() { if (string.IsNullOrWhiteSpace(patientId)) return; loading = true; error = null; try { worklist = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RefreshRadWorklistAsync(locationId); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task ViewExam(string radId) { try { exam = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetRadExamTrackingAsync(radId); tab = "exam"; } catch (Exception ex) { error = ex.Message; } }
    private async Task Prep(string radId) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).MarkRadPatientPreppedAsync(radId, null); await ViewExam(radId); } catch (Exception ex) { error = ex.Message; } }
    private async Task Start(string radId) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).StartRadExamAsync(radId); await ViewExam(radId); } catch (Exception ex) { error = ex.Message; } }
    private async Task Complete(string radId) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).CompleteRadExamAsync(radId, 24, "Standard exam completed"); await ViewExam(radId); } catch (Exception ex) { error = ex.Message; } }
    private async Task SendPacs(string radId) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).SendRadImagesToPacsAsync(radId); await ViewExam(radId); } catch (Exception ex) { error = ex.Message; } }
    private async Task LoadProtocols() { try { protocols = await Grains.GetGrain<IRadProtocolIndexGrain>("RAD-PROTOCOL-INDEX").GetAllAsync(); StateHasChanged(); } catch (Exception ex) { error = ex.Message; } }

    private string ExamBadge(RadExamStatus s) => s switch { RadExamStatus.Ordered => "badge-neutral", RadExamStatus.Scheduled => "badge-info", RadExamStatus.PatientPrepped => "badge-warning", RadExamStatus.InProgress => "badge-info", RadExamStatus.ExamComplete => "badge-success", RadExamStatus.ImagesSentToPacs => "badge-success", RadExamStatus.PendingRead => "badge-info", RadExamStatus.ReadComplete => "badge-success", RadExamStatus.Cancelled => "badge-danger", _ => "badge-neutral" };
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .exam-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem 1.5rem; font-size: 0.9rem; }
    .exam-grid p { margin: 0; }
</style>
