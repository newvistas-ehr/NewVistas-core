@page "/login"
@layout NewVistas.BlazorWeb.Components.Layout.LoginLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using NewVistas.BlazorWeb.Services
@inject JwtAuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject HttpClient Http
@inject UserSecurityContext SecurityContext

<div class="login-container">
    <div class="login-card">
        <h2>NewVistas Sign-In</h2>
        <p class="login-subtitle">Clinical Information System</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div class="form-group">
            <label>Access Code (Username)</label>
            <input type="text" @bind="userName" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" disabled="@isLoading" />
        </div>

        <div class="form-group">
            <label>Verify Code (Password)</label>
            <input type="password" @bind="password" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" disabled="@isLoading" />
        </div>

        <button class="btn-login" @onclick="LoginAsync" disabled="@isLoading">
            @if (isLoading) { <span>Signing in...</span> } else { <span>Sign In</span> }
        </button>
    </div>
</div>

@code {
    private string userName = string.Empty;
    private string password = string.Empty;
    private string? error;
    private bool isLoading;

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoginAsync();
    }

    private async Task LoginAsync()
    {
        if (string.IsNullOrWhiteSpace(userName) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please enter both access code and verify code.";
            return;
        }

        isLoading = true;
        error = null;

        try
        {
            LoginResult result = await AuthProvider.LoginAsync(userName, password);
            if (result.Success)
            {
                // Load security keys once — cached for the session lifetime.
                // All menu visibility checks are O(1) HashSet lookups from here on.
                var authState = await AuthProvider.GetAuthenticationStateAsync();
                string? userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                    ?? authState.User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")?.Value;
                if (userId is not null)
                    await SecurityContext.InitializeAsync(Http, userId);

                Navigation.NavigateTo("/", forceLoad: false);
            }
            else
            {
                error = result.Error ?? "Sign-in failed.";
            }
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }
    .login-card {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 2rem;
        width: 360px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .login-card h2 { margin: 0 0 0.25rem; color: #003366; }
    .login-subtitle { color: #666; margin: 0 0 1.5rem; font-size: 0.9rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; margin-bottom: 0.25rem; font-weight: 600; font-size: 0.85rem; }
    .form-group input {
        width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;
        font-size: 0.95rem; box-sizing: border-box;
    }
    .btn-login {
        width: 100%; padding: 0.6rem; background: #003366; color: #fff;
        border: none; border-radius: 4px; font-size: 1rem; cursor: pointer;
    }
    .btn-login:hover { background: #004488; }
    .btn-login:disabled { opacity: 0.6; cursor: not-allowed; }
    .alert-danger {
        background: #f8d7da; color: #842029; padding: 0.5rem 0.75rem;
        border-radius: 4px; margin-bottom: 1rem; font-size: 0.9rem;
    }
</style>
