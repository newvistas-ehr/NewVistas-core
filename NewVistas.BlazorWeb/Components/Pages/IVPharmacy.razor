@page "/iv-pharmacy"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>IV Pharmacy</PageTitle>

<h2>IV Pharmacy — Admixture Compounding</h2>

<div class="patient-id-bar">
    <label>Patient ID:</label>
    <input @bind="patientId" placeholder="Enter patient ID" />
    <button @onclick="LoadOrders">Load Orders</button>
</div>

@if (error != null)
{
    <div class="alert alert-error">@error</div>
}

@if (loading)
{
    <p><em>Loading...</em></p>
}
else if (patientId != null)
{
    <div class="tab-bar">
        <button class="@TabClass(0)" @onclick="() => activeTab = 0">All Orders</button>
        <button class="@TabClass(1)" @onclick="() => activeTab = 1">Pending / Verified</button>
        <button class="@TabClass(2)" @onclick="() => activeTab = 2">Compounding Queue</button>
        <button class="@TabClass(3)" @onclick="() => activeTab = 3">New Order</button>
    </div>

    @if (activeTab == 0)
    {
        <h4>All IV Admixture Orders</h4>
        @if (allOrders.Count == 0)
        {
            <p>No IV admixture orders found.</p>
        }
        else
        {
            <table class="iv-table">
                <thead>
                    <tr>
                        <th>Base Solution</th>
                        <th>Vol (mL)</th>
                        <th>Route</th>
                        <th>Frequency</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Provider</th>
                        <th>Lot #</th>
                        <th>Expires</th>
                        <th>Created</th>
                        <th>Additives</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in allOrders)
                    {
                        <tr class="@StatusRowClass(o.Status)">
                            <td>@o.BaseSolution</td>
                            <td>@o.TotalVolumeMl</td>
                            <td>@o.Route</td>
                            <td>@o.Frequency</td>
                            <td class="@PriorityClass(o.Priority)">@o.Priority</td>
                            <td>@o.Status</td>
                            <td>@(o.ProviderName ?? "—")</td>
                            <td>@(o.LotNumber ?? "—")</td>
                            <td>@(o.ExpirationDate?.ToString("MM/dd/yy") ?? "—")</td>
                            <td>@o.CreatedDate.ToString("MM/dd/yy HH:mm")</td>
                            <td>@o.AdditiveCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (activeTab == 1)
    {
        <h4>Pending &amp; Verified Orders</h4>
        @if (pendingOrders.Count == 0)
        {
            <p>No pending orders.</p>
        }
        else
        {
            <table class="iv-table">
                <thead>
                    <tr>
                        <th>Base Solution</th>
                        <th>Vol (mL)</th>
                        <th>Route</th>
                        <th>Rate / Freq</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Start</th>
                        <th>Additives</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in pendingOrders)
                    {
                        <tr class="@PriorityClass(o.Priority)">
                            <td>@o.BaseSolution</td>
                            <td>@o.TotalVolumeMl</td>
                            <td>@o.Route</td>
                            <td>@(o.InfusionRateStr ?? o.Frequency.ToString())</td>
                            <td>@o.Priority</td>
                            <td>@o.Status</td>
                            <td>@(o.StartDateTime?.ToString("MM/dd HH:mm") ?? "—")</td>
                            <td>@o.AdditiveCount</td>
                            <td>
                                @if (o.Status == IVAdmixOrderStatus.Pending)
                                {
                                    <button @onclick="() => VerifyOrder(o.OrderId)">Verify</button>
                                }
                                @if (o.Status == IVAdmixOrderStatus.Verified)
                                {
                                    <button @onclick="() => StartCompound(o.OrderId)">Start Compound</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (activeTab == 2)
    {
        <h4>Compounding Queue</h4>
        @if (activeOrders.Count == 0)
        {
            <p>No orders in compounding queue.</p>
        }
        else
        {
            <table class="iv-table">
                <thead>
                    <tr>
                        <th>Base Solution</th>
                        <th>Vol (mL)</th>
                        <th>Container</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Lot #</th>
                        <th>Expires</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in activeOrders)
                    {
                        <tr>
                            <td>@o.BaseSolution</td>
                            <td>@o.TotalVolumeMl</td>
                            <td>@o.Route</td>
                            <td class="@PriorityClass(o.Priority)">@o.Priority</td>
                            <td>@o.Status</td>
                            <td>@(o.LotNumber ?? "—")</td>
                            <td>@(o.ExpirationDate?.ToString("MM/dd/yy") ?? "—")</td>
                            <td>
                                @if (o.Status == IVAdmixOrderStatus.Compounding)
                                {
                                    <button @onclick="() => CompleteCompound(o.OrderId)">Complete</button>
                                }
                                @if (o.Status == IVAdmixOrderStatus.Ready)
                                {
                                    <button @onclick="() => DispenseOrder(o.OrderId)">Dispense</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (activeTab == 3)
    {
        <h4>New IV Admixture Order</h4>
        <div class="form-grid">
            <label>Base Solution:</label>
            <input @bind="form.BaseSolution" placeholder="e.g., Normal Saline, D5W" />

            <label>Base Volume (mL):</label>
            <input type="number" @bind="form.BaseSolutionVolumeMl" />

            <label>Route:</label>
            <select @bind="form.Route">
                @foreach (var r in Enum.GetValues<IVAdmixRoute>())
                {
                    <option value="@r">@r</option>
                }
            </select>

            <label>Frequency:</label>
            <select @bind="form.Frequency">
                @foreach (var f in Enum.GetValues<IVAdmixFrequency>())
                {
                    <option value="@f">@f</option>
                }
            </select>

            <label>Container:</label>
            <select @bind="form.ContainerType">
                @foreach (var c in Enum.GetValues<IVContainerType>())
                {
                    <option value="@c">@c</option>
                }
            </select>

            <label>Container Count:</label>
            <input type="number" @bind="form.ContainerCount" min="1" />

            <label>Priority:</label>
            <select @bind="form.Priority">
                @foreach (var p in Enum.GetValues<IVAdmixPriority>())
                {
                    <option value="@p">@p</option>
                }
            </select>

            <label>Infusion Rate String:</label>
            <input @bind="form.InfusionRateStr" placeholder="e.g., 125 mL/hr, Over 30 min" />

            <label>Infusion Rate (mL/hr):</label>
            <input type="number" step="0.1" @bind="form.InfusionRateMlHr" placeholder="Optional" />

            <label>Infusion Duration (hrs):</label>
            <input type="number" step="0.5" @bind="form.InfusionDurationHours" placeholder="Optional" />

            <label>Start Date/Time:</label>
            <input type="datetime-local" @bind="form.StartDateTime" />

            <label>Stop Date/Time:</label>
            <input type="datetime-local" @bind="form.StopDateTime" />

            <label>Provider ID:</label>
            <input @bind="form.ProviderId" />

            <label>Provider Name:</label>
            <input @bind="form.ProviderName" />

            <label>Notes:</label>
            <textarea @bind="form.Notes" rows="3"></textarea>
        </div>
        <button @onclick="CreateOrder" disabled="@creatingOrder">
            @(creatingOrder ? "Creating..." : "Create Order")
        </button>
        @if (createSuccess != null)
        {
            <div class="alert alert-success">@createSuccess</div>
        }
    }
}

@code {
    private string? patientId;
    private string? error;
    private bool loading;
    private int activeTab;
    private bool creatingOrder;
    private string? createSuccess;

    private List<IVAdmixOrderIndexEntry> allOrders = new();
    private List<IVAdmixOrderIndexEntry> pendingOrders = new();
    private List<IVAdmixOrderIndexEntry> activeOrders = new();

    private OrderForm form = new();

    private string TabClass(int tab) => tab == activeTab ? "tab active" : "tab";

    private string StatusRowClass(IVAdmixOrderStatus status) => status switch
    {
        IVAdmixOrderStatus.Discontinued or IVAdmixOrderStatus.Cancelled => "row-inactive",
        IVAdmixOrderStatus.Administered => "row-administered",
        IVAdmixOrderStatus.Ready => "row-ready",
        _ => ""
    };

    private string PriorityClass(IVAdmixPriority priority) => priority switch
    {
        IVAdmixPriority.STAT => "priority-stat",
        IVAdmixPriority.ASAP => "priority-asap",
        _ => ""
    };

    private IPatientWorkflowGrain GetWorkflow() =>
        Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim());

    private async Task LoadOrders()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true;
        error = null;
        try
        {
            var workflow = GetWorkflow();
            var all = await workflow.GetIVAdmixOrdersAsync();
            var pending = await workflow.GetPendingIVAdmixOrdersAsync();
            var active = await workflow.GetActiveIVAdmixOrdersAsync();
            allOrders = all.Select(ToLocal).ToList();
            pendingOrders = pending.Select(ToLocal).ToList();
            activeOrders = active.Select(ToLocal).ToList();
        }
        catch (Exception ex)
        {
            error = $"Failed to load orders: {ex.Message}";
        }
        loading = false;
    }

    private IVAdmixOrderIndexEntry ToLocal(NewVistas.Abstractions.GrainStates.IVAdmixOrderIndexEntry e) => new()
    {
        OrderId = e.OrderId, Status = (IVAdmixOrderStatus)(int)e.Status,
        Priority = (IVAdmixPriority)(int)e.Priority, BaseSolution = e.BaseSolution,
        TotalVolumeMl = e.TotalVolumeMl, Route = (IVAdmixRoute)(int)e.Route,
        InfusionRateStr = e.InfusionRateStr, Frequency = (IVAdmixFrequency)(int)e.Frequency,
        StartDateTime = e.StartDateTime, StopDateTime = e.StopDateTime,
        LotNumber = e.LotNumber, ExpirationDate = e.ExpirationDate,
        ProviderName = e.ProviderName, CreatedDate = e.CreatedDate,
        AdditiveCount = e.AdditiveCount
    };

    private async Task VerifyOrder(string orderId)
    {
        try
        {
            await GetWorkflow().VerifyIVAdmixOrderAsync(orderId, "PHARM-1", "Pharmacist", DateTime.UtcNow);
            await LoadOrders();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task StartCompound(string orderId)
    {
        try
        {
            await GetWorkflow().StartIVAdmixCompoundingAsync(orderId, "TECH-1", "Technician", DateTime.UtcNow);
            await LoadOrders();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CompleteCompound(string orderId)
    {
        try
        {
            await GetWorkflow().CompleteIVAdmixCompoundingAsync(orderId, DateTime.UtcNow, null, DateTime.UtcNow.AddDays(1));
            await LoadOrders();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task DispenseOrder(string orderId)
    {
        try
        {
            await GetWorkflow().DispenseIVAdmixOrderAsync(orderId, DateTime.UtcNow);
            await LoadOrders();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task CreateOrder()
    {
        if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(form.BaseSolution)) return;
        creatingOrder = true;
        createSuccess = null;
        error = null;
        try
        {
            await GetWorkflow().CreateIVAdmixOrderAsync(
                form.BaseSolution, form.BaseSolutionVolumeMl,
                (NewVistas.Abstractions.GrainStates.IVAdmixRoute)(int)form.Route,
                (NewVistas.Abstractions.GrainStates.IVAdmixFrequency)(int)form.Frequency,
                (NewVistas.Abstractions.GrainStates.IVContainerType)(int)form.ContainerType,
                form.ContainerCount,
                (NewVistas.Abstractions.GrainStates.IVAdmixPriority)(int)form.Priority,
                null, form.InfusionRateStr, form.InfusionRateMlHr,
                form.InfusionDurationHours, null, null,
                form.StartDateTime, form.StopDateTime,
                form.ProviderId, form.ProviderName, form.Notes);
            createSuccess = "IV admixture order created successfully.";
            form = new();
            await LoadOrders();
        }
        catch (Exception ex)
        {
            error = $"Error: {ex.Message}";
        }
        creatingOrder = false;
    }

    private class OrderForm
    {
        public string BaseSolution { get; set; } = string.Empty;
        public int BaseSolutionVolumeMl { get; set; } = 250;
        public IVAdmixRoute Route { get; set; } = IVAdmixRoute.Peripheral;
        public IVAdmixFrequency Frequency { get; set; } = IVAdmixFrequency.Once;
        public IVContainerType ContainerType { get; set; } = IVContainerType.Bag;
        public int ContainerCount { get; set; } = 1;
        public IVAdmixPriority Priority { get; set; } = IVAdmixPriority.Routine;
        public string? InfusionRateStr { get; set; }
        public decimal? InfusionRateMlHr { get; set; }
        public decimal? InfusionDurationHours { get; set; }
        public DateTime? StartDateTime { get; set; }
        public DateTime? StopDateTime { get; set; }
        public string? ProviderId { get; set; }
        public string? ProviderName { get; set; }
        public string? Notes { get; set; }
    }

    // Local DTO matching the server-side index entry
    private class IVAdmixOrderIndexEntry
    {
        public string OrderId { get; set; } = string.Empty;
        public IVAdmixOrderStatus Status { get; set; }
        public IVAdmixPriority Priority { get; set; }
        public string BaseSolution { get; set; } = string.Empty;
        public int TotalVolumeMl { get; set; }
        public IVAdmixRoute Route { get; set; }
        public string? InfusionRateStr { get; set; }
        public IVAdmixFrequency Frequency { get; set; }
        public DateTime? StartDateTime { get; set; }
        public DateTime? StopDateTime { get; set; }
        public string? LotNumber { get; set; }
        public DateTime? ExpirationDate { get; set; }
        public string? ProviderName { get; set; }
        public DateTime CreatedDate { get; set; }
        public int AdditiveCount { get; set; }
    }

    private enum IVAdmixOrderStatus { Pending, Verified, Compounding, Ready, Dispensed, Administered, Discontinued, Expired, Cancelled }
    private enum IVAdmixPriority { Routine, ASAP, STAT, OnCall }
    private enum IVAdmixRoute { Peripheral, Central, PICC, Midline, Epidural, Subcutaneous, Other }
    private enum IVContainerType { Bag, Syringe, Bottle, Cassette, Other }
    private enum IVAdmixFrequency { Once, Continuous, Q1H, Q2H, Q4H, Q6H, Q8H, Q12H, Q24H, PRN, Other }
}

<style>
    .patient-id-bar { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1rem; }
    .tab-bar { display: flex; gap: 0.25rem; margin-bottom: 1rem; border-bottom: 2px solid #0078d4; }
    .tab { padding: 0.4rem 0.9rem; border: 1px solid #ccc; border-bottom: none; background: #f5f5f5; cursor: pointer; }
    .tab.active { background: #0078d4; color: white; font-weight: bold; }
    .iv-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .iv-table th, .iv-table td { padding: 0.3rem 0.5rem; border: 1px solid #ddd; text-align: left; }
    .iv-table th { background: #f0f4ff; font-weight: 600; }
    .row-inactive { opacity: 0.5; }
    .row-administered { background: #e8f5e9; }
    .row-ready { background: #fff3e0; }
    .priority-stat { color: #c00; font-weight: bold; }
    .priority-asap { color: #d67000; font-weight: bold; }
    .form-grid { display: grid; grid-template-columns: 160px 1fr; gap: 0.4rem 0.8rem; align-items: center; max-width: 560px; margin-bottom: 1rem; }
    .alert { padding: 0.5rem 0.8rem; border-radius: 4px; margin: 0.5rem 0; }
    .alert-success { background: #e6f4ea; border: 1px solid #b7dfbb; color: #1a5c1a; }
</style>
