    private async Task LoadTopReferrals()
    {
        try
        {
            var topIdx = Grains.GetGrain<ITopReferralIndexGrain>("TOP-REF-IDX");
            List<TopReferralIndexEntry> allRefs = await topIdx.GetAllAsync();
            topReferrals = allRefs.Select(MapTopRef).ToList();
            List<TopReferralIndexEntry> pendingRefs = await topIdx.GetPendingAsync();
            pendingReferrals = pendingRefs.Select(MapTopRef).ToList();
        }
        catch (Exception ex) { error = $"Error loading TOP referrals: {ex.Message}"; }
    }

    private static TopReferralIndexEntryDto MapTopRef(TopReferralIndexEntry e) => new(
        e.ReferralId, e.ARAccountId, e.PatientId, e.PatientName,
        e.ReferredAmount, e.Status.ToString(), e.ReferralDate, e.OffsetAmount);

    private async Task SubmitReferToTop()
    {
        topReferMsg = null;
        if (string.IsNullOrWhiteSpace(topAccountId)) { topReferMsg = "Account ID required."; return; }
        string pid = patientId.Trim();
        try
        {
            string refId = Guid.NewGuid().ToString();
            string acctKey = topAccountId.Trim().StartsWith("AR-ACCOUNT:") ? topAccountId.Trim() : $"AR-ACCOUNT:{topAccountId.Trim()}";
            var acctGrain = Grains.GetGrain<IARAccountGrain>(acctKey);
            await acctGrain.ReferToTopAsync(refId, topReferredAmount, topReferUserId, topReferUserName);
            var topGrain = Grains.GetGrain<ITopReferralGrain>($"TOP-REF:{refId}");
            await topGrain.CreateAsync(acctKey, pid, topPatientName, topReferredAmount, topReferredAmount, topReferUserId, topReferUserName, topReferNotes);
            topReferMsg = "Account referred to TOP.";
            await LoadTopReferrals();
        }
        catch (Exception ex) { topReferMsg = $"Error: {ex.Message}"; }
    }

    private void ToggleOffsetPanel(string referralId)
    {
        recordingOffsetReferralId = recordingOffsetReferralId == referralId ? null : referralId;
