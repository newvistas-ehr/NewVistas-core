            string grainKey = selectedAccountId.StartsWith("AR-ACCOUNT:") ? selectedAccountId : $"AR-ACCOUNT:{selectedAccountId}";
            var acctGrain = Grains.GetGrain<IARAccountGrain>(grainKey);
            await acctGrain.PostPaymentAsync(payAmount, payMethod, payUserId, payUserName, payReceipt, payCheck, null);
            payMsg = "Payment posted.";
