    private async Task PostBatch(string batchId)
    {
        batchMsg = null;
        try
        {
            string grainKey = batchId.StartsWith("AR-BATCH:") ? batchId : $"AR-BATCH:{batchId}";
            var batchGrain = Grains.GetGrain<IARBatchPaymentGrain>(grainKey);
            await batchGrain.PostAsync("SYSTEM", "System");
            batchMsg = "Batch posted.";
            await RefreshBatches();
            if (!string.IsNullOrEmpty(patientId)) await RefreshAccountsAndDebtor(patientId.Trim());
        }
        catch (Exception ex) { batchMsg = $"Error: {ex.Message}"; }
    }

    private async Task RefreshBatches()
    {
        var batchIdx = Grains.GetGrain<IARBatchPaymentIndexGrain>("AR-BATCH-IDX");
        List<ARBatchPaymentIndexEntry> batchEntries = await batchIdx.GetAllAsync();
        batches = batchEntries.Select(b => new ARBatchIndexEntryDto(
            b.BatchId, b.BatchDate, b.FacilityName,
            b.PaymentMethod, b.TotalAmount, b.IsPosted, b.PaymentCount)).ToList();
    }

    private async Task UpdateSiteParams()
    {
        siteParamsMsg = null;
        try
        {
            var siteGrain = Grains.GetGrain<IARSiteParametersGrain>("AR-SITE-PARAMS");
            await siteGrain.UpdateAsync(spSiteName, spFacilityNumber,
                spInterestRate, spAdminCost, spPenaltyRate,
                spMinPayment, spMaxMonths,
                spAutoInterest, spPenaltyEnabled,
                spStatementDays, spCollectionThreshold,
                spFmsEnabled, spTreasuryOffset, spUpdatedByUserId);
            siteParamsMsg = "Site parameters updated.";
            ARSiteParametersState sp = await siteGrain.GetAsync();
            siteParams = new ARSiteParamsDto(sp.SiteId, sp.SiteName, sp.ARFacilityNumber,
                sp.InterestRate, sp.AdminCost, sp.PenaltyRate,
                sp.MinimumPaymentAmount, sp.MaxPaymentPlanMonths,
                sp.IsAutoInterestEnabled, sp.IsPenaltyEnabled,
                sp.StatementFrequencyDays, sp.CollectionThreshold,
                sp.IsFmsEnabled, sp.IsTreasuryOffsetEnabled,
                sp.LastUpdatedDate, sp.LastUpdatedByUserId);
        }
        catch (Exception ex) { siteParamsMsg = $"Error: {ex.Message}"; }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Active"         => "badge-primary",
        "Paid"           => "badge-success",
        "Waived"         => "badge-info",
        "WrittenOff"     => "badge-secondary",
        "InCollection"   => "badge-danger",
        "TreasuryOffset" => "badge-danger",
        "OnPaymentPlan"  => "badge-warning",
        "Cancelled"      => "badge-secondary",
        _                => "badge-secondary",
    };

    private static string TopStatusBadgeClass(string status) => status switch
    {
        "Pending"         => "badge-warning",
        "Certified"       => "badge-primary",
        "Offset"          => "badge-success",
        "PartiallyOffset" => "badge-info",
        "Withdrawn"       => "badge-secondary",
        "Resolved"        => "badge-success",
        _                 => "badge-secondary",
    };

