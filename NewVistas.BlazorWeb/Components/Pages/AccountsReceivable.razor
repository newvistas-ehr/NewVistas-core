@page "/accounts-receivable"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Accounts Receivable</PageTitle>

<div class="ar-container">
    <div class="ar-header">
        <h2>Accounts Receivable</h2>
        <div class="patient-lookup">
            <input class="form-control" placeholder="Patient ID" @bind="patientId" />
            <button class="btn btn-primary" @onclick="LoadPatient">Load</button>
        </div>
    </div>

    @if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (loaded)
    {
        <div class="debtor-summary">
            <div class="summary-card">
                <span class="label">Total Owed</span>
                <span class="value">@debtor?.TotalAmountOwed.ToString("C")</span>
            </div>
            <div class="summary-card">
                <span class="label">Total Paid</span>
                <span class="value paid">@debtor?.TotalAmountPaid.ToString("C")</span>
            </div>
            <div class="summary-card @(debtor?.CurrentBalance > 0 ? "balance-due" : "")">
                <span class="label">Balance Due</span>
                <span class="value">@debtor?.CurrentBalance.ToString("C")</span>
            </div>
            @if (debtor?.IsDelinquent == true)
            {
                <span class="badge badge-danger">DELINQUENT</span>
            }
            @if (debtor?.IsInCollection == true)
            {
                <span class="badge badge-warning">IN COLLECTION</span>
            }
        </div>

        <div class="ar-tabs">
            <button class="tab-btn @(activeTab == "accounts" ? "active" : "")" @onclick='() => activeTab = "accounts"'>AR Accounts</button>
            <button class="tab-btn @(activeTab == "batch" ? "active" : "")" @onclick='() => activeTab = "batch"'>Batch Payments</button>
            <button class="tab-btn @(activeTab == "site" ? "active" : "")" @onclick='() => activeTab = "site"'>Site Parameters</button>
            <button class="tab-btn @(activeTab == "top" ? "active" : "")" @onclick='async () => { activeTab = "top"; await LoadTopReferrals(); }'>Treasury Offset</button>
        </div>

        <!-- ─── AR Accounts Tab ──────────────────────────────────────────────── -->
        @if (activeTab == "accounts")
        {
            <div class="tab-panel">
                <h3>AR Accounts</h3>

                @if (accounts == null || accounts.Count == 0)
                {
                    <p class="text-muted">No AR accounts found for this patient.</p>
                }
                else
                {
                    <table class="table ar-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Original</th>
                                <th>Balance</th>
                                <th>Status</th>
                                <th>Established</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acct in accounts)
                            {
                                <tr class="@(selectedAccountId == acct.ARAccountId ? "selected-row" : "")">
                                    <td>@acct.ARCategory</td>
                                    <td>@acct.OriginalAmount.ToString("C")</td>
                                    <td>@acct.CurrentBalance.ToString("C")</td>
                                    <td><span class="badge @StatusBadgeClass(acct.ARStatus)">@acct.ARStatus</span></td>
                                    <td>@acct.DateEstablished.ToString("MM/dd/yyyy")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => SelectAccount(acct.ARAccountId)">Details</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <button class="btn btn-success btn-sm" @onclick='() => showCreateAccount = !showCreateAccount'>+ New AR Account</button>

                @if (showCreateAccount)
                {
                    <div class="form-panel">
                        <h4>Create AR Account</h4>
                        <div class="form-row">
                            <label>Category</label>
                            <select class="form-control" @bind="newCategory">
                                <option value="CopayOutpatient">Copay — Outpatient</option>
                                <option value="CopayInpatient">Copay — Inpatient</option>
                                <option value="CopayPharmacy">Copay — Pharmacy</option>
                                <option value="CopayLongTermCare">Copay — Long-Term Care</option>
                                <option value="MedicareDeductible">Medicare Deductible</option>
                                <option value="Administrative">Administrative</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Original Amount ($)</label>
                            <input class="form-control" type="number" step="0.01" @bind="newAmount" />
                        </div>
                        <div class="form-row">
                            <label>Billing Action ID (optional)</label>
                            <input class="form-control" @bind="newBillingActionId" />
                        </div>
                        <div class="form-row">
                            <label>Due Date (optional)</label>
                            <input class="form-control" type="date" @bind="newDueDate" />
                        </div>
                        <button class="btn btn-primary" @onclick="CreateAccount">Create Account</button>
                        @if (createAccountMsg != null)
                        {
                            <span class="form-msg">@createAccountMsg</span>
                        }
                    </div>
                }

                <!-- Account Detail Panel -->
                @if (selectedAccountId != null && selectedAccount != null)
                {
                    <div class="detail-panel">
                        <h4>Account Detail — @selectedAccountId</h4>
                        <div class="detail-grid">
                            <div><strong>Status:</strong> <span class="badge @StatusBadgeClass(selectedAccount.ARStatus.ToString())">@selectedAccount.ARStatus</span></div>
                            <div><strong>Category:</strong> @selectedAccount.ARCategory</div>
                            <div><strong>Original Amount:</strong> @selectedAccount.OriginalAmount.ToString("C")</div>
                            <div><strong>Current Balance:</strong> @selectedAccount.CurrentBalance.ToString("C")</div>
                            <div><strong>Amount Paid:</strong> @selectedAccount.AmountPaid.ToString("C")</div>
                            <div><strong>Amount Waived:</strong> @selectedAccount.AmountWaived.ToString("C")</div>
                            <div><strong>Interest Accrued:</strong> @selectedAccount.InterestAccrued.ToString("C")</div>
                            <div><strong>Established:</strong> @selectedAccount.DateEstablished.ToString("MM/dd/yyyy")</div>
                            @if (selectedAccount.DueDate.HasValue)
                            {
                                <div><strong>Due Date:</strong> @selectedAccount.DueDate.Value.ToString("MM/dd/yyyy")</div>
                            }
                            @if (selectedAccount.TransactionIds.Count > 0)
                            {
                                <div class="txn-list"><strong>Transactions (@selectedAccount.TransactionIds.Count):</strong>
                                    @foreach (var t in selectedAccount.TransactionIds)
                                    {
                                        <span class="txn-id">@t</span>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Post Payment -->
                        <div class="action-section">
                            <h5>Post Payment</h5>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Amount" @bind="payAmount" />
                                <select class="form-control" @bind="payMethod">
                                    <option value="CASH">Cash</option>
                                    <option value="CHECK">Check</option>
                                    <option value="CREDIT_CARD">Credit Card</option>
                                    <option value="EFT">EFT</option>
                                </select>
                                <input class="form-control" placeholder="Receipt #" @bind="payReceipt" />
                                <input class="form-control" placeholder="Check #" @bind="payCheck" />
                                <input class="form-control" placeholder="Applied By User ID" @bind="payUserId" />
                                <input class="form-control" placeholder="Applied By Name" @bind="payUserName" />
                                <button class="btn btn-primary" @onclick="PostPayment">Post Payment</button>
                            </div>
                            @if (payMsg != null)
                            {
                                <span class="form-msg">@payMsg</span>
                            }
                        </div>

                        <!-- Post Adjustment -->
                        <div class="action-section">
                            <h5>Post Adjustment</h5>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Amount (credit = positive)" @bind="adjAmount" />
                                <input class="form-control" placeholder="Adjustment Type / Reason" @bind="adjType" />
                                <input class="form-control" placeholder="Applied By User ID" @bind="adjUserId" />
                                <input class="form-control" placeholder="Applied By Name" @bind="adjUserName" />
                                <button class="btn btn-warning" @onclick="PostAdjustment">Post Adjustment</button>
                            </div>
                            @if (adjMsg != null)
                            {
                                <span class="form-msg">@adjMsg</span>
                            }
                        </div>

                        <!-- Waive Account -->
                        <div class="action-section">
                            <h5>Waive Balance</h5>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Waived Amount" @bind="waiveAmount" />
                                <input class="form-control" placeholder="Reason" @bind="waiveReason" />
                                <input class="form-control" placeholder="Waived By User ID" @bind="waiveUserId" />
                                <input class="form-control" placeholder="Waived By Name" @bind="waiveUserName" />
                                <button class="btn btn-danger" @onclick="WaiveAccount">Waive</button>
                            </div>
                            @if (waiveMsg != null)
                            {
                                <span class="form-msg">@waiveMsg</span>
                            }
                        </div>

                        <!-- Accrue Charges -->
                        <div class="action-section">
                            <h5>Accrue Charges</h5>
                            <div class="form-row">
                                <input class="form-control" placeholder="Applied By User ID" @bind="accrueUserId" />
                            </div>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Interest Amount ($)" @bind="accrueInterestAmount" />
                                <button class="btn btn-warning" @onclick="AccrueInterest">Apply Interest</button>
                            </div>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Penalty Amount ($)" @bind="accruePenaltyAmount" />
                                <button class="btn btn-warning" @onclick="AccruePenalty">Apply Penalty</button>
                            </div>
                            <div class="form-row">
                                <input class="form-control" type="number" step="0.01" placeholder="Admin Cost Amount ($)" @bind="accrueAdminCostAmount" />
                                <button class="btn btn-warning" @onclick="AccrueAdminCost">Apply Admin Cost</button>
                            </div>
                            @if (accrueMsg != null)
                            {
                                <span class="form-msg">@accrueMsg</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <!-- ─── Batch Payments Tab ────────────────────────────────────────────── -->
        @if (activeTab == "batch")
        {
            <div class="tab-panel">
                <h3>Batch Payments</h3>

                @if (batches == null || batches.Count == 0)
                {
                    <p class="text-muted">No batch payments found.</p>
                }
                else
                {
                    <table class="table ar-table">
                        <thead>
                            <tr>
                                <th>Batch Date</th>
                                <th>Facility</th>
                                <th>Method</th>
                                <th>Total</th>
                                <th>Payments</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in batches)
                            {
                                <tr>
                                    <td>@b.BatchDate.ToString("MM/dd/yyyy")</td>
                                    <td>@(b.FacilityName ?? "—")</td>
                                    <td>@b.PaymentMethod</td>
                                    <td>@b.TotalAmount.ToString("C")</td>
                                    <td>@b.PaymentCount</td>
                                    <td><span class="badge @(b.IsPosted ? "badge-success" : "badge-secondary")">@(b.IsPosted ? "Posted" : "Open")</span></td>
                                    <td>
                                        @if (!b.IsPosted)
                                        {
                                            <button class="btn btn-sm btn-primary" @onclick="() => PostBatch(b.BatchId)">Post Batch</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <button class="btn btn-success btn-sm" @onclick='() => showCreateBatch = !showCreateBatch'>+ New Batch</button>

                @if (showCreateBatch)
                {
                    <div class="form-panel">
                        <h4>Create Batch Payment</h4>
                        <div class="form-row">
                            <input class="form-control" placeholder="Facility ID (optional)" @bind="batchFacilityId" />
                            <input class="form-control" placeholder="Facility Name (optional)" @bind="batchFacilityName" />
                        </div>
                        <div class="form-row">
                            <label>Batch Date</label>
                            <input class="form-control" type="date" @bind="batchDate" />
                        </div>
                        <div class="form-row">
                            <select class="form-control" @bind="batchPayMethod">
                                <option value="CASH">Cash</option>
                                <option value="CHECK">Check</option>
                                <option value="EFT">EFT</option>
                            </select>
                            <input class="form-control" placeholder="Check # (optional)" @bind="batchCheckNumber" />
                        </div>
                        <div class="form-row">
                            <input class="form-control" placeholder="Notes (optional)" @bind="batchNotes" />
                        </div>
                        <button class="btn btn-primary" @onclick="CreateBatch">Create Batch</button>
                        @if (batchMsg != null)
                        {
                            <span class="form-msg">@batchMsg</span>
                        }
                    </div>
                }
            </div>
        }

        <!-- ─── Site Parameters Tab ──────────────────────────────────────────── -->
        @if (activeTab == "site")
        {
            <div class="tab-panel">
                <h3>AR Site Parameters</h3>

                @if (siteParams != null)
                {
                    <div class="detail-grid">
                        <div><strong>Site Name:</strong> @siteParams.SiteName</div>
                        <div><strong>Facility Number:</strong> @siteParams.ARFacilityNumber</div>
                        <div><strong>Interest Rate:</strong> @siteParams.InterestRate.ToString("P2")</div>
                        <div><strong>Admin Cost:</strong> @siteParams.AdminCost.ToString("C")</div>
                        <div><strong>Penalty Rate:</strong> @siteParams.PenaltyRate.ToString("P2")</div>
                        <div><strong>Min Payment:</strong> @siteParams.MinimumPaymentAmount.ToString("C")</div>
                        <div><strong>Max Plan Months:</strong> @siteParams.MaxPaymentPlanMonths</div>
                        <div><strong>Statement Freq (days):</strong> @siteParams.StatementFrequencyDays</div>
                        <div><strong>Collection Threshold:</strong> @siteParams.CollectionThreshold.ToString("C")</div>
                        <div><strong>Auto Interest:</strong> @(siteParams.IsAutoInterestEnabled ? "Yes" : "No")</div>
                        <div><strong>Penalty Enabled:</strong> @(siteParams.IsPenaltyEnabled ? "Yes" : "No")</div>
                        <div><strong>FMS Enabled:</strong> @(siteParams.IsFmsEnabled ? "Yes" : "No")</div>
                        <div><strong>Treasury Offset:</strong> @(siteParams.IsTreasuryOffsetEnabled ? "Yes" : "No")</div>
                    </div>
                }

                <div class="form-panel">
                    <h4>Update Site Parameters</h4>
                    <div class="form-row">
                        <input class="form-control" placeholder="Site Name" @bind="spSiteName" />
                        <input class="form-control" placeholder="Facility Number" @bind="spFacilityNumber" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" type="number" step="0.001" placeholder="Interest Rate (decimal, e.g. 0.015)" @bind="spInterestRate" />
                        <input class="form-control" type="number" step="0.01" placeholder="Admin Cost ($)" @bind="spAdminCost" />
                        <input class="form-control" type="number" step="0.001" placeholder="Penalty Rate (decimal)" @bind="spPenaltyRate" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" type="number" step="0.01" placeholder="Min Payment ($)" @bind="spMinPayment" />
                        <input class="form-control" type="number" placeholder="Max Plan Months" @bind="spMaxMonths" />
                        <input class="form-control" type="number" placeholder="Statement Freq (days)" @bind="spStatementDays" />
                        <input class="form-control" type="number" step="0.01" placeholder="Collection Threshold ($)" @bind="spCollectionThreshold" />
                    </div>
                    <div class="form-row checkboxes">
                        <label><input type="checkbox" @bind="spAutoInterest" /> Auto Interest</label>
                        <label><input type="checkbox" @bind="spPenaltyEnabled" /> Penalty Enabled</label>
                        <label><input type="checkbox" @bind="spFmsEnabled" /> FMS Enabled</label>
                        <label><input type="checkbox" @bind="spTreasuryOffset" /> Treasury Offset</label>
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Updated By User ID" @bind="spUpdatedByUserId" />
                    </div>
                    <button class="btn btn-primary" @onclick="UpdateSiteParams">Update Parameters</button>
                    @if (siteParamsMsg != null)
                    {
                        <span class="form-msg">@siteParamsMsg</span>
                    }
                </div>
            </div>
        }

        <!-- ─── Treasury Offset Tab ────────────────────────────────────────────── -->
        @if (activeTab == "top")
        {
            <div class="tab-panel">
                <h3>Treasury Offset Program (TOP)</h3>

                <!-- Refer Account to TOP -->
                <div class="form-panel">
                    <h4>Refer Account to TOP</h4>
                    <div class="form-row">
                        <input class="form-control" placeholder="AR Account ID" @bind="topAccountId" />
                        <input class="form-control" placeholder="Patient Name" @bind="topPatientName" />
                        <input class="form-control" type="number" step="0.01" placeholder="Referred Amount ($)" @bind="topReferredAmount" />
                    </div>
                    <div class="form-row">
                        <input class="form-control" placeholder="Referred By User ID" @bind="topReferUserId" />
                        <input class="form-control" placeholder="Referred By Name" @bind="topReferUserName" />
                        <input class="form-control" placeholder="Notes (optional)" @bind="topReferNotes" />
                    </div>
                    <button class="btn btn-danger" @onclick="SubmitReferToTop">Refer to TOP</button>
                    @if (topReferMsg != null)
                    {
                        <span class="form-msg">@topReferMsg</span>
                    }
                </div>

                <!-- Pending Referrals -->
                <h4 style="margin-top:1.5rem;">Pending Referrals</h4>
                @if (pendingReferrals == null || pendingReferrals.Count == 0)
                {
                    <p class="text-muted">No pending TOP referrals.</p>
                }
                else
                {
                    <table class="table ar-table">
                        <thead>
                            <tr>
                                <th>Referral ID</th>
                                <th>Account ID</th>
                                <th>Patient</th>
                                <th>Referred</th>
                                <th>Offset</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in pendingReferrals)
                            {
                                <tr>
                                    <td>@entry.ReferralId</td>
                                    <td>@entry.ARAccountId</td>
                                    <td>@entry.PatientName</td>
                                    <td>@entry.ReferredAmount.ToString("C")</td>
                                    <td>@entry.OffsetAmount.ToString("C")</td>
                                    <td><span class="badge @TopStatusBadgeClass(entry.Status)">@entry.Status</span></td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick='() => ToggleOffsetPanel(entry.ReferralId)'>Record Offset</button>
                                        <button class="btn btn-sm btn-danger" @onclick='() => ToggleWithdrawPanel(entry.ReferralId)'>Withdraw</button>
                                    </td>
                                </tr>
                                @if (recordingOffsetReferralId == entry.ReferralId)
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="form-panel">
                                                <div class="form-row">
                                                    <input class="form-control" type="number" step="0.01" placeholder="Offset Amount ($)" @bind="topOffsetAmount" />
                                                    <input class="form-control" type="date" @bind="topOffsetDate" />
                                                    <input class="form-control" placeholder="Processed By User ID" @bind="topOffsetUserId" />
                                                    <input class="form-control" placeholder="Processed By Name" @bind="topOffsetUserName" />
                                                    <button class="btn btn-primary" @onclick='() => SubmitTopOffset(entry.ReferralId)'>Submit Offset</button>
                                                </div>
                                                @if (topOffsetMsg != null) { <span class="form-msg">@topOffsetMsg</span> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @if (withdrawingReferralId == entry.ReferralId)
                                {
                                    <tr>
                                        <td colspan="7">
                                            <div class="form-panel">
                                                <div class="form-row">
                                                    <input class="form-control" placeholder="Withdrawal Reason" @bind="topWithdrawReason" />
                                                    <button class="btn btn-danger" @onclick='() => SubmitWithdrawTop(entry.ReferralId)'>Confirm Withdraw</button>
                                                </div>
                                                @if (topWithdrawMsg != null) { <span class="form-msg">@topWithdrawMsg</span> }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }

                <!-- All Referrals -->
                <h4 style="margin-top:1.5rem;">All Referrals</h4>
                @if (topReferrals == null || topReferrals.Count == 0)
                {
                    <p class="text-muted">No TOP referrals on file.</p>
                }
                else
                {
                    <table class="table ar-table">
                        <thead>
                            <tr>
                                <th>Referral ID</th>
                                <th>Account ID</th>
                                <th>Patient</th>
                                <th>Referred</th>
                                <th>Offset</th>
                                <th>Status</th>
                                <th>Referral Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in topReferrals)
                            {
                                <tr>
                                    <td>@entry.ReferralId</td>
                                    <td>@entry.ARAccountId</td>
                                    <td>@entry.PatientName</td>
                                    <td>@entry.ReferredAmount.ToString("C")</td>
                                    <td>@entry.OffsetAmount.ToString("C")</td>
                                    <td><span class="badge @TopStatusBadgeClass(entry.Status)">@entry.Status</span></td>
                                    <td>@entry.ReferralDate.ToString("MM/dd/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery] private string PatientId { get; set; } = string.Empty;

    private string patientId = string.Empty;
    private string activeTab = "accounts";
    private bool loaded;
    private string? error;

    // ─── Data models ──────────────────────────────────────────────────────────

    private ARDebtorDto? debtor;
    private List<ARAccountIndexEntryDto>? accounts;
    private string? selectedAccountId;
    private ARAccountDetailDto? selectedAccount;
    private List<ARBatchIndexEntryDto>? batches;
    private ARSiteParamsDto? siteParams;

    // ─── Create Account form ──────────────────────────────────────────────────

    private bool showCreateAccount;
    private string newCategory = "CopayOutpatient";
    private decimal newAmount;
    private string? newBillingActionId;
    private DateTime? newDueDate;
    private string? createAccountMsg;

    // ─── Payment form ─────────────────────────────────────────────────────────

    private decimal payAmount;
    private string payMethod = "CASH";
    private string? payReceipt;
    private string? payCheck;
    private string payUserId = string.Empty;
    private string payUserName = string.Empty;
    private string? payMsg;

    // ─── Adjustment form ──────────────────────────────────────────────────────

    private decimal adjAmount;
    private string adjType = string.Empty;
    private string adjUserId = string.Empty;
    private string adjUserName = string.Empty;
    private string? adjMsg;

    // ─── Waive form ───────────────────────────────────────────────────────────

    private decimal waiveAmount;
    private string waiveReason = string.Empty;
    private string waiveUserId = string.Empty;
    private string waiveUserName = string.Empty;
    private string? waiveMsg;

    // ─── Accrue Charges form ─────────────────────────────────────────────────

    private decimal accrueInterestAmount;
    private decimal accruePenaltyAmount;
    private decimal accrueAdminCostAmount;
    private string accrueUserId = string.Empty;
    private string? accrueMsg;

    // ─── Treasury Offset form ────────────────────────────────────────────────

    private List<TopReferralIndexEntryDto>? topReferrals;
    private List<TopReferralIndexEntryDto>? pendingReferrals;
    private string topAccountId = string.Empty;
    private string topPatientName = string.Empty;
    private decimal topReferredAmount;
    private string topReferUserId = string.Empty;
    private string topReferUserName = string.Empty;
    private string? topReferNotes;
    private string? topReferMsg;
    private string? recordingOffsetReferralId;
    private decimal topOffsetAmount;
    private DateTime topOffsetDate = DateTime.Today;
    private string topOffsetUserId = string.Empty;
