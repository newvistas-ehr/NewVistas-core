    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(PatientId))
        {
            patientId = PatientId;
            await LoadPatient();
        }
    }

    private async Task LoadPatient()
    {
        error = null;
        loaded = false;
        if (string.IsNullOrWhiteSpace(patientId)) { error = "Enter a Patient ID."; return; }
        string pid = patientId.Trim();
        try
        {
            var debtorGrain = Grains.GetGrain<IARDebtorGrain>($"AR-DEBTOR:{pid}");
            ARDebtorState ds = await debtorGrain.GetAsync();
            debtor = new ARDebtorDto(ds.DebtorId, ds.PatientId, ds.Name,
                ds.TotalAmountOwed, ds.TotalAmountPaid, ds.CurrentBalance,
                ds.IsDelinquent, ds.IsInCollection, ds.IsWaived, ds.LastActivityDate);

            var acctIdx = Grains.GetGrain<IARAccountIndexGrain>($"AR-ACCT-IDX:{pid}");
            List<ARAccountIndexEntry> acctEntries = await acctIdx.GetAllAsync();
            accounts = acctEntries.Select(a => new ARAccountIndexEntryDto(
                a.ARAccountId, a.PatientId, a.ARCategory, a.ARStatus,
                a.OriginalAmount, a.CurrentBalance, a.DateEstablished)).ToList();

            var batchIdx = Grains.GetGrain<IARBatchPaymentIndexGrain>("AR-BATCH-IDX");
            List<ARBatchPaymentIndexEntry> batchEntries = await batchIdx.GetAllAsync();
            batches = batchEntries.Select(b => new ARBatchIndexEntryDto(
                b.BatchId, b.BatchDate, b.FacilityName,
                b.PaymentMethod, b.TotalAmount, b.IsPosted, b.PaymentCount)).ToList();

            var siteGrain = Grains.GetGrain<IARSiteParametersGrain>("AR-SITE-PARAMS");
            ARSiteParametersState sp = await siteGrain.GetAsync();
            siteParams = new ARSiteParamsDto(sp.SiteId, sp.SiteName, sp.ARFacilityNumber,
                sp.InterestRate, sp.AdminCost, sp.PenaltyRate,
                sp.MinimumPaymentAmount, sp.MaxPaymentPlanMonths,
                sp.IsAutoInterestEnabled, sp.IsPenaltyEnabled,
                sp.StatementFrequencyDays, sp.CollectionThreshold,
                sp.IsFmsEnabled, sp.IsTreasuryOffsetEnabled,
                sp.LastUpdatedDate, sp.LastUpdatedByUserId);
            if (siteParams != null)
            {
                spSiteName          = siteParams.SiteName ?? string.Empty;
                spFacilityNumber    = siteParams.ARFacilityNumber ?? string.Empty;
                spInterestRate      = siteParams.InterestRate;
                spAdminCost         = siteParams.AdminCost;
                spPenaltyRate       = siteParams.PenaltyRate;
                spMinPayment        = siteParams.MinimumPaymentAmount;
                spMaxMonths         = siteParams.MaxPaymentPlanMonths;
                spStatementDays     = siteParams.StatementFrequencyDays;
                spCollectionThreshold = siteParams.CollectionThreshold;
                spAutoInterest      = siteParams.IsAutoInterestEnabled;
                spPenaltyEnabled    = siteParams.IsPenaltyEnabled;
                spFmsEnabled        = siteParams.IsFmsEnabled;
                spTreasuryOffset    = siteParams.IsTreasuryOffsetEnabled;
            }
            loaded = true;
        }
        catch (Exception ex)
        {
            error = $"Error loading patient data: {ex.Message}";
        }
    }

    private async Task SelectAccount(string accountId)
    {
        selectedAccountId = accountId;
        try
        {
            string grainKey = accountId.StartsWith("AR-ACCOUNT:") ? accountId : $"AR-ACCOUNT:{accountId}";
            var acctGrain = Grains.GetGrain<IARAccountGrain>(grainKey);
            ARAccountState s = await acctGrain.GetAsync();
            selectedAccount = new ARAccountDetailDto(
                s.ARAccountId, s.PatientId, s.BillingActionId,
                s.ARCategory.ToString(), s.ARStatus.ToString(),
                s.OriginalAmount, s.CurrentBalance,
                s.AmountPaid, s.AmountWaived,
                s.InterestAccrued, s.PenaltyAccrued, s.AdminCostAccrued,
                s.DateEstablished, s.DueDate, s.TransactionIds);
        }
        catch (Exception ex)
        {
            error = $"Error loading account details: {ex.Message}";
        }
    }

    private async Task CreateAccount()
    {
        createAccountMsg = null;
        string pid = patientId.Trim();
        try
        {
            string acctId = Guid.NewGuid().ToString();
            var acctGrain = Grains.GetGrain<IARAccountGrain>($"AR-ACCOUNT:{acctId}");
            ARAccountCategory cat = Enum.TryParse<ARAccountCategory>(newCategory, out var c) ? c : ARAccountCategory.Other;
            await acctGrain.CreateAsync(pid, newBillingActionId, cat, newAmount, newDueDate);
            var acctIdx = Grains.GetGrain<IARAccountIndexGrain>($"AR-ACCT-IDX:{pid}");
            await acctIdx.AddOrUpdateAsync(new ARAccountIndexEntry
            {
                ARAccountId = $"AR-ACCOUNT:{acctId}",
                PatientId = pid,
                ARCategory = newCategory,
                ARStatus = "Active",
                OriginalAmount = newAmount,
                CurrentBalance = newAmount,
                DateEstablished = DateTime.UtcNow,
            });
            createAccountMsg = "Account created.";
            showCreateAccount = false;
            await RefreshAccountsAndDebtor(pid);
        }
        catch (Exception ex)
        {
            createAccountMsg = $"Error: {ex.Message}";
        }
    }

    private async Task RefreshAccountsAndDebtor(string pid)
    {
        var acctIdx = Grains.GetGrain<IARAccountIndexGrain>($"AR-ACCT-IDX:{pid}");
        List<ARAccountIndexEntry> acctEntries = await acctIdx.GetAllAsync();
        accounts = acctEntries.Select(a => new ARAccountIndexEntryDto(
            a.ARAccountId, a.PatientId, a.ARCategory, a.ARStatus,
            a.OriginalAmount, a.CurrentBalance, a.DateEstablished)).ToList();
        var debtorGrain = Grains.GetGrain<IARDebtorGrain>($"AR-DEBTOR:{pid}");
        ARDebtorState ds = await debtorGrain.GetAsync();
        debtor = new ARDebtorDto(ds.DebtorId, ds.PatientId, ds.Name,
            ds.TotalAmountOwed, ds.TotalAmountPaid, ds.CurrentBalance,
            ds.IsDelinquent, ds.IsInCollection, ds.IsWaived, ds.LastActivityDate);
    }

