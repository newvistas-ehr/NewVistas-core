@page "/shift-handoff"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Nursing Shift Handoff</PageTitle>

<h1>Nursing Shift Handoff / Report</h1>
<p class="page-subtitle">SBAR-structured nurse-to-nurse shift transfer documentation</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadHandoffs" />
<AlertBanner Error="@error" Success="@createResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "list")
    {
        @if (handoffs == null) { <div class="empty-state">Enter a Patient ID and click Load.</div> }
        else if (handoffs.Count == 0) { <div class="empty-state">No handoffs recorded.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Date</th><th>Shift</th><th>Outgoing</th><th>Incoming</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var h in handoffs)
                    {
                        <tr>
                            <td>@h.ShiftDate.ToString("MM/dd/yyyy")</td>
                            <td>@h.Shift</td>
                            <td>@h.OutgoingNurseName</td>
                            <td>@(h.IncomingNurseName ?? "—")</td>
                            <td>@h.Status</td>
                            <td><button class="btn btn-primary" @onclick="() => ViewDetail(h.HandoffId)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tab == "detail" && selected != null)
    {
        <div class="form-section">
            <h3>Shift Handoff: @selected.Shift @selected.ShiftDate.ToString("MM/dd/yyyy") — @selected.Status</h3>
            <p>
                <strong>Outgoing:</strong> @selected.OutgoingNurseName &nbsp;&nbsp;
                <strong>Incoming:</strong> @(selected.IncomingNurseName ?? "Pending") &nbsp;&nbsp;
                <strong>Location:</strong> @(selected.LocationName ?? "—") Bed @(selected.BedNumber ?? "—")
            </p>

            @if (selected.Sbar != null)
            {
                <h3>SBAR Report</h3>
                <p><strong>S — Situation:</strong> @selected.Sbar.Situation</p>
                <p><strong>B — Background:</strong> @selected.Sbar.Background</p>
                <p><strong>A — Assessment:</strong> @selected.Sbar.Assessment</p>
                <p><strong>R — Recommendation:</strong> @selected.Sbar.Recommendation</p>
            }

            @if (selected.ClinicalSnapshot != null)
            {
                <h3>Clinical Snapshot</h3>
                <p><strong>Vitals:</strong> @(selected.ClinicalSnapshot.VitalsSummary ?? "—")</p>
                <p><strong>Pain:</strong> @(selected.ClinicalSnapshot.PainScore?.ToString() ?? "—")/10</p>
                <p><strong>Acuity:</strong> @(selected.ClinicalSnapshot.AcuityLevel ?? "—")</p>
                <p><strong>Active Dx:</strong> @(selected.ClinicalSnapshot.ActiveNursingDiagnoses.Count > 0 ? string.Join(", ", selected.ClinicalSnapshot.ActiveNursingDiagnoses) : "None")</p>
                <p><strong>Pending Tasks:</strong> @(selected.ClinicalSnapshot.PendingTasks.Count > 0 ? string.Join("; ", selected.ClinicalSnapshot.PendingTasks) : "None")</p>
            }

            @if (selected.SafetyConcerns.Count > 0)
            {
                <div class="alert alert-error"><strong>Safety Concerns:</strong> @string.Join("; ", selected.SafetyConcerns)</div>
            }

            <div class="form-actions">
                @if (selected.Status == ShiftHandoffStatus.Draft) { <button class="btn btn-primary" @onclick="() => Complete(selected.HandoffId)">Complete Report</button> }
                @if (selected.Status == ShiftHandoffStatus.Completed) { <button class="btn btn-primary" @onclick="() => Ack(selected.HandoffId)">Acknowledge (Incoming)</button> }
            </div>
        </div>
    }

    @if (tab == "new")
    {
        <div class="form-section">
            <FormField Label="Shift">
                <select class="form-input" @bind="nShift">
                    <option value="@NursingShift.Day">Day</option>
                    <option value="@NursingShift.Evening">Evening</option>
                    <option value="@NursingShift.Night">Night</option>
                </select>
            </FormField>
            <FormField Label="Outgoing Nurse ID"><input class="form-input" @bind="nNurseId" /></FormField>
            <FormField Label="Outgoing Nurse Name"><input class="form-input" @bind="nNurseName" /></FormField>
            <FormField Label="Bed #"><input class="form-input" @bind="nBed" /></FormField>

            <h3>SBAR</h3>
            <FormField Label="S — Situation"><textarea class="form-input" rows="2" @bind="nSituation"></textarea></FormField>
            <FormField Label="B — Background"><textarea class="form-input" rows="2" @bind="nBackground"></textarea></FormField>
            <FormField Label="A — Assessment"><textarea class="form-input" rows="2" @bind="nAssessment"></textarea></FormField>
            <FormField Label="R — Recommendation"><textarea class="form-input" rows="2" @bind="nRecommendation"></textarea></FormField>

            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Create" disabled="@creating">@(creating ? "Creating..." : "Create Handoff")</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "list";
    private bool loading, creating;
    private string? error, createResult;
    private List<ShiftHandoffIndexEntry>? handoffs;
    private NursingShiftHandoffState? selected;
    private NursingShift nShift = NursingShift.Day;
    private string nNurseId = string.Empty, nNurseName = string.Empty, nBed = string.Empty;
    private string nSituation = string.Empty, nBackground = string.Empty, nAssessment = string.Empty, nRecommendation = string.Empty;
    private readonly (string, string)[] _tabs = new[] { ("list", "Handoff History"), ("detail", "Report Detail"), ("new", "New Handoff") };

    private async Task LoadHandoffs() { if (string.IsNullOrWhiteSpace(patientId)) return; loading = true; error = null; try { handoffs = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetShiftHandoffsAsync(); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task ViewDetail(string id) { try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetShiftHandoffAsync(id); tab = "detail"; } catch (Exception ex) { error = ex.Message; } }
    private async Task Complete(string id) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).CompleteShiftHandoffAsync(id); await ViewDetail(id); await LoadHandoffs(); } catch (Exception ex) { error = ex.Message; } }
    private async Task Ack(string id) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).AcknowledgeShiftHandoffAsync(id, "RN-INCOMING", "Incoming Nurse"); await ViewDetail(id); await LoadHandoffs(); } catch (Exception ex) { error = ex.Message; } }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        creating = true; error = null; createResult = null;
        try
        {
            SbarPatientSummary sbar = new() { Situation = nSituation, Background = nBackground, Assessment = nAssessment, Recommendation = nRecommendation };
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).CreateShiftHandoffAsync(nShift, DateTime.UtcNow.Date, nNurseId, nNurseName, null, null, nBed, sbar, null, null);
            createResult = $"Handoff created: {id}";
            await LoadHandoffs();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { creating = false; }
    }
}

<style>
    /* Canonical clinical classes live in app.css. Page-specific only: */
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.5; }
</style>
