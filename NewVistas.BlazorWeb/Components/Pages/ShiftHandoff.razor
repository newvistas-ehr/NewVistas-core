@page "/shift-handoff"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Nursing Shift Handoff</PageTitle>

<h3>Nursing Shift Handoff / Report</h3>
<p class="text-muted">SBAR-structured nurse-to-nurse shift transfer documentation</p>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width:260px" placeholder="Patient ID" @bind="patientId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadHandoffs" disabled="@loading">Load</button>
</div>

@if (error != null) { <div class="alert alert-danger">@error</div> }

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == "list" ? "active" : "")" @onclick='() => tab = "list"'>Handoff History</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "detail" ? "active" : "")" @onclick='() => tab = "detail"'>Report Detail</button></li>
    <li class="nav-item"><button class="nav-link @(tab == "new" ? "active" : "")" @onclick='() => tab = "new"'>New Handoff</button></li>
</ul>

@if (tab == "list" && handoffs != null)
{
    <table class="table table-sm table-striped">
        <thead><tr><th>Date</th><th>Shift</th><th>Outgoing</th><th>Incoming</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var h in handoffs)
            {
                <tr>
                    <td>@h.ShiftDate.ToString("MM/dd/yyyy")</td>
                    <td>@h.Shift</td>
                    <td>@h.OutgoingNurseName</td>
                    <td>@(h.IncomingNurseName ?? "—")</td>
                    <td><span class="badge @HBadge(h.Status)">@h.Status</span></td>
                    <td><button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetail(h.HandoffId)">View</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (tab == "detail" && selected != null)
{
    <div class="card mb-3">
        <div class="card-header"><strong>Shift Handoff:</strong> @selected.Shift @selected.ShiftDate.ToString("MM/dd/yyyy") <span class="badge @HBadge(selected.Status) ms-2">@selected.Status</span></div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4"><strong>Outgoing:</strong> @selected.OutgoingNurseName</div>
                <div class="col-md-4"><strong>Incoming:</strong> @(selected.IncomingNurseName ?? "Pending")</div>
                <div class="col-md-4"><strong>Location:</strong> @(selected.LocationName ?? "—") Bed @(selected.BedNumber ?? "—")</div>
            </div>

            @if (selected.Sbar != null)
            {
                <h6>SBAR Report</h6>
                <div class="row g-2 mb-3">
                    <div class="col-md-6"><div class="card"><div class="card-body"><h6 class="card-title text-primary">S — Situation</h6><p>@selected.Sbar.Situation</p></div></div></div>
                    <div class="col-md-6"><div class="card"><div class="card-body"><h6 class="card-title text-info">B — Background</h6><p>@selected.Sbar.Background</p></div></div></div>
                    <div class="col-md-6"><div class="card"><div class="card-body"><h6 class="card-title text-success">A — Assessment</h6><p>@selected.Sbar.Assessment</p></div></div></div>
                    <div class="col-md-6"><div class="card"><div class="card-body"><h6 class="card-title text-warning">R — Recommendation</h6><p>@selected.Sbar.Recommendation</p></div></div></div>
                </div>
            }

            @if (selected.ClinicalSnapshot != null)
            {
                <h6>Clinical Snapshot</h6>
                <dl class="row mb-0">
                    <dt class="col-sm-3">Vitals</dt><dd class="col-sm-9">@(selected.ClinicalSnapshot.VitalsSummary ?? "—")</dd>
                    <dt class="col-sm-3">Pain</dt><dd class="col-sm-9">@(selected.ClinicalSnapshot.PainScore?.ToString() ?? "—")/10</dd>
                    <dt class="col-sm-3">Acuity</dt><dd class="col-sm-9">@(selected.ClinicalSnapshot.AcuityLevel ?? "—")</dd>
                    <dt class="col-sm-3">Active Dx</dt><dd class="col-sm-9">@(selected.ClinicalSnapshot.ActiveNursingDiagnoses.Count > 0 ? string.Join(", ", selected.ClinicalSnapshot.ActiveNursingDiagnoses) : "None")</dd>
                    <dt class="col-sm-3">Pending Tasks</dt><dd class="col-sm-9">@(selected.ClinicalSnapshot.PendingTasks.Count > 0 ? string.Join("; ", selected.ClinicalSnapshot.PendingTasks) : "None")</dd>
                </dl>
            }

            @if (selected.SafetyConcerns.Count > 0)
            {
                <div class="alert alert-warning mt-2"><strong>Safety Concerns:</strong> @string.Join("; ", selected.SafetyConcerns)</div>
            }

            <div class="d-flex gap-2 mt-3">
                @if (selected.Status == ShiftHandoffStatus.Draft) { <button class="btn btn-sm btn-success" @onclick="() => Complete(selected.HandoffId)">Complete Report</button> }
                @if (selected.Status == ShiftHandoffStatus.Completed) { <button class="btn btn-sm btn-primary" @onclick="() => Ack(selected.HandoffId)">Acknowledge (Incoming)</button> }
            </div>
        </div>
    </div>
}

@if (tab == "new")
{
    <div class="card">
        <div class="card-header">New Shift Handoff Report (SBAR)</div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-3"><label class="form-label">Shift</label><select class="form-select" @bind="nShift"><option value="@NursingShift.Day">Day</option><option value="@NursingShift.Evening">Evening</option><option value="@NursingShift.Night">Night</option></select></div>
                <div class="col-md-3"><label class="form-label">Outgoing Nurse ID</label><input class="form-control" @bind="nNurseId" /></div>
                <div class="col-md-3"><label class="form-label">Outgoing Nurse Name</label><input class="form-control" @bind="nNurseName" /></div>
                <div class="col-md-3"><label class="form-label">Bed #</label><input class="form-control" @bind="nBed" /></div>
            </div>
            <h6 class="mt-2">SBAR</h6>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><label class="form-label">S — Situation</label><textarea class="form-control" rows="2" @bind="nSituation"></textarea></div>
                <div class="col-md-6"><label class="form-label">B — Background</label><textarea class="form-control" rows="2" @bind="nBackground"></textarea></div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6"><label class="form-label">A — Assessment</label><textarea class="form-control" rows="2" @bind="nAssessment"></textarea></div>
                <div class="col-md-6"><label class="form-label">R — Recommendation</label><textarea class="form-control" rows="2" @bind="nRecommendation"></textarea></div>
            </div>
            <button class="btn btn-success" @onclick="Create" disabled="@creating">@(creating ? "Creating..." : "Create Handoff")</button>
            @if (createResult != null) { <div class="alert alert-success mt-2">@createResult</div> }
        </div>
    </div>
}

@code {
    private string patientId = string.Empty, tab = "list";
    private bool loading, creating;
    private string? error, createResult;
    private List<ShiftHandoffIndexEntry>? handoffs;
    private NursingShiftHandoffState? selected;
    private NursingShift nShift = NursingShift.Day;
    private string nNurseId = string.Empty, nNurseName = string.Empty, nBed = string.Empty;
    private string nSituation = string.Empty, nBackground = string.Empty, nAssessment = string.Empty, nRecommendation = string.Empty;

    private async Task LoadHandoffs() { if (string.IsNullOrWhiteSpace(patientId)) return; loading = true; error = null; try { handoffs = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetShiftHandoffsAsync(); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task ViewDetail(string id) { try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetShiftHandoffAsync(id); tab = "detail"; } catch (Exception ex) { error = ex.Message; } }
    private async Task Complete(string id) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).CompleteShiftHandoffAsync(id); await ViewDetail(id); await LoadHandoffs(); } catch (Exception ex) { error = ex.Message; } }
    private async Task Ack(string id) { try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).AcknowledgeShiftHandoffAsync(id, "RN-INCOMING", "Incoming Nurse"); await ViewDetail(id); await LoadHandoffs(); } catch (Exception ex) { error = ex.Message; } }

    private async Task Create()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        creating = true; error = null; createResult = null;
        try
        {
            SbarPatientSummary sbar = new() { Situation = nSituation, Background = nBackground, Assessment = nAssessment, Recommendation = nRecommendation };
            string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).CreateShiftHandoffAsync(nShift, DateTime.UtcNow.Date, nNurseId, nNurseName, null, null, nBed, sbar, null, null);
            createResult = $"Handoff created: {id}";
            await LoadHandoffs();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { creating = false; }
    }

    private string HBadge(ShiftHandoffStatus s) => s switch { ShiftHandoffStatus.Draft => "bg-warning text-dark", ShiftHandoffStatus.Completed => "bg-primary", ShiftHandoffStatus.Acknowledged => "bg-success", _ => "bg-secondary" };
}
