@page "/problems"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Problem List</PageTitle>

<h1>Problem List</h1>

<div class="lookup-bar">
    <input type="text" @bind="patientId" @bind:event="oninput" @onkeydown="HandleKeyDown"
           placeholder="Patient ID" class="lookup-input" />
    <button @onclick="Load" disabled="@(string.IsNullOrWhiteSpace(patientId) || loading)" class="btn btn-primary">
        @if (loading) { <span>Loading...</span> } else { <span>Load</span> }
    </button>
</div>

@if (error != null) { <div class="alert alert-error">@error</div> }
@if (successMessage != null) { <div class="alert alert-success">@successMessage</div> }

@if (patientId != null)
{
    <div class="tab-bar">
        <button class="tab @(activeTab == "view" ? "active" : "")" @onclick='() => activeTab = "view"'>Problem List</button>
        <button class="tab @(activeTab == "add" ? "active" : "")" @onclick='() => activeTab = "add"'>Add Problem</button>
    </div>

    @if (activeTab == "view")
    {
        <div class="filter-row">
            <label class="checkbox-label">
                <input type="checkbox" @bind="activeOnly" @bind:after="Load" /> Active only
            </label>
        </div>

        @if (items == null)
        {
            <div class="empty-state">Enter a Patient ID and click Load.</div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state">No problems found.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>Diagnosis</th><th>Code</th><th>Status</th><th>Onset</th><th>Condition</th><th>SC</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr>
                            <td>@p.Diagnosis</td>
                            <td class="code">@p.DiagnosisCode</td>
                            <td class="status @(p.Status == "ACTIVE" ? "active" : "inactive")">@p.Status</td>
                            <td class="date">@p.DateOfOnset?.ToString("MM/dd/yyyy")</td>
                            <td class="condition">@p.Condition</td>
                            <td>@(p.IsServiceConnected ? "Yes" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (activeTab == "add")
    {
        <div class="form-section">
            <div class="form-row">
                <label>Diagnosis <span class="required">*</span></label>
                <input type="text" @bind="form.Diagnosis" placeholder="e.g. Type 2 Diabetes Mellitus" class="form-input" />
            </div>
            <div class="form-row">
                <label>ICD-10 Code</label>
                <input type="text" @bind="form.DiagnosisCode" placeholder="e.g. E11.9" class="form-input" />
            </div>
            <div class="form-row">
                <label>Condition</label>
                <select @bind="form.Condition" class="form-input">
                    <option value="">-- Select --</option>
                    <option value="ACUTE">Acute</option>
                    <option value="CHRONIC">Chronic</option>
                    <option value="PERMANENT">Permanent</option>
                    <option value="TRANSCRIBED">Transcribed</option>
                </select>
            </div>
            <div class="form-row">
                <label>Priority</label>
                <select @bind="form.Priority" class="form-input">
                    <option value="">-- Select --</option>
                    <option value="ACUTE">Acute</option>
                    <option value="CHRONIC">Chronic</option>
                </select>
            </div>
            <div class="form-row">
                <label>Onset Date</label>
                <input type="date" @bind="form.DateOfOnset" class="form-input" />
            </div>
            <div class="form-row">
                <label>Provider</label>
                <input type="text" @bind="form.ProviderName" placeholder="Provider name" class="form-input" />
            </div>
            <div class="form-row">
                <label>Clinic</label>
                <input type="text" @bind="form.ClinicName" placeholder="Clinic name" class="form-input" />
            </div>
            <div class="form-row">
                <label>Service Connected</label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="form.IsServiceConnected" /> Yes
                </label>
            </div>
            <div class="form-row align-top">
                <label>Comments</label>
                <textarea @bind="form.Comments" rows="3" class="form-input"></textarea>
            </div>
            <div class="form-actions">
                <button @onclick="SubmitProblem" disabled="@submitting" class="btn btn-primary">
                    @(submitting ? "Saving..." : "Add Problem")
                </button>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private bool activeOnly = true;
    private List<ProblemDto>? items;
    private bool loading;
    private bool submitting;
    private string? error;
    private string? successMessage;
    private string activeTab = "view";

    private ProblemFormModel form = new();

    protected override async Task OnParametersSetAsync() { if (!string.IsNullOrWhiteSpace(patientId)) await Load(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null; items = null; successMessage = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            List<ProblemSummary> problems = activeOnly
                ? await workflow.GetActiveProblemsAsync()
                : await workflow.GetAllProblemsAsync();
            items = problems.Select(p => new ProblemDto
            {
                Diagnosis = p.Diagnosis,
                DiagnosisCode = p.DiagnosisCode,
                Status = p.Status,
                DateOfOnset = p.DateOfOnset,
                Condition = p.Condition,
                IsServiceConnected = p.IsServiceConnected
            }).ToList();
        }
        catch (Exception ex) { error = $"Error loading problems: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task SubmitProblem()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        if (string.IsNullOrWhiteSpace(form.Diagnosis)) { error = "Diagnosis is required."; return; }

        submitting = true; error = null; successMessage = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.AddProblemAsync(
                form.Diagnosis, form.DiagnosisCode,
                string.IsNullOrEmpty(form.Condition) ? null : form.Condition,
                string.IsNullOrEmpty(form.Priority) ? null : form.Priority,
                form.DateOfOnset,
                null, form.ProviderName,
                null, form.ClinicName,
                form.IsServiceConnected, form.Comments);

            successMessage = "Problem added successfully.";
            form = new ProblemFormModel();
            activeTab = "view";
            activeOnly = true;
            await Load();
        }
        catch (Exception ex) { error = $"Error saving problem: {ex.Message}"; }
        finally { submitting = false; }
    }

    private class ProblemDto
    {
        public string Diagnosis { get; set; } = "";
        public string? DiagnosisCode { get; set; }
        public string Status { get; set; } = "";
        public DateTime? DateOfOnset { get; set; }
        public string? Condition { get; set; }
        public bool IsServiceConnected { get; set; }
    }

    private class ProblemFormModel
    {
        public string Diagnosis { get; set; } = "";
        public string? DiagnosisCode { get; set; }
        public string? Condition { get; set; }
        public string? Priority { get; set; }
        public DateTime? DateOfOnset { get; set; }
        public string? ProviderName { get; set; }
        public string? ClinicName { get; set; }
        public bool IsServiceConnected { get; set; }
        public string? Comments { get; set; }
    }
}

<style>
    .lookup-bar { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; align-items: center; }
    .lookup-input { width: 280px; padding: 0.5rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
    .btn { padding: 0.5rem 1.25rem; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; }
    .btn-primary { background: #003f72; color: white; }
    .btn-primary:disabled { background: #999; cursor: not-allowed; }
    .alert { padding: 0.75rem 1rem; border-radius: 4px; margin-bottom: 1rem; }
    .alert-error { background: #fde8e8; color: #b91c1c; border: 1px solid #f5c6c6; }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .empty-state { color: #999; font-style: italic; padding: 2rem 0; }
    .filter-row { margin-bottom: 0.75rem; }
    .checkbox-label { font-size: 0.85rem; display: flex; align-items: center; gap: 0.3rem; cursor: pointer; }

    .tab-bar { display: flex; gap: 0; margin-bottom: 1.5rem; border-bottom: 2px solid #d4d9e0; }
    .tab { padding: 0.5rem 1.25rem; border: none; background: none; cursor: pointer; font-size: 0.85rem; color: #555; border-bottom: 2px solid transparent; margin-bottom: -2px; }
    .tab.active { color: #003f72; border-bottom-color: #003f72; font-weight: 600; }

    .data-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; border: 1px solid #d4d9e0; }
    .data-table thead { background: #f4f6f9; }
    .data-table th { text-align: left; padding: 0.5rem; font-weight: 600; color: #003f72; border-bottom: 2px solid #d4d9e0; font-size: 0.75rem; text-transform: uppercase; }
    .data-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #f0f0f0; }
    .data-table tr:hover { background: #f9fafb; }
    .code { font-family: monospace; color: #003f72; }
    .status.active { color: #166534; font-weight: 500; }
    .status.inactive { color: #6b7280; }
    .condition { color: #555; font-size: 0.8rem; }
    .date { color: #888; font-size: 0.8rem; }

    .form-section { max-width: 600px; }
    .form-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
    .form-row.align-top { align-items: flex-start; }
    .form-row label:first-child { width: 140px; font-size: 0.85rem; font-weight: 500; color: #333; flex-shrink: 0; }
    .required { color: #b91c1c; }
    .form-input { flex: 1; padding: 0.4rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem; }
    textarea.form-input { resize: vertical; }
    .form-actions { margin-top: 1.25rem; }
</style>
