@page "/problems"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@using NewVistas.Abstractions.Clinical
@inject OrleansGrainService Grains

<PageTitle>Problem List</PageTitle>

<h1>Problem List</h1>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="Load" />

<AlertBanner Error="@error" Success="@successMessage" />

@if (patientId != null)
{
    <TabStrip Tabs="_tabs" @bind-Active="activeTab" />

    @if (activeTab == "view")
    {
        <div class="filter-row">
            <label class="checkbox-label">
                <input type="checkbox" @bind="activeOnly" @bind:after="Load" /> Active only
            </label>
        </div>

        @if (items == null)
        {
            <div class="empty-state">Enter a Patient ID and click Load.</div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state">No problems found.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr><th>Diagnosis</th><th>Code</th><th>Status</th><th>Onset</th><th>Condition</th><th>SC</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr>
                            <td>
                                @p.Diagnosis
                                @if (p.VerificationStatus is ProblemVerificationStatus.Unconfirmed
                                     or ProblemVerificationStatus.Provisional
                                     or ProblemVerificationStatus.Differential)
                                {
                                    @* A suspected diagnosis must not render identically to a
                                       confirmed one — that reading error is the whole point. *@
                                    <span class="vs-chip">@p.VerificationStatus.ToString().ToLowerInvariant()</span>
                                }
                            </td>
                            <td class="code">@p.DiagnosisCode</td>
                            <td class="status @(p.Status == "ACTIVE" ? "active" : "inactive")">@p.Status</td>
                            <td class="date">@p.DateOfOnset?.ToString("MM/dd/yyyy")</td>
                            <td class="condition">@p.Condition</td>
                            <td>@(p.IsServiceConnected ? "Yes" : "")</td>
                            <td>
                                <button type="button" class="btn-link ev-open"
                                        @onclick="() => OpenEvidence(p)">Evidence</button>
                                @if (openEpisodeProblemIds.Contains(p.ProblemId))
                                {
                                    <button type="button" class="btn-link"
                                            @onclick="() => BeginAdjudication(p)">How did it turn out?</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (adjudicating is not null)
            {
                <div class="adjudicate-panel">
                    <h3>How did this turn out?</h3>
                    <p class="adjudicate-subject">
                        <span class="code">@adjudicating.DiagnosisCode</span> @adjudicating.Diagnosis
                    </p>
                    <p class="adjudicate-why">
                        Answering is optional and can be skipped. It is never required — a forced
                        field produces default-clicked answers, which are worse than no answer at all
                        because they cannot be told apart from real ones.
                    </p>

                    <FormField Label="Outcome">
                        <select @bind="adjOutcome" class="form-input">
                            <option value="@DiagnosticEpisodeOutcome.Confirmed">It was right</option>
                            <option value="@DiagnosticEpisodeOutcome.Refined">Same condition, more specific</option>
                            <option value="@DiagnosticEpisodeOutcome.Broadened">Same condition, less specific</option>
                            <option value="@DiagnosticEpisodeOutcome.Revised">It was something else</option>
                            <option value="@DiagnosticEpisodeOutcome.ResolvedWithoutAlternate">Resolved, never established</option>
                            <option value="@DiagnosticEpisodeOutcome.ClosedUnadjudicated">Don't know / lost to follow-up</option>
                        </select>
                    </FormField>

                    @if (adjOutcome is DiagnosticEpisodeOutcome.Revised
                         or DiagnosticEpisodeOutcome.Refined
                         or DiagnosticEpisodeOutcome.Broadened)
                    {
                        <FormField Label="What it actually was">
                            <div class="icd-search">
                                <input type="text" @bind="adjIcdTerm" @bind:event="oninput"
                                       placeholder="Search ICD-10" class="icd-input" />
                                <button type="button" class="btn btn-secondary" @onclick="SearchAdjIcd">Search</button>
                            </div>
                            @if (adjIcdResults is { Count: > 0 })
                            {
                                <ul class="icd-results">
                                    @foreach (var r in adjIcdResults)
                                    {
                                        <li @onclick="() => PickAdjIcd(r)">
                                            <span class="code">@r.Code</span> @r.ShortDescription
                                        </li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrWhiteSpace(adjOutcomeCode))
                            {
                                <div class="adj-picked">
                                    <span class="code">@adjOutcomeCode</span> @adjOutcomeDisplay
                                </div>
                            }
                        </FormField>

                        @if (proposal is not null)
                        {
                            @* The system proposes; the clinician confirms. What gets counted is
                               the clinician's choice — a machine's opinion that a doctor was wrong
                               is an accusation, a doctor's own coded statement is evidence. *@
                            <div class="adj-proposal">
                                Suggested: <strong>@proposal</strong>. Change it if that is wrong.
                            </div>
                        }
                    }

                    <FormField Label="Note">
                        <textarea @bind="adjNote" rows="2" class="form-input"
                                  placeholder="Optional — what changed your mind?"></textarea>
                    </FormField>

                    <div class="form-actions">
                        <button class="btn btn-primary" disabled="@adjSubmitting" @onclick="SubmitAdjudication">
                            @(adjSubmitting ? "Saving..." : "Record outcome")
                        </button>
                        <button class="btn btn-secondary" @onclick="() => adjudicating = null">Skip</button>
                    </div>
                </div>
            }

            @* ── Evidence panel (ADR-006 assertion head) ──
               What this diagnosis rests on: Supports / Refutes / NotAssessed / Indeterminate
               rows, each a structured citation. NotAssessed is first-class here — a positive
               record that something was NOT checked, which otherwise reads as a silent
               negative. Until this panel existed the model was writable only from seed code. *@
            @if (evidenceProblem is not null)
            {
                <div class="evidence-panel">
                    <div class="ev-head">
                        <div>
                            <strong>Evidence — @evidenceProblem.Diagnosis</strong>
                            <span class="code">@evidenceProblem.DiagnosisCode</span>
                            <span class="vs-chip">@evidenceProblem.VerificationStatus.ToString().ToLowerInvariant()</span>
                            @if (evidenceProblem.RevisionNumber > 0)
                            {
                                <span class="ev-meta">revision @evidenceProblem.RevisionNumber</span>
                            }
                        </div>
                        <button class="btn btn-secondary" @onclick="() => evidenceProblem = null">Close</button>
                    </div>

                    @if (evidenceProblem.SupersededByProblemId is not null)
                    {
                        <div class="ev-meta">Superseded by problem @evidenceProblem.SupersededByProblemId
                            (@(evidenceProblem.LastRevisionReason?.ToString() ?? "unstated")).</div>
                    }
                    @if (evidenceProblem.SupersedesProblemId is not null)
                    {
                        <div class="ev-meta">Supersedes problem @evidenceProblem.SupersedesProblemId.</div>
                    }

                    @if (evidenceProblem.Evidence.Count == 0)
                    {
                        <div class="empty-state">
                            No structured evidence recorded. An empty list means nothing was
                            recorded — not that nothing exists, and not that findings were negative.
                        </div>
                    }
                    else
                    {
                        @foreach (var ev in evidenceProblem.Evidence)
                        {
                            <div class="ev-row">
                                <span class="ev-chip @PolarityClass(ev.Polarity)">@PolarityLabel(ev.Polarity)</span>
                                <span class="ev-kind">@KindLabel(ev.Kind)</span>
                                <span>@ev.Display</span>
                                @if (!string.IsNullOrEmpty(ev.ObservedValue))
                                {
                                    <span class="ev-val">@ev.ObservedValue @ev.ObservedUnit</span>
                                }
                                @if (ev.ObservedUtc is not null)
                                {
                                    <span class="ev-meta">@ev.ObservedUtc.Value.ToString("MM/dd/yyyy")</span>
                                }
                                @if (ev.IsMachineCited)
                                {
                                    <span class="ev-chip ev-machine">machine-cited</span>
                                }
                                @if (!string.IsNullOrEmpty(ev.Note))
                                {
                                    <div class="ev-note">@ev.Note</div>
                                }
                            </div>
                        }
                    }

                    <fieldset class="ev-add">
                        <legend>Add evidence</legend>
                        <FormField Label="This evidence">
                            <select @bind="evPolarity" class="form-input">
                                <option value="@EvidencePolarity.Supports">Supports the diagnosis</option>
                                <option value="@EvidencePolarity.Refutes">Argues against it (informative negative)</option>
                                <option value="@EvidencePolarity.NotAssessed">Was NOT assessed — record the gap</option>
                                <option value="@EvidencePolarity.Indeterminate">Equivocal / indeterminate</option>
                            </select>
                        </FormField>
                        <FormField Label="Kind">
                            <select @bind="evKind" class="form-input">
                                <option value="@EvidenceKind.LabResult">Lab result</option>
                                <option value="@EvidenceKind.Symptom">Symptom</option>
                                <option value="@EvidenceKind.Note">Note</option>
                                <option value="@EvidenceKind.Imaging">Imaging</option>
                                <option value="@EvidenceKind.Medication">Medication</option>
                                <option value="@EvidenceKind.ClinicalJudgment">Exam / clinical judgment</option>
                                <option value="@EvidenceKind.ExternalRecord">External record</option>
                            </select>
                        </FormField>

                        @if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.LabResult)
                        {
                            <FormField Label="Which result">
                                <select @bind="evLabPick" class="form-input">
                                    <option value="">-- pick a lab result --</option>
                                    @for (int i = 0; i < evLabs.Count; i++)
                                    {
                                        <option value="@i">@evLabs[i].TestName — @evLabs[i].Value @evLabs[i].Units (@evLabs[i].ResultDate.ToString("MM/dd/yyyy"))</option>
                                    }
                                </select>
                            </FormField>
                        }
                        else if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.Note)
                        {
                            <FormField Label="Which note">
                                <select @bind="evNotePick" class="form-input">
                                    <option value="">-- pick a note --</option>
                                    @for (int i = 0; i < evNotes.Count; i++)
                                    {
                                        <option value="@i">@(evNotes[i].Subject ?? evNotes[i].DocumentType) (@evNotes[i].ReferenceDate.ToString("MM/dd/yyyy"))</option>
                                    }
                                </select>
                            </FormField>
                        }
                        else if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.Symptom)
                        {
                            <FormField Label="Which symptom">
                                <select @bind="evSymptomPick" class="form-input">
                                    <option value="">-- pick a recorded symptom --</option>
                                    @for (int i = 0; i < evSymptoms.Count; i++)
                                    {
                                        <option value="@i">@evSymptoms[i].Display — @evSymptoms[i].Presence (@evSymptoms[i].RecordedDate.ToString("MM/dd/yyyy"))</option>
                                    }
                                </select>
                            </FormField>
                        }
                        else
                        {
                            <FormField Label="@(evPolarity == EvidencePolarity.NotAssessed ? "What was not checked" : "Describe it")" Required>
                                <input type="text" @bind="evDisplay" class="form-input"
                                       placeholder="@(evPolarity == EvidencePolarity.NotAssessed ? "e.g. Influenza PCR — never performed" : "e.g. Strength 3/5 in right deltoid on exam")" />
                            </FormField>
                        }

                        <FormField Label="Comment">
                            <input type="text" @bind="evNote" class="form-input" placeholder="Optional qualifier" />
                        </FormField>
                        <FormField Label="Certainty after this">
                            <select @bind="evCertainty" class="form-input">
                                <option value="KEEP">Leave unchanged (@evidenceProblem.VerificationStatus)</option>
                                <option value="@ProblemVerificationStatus.Unconfirmed">Unconfirmed</option>
                                <option value="@ProblemVerificationStatus.Provisional">Provisional</option>
                                <option value="@ProblemVerificationStatus.Differential">Differential</option>
                                <option value="@ProblemVerificationStatus.Confirmed">Confirmed</option>
                                <option value="@ProblemVerificationStatus.Refuted">Refuted — actively disproved</option>
                            </select>
                        </FormField>
                        <div class="form-actions">
                            <button class="btn btn-primary" disabled="@evSubmitting" @onclick="SubmitEvidence">
                                @(evSubmitting ? "Saving..." : "Add evidence")
                            </button>
                        </div>
                    </fieldset>
                </div>
            }
        }
    }

    @if (activeTab == "add")
    {
        <div class="form-section">
            <FormField Label="Find diagnosis">
                <div class="icd-search">
                    <input type="text" @bind="icdSearchTerm" @bind:event="oninput" @onkeydown="IcdKeyDown"
                           placeholder="Search by name or ICD-10 code, e.g. diabetes or E11" class="icd-input" />
                    <button type="button" @onclick="SearchIcd10" disabled="@icdSearching" class="btn btn-secondary">
                        @(icdSearching ? "..." : "Search")
                    </button>
                </div>
                @if (icdResults != null)
                {
                    @if (icdResults.Count == 0)
                    {
                        <div class="icd-empty">No matching ICD-10 codes.</div>
                    }
                    else
                    {
                        <ul class="icd-results">
                            @foreach (var r in icdResults)
                            {
                                <li @onclick="() => PickIcd10(r)">
                                    <span class="code">@r.Code</span> @r.ShortDescription
                                    @if (!r.IsBillable) { <span class="non-billable">(non-billable)</span> }
                                </li>
                            }
                        </ul>
                    }
                }
            </FormField>
            <FormField Label="Diagnosis" Required>
                <input type="text" @bind="form.Diagnosis" placeholder="e.g. Type 2 Diabetes Mellitus" class="form-input" />
            </FormField>
            <FormField Label="ICD-10 Code">
                <input type="text" @bind="form.DiagnosisCode" placeholder="Pick from search, or type e.g. E11.9" class="form-input" />
            </FormField>

            @* Assertion-time advisory (ADR-006). Deliberately here — at the moment the working
               diagnosis is chosen — rather than only at adjudication, where it would arrive to
               congratulate a correction already made. ProblemId is null: the problem does not
               exist yet, and marking exposure while someone browses codes would poison the
               unexposed comparison arm. *@
            <DiagnosisAdvisoryPanel PatientId="@patientId"
                                    DiagnosisCode="@form.DiagnosisCode"
                                    DiagnosisDisplay="@form.Diagnosis" />
            <FormField Label="Condition">
                <select @bind="form.Condition" class="form-input">
                    <option value="">-- Select --</option>
                    <option value="ACUTE">Acute</option>
                    <option value="CHRONIC">Chronic</option>
                    <option value="PERMANENT">Permanent</option>
                    <option value="TRANSCRIBED">Transcribed</option>
                </select>
            </FormField>
            <FormField Label="Priority">
                <select @bind="form.Priority" class="form-input">
                    <option value="">-- Select --</option>
                    <option value="ACUTE">Acute</option>
                    <option value="CHRONIC">Chronic</option>
                </select>
            </FormField>
            <FormField Label="Onset Date">
                <input type="date" @bind="form.DateOfOnset" max="@todayIso" class="form-input" />
            </FormField>
            <FormField Label="Provider">
                <ProviderPicker @bind-ProviderId="form.ProviderId" @bind-ProviderName="form.ProviderName" Label="" />
            </FormField>
            <FormField Label="Clinic">
                <select @bind="form.ClinicId" @bind:after="OnClinicChanged" class="form-input">
                    <option value="">-- Select clinic --</option>
                    @if (clinics != null)
                    {
                        @foreach (var c in clinics)
                        {
                            <option value="@c.ClinicId">@c.Name</option>
                        }
                    }
                </select>
            </FormField>
            <FormField Label="Service Connected">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="form.IsServiceConnected" /> Yes
                </label>
            </FormField>
            <FormField Label="Comments">
                <textarea @bind="form.Comments" rows="3" class="form-input"></textarea>
            </FormField>
            <div class="form-actions">
                <button @onclick="SubmitProblem" disabled="@submitting" class="btn btn-primary">
                    @(submitting ? "Saving..." : "Add Problem")
                </button>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery] public string? patientId { get; set; }
    private bool activeOnly = true;
    private List<ProblemDto>? items;
    private bool loading;
    private readonly (string, string)[] _tabs = new[] { ("view", "Problem List"), ("add", "Add Problem") };
    private bool submitting;
    private string? error;
    private string? successMessage;
    private string activeTab = "view";

    private ProblemFormModel form = new();

    // ICD-10 diagnosis search
    private string icdSearchTerm = "";
    private List<Icd10IndexEntry>? icdResults;
    private bool icdSearching;

    // Clinic dropdown (loaded once)
    private List<ClinicEntry>? clinics;

    // Onset cannot be in the future — cap the date picker at today.
    private readonly string todayIso = DateTime.Today.ToString("yyyy-MM-dd");

    // Diagnostic stewardship (ADR-006) — adjudication prompt state.
    private HashSet<string> openEpisodeProblemIds = new(StringComparer.Ordinal);
    private ProblemDto? adjudicating;
    private DiagnosticEpisodeOutcome adjOutcome = DiagnosticEpisodeOutcome.Confirmed;
    private string? adjOutcomeCode;
    private string? adjOutcomeDisplay;
    private string? adjNote;
    private string adjIcdTerm = "";
    private List<Icd10IndexEntry>? adjIcdResults;
    private string? proposal;
    private bool adjSubmitting;

    // Evidence panel (ADR-006 assertion head)
    private ProblemEntry? evidenceProblem;
    private EvidencePolarity evPolarity = EvidencePolarity.Supports;
    private EvidenceKind evKind = EvidenceKind.LabResult;
    private string evLabPick = "", evNotePick = "", evSymptomPick = "";
    private string? evDisplay, evNote;
    private string evCertainty = "KEEP";
    private bool evSubmitting;
    private List<LabTestSummaryEntry> evLabs = new();
    private List<TiuNoteSummary> evNotes = new();
    private List<SymptomObservation> evSymptoms = new();

    protected override async Task OnInitializedAsync()
    {
        try { clinics = await Grains.GetGrain<IClinicIndexGrain>("SD-CLINIC-INDEX").GetAllClinicsAsync(); }
        catch { clinics = new(); }
    }

    protected override async Task OnParametersSetAsync() { if (!string.IsNullOrWhiteSpace(patientId)) await Load(); }
    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await Load(); }

    private async Task IcdKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await SearchIcd10(); }

    private async Task SearchIcd10()
    {
        if (string.IsNullOrWhiteSpace(icdSearchTerm)) { icdResults = null; return; }
        icdSearching = true; error = null;
        try
        {
            var index = Grains.GetGrain<IIcd10IndexGrain>("ICD10-INDEX");
            icdResults = await index.SearchAsync(icdSearchTerm.Trim(), false, 20);
        }
        catch (Exception ex) { error = $"ICD-10 search failed: {ex.Message}"; }
        finally { icdSearching = false; }
    }

    // Picking a code fills BOTH the description and the code, so they always agree
    // (no more "broken arm" saved against a diabetes code).
    private void PickIcd10(Icd10IndexEntry entry)
    {
        form.DiagnosisCode = entry.Code;
        form.Diagnosis = entry.ShortDescription;
        icdResults = null;
        icdSearchTerm = "";
    }

    private void OnClinicChanged()
        => form.ClinicName = clinics?.FirstOrDefault(c => c.ClinicId == form.ClinicId)?.Name;

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        loading = true; error = null; items = null; successMessage = null;
        // Clear per-patient panel state so a stale adjudication/evidence panel from the
        // previous patient never survives a patient switch.
        adjudicating = null;
        adjOutcome = DiagnosticEpisodeOutcome.Confirmed;
        adjOutcomeCode = null; adjOutcomeDisplay = null; adjNote = null;
        adjIcdTerm = ""; adjIcdResults = null; proposal = null;
        evidenceProblem = null;
        evLabs = new(); evNotes = new(); evSymptoms = new();
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            List<ProblemSummary> problems = activeOnly
                ? await workflow.GetActiveProblemsAsync()
                : await workflow.GetAllProblemsAsync();
            items = problems.Select(p => new ProblemDto
            {
                ProblemId = p.ProblemId,
                Diagnosis = p.Diagnosis,
                DiagnosisCode = p.DiagnosisCode,
                Status = p.Status,
                DateOfOnset = p.DateOfOnset,
                Condition = p.Condition,
                IsServiceConnected = p.IsServiceConnected,
                VerificationStatus = p.VerificationStatus
            }).ToList();

            await LoadOpenEpisodesAsync(workflow);
        }
        catch (Exception ex) { error = $"Error loading problems: {ex.Message}"; }
        finally { loading = false; }
    }

    /// <summary>
    /// Which problems still have an unadjudicated episode, so only those offer the prompt.
    /// Degrades to "none" when stewardship is off — the page must not depend on it.
    /// </summary>
    private async Task LoadOpenEpisodesAsync(IPatientWorkflowGrain workflow)
    {
        try
        {
            List<DiagnosticEpisode> episodes = await workflow.GetDiagnosticEpisodesAsync();
            openEpisodeProblemIds = episodes
                .Where(e => e.Outcome == DiagnosticEpisodeOutcome.Open)
                .Select(e => e.ProblemId)
                .ToHashSet(StringComparer.Ordinal);
        }
        catch { openEpisodeProblemIds = new(StringComparer.Ordinal); }
    }

    private void BeginAdjudication(ProblemDto p)
    {
        adjudicating = p;
        adjOutcome = DiagnosticEpisodeOutcome.Confirmed;
        adjOutcomeCode = null;
        adjOutcomeDisplay = null;
        adjNote = null;
        adjIcdTerm = "";
        adjIcdResults = null;
        proposal = null;
    }

    private async Task SearchAdjIcd()
    {
        if (string.IsNullOrWhiteSpace(adjIcdTerm)) { adjIcdResults = null; return; }
        try
        {
            adjIcdResults = await Grains.GetGrain<IIcd10IndexGrain>("ICD10-INDEX")
                .SearchAsync(adjIcdTerm.Trim(), false, 15);
        }
        catch (Exception ex) { error = $"ICD-10 search failed: {ex.Message}"; }
    }

    private void PickAdjIcd(Icd10IndexEntry entry)
    {
        adjOutcomeCode = entry.Code;
        adjOutcomeDisplay = entry.ShortDescription;
        adjIcdResults = null;
        adjIcdTerm = "";

        // Offer the system's reading as a default the clinician can override. Computed on the
        // client from the same shared rule the server uses, so the two cannot drift.
        DiagnosticEpisodeOutcome suggested =
            DiagnosisCodeRelation.Propose(adjudicating?.DiagnosisCode, adjOutcomeCode);
        if (suggested is DiagnosticEpisodeOutcome.Refined
            or DiagnosticEpisodeOutcome.Broadened
            or DiagnosticEpisodeOutcome.Revised
            or DiagnosticEpisodeOutcome.Confirmed)
        {
            adjOutcome = suggested;
            proposal = suggested switch
            {
                DiagnosticEpisodeOutcome.Refined => "same condition, more specific",
                DiagnosticEpisodeOutcome.Broadened => "same condition, less specific",
                DiagnosticEpisodeOutcome.Revised => "it was something else",
                _ => "it was right"
            };
        }
    }

    private async Task SubmitAdjudication()
    {
        if (adjudicating is null || string.IsNullOrWhiteSpace(patientId)) return;

        adjSubmitting = true; error = null;
        try
        {
            RevisionReason? reason = adjOutcome switch
            {
                DiagnosticEpisodeOutcome.Revised => RevisionReason.Correction,
                DiagnosticEpisodeOutcome.Refined or DiagnosticEpisodeOutcome.Broadened
                    => RevisionReason.Refinement,
                DiagnosticEpisodeOutcome.ResolvedWithoutAlternate => RevisionReason.Resolution,
                _ => null
            };

            bool ok = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim())
                .AdjudicateDiagnosticEpisodeAsync(
                    adjudicating.ProblemId, adjOutcome,
                    adjOutcomeCode, adjOutcomeDisplay, reason,
                    string.IsNullOrWhiteSpace(adjNote) ? null : adjNote);

            successMessage = ok
                ? "Outcome recorded. Thank you — this is what makes the statistics honest."
                : "No open episode for that problem.";
            adjudicating = null;
            await Load();
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = $"Error recording outcome: {ex.Message}"; }
        finally { adjSubmitting = false; }
    }

    // ── Evidence panel handlers (ADR-006) ───────────────────────────────────

    private static string KindLabel(EvidenceKind k) => k switch
    {
        EvidenceKind.LabResult => "lab result",
        EvidenceKind.ClinicalJudgment => "exam / judgment",
        EvidenceKind.ExternalRecord => "external record",
        EvidenceKind.ProtoCondition => "emerging cluster",
        _ => k.ToString().ToLowerInvariant(),
    };

    private static string PolarityLabel(EvidencePolarity p) => p switch
    {
        EvidencePolarity.Supports => "supports",
        EvidencePolarity.Refutes => "argues against",
        EvidencePolarity.NotAssessed => "not assessed",
        EvidencePolarity.Indeterminate => "equivocal",
        EvidencePolarity.Stale => "stale",
        _ => p.ToString().ToLowerInvariant(),
    };

    private static string PolarityClass(EvidencePolarity p) => p switch
    {
        EvidencePolarity.Supports => "ev-supports",
        EvidencePolarity.Refutes => "ev-refutes",
        EvidencePolarity.NotAssessed => "ev-na",
        _ => "ev-other",
    };

    private async Task OpenEvidence(ProblemDto p)
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        error = null; adjudicating = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            evidenceProblem = await wf.GetProblemWithEvidenceAsync(p.ProblemId);

            // Picker sources, loaded when the panel opens so the dropdowns are current.
            evLabs = await wf.GetLabSummaryAsync();
            evNotes = await wf.GetRecentNotesAsync();
            evSymptoms = await wf.GetPatientSymptomsAsync();

            evPolarity = EvidencePolarity.Supports;
            evKind = EvidenceKind.LabResult;
            evLabPick = evNotePick = evSymptomPick = "";
            evDisplay = evNote = null;
            evCertainty = "KEEP";
        }
        catch (Exception ex) { error = $"Error loading evidence: {ex.Message}"; }
    }

    private async Task SubmitEvidence()
    {
        if (evidenceProblem is null || string.IsNullOrWhiteSpace(patientId)) return;

        EvidenceRef? built = BuildEvidenceRef();
        if (built is null)
        {
            error = evPolarity == EvidencePolarity.NotAssessed
                ? "Say what was not checked."
                : "Pick a source record, or describe the evidence.";
            return;
        }

        evSubmitting = true; error = null;
        try
        {
            var wf = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            ProblemVerificationStatus certainty = evCertainty == "KEEP"
                ? evidenceProblem.VerificationStatus
                : Enum.Parse<ProblemVerificationStatus>(evCertainty);

            await wf.AssessProblemAsync(new ProblemAssessmentCommand
            {
                ProblemId = evidenceProblem.ProblemId,
                Evidence = new List<EvidenceRef> { built },
                VerificationStatus = certainty,
                Narrative = string.IsNullOrWhiteSpace(evNote) ? null : evNote,
            });

            string evidenceProblemId = evidenceProblem.ProblemId;
            await Load();   // refresh the list so a certainty change shows on the row chip
                            // (Load clears the panel; re-open it for the same problem below)
            evidenceProblem = await wf.GetProblemWithEvidenceAsync(evidenceProblemId);
            evLabs = await wf.GetLabSummaryAsync();
            evNotes = await wf.GetRecentNotesAsync();
            evSymptoms = await wf.GetPatientSymptomsAsync();
            successMessage = "Evidence recorded.";
            evDisplay = evNote = null;
            evLabPick = evNotePick = evSymptomPick = "";
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = $"Error recording evidence: {ex.Message}"; }
        finally { evSubmitting = false; }
    }

    private EvidenceRef? BuildEvidenceRef()
    {
        if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.LabResult
            && int.TryParse(evLabPick, out int li) && li >= 0 && li < evLabs.Count)
        {
            LabTestSummaryEntry lab = evLabs[li];
            return new EvidenceRef
            {
                Kind = EvidenceKind.LabResult,
                // The lab summary carries no per-result grain id; the LOINC + value + date
                // identify the observation, which is the clinically meaningful citation.
                CodeSystem = "LOINC",
                Code = lab.LoincCode,
                Display = lab.TestName,
                Polarity = evPolarity,
                ObservedValue = lab.Value,
                ObservedUnit = lab.Units,
                ObservedUtc = lab.ResultDate.UtcDateTime,
                Note = evNote,
            };
        }

        if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.Note
            && int.TryParse(evNotePick, out int ni) && ni >= 0 && ni < evNotes.Count)
        {
            TiuNoteSummary note = evNotes[ni];
            return new EvidenceRef
            {
                Kind = EvidenceKind.Note,
                SourceId = note.DocumentId,
                Display = $"{note.Subject ?? note.DocumentType} ({note.ReferenceDate:MM/dd/yyyy})",
                Polarity = evPolarity,
                ObservedUtc = note.ReferenceDate,
                Note = evNote,
            };
        }

        if (evPolarity != EvidencePolarity.NotAssessed && evKind == EvidenceKind.Symptom
            && int.TryParse(evSymptomPick, out int si) && si >= 0 && si < evSymptoms.Count)
        {
            SymptomObservation sym = evSymptoms[si];
            return new EvidenceRef
            {
                Kind = EvidenceKind.Symptom,
                CodeSystem = "SNOMED",
                Code = sym.Code,
                Display = sym.Display,
                Polarity = evPolarity,
                ObservedValue = sym.Presence.ToString(),
                ObservedUtc = sym.RecordedDate,
                Note = evNote,
            };
        }

        // Free-text path: NotAssessed rows ("Influenza PCR — never performed") and exam /
        // external / other kinds with no local source record.
        if (!string.IsNullOrWhiteSpace(evDisplay))
        {
            return new EvidenceRef
            {
                Kind = evKind,
                Display = evDisplay.Trim(),
                Polarity = evPolarity,
                Note = evNote,
            };
        }

        return null;
    }

    private async Task SubmitProblem()
    {
        if (string.IsNullOrWhiteSpace(patientId)) return;
        if (string.IsNullOrWhiteSpace(form.Diagnosis)) { error = "Diagnosis is required."; return; }
        if (form.DateOfOnset.HasValue && form.DateOfOnset.Value.Date > DateTime.Today)
        { error = "Onset date cannot be in the future."; return; }

        submitting = true; error = null; successMessage = null;
        try
        {
            var workflow = Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim());
            await workflow.AddProblemAsync(
                form.Diagnosis, form.DiagnosisCode,
                string.IsNullOrEmpty(form.Condition) ? null : form.Condition,
                string.IsNullOrEmpty(form.Priority) ? null : form.Priority,
                form.DateOfOnset,
                form.ProviderId, form.ProviderName,
                string.IsNullOrEmpty(form.ClinicId) ? null : form.ClinicId, form.ClinicName,
                form.IsServiceConnected, form.Comments);

            successMessage = "Problem added successfully.";
            form = new ProblemFormModel();
            activeTab = "view";
            activeOnly = true;
            await Load();
        }
        catch (UnauthorizedAccessException ex) { error = SecurityKeyError.Describe(ex); }
        catch (Exception ex) { error = $"Error saving problem: {ex.Message}"; }
        finally { submitting = false; }
    }

    private class ProblemDto
    {
        public string ProblemId { get; set; } = "";
        public string Diagnosis { get; set; } = "";
        public string? DiagnosisCode { get; set; }
        public string Status { get; set; } = "";
        public DateTime? DateOfOnset { get; set; }
        public string? Condition { get; set; }
        public bool IsServiceConnected { get; set; }
        public ProblemVerificationStatus VerificationStatus { get; set; }
    }

    private class ProblemFormModel
    {
        public string Diagnosis { get; set; } = "";
        public string? DiagnosisCode { get; set; }
        public string? Condition { get; set; }
        public string? Priority { get; set; }
        public DateTime? DateOfOnset { get; set; }
        public string? ProviderName { get; set; }
        public string? ProviderId { get; set; }
        public string? ClinicId { get; set; }
        public string? ClinicName { get; set; }
        public bool IsServiceConnected { get; set; }
        public string? Comments { get; set; }
    }
}

