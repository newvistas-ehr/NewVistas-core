@page "/pain-assessment"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<PageTitle>Pain Assessment</PageTitle>

<h1>Pain Assessment Workflow</h1>
<p class="page-subtitle">Structured Pain Assessment — DVPRS, Wong-Baker FACES, FLACC, NRS, CPOT, VAS</p>

<PatientBar @bind-PatientId="patientId" Loading="loading" OnLoad="LoadAssessments" />
<AlertBanner Error="@error" Success="@recordResult" />

@if (!string.IsNullOrWhiteSpace(patientId))
{
    <TabStrip Tabs="_tabs" @bind-Active="tab" />

    @if (tab == "history")
    {
        @if (assessments == null) { <div class="empty-state">Enter a Patient ID and click Load.</div> }
        else if (assessments.Count == 0) { <div class="empty-state">No pain assessments recorded.</div> }
        else
        {
            <table class="data-table">
                <thead><tr><th>Date/Time</th><th>Nurse</th><th>Tool</th><th>Score</th><th>Location</th><th>Reassess?</th><th>Post-Rx</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in assessments)
                    {
                        <tr class="@(a.PainScore >= 7 ? "row-danger" : a.PainScore >= 4 ? "row-warning" : "")">
                            <td>@a.AssessmentDateTime.ToString("MM/dd HH:mm")</td>
                            <td>@a.NurseName</td>
                            <td>@a.Tool</td>
                            <td><span class="badge @PainBadge(a.PainScore)">@a.PainScore/10</span></td>
                            <td>@(a.PainLocation ?? "—")</td>
                            <td>@(a.IsReassessment ? "Yes" : "No")</td>
                            <td>@(a.PostInterventionScore?.ToString() ?? "—")</td>
                            <td><button class="btn btn-primary" @onclick="() => ViewDetail(a.AssessmentId)">View</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (tab == "detail" && selected != null)
    {
        <div class="form-section">
            <h3>Pain Assessment — @selected.Tool <span class="badge @PainBadge(selected.PainScore)">@selected.PainScore/10</span></h3>
            <p><strong>Location:</strong> @(selected.PainLocation ?? "—")</p>
            <p><strong>Character:</strong> @(selected.PainCharacter ?? "—")</p>
            <p><strong>Onset:</strong> @(selected.PainOnset ?? "—")</p>
            <p><strong>Radiation:</strong> @(selected.Radiation ?? "—")</p>
            <p><strong>Aggravating:</strong> @(selected.AggravatingFactors ?? "—")</p>
            <p><strong>Alleviating:</strong> @(selected.AlleviatingFactors ?? "—")</p>
            <p><strong>Acceptable Level:</strong> @(selected.AcceptablePainLevel?.ToString() ?? "—")/10</p>
            <p><strong>Intervention:</strong> @(selected.InterventionProvided ?? "—")</p>

            @if (selected.DvprsSupplemental != null)
            {
                <h3>DVPRS Supplemental</h3>
                <p><strong>Activity:</strong> @(selected.DvprsSupplemental.ActivityInterference?.ToString() ?? "—")/10 &nbsp; <strong>Sleep:</strong> @(selected.DvprsSupplemental.SleepInterference?.ToString() ?? "—")/10 &nbsp; <strong>Mood:</strong> @(selected.DvprsSupplemental.MoodInterference?.ToString() ?? "—")/10 &nbsp; <strong>Stress:</strong> @(selected.DvprsSupplemental.StressInterference?.ToString() ?? "—")/10</p>
            }
            @if (selected.FlaccComponents != null)
            {
                <h3>FLACC Components</h3>
                <p><strong>Face:</strong> @selected.FlaccComponents.Face &nbsp; <strong>Legs:</strong> @selected.FlaccComponents.Legs &nbsp; <strong>Activity:</strong> @selected.FlaccComponents.Activity &nbsp; <strong>Cry:</strong> @selected.FlaccComponents.Cry &nbsp; <strong>Consolability:</strong> @selected.FlaccComponents.Consolability &nbsp; <strong>Total:</strong> @selected.FlaccComponents.Total</p>
            }
            @if (selected.IsReassessment)
            {
                <h3>Reassessment</h3>
                <p><strong>Post-Rx Score:</strong> @(selected.PostInterventionScore?.ToString() ?? "—")/10 &nbsp; <strong>Minutes Since:</strong> @(selected.MinutesSinceIntervention?.ToString() ?? "—") &nbsp; <strong>Effective?:</strong> @(selected.InterventionEffective == true ? "Yes" : selected.InterventionEffective == false ? "No" : "—")</p>
            }
        </div>
    }

    @if (tab == "new")
    {
        <div class="form-section">
            <FormField Label="Tool">
                <select class="form-input" @bind="nTool">
                    <option value="@PainAssessmentTool.NumericRatingScale">NRS (0-10)</option>
                    <option value="@PainAssessmentTool.DVPRS">DVPRS</option>
                    <option value="@PainAssessmentTool.WongBakerFACES">Wong-Baker FACES</option>
                    <option value="@PainAssessmentTool.FLACC">FLACC</option>
                    <option value="@PainAssessmentTool.CPOT">CPOT</option>
                    <option value="@PainAssessmentTool.VisualAnalogScale">VAS</option>
                </select>
            </FormField>
            <FormField Label="Pain Score" Required><input type="number" min="0" max="10" class="form-input" @bind="nScore" /></FormField>
            <FormField Label="Location"><input class="form-input" @bind="nLocation" /></FormField>
            <FormField Label="Character">
                <select class="form-input" @bind="nCharacter">
                    <option>Sharp</option><option>Dull</option><option>Burning</option><option>Throbbing</option><option>Aching</option><option>Pressure</option><option>Stabbing</option>
                </select>
            </FormField>
            <FormField Label="Nurse ID"><input class="form-input" @bind="nNurseId" /></FormField>
            <FormField Label="Onset">
                <select class="form-input" @bind="nOnset"><option>Acute</option><option>Chronic</option><option>Intermittent</option></select>
            </FormField>
            <FormField Label="Intervention"><input class="form-input" @bind="nIntervention" placeholder="e.g. Morphine 4mg IV" /></FormField>
            <FormField Label="Acceptable Level"><input type="number" min="0" max="10" class="form-input" @bind="nAcceptable" /></FormField>
            <FormField Label="Notes"><input class="form-input" @bind="nNotes" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="RecordPain" disabled="@recording">@(recording ? "Recording..." : "Record Pain Assessment")</button>
            </div>
        </div>
    }

    @if (tab == "reassess")
    {
        <div class="form-section">
            <FormField Label="Initial Assessment ID" Required><input class="form-input" @bind="rInitialId" /></FormField>
            <FormField Label="Post-Rx Score"><input type="number" min="0" max="10" class="form-input" @bind="rPostScore" /></FormField>
            <FormField Label="Minutes Since"><input type="number" class="form-input" @bind="rMinutes" /></FormField>
            <FormField Label="Intervention"><input class="form-input" @bind="rIntervention" /></FormField>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="Reassess" disabled="@recording">Reassess</button>
            </div>
        </div>
    }
}

@code {
    private string? patientId;
    private string tab = "history";
    private bool loading, recording;
    private string? error, recordResult;
    private List<PainAssessmentIndexEntry>? assessments;
    private PainAssessmentState? selected;
    private PainAssessmentTool nTool = PainAssessmentTool.NumericRatingScale;
    private int nScore; private string nLocation = string.Empty, nCharacter = "Sharp", nOnset = "Acute", nIntervention = string.Empty, nNurseId = string.Empty, nNotes = string.Empty;
    private int? nAcceptable;
    private string rInitialId = string.Empty, rIntervention = string.Empty; private int rPostScore, rMinutes = 30;
    private readonly (string, string)[] _tabs = new[] { ("history", "Pain History"), ("detail", "Assessment Detail"), ("new", "New Assessment"), ("reassess", "Reassessment") };

    private async Task LoadAssessments() { if (string.IsNullOrWhiteSpace(patientId)) return; loading = true; error = null; try { assessments = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).GetPainAssessmentsAsync(); } catch (Exception ex) { error = ex.Message; } finally { loading = false; } }
    private async Task ViewDetail(string id) { try { selected = await Grains.GetGrain<IPatientWorkflowGrain>(patientId!.Trim()).GetPainAssessmentAsync(id); tab = "detail"; } catch (Exception ex) { error = ex.Message; } }
    private async Task RecordPain() { if (string.IsNullOrWhiteSpace(patientId)) return; recording = true; error = null; recordResult = null; try { string id = await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RecordPainAssessmentAsync(nTool, nScore, nLocation, nCharacter, nOnset, null, null, null, nAcceptable, null, null, string.IsNullOrWhiteSpace(nIntervention) ? null : nIntervention, nNurseId, "Nurse", nNotes); recordResult = $"Assessment recorded: {id}"; await LoadAssessments(); } catch (Exception ex) { error = ex.Message; } finally { recording = false; } }
    private async Task Reassess() { if (string.IsNullOrWhiteSpace(patientId) || string.IsNullOrWhiteSpace(rInitialId)) return; recording = true; error = null; try { await Grains.GetGrain<IPatientWorkflowGrain>(patientId.Trim()).RecordPainReassessmentAsync(rInitialId, nTool, rPostScore, rMinutes, rIntervention, nNurseId, "Nurse", null); recordResult = "Reassessment recorded"; await LoadAssessments(); } catch (Exception ex) { error = ex.Message; } finally { recording = false; } }

    private string PainBadge(int score) => score >= 7 ? "badge-danger" : score >= 4 ? "badge-warning" : score > 0 ? "badge-info" : "badge-success";
}

<style>
    .page-subtitle { color: #666; margin: -0.5rem 0 1.25rem; font-size: 0.9rem; }
    .form-section p { font-size: 0.9rem; line-height: 1.6; }
</style>
