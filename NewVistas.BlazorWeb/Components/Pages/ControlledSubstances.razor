@page "/controlled-substances"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using NewVistas.BlazorWeb.Services
@using NewVistas.Abstractions.GrainInterfaces
@using NewVistas.Abstractions.GrainStates
@inject OrleansGrainService Grains

<h2>Controlled Substances</h2>
<p class="subtitle">VistA Files #58.80, #58.82 — PSNCS.m, PSNLOG.m, PSNINSP.m</p>

<div class="location-bar">
    <label>Location ID:</label>
    <input @bind="locationId" @bind:event="oninput" placeholder="e.g., VAULT-1A" class="input-field" />
    <button @onclick="LoadAll" class="btn-primary">Load</button>
</div>

@if (error != null)
{
    <div class="error-banner">@error</div>
}

<div class="tabs">
    <button class="@TabClass(0)" @onclick="() => activeTab = 0">Dispense Log</button>
    <button class="@TabClass(1)" @onclick="() => activeTab = 1">Inspections</button>
    <button class="@TabClass(2)" @onclick="() => activeTab = 2">Record</button>
</div>

@* ── TAB 0: Dispense Log ───────────────────────────────────────────────────── *@
@if (activeTab == 0)
{
    <div class="tab-content">
        <div class="filter-row">
            <label>Filter by DEA Schedule:</label>
            <select @bind="scheduleFilter" class="input-field">
                <option value="">All Schedules</option>
                <option value="2">Schedule II</option>
                <option value="3">Schedule III</option>
                <option value="4">Schedule IV</option>
                <option value="5">Schedule V</option>
            </select>
            <button @onclick="LoadDispenses" class="btn-secondary">Filter</button>
        </div>

        @if (loadingDispenses)
        {
            <p>Loading dispense log...</p>
        }
        else if (dispenses.Count == 0)
        {
            <p class="empty-msg">No controlled substance dispenses found for this location.</p>
        }
        else
        {
            <table class="cs-table">
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>Patient</th>
                        <th>Drug</th>
                        <th>Schedule</th>
                        <th>Qty</th>
                        <th>Unit</th>
                        <th>Running Balance</th>
                        <th>Dispensed By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DispenseSummary d in dispenses)
                    {
                        <tr>
                            <td>@d.DispenseDateTime.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>@d.PatientName</td>
                            <td>@d.DrugName</td>
                            <td class="schedule-badge schedule-@d.DrugSchedule">CII@(d.DrugSchedule > 2 ? "I" : "")@(d.DrugSchedule > 3 ? "I" : "")@(d.DrugSchedule > 4 ? "V" : "")</td>
                            <td class="qty-cell">@d.QuantityDispensed</td>
                            <td>@d.UnitOfMeasure</td>
                            <td class="balance-cell @(d.RunningBalance < 0 ? "balance-negative" : "")">@d.RunningBalance</td>
                            <td>@d.DispensedByName</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* ── TAB 1: Inspections ───────────────────────────────────────────────────── *@
@if (activeTab == 1)
{
    <div class="tab-content">
        <div class="filter-row">
            <label>Filter:</label>
            <select @bind="inspectionFilter" class="input-field">
                <option value="all">All Inspections</option>
                <option value="failed">Failed / Discrepancy Only</option>
            </select>
            <button @onclick="LoadInspections" class="btn-secondary">Filter</button>
        </div>

        @if (loadingInspections)
        {
            <p>Loading inspection history...</p>
        }
        else if (inspections.Count == 0)
        {
            <p class="empty-msg">No inspections found for this location.</p>
        }
        else
        {
            <table class="cs-table">
                <thead>
                    <tr>
                        <th>Date/Time</th>
                        <th>Type</th>
                        <th>Inspector</th>
                        <th>Result</th>
                        <th>Discrepancies</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (InspectionSummary insp in inspections)
                    {
                        <tr class="@(insp.OverallResult == "Failed" || insp.OverallResult == "DiscrepancyIdentified" ? "row-alert" : "")">
                            <td>@insp.InspectionDateTime.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>@insp.InspectionType</td>
                            <td>@insp.InspectorName</td>
                            <td class="result-badge result-@insp.OverallResult">@insp.OverallResult</td>
                            <td class="@(insp.TotalDiscrepancies > 0 ? "discrepancy-count" : "")">@insp.TotalDiscrepancies</td>
                            <td>
                                <button @onclick="() => ViewInspection(insp.InspectionId)" class="btn-small">View Counts</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (selectedInspection != null)
        {
            <div class="detail-panel">
                <h4>Drug Counts — @selectedInspection.InspectionDateTime.ToString("MM/dd/yyyy HH:mm")</h4>
                <p><strong>Inspector:</strong> @selectedInspection.InspectorName &nbsp;
                   <strong>Witness:</strong> @selectedInspection.WitnessName &nbsp;
                   <strong>Result:</strong> @selectedInspection.OverallResult</p>
                @if (selectedInspection.DrugCounts.Count == 0)
                {
                    <p class="empty-msg">No drug counts recorded.</p>
                }
                else
                {
                    <table class="cs-table">
                        <thead>
                            <tr><th>Drug</th><th>Schedule</th><th>System</th><th>Physical</th><th>Discrepancy</th><th>Unit</th><th>Notes</th></tr>
                        </thead>
                        <tbody>
                            @foreach (DrugCount dc in selectedInspection.DrugCounts)
                            {
                                <tr class="@(dc.Discrepancy != 0 ? "row-alert" : "")">
                                    <td>@dc.DrugName</td>
                                    <td>@dc.DrugSchedule</td>
                                    <td>@dc.SystemCount</td>
                                    <td>@dc.PhysicalCount</td>
                                    <td class="@(dc.Discrepancy < 0 ? "discrepancy-neg" : dc.Discrepancy > 0 ? "discrepancy-pos" : "")">
                                        @(dc.Discrepancy > 0 ? "+" : "")@dc.Discrepancy
                                    </td>
                                    <td>@dc.CountUnit</td>
                                    <td>@dc.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <button @onclick="() => selectedInspection = null" class="btn-secondary">Close</button>
            </div>
        }
    </div>
}

@* ── TAB 2: Record ────────────────────────────────────────────────────────── *@
@if (activeTab == 2)
{
    <div class="tab-content">
        <div class="record-tabs">
            <button class="@SubTabClass(0)" @onclick="() => activeSubTab = 0">Create Inspection</button>
            <button class="@SubTabClass(1)" @onclick="() => activeSubTab = 1">Record Dispense</button>
        </div>

        @* Sub-tab: Create Inspection *@
        @if (activeSubTab == 0)
        {
            <div class="form-section">
                <h4>New Vault Inspection</h4>
                <div class="form-grid">
                    <label>Inspection Type:</label>
                    <select @bind="newInspType" class="input-field">
                        <option value="0">Scheduled</option>
                        <option value="1">Unscheduled</option>
                        <option value="2">Discrepancy Follow-Up</option>
                        <option value="3">Reconciliation</option>
                    </select>

                    <label>Date/Time:</label>
                    <input type="datetime-local" @bind="newInspDateTime" class="input-field" />

                    <label>Inspector ID:</label>
                    <input @bind="newInspectorId" class="input-field" placeholder="User ID" />

                    <label>Inspector Name:</label>
                    <input @bind="newInspectorName" class="input-field" placeholder="Full name" />

                    <label>Witness ID:</label>
                    <input @bind="newWitnessId" class="input-field" placeholder="User ID" />

                    <label>Witness Name:</label>
                    <input @bind="newWitnessName" class="input-field" placeholder="Full name" />

                    <label>Notes:</label>
                    <textarea @bind="newInspNotes" class="input-field" rows="2"></textarea>
                </div>

                <div class="drug-count-section">
                    <h5>Add Drug Counts</h5>
                    <div class="form-grid">
                        <label>Drug Name:</label>
                        <input @bind="countDrugName" class="input-field" />

                        <label>DEA Schedule:</label>
                        <select @bind="countSchedule" class="input-field">
                            <option value="2">Schedule II</option>
                            <option value="3">Schedule III</option>
                            <option value="4">Schedule IV</option>
                            <option value="5">Schedule V</option>
                        </select>

                        <label>System Count:</label>
                        <input type="number" @bind="countSystem" class="input-field" />

                        <label>Physical Count:</label>
                        <input type="number" @bind="countPhysical" class="input-field" />

                        <label>Unit:</label>
                        <input @bind="countUnit" class="input-field" placeholder="tablets, mL, etc." />
                    </div>
                    <button @onclick="AddDrugCount" class="btn-secondary">+ Add Count</button>

                    @if (pendingCounts.Count > 0)
                    {
                        <table class="cs-table">
                            <thead><tr><th>Drug</th><th>Schedule</th><th>System</th><th>Physical</th><th>Unit</th></tr></thead>
                            <tbody>
                                @foreach (DrugCount dc in pendingCounts)
                                {
                                    <tr class="@(dc.PhysicalCount != dc.SystemCount ? "row-alert" : "")">
                                        <td>@dc.DrugName</td><td>@dc.DrugSchedule</td>
                                        <td>@dc.SystemCount</td><td>@dc.PhysicalCount</td><td>@dc.CountUnit</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>

                <button @onclick="CreateInspection" class="btn-primary" disabled="@savingInspection">
                    @(savingInspection ? "Saving..." : "Create Inspection")
                </button>
                @if (inspectionSuccess != null)
                {
                    <span class="success-msg">@inspectionSuccess</span>
                }
            </div>
        }

        @* Sub-tab: Record Dispense *@
        @if (activeSubTab == 1)
        {
            <div class="form-section">
                <h4>Record CS Dispense</h4>
                <div class="form-grid">
                    <label>Patient ID:</label>
                    <input @bind="dispPatientId" class="input-field" />

                    <label>Patient Name:</label>
                    <input @bind="dispPatientName" class="input-field" />

                    <label>Drug ID:</label>
                    <input @bind="dispDrugId" class="input-field" />

                    <label>Drug Name:</label>
                    <input @bind="dispDrugName" class="input-field" />

                    <label>DEA Schedule:</label>
                    <select @bind="dispSchedule" class="input-field">
                        <option value="2">Schedule II</option>
                        <option value="3">Schedule III</option>
                        <option value="4">Schedule IV</option>
                        <option value="5">Schedule V</option>
                    </select>

                    <label>Qty Dispensed:</label>
                    <input type="number" step="0.01" @bind="dispQty" class="input-field" />

                    <label>Unit:</label>
                    <input @bind="dispUnit" class="input-field" placeholder="tablets, mL, mg" />

                    <label>Running Balance:</label>
                    <input type="number" step="0.01" @bind="dispBalance" class="input-field" />

                    <label>Dispense Type:</label>
                    <select @bind="dispType" class="input-field">
                        <option value="0">Routine</option>
                        <option value="1">STAT</option>
                        <option value="2">Emergency</option>
                        <option value="3">Wastage</option>
                    </select>

                    <label>Prescriber ID:</label>
                    <input @bind="dispPrescriberId" class="input-field" />

                    <label>Prescriber Name:</label>
                    <input @bind="dispPrescriberName" class="input-field" />

                    <label>Prescriber DEA #:</label>
                    <input @bind="dispPrescriberDEA" class="input-field" placeholder="Optional" />

                    <label>Dispensed By ID:</label>
                    <input @bind="dispById" class="input-field" />

                    <label>Dispensed By Name:</label>
                    <input @bind="dispByName" class="input-field" />

                    <label>Witness Name:</label>
                    <input @bind="dispWitnessName" class="input-field" placeholder="Required for CII" />

                    <label>Date/Time:</label>
                    <input type="datetime-local" @bind="dispDateTime" class="input-field" />

                    <label>Rx/Order Number:</label>
                    <input @bind="dispRxNumber" class="input-field" placeholder="Optional" />

                    <label>Notes:</label>
                    <textarea @bind="dispNotes" class="input-field" rows="2"></textarea>
                </div>

                <button @onclick="RecordDispense" class="btn-primary" disabled="@savingDispense">
                    @(savingDispense ? "Saving..." : "Record Dispense")
                </button>
                @if (dispenseSuccess != null)
                {
                    <span class="success-msg">@dispenseSuccess</span>
                }
            </div>
        }
    </div>
}

<style>
    .subtitle { color: #666; font-size: 0.9rem; margin-bottom: 1rem; }
    .location-bar { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .error-banner { background: #fde; border: 1px solid #f88; padding: 0.5rem 1rem; border-radius: 4px; margin-bottom: 1rem; color: #c00; }
    .tabs { display: flex; gap: 0.25rem; border-bottom: 2px solid #dee2e6; margin-bottom: 1rem; }
    .tab-btn { padding: 0.5rem 1.25rem; border: none; background: none; cursor: pointer; color: #555; border-bottom: 2px solid transparent; margin-bottom: -2px; }
    .tab-btn.active { color: #0056b3; border-bottom-color: #0056b3; font-weight: 600; }
    .tab-content { padding: 0.5rem 0; }
    .record-tabs { display: flex; gap: 0.25rem; margin-bottom: 1rem; }
    .sub-tab-btn { padding: 0.35rem 1rem; border: 1px solid #dee2e6; background: #f8f9fa; cursor: pointer; border-radius: 4px; }
    .sub-tab-btn.active { background: #e7f0fd; border-color: #0056b3; color: #0056b3; font-weight: 600; }
    .filter-row { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
    .input-field { padding: 0.35rem 0.6rem; border: 1px solid #ced4da; border-radius: 4px; }
    .btn-primary { background: #0056b3; color: white; border: none; padding: 0.4rem 1rem; border-radius: 4px; cursor: pointer; }
    .btn-primary:hover { background: #004094; }
    .btn-primary:disabled { background: #6c757d; cursor: not-allowed; }
    .btn-secondary { background: #6c757d; color: white; border: none; padding: 0.35rem 0.8rem; border-radius: 4px; cursor: pointer; }
    .btn-secondary:hover { background: #5a6268; }
    .btn-small { font-size: 0.8rem; padding: 0.2rem 0.5rem; background: #17a2b8; color: white; border: none; border-radius: 3px; cursor: pointer; }
    .cs-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; margin-top: 0.5rem; }
    .cs-table th { background: #343a40; color: white; padding: 0.4rem 0.6rem; text-align: left; }
    .cs-table td { padding: 0.35rem 0.6rem; border-bottom: 1px solid #dee2e6; }
    .cs-table tr:hover td { background: #f8f9fa; }
    .row-alert td { background: #fff3cd !important; }
    .result-badge { font-weight: 600; }
    .result-Passed { color: #28a745; }
    .result-PassedWithNotes { color: #17a2b8; }
    .result-Failed { color: #dc3545; }
    .result-DiscrepancyIdentified { color: #fd7e14; }
    .schedule-badge { font-weight: 600; font-size: 0.8rem; }
    .discrepancy-count { color: #dc3545; font-weight: bold; }
    .discrepancy-neg { color: #dc3545; font-weight: bold; }
    .discrepancy-pos { color: #fd7e14; font-weight: bold; }
    .qty-cell { text-align: right; }
    .balance-cell { text-align: right; font-weight: 600; }
    .balance-negative { color: #dc3545; }
    .empty-msg { color: #6c757d; font-style: italic; }
    .form-section { max-width: 680px; }
    .form-grid { display: grid; grid-template-columns: 180px 1fr; gap: 0.5rem; align-items: center; margin-bottom: 1rem; }
    .drug-count-section { background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; padding: 1rem; margin: 1rem 0; }
    .detail-panel { background: #f0f4ff; border: 1px solid #c0d0f0; border-radius: 6px; padding: 1rem; margin-top: 1.5rem; }
    .success-msg { color: #28a745; font-weight: 600; margin-left: 1rem; }
</style>

@code {
    // ── State ──────────────────────────────────────────────────────────────────
    private int activeTab = 0;
    private int activeSubTab = 0;
    private string locationId = string.Empty;
    private string? error;

    // Dispense log
    private bool loadingDispenses;
    private List<DispenseSummary> dispenses = new();
    private string scheduleFilter = string.Empty;

    // Inspections
    private bool loadingInspections;
    private List<InspectionSummary> inspections = new();
    private string inspectionFilter = "all";
    private InspectionDetail? selectedInspection;

    // New inspection form
    private int newInspType = 0;
    private DateTime newInspDateTime = DateTime.Now;
    private string newInspectorId = string.Empty;
    private string newInspectorName = string.Empty;
    private string newWitnessId = string.Empty;
    private string newWitnessName = string.Empty;
    private string? newInspNotes;
    private bool savingInspection;
    private string? inspectionSuccess;

    // Drug counts for new inspection
    private List<DrugCount> pendingCounts = new();
    private string countDrugName = string.Empty;
    private int countSchedule = 2;
    private decimal countSystem;
    private decimal countPhysical;
    private string countUnit = string.Empty;
    private string? pendingInspectionId;

    // New dispense form
    private string dispPatientId = string.Empty;
    private string dispPatientName = string.Empty;
    private string dispDrugId = string.Empty;
    private string dispDrugName = string.Empty;
    private int dispSchedule = 2;
    private decimal dispQty;
    private string dispUnit = string.Empty;
    private decimal dispBalance;
    private int dispType = 0;
    private string dispPrescriberId = string.Empty;
    private string dispPrescriberName = string.Empty;
    private string? dispPrescriberDEA;
    private string dispById = string.Empty;
    private string dispByName = string.Empty;
    private string? dispWitnessName;
    private DateTime dispDateTime = DateTime.Now;
    private string? dispRxNumber;
    private string? dispNotes;
    private bool savingDispense;
    private string? dispenseSuccess;

    // ── Helpers ────────────────────────────────────────────────────────────────
    private string TabClass(int tab) => tab == activeTab ? "tab-btn active" : "tab-btn";
    private string SubTabClass(int tab) => tab == activeSubTab ? "sub-tab-btn active" : "sub-tab-btn";

    private async Task LoadAll()
    {
        error = null;
        await Task.WhenAll(LoadDispenses(), LoadInspections());
    }

    private ICSDispenseLogGrain GetDispenseLog() =>
        Grains.GetGrain<ICSDispenseLogGrain>($"CS-DISPENSE-LOG:{locationId.Trim()}");

    private ICSInspectionLogGrain GetInspectionLog() =>
        Grains.GetGrain<ICSInspectionLogGrain>($"CS-INSPECT-LOG:{locationId.Trim()}");

    // ── Dispense Log ───────────────────────────────────────────────────────────
    private async Task LoadDispenses()
    {
        if (string.IsNullOrWhiteSpace(locationId)) return;
        loadingDispenses = true;
        try
        {
            List<CSDispenseSummaryEntry> entries;
            if (!string.IsNullOrEmpty(scheduleFilter) && int.TryParse(scheduleFilter, out int sched))
                entries = await GetDispenseLog().GetRecordsByScheduleAsync((DEADrugSchedule)sched);
            else
                entries = await GetDispenseLog().GetAllRecordsAsync();
            dispenses = entries.Select(e => new DispenseSummary
            {
                RecordId = e.RecordId, PatientName = e.PatientName, DrugName = e.DrugName,
                DrugSchedule = (int)e.DrugSchedule, QuantityDispensed = e.QuantityDispensed,
                UnitOfMeasure = e.UnitOfMeasure, DispensedByName = e.DispensedByName,
                DispenseDateTime = e.DispenseDateTime, RunningBalance = e.RunningBalance
            }).ToList();
        }
        catch { error = "Failed to load dispense log."; }
        finally { loadingDispenses = false; }
    }

    // ── Inspections ────────────────────────────────────────────────────────────
    private async Task LoadInspections()
    {
        if (string.IsNullOrWhiteSpace(locationId)) return;
        loadingInspections = true;
        try
        {
            List<CSInspectionSummaryEntry> entries = inspectionFilter == "failed"
                ? await GetInspectionLog().GetFailedInspectionsAsync()
                : await GetInspectionLog().GetAllInspectionsAsync();
            inspections = entries.Select(e => new InspectionSummary
            {
                InspectionId = e.InspectionId, InspectionType = e.InspectionType.ToString(),
                InspectionDateTime = e.InspectionDateTime, InspectorName = e.InspectorName,
                OverallResult = e.OverallResult.ToString(), TotalDiscrepancies = e.TotalDiscrepancies
            }).ToList();
        }
        catch { error = "Failed to load inspections."; }
        finally { loadingInspections = false; }
    }

    private async Task ViewInspection(string inspectionId)
    {
        try
        {
            var grain = Grains.GetGrain<ICSInspectionGrain>(inspectionId);
            CSInspectionState state = await grain.GetInspectionAsync();
            selectedInspection = new InspectionDetail
            {
                InspectionId = inspectionId, InspectionDateTime = state.InspectionDateTime,
                InspectorName = state.InspectorName, WitnessName = state.WitnessName,
                OverallResult = state.OverallResult.ToString(),
                DrugCounts = state.DrugCounts.Select(c => new DrugCount
                {
                    DrugName = c.DrugName, DrugSchedule = (int)c.DrugSchedule,
                    SystemCount = c.SystemCount, PhysicalCount = c.PhysicalCount,
                    Discrepancy = c.PhysicalCount - c.SystemCount, CountUnit = c.CountUnit, Notes = c.Notes
                }).ToList()
            };
        }
        catch { error = "Failed to load inspection details."; }
    }

    // ── Create Inspection ──────────────────────────────────────────────────────
    private void AddDrugCount()
    {
        if (string.IsNullOrWhiteSpace(countDrugName)) return;
        pendingCounts.Add(new DrugCount
        {
            DrugName = countDrugName,
            DrugSchedule = countSchedule,
            SystemCount = countSystem,
            PhysicalCount = countPhysical,
            CountUnit = countUnit,
        });
        countDrugName = string.Empty;
        countSystem = 0;
        countPhysical = 0;
        countUnit = string.Empty;
    }

    private async Task CreateInspection()
    {
        if (string.IsNullOrWhiteSpace(locationId)) { error = "Enter a Location ID first."; return; }
        savingInspection = true;
        inspectionSuccess = null;
        error = null;
        try
        {
            string inspId = $"CS-INSPECTION:{Guid.NewGuid()}";
            var grain = Grains.GetGrain<ICSInspectionGrain>(inspId);
            await grain.CreateInspectionAsync(
                locationId.Trim(), locationId.Trim(),
                (CSInspectionType)newInspType, newInspDateTime,
                newInspectorId, newInspectorName,
                newWitnessId, newWitnessName, null, null, newInspNotes);

            pendingInspectionId = inspId;

            foreach (DrugCount dc in pendingCounts)
            {
                await grain.AddDrugCountAsync(new CSInspectionCount
                {
                    DrugName = dc.DrugName, DrugSchedule = (DEADrugSchedule)dc.DrugSchedule,
                    SystemCount = dc.SystemCount, PhysicalCount = dc.PhysicalCount,
                    CountUnit = dc.CountUnit, Notes = null
                });
            }

            pendingCounts.Clear();
            inspectionSuccess = $"Inspection created: {pendingInspectionId}";
            await LoadInspections();
        }
        catch { error = "An error occurred creating the inspection."; }
        finally { savingInspection = false; }
    }

    // ── Record Dispense ────────────────────────────────────────────────────────
    private async Task RecordDispense()
    {
        if (string.IsNullOrWhiteSpace(locationId)) { error = "Enter a Location ID first."; return; }
        savingDispense = true;
        dispenseSuccess = null;
        error = null;
        try
        {
            string recordId = $"CS-DISPENSE:{Guid.NewGuid()}";
            var grain = Grains.GetGrain<ICSDispenseRecordGrain>(recordId);
            await grain.CreateRecordAsync(
                locationId.Trim(), locationId.Trim(),
                dispPatientId, dispPatientName, null,
                dispDrugId, dispDrugName,
                (DEADrugSchedule)dispSchedule, null,
                dispQty, dispUnit, dispBalance,
                (CSDispenseType)dispType,
                dispPrescriberId, dispPrescriberName, dispPrescriberDEA,
                dispById, dispByName, null, dispWitnessName,
                dispDateTime, dispRxNumber, null, dispNotes);

            dispenseSuccess = "Dispense recorded successfully.";
            await LoadDispenses();
        }
        catch { error = "An error occurred recording the dispense."; }
        finally { savingDispense = false; }
    }

