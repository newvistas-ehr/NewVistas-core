@* Canonical status banners (UI-CONVENTIONS.md §5): one success class, one *@
@* error class — no .alert-danger / bare .error variants. *@

@if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-error">@Error</div> }
@if (!string.IsNullOrEmpty(Success)) { <div class="alert alert-success">@Success</div> }

@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Success { get; set; }
}
