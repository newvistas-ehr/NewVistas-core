@* Canonical patient bar (UI-CONVENTIONS.md §1): one ID input + Load button + *@
@* Enter-to-load, used on every patient-scoped page. *@
@using NewVistas.BlazorWeb.Services
@inject PatientContextService PatientContext

<div class="lookup-bar">
    <input type="text" value="@PatientId" @oninput="OnInput" @onkeydown="HandleKeyDown"
           placeholder="Patient ID" class="lookup-input" />
    <button @onclick="OnLoad" disabled="@(string.IsNullOrWhiteSpace(PatientId) || Loading)" class="btn btn-primary">
        @(Loading ? "Loading..." : LoadText)
    </button>
</div>

@code {
    [Parameter] public string? PatientId { get; set; }
    [Parameter] public EventCallback<string?> PatientIdChanged { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnLoad { get; set; }
    [Parameter] public string LoadText { get; set; } = "Load";

    private bool _adopted;

    protected override async Task OnParametersSetAsync()
    {
        // Carry the current patient across pages. If this page opened without a patient
        // (no ?patientId= and nothing typed), adopt the session's selected patient and load
        // it — so the doctor never re-types an ID they already chose. To switch patients they
        // use Patient Lookup, which sets a new current patient. Runs once per bar instance.
        if (!_adopted && string.IsNullOrWhiteSpace(PatientId) && !string.IsNullOrWhiteSpace(PatientContext.PatientId))
        {
            _adopted = true;
            PatientId = PatientContext.PatientId;
            await PatientIdChanged.InvokeAsync(PatientId);
            await OnLoad.InvokeAsync();
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        PatientId = e.Value?.ToString();
        await PatientIdChanged.InvokeAsync(PatientId);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnLoad.InvokeAsync();
    }
}
