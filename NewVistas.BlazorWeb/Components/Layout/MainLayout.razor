<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        PatientContext.OnChanged += StateHasChanged;
    }

    private void Logout()
    {
        PatientContext.Clear();
        SecurityContext.Clear();
        ((JwtAuthenticationStateProvider)AuthStateProvider).Logout();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    public void Dispose()
    {
        PatientContext.OnChanged -= StateHasChanged;
    }
}

<style>
    .patient-context-bar {
        background: #eef3f9; border: 1px solid #c5d3e3; border-radius: 4px;
        padding: 0.4rem 0.75rem; margin-bottom: 1rem;
        display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem;
    }
    .ctx-icon { font-size: 1rem; }
    .ctx-label { color: #666; }
    .ctx-value { font-weight: 600; color: #003f72; }
    .ctx-id { color: #888; font-size: 0.8rem; }
</style>
