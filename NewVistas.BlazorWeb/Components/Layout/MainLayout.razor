            @if (SecurityContext.HasAccess(MenuArea.SystemAdmin))
            {
            <NavLink class="nav-item" href="/site-parameters">
                <span class="nav-icon">⚙️</span>
                <span class="nav-label">Site Parameters</span>
            </NavLink>
            <NavLink class="nav-item" href="/admin/institutions">
                <span class="nav-icon">🏥</span>
                <span class="nav-label">Institutions</span>
            </NavLink>
            <NavLink class="nav-item" href="/patient-merge">
                <span class="nav-icon">🔀</span>
                <span class="nav-label">Patient Merge</span>
            </NavLink>
            <NavLink class="nav-item" href="/direct">
                <span class="nav-icon">✉️</span>
                <span class="nav-label">Direct Messaging</span>
            </NavLink>
            <NavLink class="nav-item" href="/ds4p">
                <span class="nav-icon">🔒</span>
                <span class="nav-label">DS4P</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Financial))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Financial</div>

            <NavLink class="nav-item" href="/accounts-receivable">
                <span class="nav-icon">💰</span>
                <span class="nav-label">Accounts Receivable</span>
            </NavLink>
            <NavLink class="nav-item" href="/integrated-billing">
