                <span class="nav-label">Integrated Billing</span>
            </NavLink>
            <NavLink class="nav-item" href="/edi-billing">
                <span class="nav-icon">📤</span>
                <span class="nav-label">EDI Billing</span>
            </NavLink>
            <NavLink class="nav-item" href="/agent-cashier">
                <span class="nav-icon">🏦</span>
                <span class="nav-label">Agent Cashier</span>
            </NavLink>
            <NavLink class="nav-item" href="/fee-basis">
                <span class="nav-icon">📄</span>
                <span class="nav-label">Fee Basis</span>
            </NavLink>
            @if (SecurityContext.IsFeatureEnabled("PROCEDURE_PRIOR_AUTH"))
            {
            <NavLink class="nav-item" href="/prior-auth">
