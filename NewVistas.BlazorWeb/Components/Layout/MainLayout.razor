        </Authorized>
        </AuthorizeView>

        <main class="main-content">
            @if (!string.IsNullOrEmpty(PatientContext.PatientId))
            {
                <div class="patient-context-bar">
                    <span class="ctx-icon">👤</span>
                    <span class="ctx-label">Patient:</span>
                    <span class="ctx-value">@(PatientContext.PatientName ?? PatientContext.PatientId)</span>
                    <span class="ctx-id">(ID: @PatientContext.PatientId)</span>
                </div>
            }
            @* App-wide safety net: a page that throws on load (e.g. a key-gated read for a user
               without the key) shows a friendly card instead of tearing down the circuit. Most
               pages also catch their own action errors; this covers the uncaught cases. *@
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    @if (ex is UnauthorizedAccessException)
                    {
                        <div class="page-error page-error-access">
                            <h2>🔒 Additional access required</h2>
                            <p>@SecurityKeyError.Describe(ex)</p>
                        </div>
                    }
                    else
                    {
                        <div class="page-error">
                            <h2>Something went wrong on this page</h2>
                            <p>An unexpected error occurred. Try again, or choose another page from the menu.</p>
                        </div>
                    }
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private string _manualSection = "doctor";
    private string _helpUrl = $"{ManualHelp.Root}/index.html";

    /// <summary>Active institution count for the Transfer Center nav self-hide.
    /// Null = unknown (load failed/pending) — fail open and show the item.</summary>
    private int? _activeInstitutions;

    protected override async Task OnInitializedAsync()
    {
        PatientContext.OnChanged += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // The user's role picks the manual section for the context-sensitive Help link.
            _manualSection = ManualHelp.SectionForRoles(ManualHelp.RolesFromPrincipal(authState.User));
            UpdateHelpUrl();

            // Self-heal the per-circuit security context. It is normally populated by the login
            // page, but if that didn't run for this circuit (fresh circuit, reconnect) the menu
            // would collapse to General-only for the whole session. Load it here — straight from
            // the silo's AccessControl grain, like every other internal page — so the navigation
            // reflects the user's actual access.
            if (!SecurityContext.IsInitialized)
            {
                string? userId =
                    authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                    ?? authState.User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")?.Value;

                if (userId is not null)
                {
                    await SecurityContext.InitializeAsync(Grains, userId);
                    StateHasChanged();
                }
            }

            // Cache the active institution count once per circuit — the Transfer Center nav
            // item hides itself on single-institution sites. Best-effort: on failure it
            // stays null and the item shows (the page itself also self-hides).
            try
            {
                _activeInstitutions = await Grains
                    .GetGrain<NewVistas.Abstractions.GrainInterfaces.IInstitutionIndexGrain>("INSTITUTION-INDEX")
                    .GetActiveCountAsync();
            }
            catch { /* leave null — fail open */ }
        }
    }

    // The Help link points at the manual page for the user's role + the current screen.
    private void UpdateHelpUrl()
        => _helpUrl = ManualHelp.UrlForRoute(_manualSection, Navigation.ToBaseRelativePath(Navigation.Uri));

    private void Logout()
    {
        PatientContext.Clear();
        SecurityContext.Clear();
        ((JwtAuthenticationStateProvider)AuthStateProvider).Logout();
        Navigation.NavigateTo("/login", forceLoad: false);
    }

    // On navigation: clear any caught page error so the next page renders fresh, and re-point
    // the Help link at the new page's manual topic.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        UpdateHelpUrl();
        StateHasChanged();
    }

    public void Dispose()
    {
        PatientContext.OnChanged -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

