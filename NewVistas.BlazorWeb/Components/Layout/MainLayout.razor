            <div class="nav-divider"></div>
            <div class="nav-section-title">Reference</div>

            <NavLink class="nav-item" href="/icd10">
                <span class="nav-icon">📖</span>
                <span class="nav-label">ICD-10 Codes</span>
            </NavLink>
            <NavLink class="nav-item" href="/drugformulary">
                <span class="nav-icon">📚</span>
                <span class="nav-label">NDF Formulary</span>
            </NavLink>
            <NavLink class="nav-item" href="/drugfile">
