@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using NewVistas.BlazorWeb.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject PatientContextService PatientContext
@inject UserSecurityContext SecurityContext
@inject OrleansGrainService Grains
@using NewVistas.Abstractions.Security

<div class="app-container">
    <header class="app-header">
        <div class="header-brand">
            <img class="header-logo" src="branding/newvistas-logo-dark.svg" alt="NewVistas EHR" />
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="header-user">
                    <span class="user-name">@context.User.Identity?.Name</span>
                    <a class="btn-help" href="@_helpUrl" target="_blank" rel="noopener"
                       title="Open the user manual for this page">📖 Help</a>
                    <button class="btn-logout" @onclick="Logout">Sign Out</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <div class="app-body">
        @* Login-first: the nav (the whole "UI map") only renders for an authenticated
           user. An anonymous visitor hitting a protected route is redirected to /login
           by AuthorizeRouteView and never sees the feature list. *@
        <AuthorizeView>
        <Authorized>
        <nav class="sidebar">
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Home</span>
            </NavLink>
            <NavLink class="nav-item" href="/patient-lookup">
                <span class="nav-icon">🔍</span>
                <span class="nav-label">Patient Lookup</span>
            </NavLink>

            @if (SecurityContext.HasAccess(MenuArea.Clinical))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Clinical</div>

            <NavLink class="nav-item" href="/cover-sheet">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Cover Sheet</span>
            </NavLink>
            @if (SecurityContext.IsFeatureEnabled("SPECIALTY_COVERSHEET"))
            {
                <NavLink class="nav-item" href="/coversheet-preview">
                    <span class="nav-icon">🗂️</span>
                    <span class="nav-label">Cover Sheet (Specialty)</span>
                </NavLink>
            }
            <NavLink class="nav-item" href="/patient-summary">
                <span class="nav-icon">🧠</span>
                <span class="nav-label">AI Summary</span>
            </NavLink>
            <NavLink class="nav-item" href="/problems">
                <span class="nav-icon">⚠️</span>
                <span class="nav-label">Problems</span>
            </NavLink>
            <NavLink class="nav-item" href="/medications">
                <span class="nav-icon">💊</span>
                <span class="nav-label">Medications</span>
            </NavLink>
            <NavLink class="nav-item" href="/orders">
                <span class="nav-icon">📝</span>
                <span class="nav-label">Orders</span>
            </NavLink>
            <NavLink class="nav-item" href="/notes">
                <span class="nav-icon">🗒️</span>
                <span class="nav-label">Notes</span>
            </NavLink>
            <NavLink class="nav-item" href="/consults">
                <span class="nav-icon">🩺</span>
                <span class="nav-label">Consults</span>
            </NavLink>
            <NavLink class="nav-item" href="/external-referrals">
                <span class="nav-icon">🔗</span>
                <span class="nav-label">Ext. Referrals</span>
            </NavLink>
            <NavLink class="nav-item" href="/labs">
                <span class="nav-icon">🔬</span>
                <span class="nav-label">Labs</span>
            </NavLink>
            <NavLink class="nav-item" href="/vitals">
                <span class="nav-icon">❤️</span>
                <span class="nav-label">Vitals</span>
            </NavLink>
            <NavLink class="nav-item" href="/allergies">
                <span class="nav-icon">🚫</span>
                <span class="nav-label">Allergies</span>
            </NavLink>
            <NavLink class="nav-item" href="/immunizations">
                <span class="nav-icon">💉</span>
                <span class="nav-label">Immunizations</span>
            </NavLink>
            <NavLink class="nav-item" href="/immunization-forecast">
                <span class="nav-icon">📅</span>
                <span class="nav-label">Imm. Forecast</span>
            </NavLink>
            <NavLink class="nav-item" href="/surgery">
                <span class="nav-icon">🏥</span>
                <span class="nav-label">Surgery</span>
            </NavLink>
            <NavLink class="nav-item" href="/radiology">
                <span class="nav-icon">📡</span>
                <span class="nav-label">Radiology</span>
            </NavLink>
            <NavLink class="nav-item" href="/imaging">
                <span class="nav-icon">🖼️</span>
                <span class="nav-label">Imaging</span>
            </NavLink>
            <NavLink class="nav-item" href="/bcma">
                <span class="nav-icon">💊</span>
                <span class="nav-label">BCMA</span>
            </NavLink>
            @* Mental Health needs the fine-grained YS MH INSTRUMENT key (not just Clinical
               access), so gate the item on the key — otherwise a clinician without it lands
               on a page that throws Access denied. *@
            @if (SecurityContext.HasKey(SecurityKeys.YS_MH_INSTRUMENT))
            {
            <NavLink class="nav-item" href="/mental-health">
                <span class="nav-icon">🧠</span>
                <span class="nav-label">Mental Health</span>
            </NavLink>
            }
            <NavLink class="nav-item" href="/dietetics">
                <span class="nav-icon">🥗</span>
                <span class="nav-label">Dietetics</span>
            </NavLink>
            <NavLink class="nav-item" href="/reminders">
                <span class="nav-icon">⏰</span>
                <span class="nav-label">Reminders</span>
            </NavLink>
            <NavLink class="nav-item" href="/health-factors">
                <span class="nav-icon">📊</span>
                <span class="nav-label">Health Factors</span>
            </NavLink>
            <NavLink class="nav-item" href="/health-summary">
                <span class="nav-icon">📃</span>
                <span class="nav-label">Health Summary</span>
            </NavLink>
            <NavLink class="nav-item" href="/pt">
                <span class="nav-icon">🏋️</span>
                <span class="nav-label">Physical Therapy</span>
            </NavLink>
            <NavLink class="nav-item" href="/ecr">
                <span class="nav-icon">📡</span>
                <span class="nav-label">eCR</span>
            </NavLink>
            <NavLink class="nav-item" href="/dsi">
                <span class="nav-icon">🧩</span>
                <span class="nav-label">Decision Support</span>
            </NavLink>
            <NavLink class="nav-item" href="/cqm">
                <span class="nav-icon">📈</span>
                <span class="nav-label">CQM</span>
            </NavLink>
            }

            @* Oncology — first-class Modern module (ONCOLOGY flag, on by default). Shown to any
               clinician; the pages are read-only unless the user holds ONCO MANAGER. Not a
               privacy silo like Mental Health, so it's gated on the flag, not a view key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("ONCOLOGY"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Oncology</div>
            <NavLink class="nav-item" href="/oncology">
                <span class="nav-icon">🎗️</span>
                <span class="nav-label">Tumor Registry</span>
            </NavLink>
            <NavLink class="nav-item" href="/radiation-therapy">
                <span class="nav-icon">☢️</span>
                <span class="nav-label">Radiation Therapy</span>
            </NavLink>
            <NavLink class="nav-item" href="/cancerregistry">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Cancer Registry</span>
            </NavLink>
            }

            @* Pharmacogenomics (PGx) — Modern module gated on the PHARMACOGENOMICS site flag.
               Drug-gene decision support; writes are OPEN like neonatal/OB, so gated on the
               flag only, not a security key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("PHARMACOGENOMICS"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Pharmacogenomics</div>
            <NavLink class="nav-item" href="/pharmacogenomics">
                <span class="nav-icon">🧬</span>
                <span class="nav-label">Pharmacogenomics</span>
            </NavLink>
            }

            @* Person / Identity (ADR-002) — Modern module gated on the PERSON_IDENTITY site flag.
               Cross-role Person view + link workflow + privacy/audit surfaces; the record-level access
               decision is made in the workflow grain (treatment relationship never gated, protected
               records require break-the-glass), so gated on the flag only, not a security key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("PERSON_IDENTITY"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Identity</div>
            <NavLink class="nav-item" href="/person">
                <span class="nav-icon">👤</span>
                <span class="nav-label">Person / Identity</span>
            </NavLink>
            }

            @* Inpatient / Bed Management — gated on the BED_MANAGEMENT site flag. Bed Board is
               read-open (actions are key-gated in the grains); Transfer Center additionally
               self-hides on single-institution sites (it needs somewhere to transfer TO). *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("BED_MANAGEMENT"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Inpatient</div>
            <NavLink class="nav-item" href="/beds">
                <span class="nav-icon">🛏️</span>
                <span class="nav-label">Bed Board</span>
            </NavLink>
            @if (_activeInstitutions is null or > 1)
            {
            <NavLink class="nav-item" href="/transfer-center">
                <span class="nav-icon">🚑</span>
                <span class="nav-label">Transfer Center</span>
            </NavLink>
            }
            }

            @* Hereditary Genetics & Family History — Modern module gated on the HEREDITARY_GENETICS
               site flag. Genetic test reports + structured family history + curated hereditary-risk
               assessment; writes are OPEN like pharmacogenomics/neonatal/OB, so gated on the flag
               only, not a security key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("HEREDITARY_GENETICS"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Genetics</div>
            <NavLink class="nav-item" href="/genetics">
                <span class="nav-icon">🧬</span>
                <span class="nav-label">Genetics &amp; Family Hx</span>
            </NavLink>
            }

            @* Home-Based Care (HBPC) — Modern module gated on the HOME_BASED_CARE site flag.
               Shown to any clinician; the page is read-only unless the user holds HBHC MANAGER. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("HOME_BASED_CARE"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Home Care</div>
            <NavLink class="nav-item" href="/home-care">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Home Care</span>
            </NavLink>
            <NavLink class="nav-item" href="/home-health-agencies">
                <span class="nav-icon">🏥</span>
                <span class="nav-label">Home-Health Agencies</span>
            </NavLink>
            }

            @* Neonatal / Newborn Nursery — extends the OB module (NEONATAL_CARE site flag).
               Writes are OPEN like OB, so gated on the flag only, not a security key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("NEONATAL_CARE"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Neonatal</div>
            <NavLink class="nav-item" href="/neonatal">
                <span class="nav-icon">👶</span>
                <span class="nav-label">Neonatal / Nursery</span>
            </NavLink>
            }

            @* Emerging-condition surveillance (ADR-004) — Modern module gated on the
               EMERGING_CONDITIONS site flag. Reads are OPEN (surveillance is part of the chart);
               proto edits/promotion need EPI MANAGER, symptom recording needs a front-door key. *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("EMERGING_CONDITIONS"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Surveillance</div>
            <NavLink class="nav-item" href="/emerging-conditions">
                <span class="nav-icon">🧫</span>
                <span class="nav-label">Emerging Conditions</span>
            </NavLink>
            <NavLink class="nav-item" href="/symptom-survey">
                <span class="nav-icon">📝</span>
                <span class="nav-label">Symptom Survey</span>
            </NavLink>
            }

            @* Whole-Person Social Care (ADR-005) — Modern module gated on the SOCIAL_CARE site flag.
               Person-anchored household + coded SDOH screening that closes the loop to Z-codes and
               the existing Social Work referral machinery. Reads open; the Z-code apply needs
               GMPL PROBLEM (a problem-list write). *@
            @if (SecurityContext.HasAccess(MenuArea.Clinical) && SecurityContext.IsFeatureEnabled("SOCIAL_CARE"))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Social Care</div>
            <NavLink class="nav-item" href="/sdoh-screening">
                <span class="nav-icon">🧭</span>
                <span class="nav-label">SDOH Screening</span>
            </NavLink>
            <NavLink class="nav-item" href="/household">
                <span class="nav-icon">🏘️</span>
                <span class="nav-label">Household</span>
            </NavLink>
            <NavLink class="nav-item" href="/case-management">
                <span class="nav-icon">🎯</span>
                <span class="nav-label">Case Management</span>
            </NavLink>
            <NavLink class="nav-item" href="/resource-directory">
                <span class="nav-icon">🤝</span>
                <span class="nav-label">Resource Directory</span>
            </NavLink>
            <NavLink class="nav-item" href="/veteran-psychosocial">
                <span class="nav-icon">🎖️</span>
                <span class="nav-label">Veteran Psychosocial</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Nursing))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Nursing</div>

            <NavLink class="nav-item" href="/nursing">
                <span class="nav-icon">🩹</span>
                <span class="nav-label">Nursing Assessment</span>
            </NavLink>
            <NavLink class="nav-item" href="/shift-handoff">
                <span class="nav-icon">🔄</span>
                <span class="nav-label">Shift Handoff</span>
            </NavLink>
            <NavLink class="nav-item" href="/nursing-careplan">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Care Plan</span>
            </NavLink>
            <NavLink class="nav-item" href="/nursing-triage">
                <span class="nav-icon">🚑</span>
                <span class="nav-label">Triage</span>
            </NavLink>
            <NavLink class="nav-item" href="/nursing-tasks">
                <span class="nav-icon">✅</span>
                <span class="nav-label">Task Worklist</span>
            </NavLink>
            <NavLink class="nav-item" href="/pain-assessment">
                <span class="nav-icon">😣</span>
                <span class="nav-label">Pain Assessment</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Laboratory))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Laboratory</div>

            <NavLink class="nav-item" href="/lab-tech">
                <span class="nav-icon">🧪</span>
                <span class="nav-label">Lab Tech</span>
            </NavLink>
            <NavLink class="nav-item" href="/anatomic-pathology">
                <span class="nav-icon">🔬</span>
                <span class="nav-label">Anatomic Pathology</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Radiology))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Radiology</div>

            <NavLink class="nav-item" href="/rad-tech">
                <span class="nav-icon">📡</span>
                <span class="nav-label">Rad Tech</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Pharmacy))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Pharmacy</div>

            <NavLink class="nav-item" href="/pharmacy" Match="NavLinkMatch.All">
                <span class="nav-icon">💊</span>
                <span class="nav-label">Pharmacy Hub</span>
            </NavLink>
            <NavLink class="nav-item" href="/outpatientpharmacy">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Outpatient Rx</span>
            </NavLink>
            <NavLink class="nav-item" href="/inpatientpharmacy">
                <span class="nav-icon">🏥</span>
                <span class="nav-label">Inpatient Meds</span>
            </NavLink>
            <NavLink class="nav-item" href="/drugaccountability">
                <span class="nav-icon">📦</span>
                <span class="nav-label">Drug Accountability</span>
            </NavLink>
            <NavLink class="nav-item" href="/pharmacybenefits">
                <span class="nav-icon">💳</span>
                <span class="nav-label">Benefits &amp; PA</span>
            </NavLink>
            <NavLink class="nav-item" href="/drug-utilization-review">
                <span class="nav-icon">🔬</span>
                <span class="nav-label">DUR</span>
            </NavLink>
            <NavLink class="nav-item" href="/interaction-blocking">
                <span class="nav-icon">⚠️</span>
                <span class="nav-label">Interactions</span>
            </NavLink>
            }

            @if (SecurityContext.HasAccess(MenuArea.Registration))
            {
            <div class="nav-divider"></div>
            <div class="nav-section-title">Administrative</div>

            <NavLink class="nav-item" href="/adt">
                <span class="nav-icon">🛏️</span>
                <span class="nav-label">ADT</span>
            </NavLink>
            <NavLink class="nav-item" href="/means-test">
                <span class="nav-icon">📋</span>
                <span class="nav-label">Means Test</span>
            </NavLink>
            <NavLink class="nav-item" href="/service-connected">
                <span class="nav-icon">🎖️</span>
                <span class="nav-label">SC Conditions</span>
            </NavLink>
            <NavLink class="nav-item" href="/prosthetics">
