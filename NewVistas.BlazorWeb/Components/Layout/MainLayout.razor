            </NavLink>
            <NavLink class="nav-item" href="/drug-interactions">
                <span class="nav-icon">⚗️</span>
                <span class="nav-label">Drug Interactions</span>
            </NavLink>
            <NavLink class="nav-item" href="/lab-shipping">
